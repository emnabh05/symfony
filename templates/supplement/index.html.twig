{% extends 'base.html.twig' %}

{% block title %}Supplements - Fitopia Admin{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">Supplements</h1>
        <p class="page-subtitle">Manage your supplement inventory</p>
    </div>
    <div class="header-actions">
        <a href="{{ path('app_supplement_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Supplement
        </a>
    </div>
</div>

<div class="table-container">
    <div class="table-wrapper">
        {% if supplements|length > 0 %}
        <table>
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for supplement in supplements %}
                <tr>
                    <td>
                        {% if supplement.image %}
                            <img src="/uploads/supplements/{{ supplement.image }}" alt="{{ supplement.name }}" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px;">
                        {% else %}
                            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #0B2C3D, #1B5E4B); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white;">
                                <i class="fas fa-capsules"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td><strong>{{ supplement.name }}</strong></td>
                    <td>{{ supplement.category }}</td>
                    <td>{{ supplement.brand }}</td>
                    <td><strong>${{ supplement.price|number_format(2) }}</strong></td>
                    <td>
                        <span class="badge {% if supplement.stock > 50 %}badge-active{% elseif supplement.stock > 0 %}badge-inactive{% else %}badge-inactive{% endif %}">
                            {{ supplement.stock }} units
                        </span>
                    </td>
                    <td class="table-actions">
                        <a href="{{ path('app_supplement_show', {'id': supplement.id}) }}" class="btn btn-small btn-edit" title="View">
                            <i class="fas fa-eye"></i> View
                        </a>
                        <a href="{{ path('app_supplement_edit', {'id': supplement.id}) }}" class="btn btn-small btn-edit" title="Edit">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <form method="post" action="{{ path('app_supplement_delete', {'id': supplement.id}) }}" onsubmit="return confirm('Are you sure you want to delete this supplement?');" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ supplement.id) }}">
                            <button type="submit" class="btn btn-small btn-danger" title="Delete">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="empty-state">
            <i class="fas fa-capsules"></i>
            <p>No supplements found</p>
            <a href="{{ path('app_supplement_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add Your First Supplement
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

