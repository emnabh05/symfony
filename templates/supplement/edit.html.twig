{% extends 'base.html.twig' %}

{% block title %}Edit {{ supplement.name }} - Fitopia Admin{% endblock %}

{% block body %}
<div class="page-header">
    <a href="{{ path('app_supplement_index') }}" class="back-btn">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h1 class="page-title">Edit Supplement</h1>
</div>

<div class="form-container">
    {{ form_start(form, {'attr': {'id': 'supplementForm', 'novalidate': 'novalidate'}}) }}

    <div class="form-row">
        <div class="form-group">
            <label>Name *</label>
            {{ form_widget(form.name) }}
            <div class="error-message" id="name-error"></div>
        </div>
        <div class="form-group">
            <label>Category *</label>
            {{ form_widget(form.category) }}
            <div class="error-message" id="category-error"></div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label>Brand *</label>
            {{ form_widget(form.brand) }}
            <div class="error-message" id="brand-error"></div>
        </div>
        <div class="form-group">
            <label>Price ($) *</label>
            {{ form_widget(form.price) }}
            <div class="error-message" id="price-error"></div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label>Stock Quantity *</label>
            {{ form_widget(form.stock) }}
            <div class="error-message" id="stock-error"></div>
        </div>
        <div class="form-group">
            <label>Calories</label>
            {{ form_widget(form.calories) }}
            <div class="error-message" id="calories-error"></div>
        </div>
    </div>

    <div class="form-row full">
        <div class="form-group">
            <label>Description</label>
            {{ form_widget(form.description) }}
            <div class="error-message" id="description-error"></div>
        </div>
    </div>

    <div class="form-row full">
        <div class="form-group">
            <label>Product Image</label>
            {% if supplement.image %}
                <div class="current-image">
                    <img src="/uploads/supplements/{{ supplement.image }}" alt="{{ supplement.name }}">
                    <p>Current image</p>
                </div>
            {% endif %}
            {{ form_widget(form.imageFile) }}
            <div class="error-message" id="image-error"></div>
            <small style="color: #8892A0; font-size: 12px; margin-top: 5px; display: block;">Leave empty to keep current image. Allowed formats: JPG, PNG, WEBP. Max size: 5MB</small>
        </div>
    </div>

    <div class="form-actions">
        <a href="{{ path('app_supplement_index') }}" class="btn btn-secondary">
            <i class="fas fa-times"></i> Cancel
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Update Supplement
        </button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
<script src="/js/supplement-validation.js"></script>
{% endblock %}

