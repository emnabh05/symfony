{% extends 'base.html.twig' %}

{% block title %}Events | Fitopia{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Sora:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --events-bg: #f5f8fb;
      --events-surface: #ffffff;
      --events-text: #0f172a;
      --events-muted: #55627a;
      --events-brand: #0f7a5f;
      --events-brand-dark: #0b3a3d;
      --events-border: #dde6ef;
      --events-shadow: 0 20px 40px rgba(15, 32, 48, 0.08);
      --events-page-gutter: clamp(18px, 2.8vw, 52px);
    }
    .events-shell {
      background: radial-gradient(circle at 18% 10%, #e5fff3 0%, transparent 32%),
                  radial-gradient(circle at 85% 12%, #e8f3ff 0%, transparent 30%),
                  var(--events-bg);
      padding: 48px 0 70px;
      font-family: "Manrope", "Sora", sans-serif;
      color: var(--events-text);
    }
    .events-container {
      width: calc(100% - (var(--events-page-gutter) * 2));
      max-width: none;
      margin: 0 auto;
    }
    .events-hero {
      background: linear-gradient(125deg, #0b3a3d 0%, #0f7a5f 55%, #3dcf9f 100%);
      border-radius: 24px;
      color: #fff;
      overflow: hidden;
      position: relative;
      box-shadow: var(--events-shadow);
      margin-bottom: 22px;
    }
    .events-hero::after {
      content: "";
      position: absolute;
      right: -90px;
      top: -90px;
      width: 260px;
      height: 260px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.11);
    }
    .events-hero-content {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 20px;
      padding: 36px;
      position: relative;
      z-index: 1;
    }
    .hero-kicker {
      display: inline-flex;
      border-radius: 999px;
      padding: 7px 14px;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.3);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .events-hero h1 {
      margin: 0;
      font-size: clamp(32px, 4.2vw, 52px);
      font-weight: 800;
      line-height: 1.05;
    }
    .hero-copy {
      margin-top: 14px;
      max-width: 48ch;
      color: rgba(255, 255, 255, 0.9);
      font-size: 18px;
      line-height: 1.6;
    }
    .hero-ctas {
      margin-top: 22px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .hero-btn {
      border: 0;
      border-radius: 12px;
      padding: 12px 20px;
      font-weight: 800;
      font-size: 14px;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .hero-btn:hover { transform: translateY(-2px); }
    .hero-btn-primary {
      background: #fff;
      color: #0b3a3d;
      box-shadow: 0 12px 24px rgba(8, 26, 35, .2);
    }
    .hero-btn-secondary {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.35);
    }
    .featured-panel {
      background: rgba(255, 255, 255, 0.17);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 16px;
      padding: 18px;
      backdrop-filter: blur(4px);
    }
    .featured-panel h3 {
      margin: 0;
      font-size: 18px;
      font-weight: 800;
    }
    .featured-meta {
      margin-top: 8px;
      display: grid;
      gap: 6px;
      font-size: 14px;
      color: rgba(255, 255, 255, .9);
    }
    .trust-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 16px;
    }
    .trust-badge {
      border-radius: 999px;
      background: #fff;
      border: 1px solid var(--events-border);
      color: #203047;
      padding: 8px 14px;
      font-size: 12px;
      font-weight: 700;
      box-shadow: 0 8px 16px rgba(15, 32, 48, 0.06);
    }
    .loyalty-overview {
      margin-top: 14px;
      border: 1px solid var(--events-border);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: var(--events-shadow);
      padding: 14px;
    }
    .loyalty-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }
    .loyalty-title {
      margin: 0;
      color: #10324e;
      font-size: 16px;
      font-weight: 800;
    }
    .loyalty-badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 800;
      border: 1px solid transparent;
    }
    .loyalty-None { background: #f1f5f9; color: #475569; border-color: #d9e2ec; }
    .loyalty-Bronze { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
    .loyalty-Silver { background: #e2e8f0; color: #334155; border-color: #cbd5e1; }
    .loyalty-Gold { background: #fef08a; color: #854d0e; border-color: #fde047; }
    .loyalty-VIP { background: #fee2e2; color: #9f1239; border-color: #fda4af; }
    .loyalty-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-top: 10px;
    }
    .loyalty-metric {
      border: 1px solid #e5edf4;
      border-radius: 10px;
      background: #f8fbff;
      padding: 10px;
    }
    .loyalty-metric strong {
      display: block;
      font-size: 13px;
      color: #1f3d61;
    }
    .loyalty-metric span {
      color: #506176;
      font-size: 13px;
      font-weight: 700;
    }
    .loyalty-benefits {
      margin-top: 10px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .loyalty-benefit {
      border: 1px solid #d9e5f1;
      border-radius: 10px;
      background: #fff;
      padding: 8px 10px;
    }
    .loyalty-benefit strong {
      display: block;
      color: #183a59;
      font-size: 13px;
      margin-bottom: 2px;
    }
    .loyalty-benefit p {
      margin: 0;
      color: #576a80;
      font-size: 12px;
    }
    .vip-lock-note {
      margin-top: 6px;
      font-size: 12px;
      font-weight: 800;
      color: #9f1239;
    }
    .events-toolbar {
      background: var(--events-surface);
      border: 1px solid var(--events-border);
      border-radius: 18px;
      padding: 16px;
      display: grid;
      grid-template-columns: 1.4fr repeat(4, 1fr);
      gap: 12px;
      box-shadow: var(--events-shadow);
      margin-bottom: 20px;
    }
    .recommend-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
      margin: 14px 0 18px;
    }
    .recommend-card {
      background: #fff;
      border: 1px solid var(--events-border);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 8px 18px rgba(15, 32, 48, 0.08);
      display: flex;
      flex-direction: column;
    }
    .recommend-image {
      aspect-ratio: 16/9;
      width: 100%;
      object-fit: cover;
      background: #e5edf5;
    }
    .recommend-body {
      padding: 10px;
      display: grid;
      gap: 8px;
    }
    .recommend-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      flex-wrap: wrap;
    }
    .recommend-card h4 {
      margin: 0;
      font-size: 14px;
      font-weight: 800;
      line-height: 1.3;
      color: #0f2139;
    }
    .recommend-score {
      display: inline-flex;
      border-radius: 999px;
      background: #e9fbf3;
      color: #0f7a5f;
      border: 1px solid #b7f0d7;
      font-size: 11px;
      font-weight: 800;
      padding: 3px 8px;
    }
    .recommend-meta {
      margin: 0;
      color: #506176;
      font-size: 12px;
      display: grid;
      gap: 3px;
    }
    .recommend-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      border: 0;
      border-radius: 10px;
      text-decoration: none;
      background: linear-gradient(120deg, #0b3a3d, #0f7a5f);
      color: #fff;
      font-size: 12px;
      font-weight: 800;
      padding: 9px 10px;
    }
    .recommend-action.disabled {
      background: #d6dfe8;
      color: #5c6a7f;
      pointer-events: none;
    }
    .recommend-empty {
      border: 1px solid var(--events-border);
      border-radius: 12px;
      background: #fff;
      color: #55627a;
      padding: 12px;
      margin: 10px 0 18px;
    }
    .events-input, .events-select {
      border: 1px solid #d5dfe9;
      border-radius: 12px;
      min-height: 44px;
      padding: 10px 12px;
      font-size: 14px;
      font-weight: 600;
      color: #173049;
      width: 100%;
      background: #fff;
    }
    .events-input:focus, .events-select:focus {
      outline: none;
      border-color: #3cae8c;
      box-shadow: 0 0 0 3px rgba(60, 174, 140, .15);
    }
    .events-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
    .event-card {
      background: var(--events-surface);
      border: 1px solid var(--events-border);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: var(--events-shadow);
      transition: transform .22s ease, box-shadow .22s ease;
      animation: cardIn .35s ease both;
    }
    .event-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 28px 44px rgba(15, 32, 48, 0.13);
    }
    .event-media {
      aspect-ratio: 16/8;
      width: 100%;
      object-fit: cover;
    }
    .event-body {
      padding: 16px;
    }
    .event-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
    }
    .event-title {
      margin: 0;
      font-size: 22px;
      line-height: 1.2;
      font-weight: 800;
      color: #0f2139;
    }
    .state-badge {
      border-radius: 999px;
      padding: 6px 11px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .05em;
      font-weight: 800;
    }
    .state-open { background: #e9fbf3; color: #0f7a5f; }
    .state-full { background: #ffe8e8; color: #ba3030; }
    .event-engagement {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }
    .engage-chip {
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 700;
      background: #f4f7fb;
      color: #29415f;
      border: 1px solid #d8e2ee;
    }
    .engage-chip i {
      margin-right: 4px;
    }
    .rating-stars {
      display: inline-flex;
      gap: 2px;
      color: #f59e0b;
      font-size: 13px;
      vertical-align: middle;
    }
    .badge-insight {
      border-radius: 10px;
      padding: 5px 9px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-left: 6px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .badge-premium { background: #ffedd5; color: #9a3412; border: 1px solid #fdba74; }
    .badge-recommended { background: #ecfeff; color: #0f766e; border: 1px solid #99f6e4; }
    .badge-new { background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe; }
    .event-actions {
      margin-top: 10px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }
    .favorite-btn {
      border: 1px solid #d8e2ee;
      border-radius: 10px;
      background: #fff;
      color: #173049;
      font-size: 13px;
      font-weight: 800;
      padding: 9px 12px;
      white-space: nowrap;
    }
    .favorite-btn.active {
      border-color: #fda4af;
      color: #be123c;
      background: #fff1f2;
    }
    .favorite-btn:disabled {
      opacity: .55;
      cursor: not-allowed;
    }
    .event-meta {
      margin: 11px 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      color: #415069;
      font-size: 13px;
      font-weight: 700;
    }
    .event-pill {
      background: #f0f4f8;
      border-radius: 999px;
      padding: 7px 11px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .event-description {
      margin: 0 0 15px;
      color: var(--events-muted);
      line-height: 1.65;
      font-size: 16px;
      min-height: 78px;
    }
    .event-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .event-price {
      font-size: 22px;
      font-weight: 800;
      color: #0e6f57;
    }
    .register-btn {
      border: 0;
      background: linear-gradient(120deg, #0b3a3d, #0f7a5f);
      color: #fff;
      font-weight: 800;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-radius: 12px;
      padding: 11px 16px;
      text-decoration: none;
      transition: transform .2s ease, opacity .2s ease, box-shadow .2s ease;
      box-shadow: 0 10px 18px rgba(11, 58, 61, .2);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .register-btn:hover { opacity: .95; transform: translateY(-2px); color: #fff; }
    .register-btn.disabled {
      background: #d6dfe8;
      box-shadow: none;
      color: #5c6a7f;
      pointer-events: none;
    }
    .register-btn.priority {
      background: linear-gradient(120deg, #1f4d8f, #0f7a5f);
      box-shadow: 0 12px 20px rgba(31, 77, 143, 0.24);
    }
    .details-panel {
      margin-top: 26px;
      background: #fff;
      border-radius: 18px;
      border: 1px solid var(--events-border);
      box-shadow: var(--events-shadow);
      padding: 18px;
    }
    .details-header {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 18px;
    }
    .details-image {
      width: 100%;
      border-radius: 14px;
      aspect-ratio: 16/9;
      object-fit: cover;
      margin-top: 12px;
    }
    .book-panel {
      border: 1px solid var(--events-border);
      border-radius: 14px;
      padding: 14px;
      background: #fbfdff;
    }
    .book-panel h4 { margin: 0 0 8px; font-weight: 800; }
    .book-panel .form-label { font-size: 13px; font-weight: 700; }
    .book-panel .form-control {
      border-radius: 10px;
      min-height: 42px;
      border: 1px solid #d6e2ed;
    }
    .book-panel .book-trust {
      margin-top: 10px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .book-chip {
      font-size: 11px;
      font-weight: 700;
      border-radius: 999px;
      border: 1px solid #d9e7f3;
      color: #27405a;
      padding: 5px 10px;
      background: #fff;
    }
    .reviews-panel {
      margin-top: 18px;
      border: 1px solid var(--events-border);
      border-radius: 14px;
      background: #fcfdff;
      padding: 14px;
    }
    .reviews-grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 14px;
    }
    .review-card {
      border: 1px solid #dbe5ef;
      border-radius: 12px;
      background: #fff;
      padding: 12px;
      margin-bottom: 10px;
    }
    .review-card:last-child {
      margin-bottom: 0;
    }
    .review-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 6px;
      color: #20354f;
      font-size: 13px;
      font-weight: 700;
    }
    .review-comment {
      margin: 0;
      color: #42556f;
      line-height: 1.55;
      white-space: pre-wrap;
    }
    .review-sort {
      min-height: 38px;
      border-radius: 10px;
      border: 1px solid #cfdae6;
      padding: 8px 10px;
      font-size: 13px;
      font-weight: 700;
      background: #fff;
    }
    .empty-note {
      background: #fff;
      border: 1px solid var(--events-border);
      border-radius: 14px;
      padding: 18px;
      color: var(--events-muted);
    }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @media (max-width: 1080px) {
      .events-toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .recommend-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .events-grid { grid-template-columns: 1fr; }
      .details-header { grid-template-columns: 1fr; }
      .reviews-grid { grid-template-columns: 1fr; }
      .loyalty-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .loyalty-benefits { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .events-shell { padding-top: 28px; }
      .events-hero-content { grid-template-columns: 1fr; padding: 24px; }
      .hero-copy { font-size: 16px; }
      .events-toolbar { grid-template-columns: 1fr; padding: 12px; }
      .recommend-grid { grid-template-columns: 1fr; }
      .event-title { font-size: 19px; }
      .event-description { min-height: 0; font-size: 15px; }
    }

    .events-shell {
      background: radial-gradient(circle at 12% 0%, #effcf6 0%, transparent 27%),
                  radial-gradient(circle at 94% 5%, #eff7ff 0%, transparent 23%),
                  #f7fbf8;
      padding: 18px 0 78px;
    }

    .events-container {
      width: calc(100% - (var(--events-page-gutter) * 2));
    }

    .events-command-bar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
    }

    .events-command-left,
    .events-command-right,
    .events-command-pills {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .events-command-right {
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }

    .events-command-label {
      color: #6a7d73;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.01em;
    }

    .command-heart-btn,
    .command-recommend-btn {
      border: 1px solid #d9ebe2;
      background: #fff;
      color: #153f33;
      text-decoration: none;
      box-shadow: 0 10px 20px rgba(12, 45, 41, 0.05);
    }

    .command-heart-btn {
      width: 58px;
      height: 58px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      color: #f43f5e;
    }

    .command-recommend-btn {
      border-radius: 999px;
      padding: 14px 28px;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

    .command-recommend-btn.is-active,
    .command-recommend-btn:hover,
    .command-heart-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 16px 28px rgba(12, 45, 41, 0.08);
    }

    .command-pill {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 4px 0;
      color: #24453a;
      font-size: 13px;
      font-weight: 700;
    }

    .events-dock {
      border: 1px solid #d9ebe2;
      background: #ffffff;
      border-radius: 28px;
      padding: 24px;
      margin-bottom: 18px;
      box-shadow: 0 18px 36px rgba(11, 58, 61, 0.06);
    }

    .events-dock.is-hidden {
      display: none;
    }

    .dock-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }

    .dock-title {
      margin: 0;
      color: #153f33;
      font-size: 18px;
      font-weight: 900;
    }

    .dock-subtitle {
      margin: 4px 0 0;
      color: #667d73;
      font-size: 14px;
    }

    .dock-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 114px;
      min-height: 44px;
      border-radius: 999px;
      border: 1px solid #d9ebe2;
      background: #f8fdfb;
      color: #153f33;
      font-weight: 800;
      font-size: 14px;
    }

    .dock-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }

    .dock-card {
      border: 1px solid #e5edea;
      border-radius: 20px;
      background: #fbfefd;
      padding: 16px;
      display: grid;
      gap: 10px;
      min-height: 210px;
    }

    .dock-card strong {
      color: #0c2b22;
      font-size: 18px;
      font-weight: 900;
      line-height: 1.2;
    }

    .dock-card p {
      margin: 0;
      color: #5d6d68;
      font-size: 13px;
      line-height: 1.55;
    }

    .dock-chip-row,
    .passport-chip-row,
    .featured-chip-row,
    .card-chip-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .dock-chip,
    .passport-chip,
    .featured-chip,
    .card-chip {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 700;
    }

    .dock-chip {
      background: #ecfdf5;
      color: #059669;
      border: 1px solid #bbf7d0;
    }

    .dock-action {
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      border-radius: 14px;
      text-decoration: none;
      background: #10b981;
      color: #ffffff;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.01em;
      padding: 10px 14px;
    }

    .dock-action.is-disabled {
      opacity: .55;
      pointer-events: none;
    }

    .events-hero {
      background: #ebf5ef;
      border-radius: 32px;
      padding: 36px;
      box-shadow: 0 18px 36px rgba(11, 58, 61, 0.06);
      margin-bottom: 28px;
    }

    .events-hero::after {
      display: none;
    }

    .events-hero-grid {
      display: grid;
      grid-template-columns: minmax(560px, 820px) minmax(380px, 1fr);
      gap: 32px;
      align-items: center;
    }

    .events-hero-visual {
      position: relative;
      min-height: 470px;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 18px 32px rgba(8, 20, 28, 0.16);
      background: #dce8e3 center/cover no-repeat;
    }

    .events-hero-visual::before {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 58%;
      background: linear-gradient(to top, rgba(10, 27, 37, 0.82), rgba(10, 27, 37, 0.08));
    }

    .events-hero-overlay {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      max-width: 345px;
      padding: 24px;
      z-index: 1;
    }

    .events-story-chip {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 6px 14px;
      background: #ffffff;
      color: #0c2b22;
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .events-hero-overlay h2 {
      margin: 0;
      color: #ffffff;
      font-size: clamp(28px, 2.3vw, 42px);
      font-weight: 900;
      line-height: 1.05;
    }

    .events-hero-copy {
      display: grid;
      gap: 18px;
      align-content: center;
    }

    .events-mini-kicker {
      color: #10b981;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.08em;
    }

    .events-hero-copy h1 {
      margin: 0;
      color: #0c2b22;
      font-size: clamp(38px, 3.7vw, 64px);
      font-weight: 900;
      line-height: 0.98;
      max-width: 15ch;
    }

    .events-hero-text {
      margin: 0;
      color: #475a61;
      font-size: 15px;
      line-height: 1.7;
      max-width: 60ch;
    }

    .events-hero-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .hero-btn {
      min-height: 50px;
      border-radius: 999px;
      padding: 0 28px;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      box-shadow: none;
    }

    .hero-btn-primary {
      background: #10b981;
      color: #ffffff;
    }

    .hero-btn-secondary {
      background: transparent;
      border: 1px solid #10b981;
      color: #10b981;
    }

    .hero-btn.is-disabled {
      opacity: .55;
      pointer-events: none;
    }

    .hero-link-btn {
      color: #64748b;
      text-decoration: none;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      padding: 10px 4px;
    }

    .hero-signal-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      padding-top: 10px;
    }

    .hero-signal-card {
      border: 1px solid #e5edea;
      border-radius: 18px;
      background: #ffffff;
      padding: 18px 22px;
      min-height: 116px;
      display: grid;
      gap: 8px;
      align-content: start;
    }

    .hero-signal-card strong {
      color: #0c2b22;
      font-size: 19px;
      font-weight: 900;
      line-height: 1.1;
    }

    .hero-signal-card span {
      color: #617770;
      font-size: 12px;
      line-height: 1.55;
    }

    .events-passport {
      display: grid;
      grid-template-columns: minmax(290px, .95fr) minmax(350px, 1.05fr) minmax(280px, .8fr) minmax(320px, .95fr);
      gap: 24px;
      background: #ffffff;
      border: 1px solid #d9ebe2;
      border-radius: 30px;
      padding: 26px;
      box-shadow: 0 18px 36px rgba(11, 58, 61, 0.05);
      margin-bottom: 26px;
    }

    .passport-title,
    .featured-kicker,
    .stat-block-label,
    .vip-progress-label {
      color: #10b981;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .passport-identity {
      color: #0c2b22;
      font-size: 22px;
      font-weight: 900;
      line-height: 1.2;
      margin: 12px 0 4px;
      word-break: break-word;
    }

    .passport-subtitle {
      color: #64748b;
      font-size: 14px;
      margin: 0 0 16px;
    }

    .passport-chip {
      border: 1px solid transparent;
      font-weight: 800;
    }

    .passport-chip.tier-bronze { background: #fff7ed; color: #c2410c; border-color: #fdba74; }
    .passport-chip.tier-silver { background: #eef2ff; color: #334155; border-color: #cbd5e1; }
    .passport-chip.tier-vip { background: #ecfdf5; color: #047857; border-color: #a7f3d0; }
    .passport-chip.access-active { background: #ecfdf5; color: #059669; border-color: #bbf7d0; }
    .passport-chip.access-locked { background: #f8fafc; color: #64748b; border-color: #dbe3ea; }

    .events-featured-card {
      border: 1px solid #bff2db;
      background: #fbfefd;
      border-radius: 24px;
      padding: 22px;
      box-shadow: 0 16px 30px rgba(16, 185, 129, 0.08);
      display: grid;
      gap: 16px;
    }

    .featured-title {
      margin: 0;
      color: #0c2b22;
      font-size: 44px;
      font-weight: 900;
      line-height: 1;
      text-transform: lowercase;
    }

    .featured-chip {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      color: #475569;
    }

    .featured-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      border-radius: 14px;
      text-decoration: none;
      background: #10b981;
      color: #ffffff;
      font-size: 14px;
      font-weight: 800;
      padding: 10px 18px;
    }

    .featured-action.is-muted {
      background: #9ca3af;
      color: #ffffff;
    }

    .featured-action.is-disabled {
      background: #d6dfe8;
      color: #5c6a7f;
      pointer-events: none;
    }

    .featured-description {
      margin: 0;
      color: #475a61;
      font-size: 14px;
      line-height: 1.65;
    }

    .passport-insights {
      display: grid;
      gap: 18px;
      align-content: start;
    }

    .stat-block {
      border: 1px solid #eef2f7;
      background: #ffffff;
      border-radius: 18px;
      padding: 16px;
      display: grid;
      gap: 6px;
    }

    .stat-block strong {
      color: #0c2b22;
      font-size: 18px;
      font-weight: 900;
    }

    .vip-progress-card {
      background: #f0faf5;
      border: 1px solid rgba(16, 185, 129, 0.12);
      border-radius: 22px;
      padding: 16px 18px;
      display: grid;
      gap: 12px;
      align-content: start;
    }

    .vip-progress-bar {
      width: 100%;
      height: 8px;
      border-radius: 999px;
      background: #dbe9e2;
      overflow: hidden;
    }

    .vip-progress-bar > span {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #0f7a5f, #10b981);
    }

    .vip-progress-main {
      margin: 0;
      color: #065f46;
      font-size: 13px;
      font-weight: 800;
      line-height: 1.55;
    }

    .vip-progress-sub {
      margin: 0;
      color: #34d399;
      font-size: 12px;
      font-weight: 700;
      line-height: 1.55;
    }

    .events-browse-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      margin: 8px 0 20px;
    }

    .events-browse-head h2 {
      margin: 0;
      color: #123d3a;
      font-size: clamp(34px, 3vw, 58px);
      font-weight: 900;
      line-height: 0.96;
    }

    .events-browse-head p {
      margin: 10px 0 0;
      max-width: 58ch;
      color: #72867b;
      font-size: 15px;
      line-height: 1.65;
    }

    .result-count-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 108px;
      min-height: 46px;
      padding: 0 22px;
      border-radius: 999px;
      border: 1px solid #d7e8de;
      background: #ffffff;
      color: #123d3a;
      font-size: 14px;
      font-weight: 800;
      box-shadow: 0 10px 24px rgba(11, 58, 61, 0.05);
    }

    .events-toolbar {
      grid-template-columns: minmax(320px, 2.2fr) repeat(4, minmax(0, .92fr)) auto;
      align-items: center;
      gap: 14px;
      border-radius: 34px;
      padding: 18px;
      border: 1px solid #d7e8de;
      background: linear-gradient(180deg, #ffffff 0%, #fcfffd 100%);
      box-shadow: 0 20px 38px rgba(11, 58, 61, 0.06);
    }

    .toolbar-search-slot,
    .toolbar-filter-slot {
      min-width: 0;
    }

    .toolbar-filter-slot--sort {
      min-width: 220px;
    }

    .toolbar-pill {
      display: flex;
      align-items: stretch;
      min-height: 60px;
      border: 1px solid #cfe5d9;
      border-radius: 24px;
      background: #ffffff;
      overflow: hidden;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .toolbar-pill .events-input,
    .toolbar-pill .events-select {
      min-height: 58px;
      border: 0;
      border-radius: 0;
      font-size: 15px;
      font-weight: 800;
      padding: 0 18px;
      color: #173f35;
      background: transparent;
      box-shadow: none;
    }

    .toolbar-pill .events-input:focus,
    .toolbar-pill .events-select:focus {
      outline: none;
      border: 0;
      box-shadow: none;
    }

    .toolbar-pill .events-select {
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      padding-right: 10px;
    }

    .toolbar-pill-tail {
      flex: 0 0 54px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-left: 1px solid #d7eadf;
      background: #eef8f2;
      color: #4f7d6a;
      font-size: 16px;
    }

    .events-date-input {
      color: #173f35;
    }

    .events-input::placeholder {
      color: #7e9489;
      opacity: 1;
      font-weight: 700;
    }

    .events-reset-btn {
      min-height: 52px;
      border: 0;
      border-radius: 999px;
      background: #194f43;
      color: #ffffff;
      font-size: 14px;
      font-weight: 900;
      padding: 0 28px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.01em;
      box-shadow: 0 14px 26px rgba(25, 79, 67, 0.16);
    }

    .events-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
      align-items: start;
      margin-top: 22px;
    }

    .event-card {
      border-radius: 22px;
      overflow: hidden;
      border: 1px solid #dbe9e2;
      box-shadow: 0 16px 30px rgba(15, 32, 48, 0.09);
      background: #ffffff;
    }

    .event-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 42px rgba(15, 32, 48, 0.14);
    }

    .event-media-frame {
      position: relative;
      min-height: 312px;
      overflow: hidden;
      border-radius: 22px 22px 0 0;
    }

    .event-media {
      aspect-ratio: auto;
      width: 100%;
      height: 312px;
      object-fit: cover;
      display: block;
    }

    .event-media-frame::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 48%;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0));
    }

    .event-card-ribbon {
      position: absolute;
      top: 18px;
      left: -31px;
      z-index: 2;
      transform: rotate(-45deg);
      min-width: 120px;
      text-align: center;
      background: #e24031;
      color: #ffffff;
      font-size: 12px;
      font-weight: 900;
      padding: 7px 0;
      letter-spacing: 0.02em;
      box-shadow: 0 10px 18px rgba(0, 0, 0, 0.18);
    }

    .event-media-title {
      position: absolute;
      left: 20px;
      right: 20px;
      bottom: 18px;
      z-index: 2;
      margin: 0;
      color: #ffffff;
      font-size: clamp(24px, 2vw, 38px);
      font-weight: 900;
      line-height: 1.05;
      text-transform: uppercase;
    }

    .event-card-body {
      padding: 16px 18px 18px;
      display: grid;
      gap: 12px;
    }

    .card-chip-row {
      gap: 8px;
    }

    .card-chip {
      background: #f7faf8;
      border: 1px solid #e4ece7;
      color: #587067;
    }

    .event-mini-meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .event-mini-note {
      background: #fbfefd;
      border: 1px solid #e4ece7;
      border-radius: 14px;
      padding: 10px 12px;
      display: grid;
      gap: 3px;
    }

    .event-mini-note strong {
      color: #20443a;
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .event-mini-note span {
      color: #617770;
      font-size: 13px;
      font-weight: 700;
      line-height: 1.45;
    }

    .event-actions-bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1.2fr);
      gap: 10px;
      align-items: center;
    }

    .event-action-btn,
    .event-book-btn,
    .event-favorite-icon {
      min-height: 44px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 13px;
      font-weight: 900;
      border: 0;
    }

    .event-action-btn {
      background: #f1f5f9;
      color: #31465f;
    }

    .event-favorite-icon {
      width: 44px;
      background: #f8fafc;
      color: #64748b;
      cursor: pointer;
      border: 1px solid #e2e8f0;
    }

    .event-favorite-icon.active {
      background: #fff1f2;
      border-color: #fecdd3;
      color: #ef4444;
    }

    .event-favorite-icon:disabled {
      opacity: .55;
      cursor: not-allowed;
    }

    .event-actions-bar form {
      margin: 0;
    }

    .event-book-btn {
      background: #8d8d8d;
      color: #ffffff !important;
      text-transform: uppercase;
      letter-spacing: 0.01em;
      padding: 0 14px;
    }

    .event-book-btn:hover,
    .event-book-btn:focus,
    .event-book-btn:visited {
      color: #ffffff !important;
    }

    .event-book-btn.is-muted {
      background: #9ca3af;
      color: #ffffff;
    }

    .event-book-btn.is-disabled {
      background: #d6dfe8;
      color: #5c6a7f;
      pointer-events: none;
    }

    .selected-event-shell {
      margin-top: 30px;
    }

    @media (max-width: 1480px) {
      .events-hero-grid { grid-template-columns: 1fr; }
      .events-passport { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .events-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .dock-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 1040px) {
      .events-toolbar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .toolbar-filter-slot--sort { min-width: 0; }
      .hero-signal-grid { grid-template-columns: 1fr; }
      .events-passport { grid-template-columns: 1fr; }
      .events-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 768px) {
      .events-container {
        width: calc(100% - 18px);
      }

      .events-command-bar,
      .events-browse-head,
      .dock-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .events-hero,
      .events-passport,
      .events-dock {
        padding: 20px;
      }
      .events-hero-grid {
        gap: 20px;
      }
      .events-hero-visual {
        min-height: 360px;
      }
      .events-hero-copy h1 {
        max-width: 100%;
      }
      .events-toolbar {
        grid-template-columns: 1fr;
        padding: 16px;
      }
      .toolbar-pill {
        min-height: 56px;
      }
      .toolbar-pill .events-input,
      .toolbar-pill .events-select {
        min-height: 54px;
      }
      .event-actions-bar {
        grid-template-columns: 1fr 44px 1fr;
      }
      .dock-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
{% endblock %}

{% block body %}
{% set events = events|default([]) %}
{% set stats = stats|default({}) %}
{% set favoriteCounts = favoriteCounts|default({}) %}
{% set favoritedEventIds = favoritedEventIds|default([]) %}
{% set reviewStats = reviewStats|default({}) %}
{% set selectedEvent = selectedEvent|default(null) %}
{% set upcomingEvent = upcomingEvent|default(null) %}
{% set selectedEventReviews = selectedEventReviews|default([]) %}
{% set selectedReviewSort = selectedReviewSort|default('recent') %}
{% set mySelectedEventReview = mySelectedEventReview|default(null) %}
{% set participantEmail = participantEmail|default(null) %}
{% set loyaltyTier = loyaltyTier|default('None') %}
{% set loyaltyStats = loyaltyStats|default({'countConfirmed': 0, 'totalAmount': 0, 'lastReservationDate': null}) %}
{% set loyaltyBenefits = loyaltyBenefits|default([]) %}
{% set loyaltyProgress = loyaltyProgress|default({'current': 0, 'needed': 1, 'nextTier': 'Bronze'}) %}
{% set canAccessVipEvents = canAccessVipEvents|default(false) %}
{% set vipReservationThreshold = vipReservationThreshold|default(5) %}
{% set recommendedEvents = recommendedEvents|default([]) %}
{% set favoriteEvents = favoriteEvents|default([]) %}
{% set popularityScores = popularityScores|default({}) %}
{% set waitlistEntriesByEvent = waitlistEntriesByEvent|default({}) %}
{% set eventIsFullById = eventIsFullById|default({}) %}
{% set eventRemainingPlacesById = eventRemainingPlacesById|default({}) %}
{% set eventImageUrls = eventImageUrls|default({}) %}
{% set heroPulse = heroPulse|default({'score': 0, 'openCount': 0, 'savedCount': 0, 'totalCount': 0}) %}
{% set heroSignals = heroSignals|default({'dnaValue': '84% match', 'dnaHint': 'Recommendation logic aligned this event with your current activity pattern.', 'energyValue': 'Explorer mode', 'energyHint': 'A flexible match for discovery and broad exploration.', 'vipPathValue': vipReservationThreshold ~ ' steps to VIP', 'vipPathHint': 'Connect a member account to activate loyalty memory and VIP tracking.'}) %}
{% set featuredEvent = featuredEvent|default(null) %}
{% set loyaltyIdentity = loyaltyIdentity|default(participantEmail ?? 'No connected member') %}
{% set loyaltyAccessLabel = loyaltyAccessLabel|default(canAccessVipEvents ? 'VIP access active' : 'VIP access locked') %}
{% set loyaltyMood = loyaltyMood|default('Discovery mode is well underway') %}
{% set loyaltyBenefitsCopy = loyaltyBenefitsCopy|default('Priority access locked') %}
{% set typeImages = {
  'Yoga': 'https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=1400&q=80',
  'Nutrition': 'https://images.unsplash.com/photo-1498837167922-ddd27525d352?auto=format&fit=crop&w=1400&q=80',
  'Sport': 'https://images.unsplash.com/photo-1549060279-7e168fcee0c2?auto=format&fit=crop&w=1400&q=80',
  'Cardio': 'https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=1400&q=80'
} %}

<section class="events-shell">
  <div class="events-container">
    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="alert alert-danger">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('info') %}<div class="alert alert-info">{{ message }}</div>{% endfor %}

    <div class="events-command-bar">
      <div class="events-command-left">
        <button type="button" class="command-heart-btn" id="favoritesDockButton" aria-expanded="false" aria-controls="favoritesDockSection" aria-label="Mes favoris">
          <i class="fa fa-heart-o"></i>
        </button>
        <button type="button" class="command-recommend-btn" id="recommendationDockButton" aria-expanded="false" aria-controls="recommendationDockSection">
          RECOMMENDATIONS
        </button>
      </div>
      <div class="events-command-right">
        <span class="events-command-label">Event pulse</span>
        <div class="events-command-pills">
          <span class="command-pill">Score {{ heroPulse.score|default(0) }}</span>
          <span class="command-pill">{{ heroPulse.openCount|default(0) }} open</span>
          <span class="command-pill">{{ heroPulse.savedCount|default(0) }} saved</span>
        </div>
      </div>
    </div>

    <section class="events-dock is-hidden" id="favoritesDockSection" aria-label="Favorites dock">
      <div class="dock-header">
        <div>
          <h3 class="dock-title">My favorites</h3>
          <p class="dock-subtitle">Your saved picks appear here in a compact format for quick access.</p>
        </div>
        <span class="dock-count">{{ favoriteEvents|length }} favorites</span>
      </div>
      {% if favoriteEvents is not empty %}
        <div class="dock-grid">
          {% for favoriteEvent in favoriteEvents|slice(0, 4) %}
            {% set favoritePrice = favoriteEvent.prixEvent|default('0') + 0 %}
            {% set favoriteFull = eventIsFullById[favoriteEvent.id]|default(false) %}
            {% set favoriteVipLocked = favoriteEvent.isPremium and not canAccessVipEvents %}
            <article class="dock-card">
              <div class="dock-chip-row">
                <span class="dock-chip">{{ favoriteEvent.dateEvent|date('Y-m-d') }}</span>
                <span class="dock-chip">{{ favoriteEvent.lieu }}</span>
              </div>
              <strong>{{ favoriteEvent.titre }}</strong>
              <p>{{ favoriteEvent.typeEvent }} | {{ favoritePrice > 0 ? favoriteEvent.prixEvent ~ ' DT' : 'Free' }}</p>
              <a class="dock-action {% if favoriteVipLocked %}is-disabled{% endif %}" href="{% if favoriteVipLocked or favoriteFull %}{{ path('app_event_show', {id: favoriteEvent.id}) }}{% else %}{{ path('app_event_reservation_new', {id: favoriteEvent.id}) }}{% endif %}">
                {% if favoriteVipLocked %}
                  VIP ONLY
                {% elseif favoriteFull %}
                  VIEW DETAILS
                {% else %}
                  BOOK NOW
                {% endif %}
              </a>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="empty-note">Add an event with the heart button to build your personal shortcut.</div>
      {% endif %}
    </section>

    <section class="events-dock is-hidden" id="recommendationDockSection" aria-label="Recommendations dock">
      <div class="dock-header">
        <div>
          <h3 class="dock-title">My recommendations</h3>
          <p class="dock-subtitle">A clean list with same-size cards so you can compare quickly.</p>
        </div>
        <span class="dock-count">{{ recommendedEvents|length }} recommendations</span>
      </div>
      {% if recommendedEvents is not empty %}
        <div class="dock-grid">
          {% for item in recommendedEvents %}
            {% set recEvent = item.event %}
            {% set isRecVipLocked = recEvent.isPremium and not canAccessVipEvents %}
            <article class="dock-card">
              <div class="dock-chip-row">
                <span class="dock-chip">Score {{ item.score }}</span>
                {% if recEvent.isPremium %}
                  <span class="dock-chip">Premium</span>
                {% endif %}
              </div>
              <strong>{{ recEvent.titre }}</strong>
              <p>{{ item.reason }}</p>
              <div class="card-chip-row">
                <span class="card-chip">{{ recEvent.dateEvent|date('Y-m-d') }}</span>
                <span class="card-chip">{{ recEvent.lieu }}</span>
              </div>
              <a class="dock-action {% if isRecVipLocked %}is-disabled{% endif %}" href="{% if isRecVipLocked %}#{% else %}{{ path('app_event_show', {id: recEvent.id}) }}{% endif %}">
                {{ isRecVipLocked ? 'VIP ONLY' : 'OPEN DETAILS' }}
              </a>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="empty-note">Book or save events to unlock more personal suggestions.</div>
      {% endif %}
    </section>

    <header class="events-hero">
      <div class="events-hero-grid">
        <div class="events-hero-visual" style="background-image:url('{{ asset('images/events/hero-collage.png') }}');">
          <div class="events-hero-overlay">
            <span class="events-story-chip">EVENT STORIES</span>
            <h2>Move with the city, discover standout sessions, and keep your calendar full of energy.</h2>
          </div>
        </div>
        <div class="events-hero-copy">
          <span class="events-mini-kicker">FITOPIA EVENTS</span>
          <h1>Discover events with premium energy and real vibe</h1>
          <p class="events-hero-text">
            Explore standout events, book faster, and keep your favorites and member benefits inside one clean white-and-green experience.
          </p>
          <div class="events-hero-actions">
            <a class="hero-btn hero-btn-primary" href="#events-catalog">VIEW EVENTS</a>
            {% if featuredEvent %}
              {% set featuredVipLocked = featuredEvent.isPremium and not canAccessVipEvents %}
              <a class="hero-btn hero-btn-secondary {% if featuredVipLocked %}is-disabled{% endif %}" href="{% if featuredVipLocked %}#{% else %}{{ path('app_event_reservation_new', {id: featuredEvent.id}) }}{% endif %}">
                BOOK THE NEXT ONE
              </a>
            {% endif %}
            <a class="hero-link-btn" href="{{ path('app_reservation_history_index') }}">MY BOOKINGS</a>
          </div>
          <div class="hero-signal-grid">
            <article class="hero-signal-card">
              <strong>{{ heroSignals.dnaValue|default('84% match') }}</strong>
              <span>{{ heroSignals.dnaHint|default('Recommendation logic aligned this event with your current activity pattern.') }}</span>
            </article>
            <article class="hero-signal-card">
              <strong>{{ heroSignals.energyValue|default('Explorer mode') }}</strong>
              <span>{{ heroSignals.energyHint|default('A flexible match for discovery and broad exploration.') }}</span>
            </article>
            <article class="hero-signal-card">
              <strong>{{ heroSignals.vipPathValue|default(vipReservationThreshold ~ ' steps to VIP') }}</strong>
              <span>{{ heroSignals.vipPathHint|default('Connect a member account to activate loyalty memory and VIP tracking.') }}</span>
            </article>
          </div>
        </div>
      </div>
    </header>

    {% set heroEvent = featuredEvent ?? upcomingEvent %}
    {% set heroEventId = heroEvent and heroEvent.id ? heroEvent.id : 0 %}
    {% set heroParticipants = heroEventId ? stats[heroEventId].participants|default(0) : 0 %}
    {% set heroRemaining = heroEventId ? eventRemainingPlacesById[heroEventId]|default(heroEvent.capacite|default(0)) : 0 %}
    {% set heroPrice = heroEvent ? (heroEvent.prixEvent|default('0') + 0) : 0 %}
    {% set heroWaitlistEntry = heroEventId ? waitlistEntriesByEvent[heroEventId]|default(null) : null %}
    {% set heroIsFull = heroEventId ? eventIsFullById[heroEventId]|default(false) : false %}
    {% set heroVipLocked = heroEvent ? (heroEvent.isPremium and not canAccessVipEvents) : false %}

    <section class="events-passport">
      <div>
        <span class="passport-title">LOYALTY PASSPORT</span>
        <div class="passport-identity">{{ loyaltyIdentity|default('No connected member') }}</div>
        <p class="passport-subtitle">Personal member profile</p>
        <div class="passport-chip-row">
          <span class="passport-chip {% if loyaltyTier == 'VIP' %}tier-vip{% elseif loyaltyTier == 'Silver' %}tier-silver{% else %}tier-bronze{% endif %}">{{ loyaltyTier }}</span>
          <span class="passport-chip {% if canAccessVipEvents %}access-active{% else %}access-locked{% endif %}">{{ loyaltyAccessLabel|default(canAccessVipEvents ? 'VIP access active' : 'VIP access locked') }}</span>
        </div>
      </div>

      <article class="events-featured-card" id="event-featured-card">
        <div class="featured-chip-row">
          <span class="featured-kicker">FEATURED EVENT</span>
          {% if recommendedEvents is not empty %}
            <span class="dock-chip">DNA {{ recommendedEvents[0].score }}%</span>
          {% endif %}
        </div>
        <h3 class="featured-title">{{ heroEvent ? heroEvent.titre : 'No upcoming event' }}</h3>
        {% if heroEvent %}
          <div class="featured-chip-row">
            <span class="featured-chip">Date: {{ heroEvent.dateEvent|date('Y-m-d') }}</span>
            <span class="featured-chip">Location: {{ heroEvent.lieu }}</span>
          </div>
          <div class="featured-chip-row">
            <span class="featured-chip">Participants: {{ heroParticipants }}/{{ heroEvent.capacite }}</span>
            <span class="featured-chip">Price: {{ heroPrice > 0 ? heroEvent.prixEvent ~ ' DT' : 'Free' }}</span>
          </div>
          <p class="featured-description">{{ heroEvent.description|length > 160 ? heroEvent.description|slice(0, 160) ~ '...' : heroEvent.description }}</p>
          {% if heroVipLocked %}
            <span class="featured-action is-disabled">VIP ONLY</span>
          {% elseif heroIsFull %}
            {% if heroWaitlistEntry %}
              <span class="featured-action is-muted">WAITLISTED</span>
            {% else %}
              <a class="featured-action is-muted" href="{{ path('app_waitlist_join_form', {id: heroEvent.id}) }}">JOIN WAITLIST</a>
            {% endif %}
          {% else %}
            <a class="featured-action" href="{{ path('app_event_reservation_new', {id: heroEvent.id}) }}">BOOK THIS EVENT</a>
          {% endif %}
        {% else %}
          <p class="featured-description">The next event will appear here.</p>
        {% endif %}
      </article>

      <div class="passport-insights">
        <article class="stat-block">
          <span class="stat-block-label">VALID BOOKINGS</span>
          <strong>{{ loyaltyStats.countConfirmed|default(0) }} confirmed/used booking{{ loyaltyStats.countConfirmed|default(0) > 1 ? 's' : '' }}</strong>
        </article>
        <article class="stat-block">
          <span class="stat-block-label">TOTAL SPENT</span>
          <strong>{{ loyaltyStats.totalAmount|default(0)|number_format(2, '.', ' ') }} DT spent</strong>
        </article>
      </div>

      <article class="vip-progress-card">
        <span class="vip-progress-label">PROGRESS TO VIP</span>
        <div class="vip-progress-bar">
          <span style="width: {{ ((loyaltyProgress.ratio|default(0)) * 100)|number_format(0, '.', '') }}%;"></span>
        </div>
        <p class="vip-progress-main">{{ loyaltyProgress.current|default(0) }} valid booking(s) tracked | {{ loyaltyProgress.remaining|default(vipReservationThreshold) }} more to unlock VIP.</p>
        <p class="vip-progress-main">{{ loyaltyMood|default('Discovery mode is well underway') }}</p>
        <p class="vip-progress-sub">{{ loyaltyBenefitsCopy|default('Priority access locked') }}</p>
      </article>
    </section>

    <section class="events-browse-head">
      <div>
        <h2>Explore events</h2>
        <p>A clearer grid to compare seats, ratings, prices, and book without losing your flow.</p>
      </div>
      <span class="result-count-chip" id="resultCountLabel">{{ events|length }} events</span>
    </section>

    <section class="events-toolbar" id="events-catalog" aria-label="Events filters">
      <div class="toolbar-search-slot">
        <div class="toolbar-pill">
          <input id="eventSearch" class="events-input" type="search" placeholder="Search by title, location or category..." value="{{ search|default('') }}">
        </div>
      </div>
      <div class="toolbar-filter-slot">
        <div class="toolbar-pill">
          <select id="eventCategory" class="events-select">
            <option value="">All categories</option>
            {% for type in types|default([]) %}<option value="{{ type }}" {% if selectedType|default('') == type %}selected{% endif %}>{{ type }}</option>{% endfor %}
          </select>
          <span class="toolbar-pill-tail" aria-hidden="true"><i class="fa fa-caret-down"></i></span>
        </div>
      </div>
      <div class="toolbar-filter-slot">
        <div class="toolbar-pill">
          <input id="eventDateFilter" class="events-input events-date-input" type="date" aria-label="Filter by date">
          <span class="toolbar-pill-tail" aria-hidden="true"><i class="fa fa-calendar"></i></span>
        </div>
      </div>
      <div class="toolbar-filter-slot">
        <div class="toolbar-pill">
          <select id="eventPriceFilter" class="events-select">
            <option value="">All prices</option>
            <option value="free">Free</option>
            <option value="paid">Paid</option>
            <option value="under25">Under 25 DT</option>
            <option value="under50">Under 50 DT</option>
          </select>
          <span class="toolbar-pill-tail" aria-hidden="true"><i class="fa fa-caret-down"></i></span>
        </div>
      </div>
      <div class="toolbar-filter-slot toolbar-filter-slot--sort">
        <div class="toolbar-pill">
          <select id="eventSort" class="events-select">
            <option value="date_asc">Sort: Date (soonest)</option>
            <option value="date_desc">Sort: Date (latest)</option>
            <option value="price_asc">Sort: Price (low-high)</option>
            <option value="price_desc">Sort: Price (high-low)</option>
            <option value="popularity_desc">Sort: Most popular</option>
          </select>
          <span class="toolbar-pill-tail" aria-hidden="true"><i class="fa fa-caret-down"></i></span>
        </div>
      </div>
      <button type="button" class="events-reset-btn" id="eventClearFilters">Clear filters</button>
    </section>

    <div class="events-grid" id="eventsGrid">
      {% if events is empty %}
        <div class="empty-note">No events are available right now.</div>
      {% endif %}
      {% for event in events %}
        {% set participants = stats[event.id].participants|default(0) %}
        {% set favoritesCount = favoriteCounts[event.id]|default(0) %}
        {% set isFavorited = event.id in favoritedEventIds %}
        {% set review = reviewStats[event.id]|default({'average': 0, 'count': 0}) %}
        {% set avgRating = review.average|default(0) + 0 %}
        {% set reviewCount = review.count|default(0) %}
        {% set popularity = popularityScores[event.id]|default({'score': 0}) %}
        {% set popularityScore = popularity.score|default(0) + 0 %}
        {% set badgeLabel = '' %}
        {% set badgeClass = '' %}
        {% if event.isPremium %}
          {% set badgeLabel = 'Evenement Premium' %}
          {% set badgeClass = 'badge-premium' %}
        {% elseif avgRating >= 4.0 %}
          {% set badgeLabel = 'Recommande' %}
          {% set badgeClass = 'badge-recommended' %}
        {% elseif reviewCount < 3 %}
          {% set badgeLabel = 'Nouveau' %}
          {% set badgeClass = 'badge-new' %}
        {% endif %}
        {% set isFull = eventIsFullById[event.id]|default(false) %}
        {% set remainingPlaces = eventRemainingPlacesById[event.id]|default(event.capacite) %}
        {% set isVipEvent = event.isPremium %}
        {% set isVipLocked = isVipEvent and not canAccessVipEvents %}
        {% set waitlistEntry = waitlistEntriesByEvent[event.id]|default(null) %}
        {% set price = event.prixEvent|default('0') + 0 %}
        {% set imageSrc = eventImageUrls[event.id]|default(typeImages[event.typeEvent]|default('https://images.unsplash.com/photo-1476480862126-209bfaa8edc8?auto=format&fit=crop&w=1400&q=80')) %}
        <article class="event-card js-event-card"
          data-title="{{ event.titre|lower }}"
          data-location="{{ event.lieu|lower }}"
          data-category="{{ event.typeEvent|lower }}"
          data-date="{{ event.dateEvent|date('Y-m-d') }}"
          data-price="{{ price }}"
          data-popularity="{{ participants }}">
          {% set ribbonText = isFull ? 'FULL' : (event.isPremium ? 'PREMIUM' : 'EVENTS') %}
          <div class="event-media-frame">
            <img class="event-media" src="{{ imageSrc }}" alt="{{ event.titre }}">
            <span class="event-card-ribbon">{{ ribbonText }}</span>
            <h3 class="event-media-title">{{ event.titre }}</h3>
          </div>
          <div class="event-card-body">
            <div class="card-chip-row">
              <span class="card-chip">{{ event.typeEvent }}</span>
              <span class="card-chip">{{ event.dateEvent|date('d M Y') }}</span>
              <span class="card-chip">{{ event.lieu }}</span>
              <span class="card-chip">{{ remainingPlaces }} spots left</span>
            </div>
            <div class="event-mini-meta">
              <div class="event-mini-note">
                <strong>Rating</strong>
                <span>{{ avgRating|number_format(1, '.', ',') }}/5 ({{ reviewCount }})</span>
              </div>
              <div class="event-mini-note">
                <strong>Price</strong>
                <span>{{ price > 0 ? event.prixEvent ~ ' DT' : 'Free' }}</span>
              </div>
            </div>
            <div class="event-actions-bar">
              <a class="event-action-btn" href="{{ path('app_event_show', {id: event.id}) }}">DETAILS</a>
              <form method="post" action="{{ path('app_event_favorite_toggle', {id: event.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('event_favorite_' ~ event.id) }}">
                <input type="hidden" name="redirect_url" value="{{ app.request.uri }}">
                <button type="submit" class="event-favorite-icon {% if isFavorited %}active{% endif %}" {% if not participantEmail %}disabled title="Connectez-vous ou reservez d'abord pour activer les favoris"{% endif %}>
                  <i class="fa {% if isFavorited %}fa-heart{% else %}fa-heart-o{% endif %}"></i>
                </button>
              </form>
              {% if isVipLocked %}
                <span class="event-book-btn is-disabled">VIP ONLY</span>
              {% elseif isFull %}
                {% if waitlistEntry %}
                  <span class="event-book-btn is-muted">WAITLISTED</span>
                {% else %}
                  <a class="event-book-btn is-muted" href="{{ path('app_waitlist_join_form', {id: event.id}) }}">JOIN WAITLIST</a>
                {% endif %}
              {% else %}
                <a class="event-book-btn" href="{{ path('app_event_reservation_new', {id: event.id}) }}">BOOK NOW</a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if selectedEvent %}
      {% set participants = stats[selectedEvent.id].participants|default(0) %}
      {% set selectedFavoriteCount = favoriteCounts[selectedEvent.id]|default(0) %}
      {% set selectedIsFavorited = selectedEvent.id in favoritedEventIds %}
      {% set selectedReview = reviewStats[selectedEvent.id]|default({'average': 0, 'count': 0}) %}
      {% set selectedAvgRating = selectedReview.average|default(0) + 0 %}
      {% set selectedReviewCount = selectedReview.count|default(0) %}
      {% set selectedPopularity = popularityScores[selectedEvent.id]|default({'score': 0}) %}
      {% set selectedPopularityScore = selectedPopularity.score|default(0) + 0 %}
      {% set isFull = eventIsFullById[selectedEvent.id]|default(false) %}
      {% set selectedRemainingPlaces = eventRemainingPlacesById[selectedEvent.id]|default(selectedEvent.capacite) %}
      {% set isSelectedVipEvent = selectedEvent.isPremium %}
      {% set isSelectedVipLocked = isSelectedVipEvent and not canAccessVipEvents %}
      {% set selectedWaitlistEntry = waitlistEntriesByEvent[selectedEvent.id]|default(null) %}
      {% set selectedPrice = selectedEvent.prixEvent|default('0') + 0 %}
      {% set selectedImage = eventImageUrls[selectedEvent.id]|default(typeImages[selectedEvent.typeEvent]|default('https://images.unsplash.com/photo-1476480862126-209bfaa8edc8?auto=format&fit=crop&w=1400&q=80')) %}
      <section class="details-panel" id="event-register">
        <div class="details-header">
          <div>
            <h3 style="font-size:30px;line-height:1.1;margin:0;font-weight:800;">
              {{ selectedEvent.titre }}
              {% if selectedPopularityScore > 20 %}
                <span class="badge-insight badge-recommended"><i class="fa fa-fire"></i> Tendance</span>
              {% endif %}
              {% if selectedEvent.isPremium %}
                <span class="badge-insight badge-premium"><i class="fa fa-certificate"></i> Premium</span>
              {% endif %}
              {% if selectedAvgRating >= 4.5 %}
                <span class="badge-insight badge-premium"><i class="fa fa-star"></i> Top Note</span>
              {% endif %}
            </h3>
            <div class="event-meta">
              <span class="event-pill"><i class="fa fa-calendar"></i> {{ selectedEvent.dateEvent|date('Y-m-d') }}</span>
              <span class="event-pill"><i class="fa fa-map-marker"></i> {{ selectedEvent.lieu }}</span>
              <span class="event-pill"><i class="fa fa-users"></i> {{ participants }} inscrits</span>
              <span class="event-pill"><i class="fa fa-ticket"></i> {{ selectedRemainingPlaces }} places restantes</span>
            </div>
            <div class="event-engagement">
              <span class="engage-chip"><i class="fa fa-heart text-danger"></i> {{ selectedFavoriteCount }} favoris</span>
              <span class="engage-chip">
                <span class="rating-stars">
                  {% for i in 1..5 %}
                    <i class="fa {% if selectedAvgRating >= i %}fa-star{% elseif selectedAvgRating >= (i - 0.5) %}fa-star-half-o{% else %}fa-star-o{% endif %}"></i>
                  {% endfor %}
                </span>
                {{ selectedAvgRating|number_format(1, '.', ',') }}/5 ({{ selectedReviewCount }} avis)
              </span>
            </div>
            <form method="post" action="{{ path('app_event_favorite_toggle', {id: selectedEvent.id}) }}" class="mb-2">
              <input type="hidden" name="_token" value="{{ csrf_token('event_favorite_' ~ selectedEvent.id) }}">
              <input type="hidden" name="redirect_url" value="{{ app.request.uri }}">
              <button type="submit" class="favorite-btn {% if selectedIsFavorited %}active{% endif %}" {% if not participantEmail %}disabled title="Connectez-vous ou reservez d'abord pour activer les favoris"{% endif %}>
                {% if selectedIsFavorited %}💔 Retirer des favoris{% else %}❤️ Ajouter aux favoris{% endif %}
              </button>
            </form>
            <p class="event-description" style="min-height:auto;">{{ selectedEvent.description|nl2br }}</p>
            <img class="details-image" src="{{ selectedImage }}" alt="{{ selectedEvent.titre }}">
          </div>
          <aside class="book-panel">
            <h4>Reserver votre place</h4>
            <p class="text-muted mb-2">Passez a la page reservation pour confirmer votre participation.</p>
            {% if isSelectedVipLocked %}
              <div class="alert alert-warning mb-0">
                Reserve aux VIP. Deviens VIP a partir de {{ vipReservationThreshold }} reservations.
              </div>
            {% elseif isFull %}
              {% if selectedWaitlistEntry %}
                <div class="alert alert-info mb-0">
                  Vous etes deja sur la liste d attente ({{ selectedWaitlistEntry.status }}).
                </div>
              {% else %}
                <div class="alert alert-warning mb-2">Cet evenement est complet.</div>
                <form method="post" action="{{ path('app_waitlist_join', {id: selectedEvent.id}) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('waitlist_join_' ~ selectedEvent.id) }}">
                  <div class="mb-2">
                    <input type="text" name="nom" class="form-control" placeholder="Votre nom" required maxlength="150">
                  </div>
                  <div class="mb-2">
                    <input type="email" name="email" class="form-control" placeholder="Votre email" value="{{ participantEmail|default('') }}" required maxlength="150">
                  </div>
                  <button type="submit" class="register-btn w-100 justify-content-center">
                    <i class="fa fa-hourglass-half"></i> Rejoindre la liste d attente
                  </button>
                </form>
              {% endif %}
            {% else %}
              <div class="d-flex justify-content-between align-items-center mb-2">
                <strong style="font-size:20px;color:#0b6d57;">{% if selectedPrice > 0 %}{{ selectedEvent.prixEvent }} DT{% else %}Gratuit{% endif %}</strong>
                <small class="text-muted">{{ selectedRemainingPlaces }} places restantes</small>
              </div>
              <a class="register-btn w-100 justify-content-center {% if loyaltyTier in ['Silver', 'Gold', 'VIP'] %}priority{% endif %}" href="{{ path('app_event_reservation_new', {id: selectedEvent.id}) }}">
                <i class="fa fa-check"></i> Continuer la reservation
              </a>
              <div class="book-trust">
                <span class="book-chip">Reservation directe</span>
                <span class="book-chip">Confirmation immediate</span>
                <span class="book-chip">Aucun paiement en ligne</span>
                {% if loyaltyTier in ['Silver', 'Gold', 'VIP'] %}
                  <span class="book-chip">Reservation prioritaire</span>
                {% endif %}
              </div>
            {% endif %}
          </aside>
        </div>
        <div class="reviews-panel">
          <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h4 class="mb-0">Avis & Evaluation</h4>
            <div class="d-flex align-items-center gap-2">
              <span class="engage-chip">
                <span class="rating-stars">
                  {% for i in 1..5 %}
                    <i class="fa {% if selectedAvgRating >= i %}fa-star{% elseif selectedAvgRating >= (i - 0.5) %}fa-star-half-o{% else %}fa-star-o{% endif %}"></i>
                  {% endfor %}
                </span>
                {{ selectedAvgRating|number_format(1, '.', ',') }}/5 ({{ selectedReviewCount }} avis)
              </span>
              <select id="reviewSortSelect" class="review-sort">
                <option value="recent" {% if selectedReviewSort == 'recent' %}selected{% endif %}>Plus recents</option>
                <option value="best" {% if selectedReviewSort == 'best' %}selected{% endif %}>Meilleures notes</option>
              </select>
            </div>
          </div>
          <div class="reviews-grid">
            <div>
              <h5 class="h6 mb-2">{{ mySelectedEventReview ? 'Modifier mon avis' : 'Laisser un avis' }}</h5>
              {% if participantEmail %}
                <form method="post" action="{{ path('app_event_review_upsert', {id: selectedEvent.id}) }}" novalidate>
                  <input type="hidden" name="_token" value="{{ csrf_token('event_review_' ~ selectedEvent.id) }}">
                  <input type="hidden" name="redirect_url" value="{{ app.request.uri }}">
                  <div class="mb-2">
                    <label class="form-label">Note</label>
                    <select class="form-control" name="note">
                      {% set selectedNote = mySelectedEventReview ? mySelectedEventReview.note : 5 %}
                      {% for note in 1..5 %}
                        <option value="{{ note }}" {% if selectedNote == note %}selected{% endif %}>{{ note }}/5</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Commentaire</label>
                    <textarea class="form-control" name="commentaire" rows="4">{{ mySelectedEventReview ? mySelectedEventReview.commentaire : '' }}</textarea>
                  </div>
                  <button class="register-btn w-100 justify-content-center" type="submit">
                    <i class="fa fa-star"></i> {{ mySelectedEventReview ? 'Mettre a jour mon avis' : 'Publier mon avis' }}
                  </button>
                </form>
              {% else %}
                <div class="alert alert-warning mb-0">Connectez-vous ou reservez un evenement pour pouvoir laisser un avis.</div>
              {% endif %}
            </div>
            <div>
              {% if selectedEventReviews is empty %}
                <div class="alert alert-info mb-0">Aucun avis pour le moment.</div>
              {% else %}
                {% for review in selectedEventReviews %}
                  <article class="review-card">
                    <div class="review-head">
                      <span>{{ review.emailParticipant }}</span>
                      <span>
                        <span class="rating-stars">
                          {% for i in 1..5 %}
                            <i class="fa {% if review.note >= i %}fa-star{% else %}fa-star-o{% endif %}"></i>
                          {% endfor %}
                        </span>
                        {{ review.note }}/5
                      </span>
                    </div>
                    <p class="review-comment">{{ review.commentaire }}</p>
                    <div class="text-muted small mt-2">
                      {{ review.createdAt ? review.createdAt|date('Y-m-d H:i') : '' }}
                      {% if review.updatedAt %} • modifie le {{ review.updatedAt|date('Y-m-d H:i') }}{% endif %}
                    </div>
                  </article>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
      </section>
    {% endif %}

  </div>
</section>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = Array.from(document.querySelectorAll('.js-event-card'));
      const searchInput = document.getElementById('eventSearch');
      const categorySelect = document.getElementById('eventCategory');
      const dateSelect = document.getElementById('eventDateFilter');
      const priceSelect = document.getElementById('eventPriceFilter');
      const sortSelect = document.getElementById('eventSort');
      const reviewSortSelect = document.getElementById('reviewSortSelect');
      const grid = document.getElementById('eventsGrid');
      const clearFiltersBtn = document.getElementById('eventClearFilters');
      const resultCountLabel = document.getElementById('resultCountLabel');
      const favoritesDockButton = document.getElementById('favoritesDockButton');
      const favoritesDockSection = document.getElementById('favoritesDockSection');
      const recommendationDockButton = document.getElementById('recommendationDockButton');
      const recommendationDockSection = document.getElementById('recommendationDockSection');

      const toggleDock = (button, section) => {
        if (!button || !section) return;
        const isHidden = section.classList.toggle('is-hidden');
        button.classList.toggle('is-active', !isHidden);
        button.setAttribute('aria-expanded', String(!isHidden));
      };

      reviewSortSelect?.addEventListener('change', () => {
        const url = new URL(window.location.href);
        url.searchParams.set('review_sort', reviewSortSelect.value || 'recent');
        window.location.href = url.toString();
      });

      const getDateNum = (value) => new Date(value + 'T00:00:00').getTime();

      function matchesFilters(card) {
        const q = (searchInput?.value || '').trim().toLowerCase();
        const cat = (categorySelect?.value || '').toLowerCase();
        const dateMode = dateSelect?.value || '';
        const priceMode = priceSelect?.value || '';

        const title = card.dataset.title || '';
        const location = card.dataset.location || '';
        const category = card.dataset.category || '';
        const eventDate = getDateNum(card.dataset.date || '');
        const price = Number(card.dataset.price || 0);

        const searchOk = q === '' || title.includes(q) || location.includes(q) || category.includes(q);
        const catOk = cat === '' || category === cat.toLowerCase();
        const dateOk =
          dateMode === '' ||
          eventDate >= getDateNum(dateMode);
        const priceOk =
          priceMode === '' ||
          (priceMode === 'free' && price === 0) ||
          (priceMode === 'paid' && price > 0) ||
          (priceMode === 'under25' && price <= 25) ||
          (priceMode === 'under50' && price <= 50);

        return searchOk && catOk && dateOk && priceOk;
      }

      function sortCards(list) {
        const mode = sortSelect?.value || 'date_asc';
        return list.sort((a, b) => {
          const dateA = getDateNum(a.dataset.date || '');
          const dateB = getDateNum(b.dataset.date || '');
          const priceA = Number(a.dataset.price || 0);
          const priceB = Number(b.dataset.price || 0);
          const popA = Number(a.dataset.popularity || 0);
          const popB = Number(b.dataset.popularity || 0);

          if (mode === 'date_desc') return dateB - dateA;
          if (mode === 'price_asc') return priceA - priceB;
          if (mode === 'price_desc') return priceB - priceA;
          if (mode === 'popularity_desc') return popB - popA;
          return dateA - dateB;
        });
      }

      function applyFilters() {
        const visible = sortCards(cards.filter(matchesFilters));
        grid.innerHTML = '';
        visible.forEach((card) => grid.appendChild(card));
        if (resultCountLabel) {
          resultCountLabel.textContent = `${visible.length} event${visible.length > 1 ? 's' : ''}`;
        }
        if (visible.length === 0) {
          const note = document.createElement('div');
          note.className = 'empty-note';
          note.textContent = 'No events match your filters. Try broadening your selection.';
          grid.appendChild(note);
        }
      }

      [searchInput, categorySelect, dateSelect, priceSelect, sortSelect].forEach((el) => {
        el?.addEventListener('input', applyFilters);
        el?.addEventListener('change', applyFilters);
      });

      clearFiltersBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        if (categorySelect) categorySelect.value = '';
        if (dateSelect) dateSelect.value = '';
        if (priceSelect) priceSelect.value = '';
        if (sortSelect) sortSelect.value = 'date_asc';
        applyFilters();
      });

      favoritesDockButton?.addEventListener('click', () => toggleDock(favoritesDockButton, favoritesDockSection));
      recommendationDockButton?.addEventListener('click', () => {
        toggleDock(recommendationDockButton, recommendationDockSection);
      });

      if (!grid || cards.length === 0) return;

      applyFilters();
    });
  </script>
{% endblock %}

{% block footer %}{% endblock %}
