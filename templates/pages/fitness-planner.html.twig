      font-size: 16px;
      font-weight: 900;
    }

    .explore-playlist-box {
      max-height: 582px;
      overflow: auto;
      padding-right: 4px;
      display: grid;
      gap: 10px;
    }

    .explore-playlist-item {
      border: 1px solid #d9ebe4;
      border-radius: 16px;
      background: #ffffff;
      padding: 12px 14px;
      display: grid;
      gap: 4px;
      cursor: pointer;
