      transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

    .explore-playlist-item:hover,
    .explore-playlist-item.is-active {
      border-color: #9fe0c3;
      box-shadow: 0 14px 28px rgba(26, 160, 111, 0.12);
      transform: translateY(-1px);
    }

    .explore-playlist-title {
      color: #063b39;
      font-size: 15px;
      font-weight: 900;
      line-height: 1.3;
    }

    .explore-playlist-meta {
      color: #64748b;
      font-size: 13px;
      font-weight: 700;
    }

    .explore-playlist-prefix {
      color: #00b06b;
      font-weight: 900;
      margin-right: 6px;
    }

    .coach-shell {
      padding: 0;
      background: transparent;
      border: 0;
      box-shadow: none;
    }

    .coach-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
      align-items: start;
    }

    .coach-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .coach-item {
      border: 1px solid #dcebe3;
      border-radius: 30px;
      background: #ffffff;
      padding: 24px 26px;
      display: grid;
      grid-template-columns: 124px minmax(0, 1fr) auto;
      gap: 22px;
      align-items: center;
      box-shadow: 0 14px 34px rgba(10, 36, 54, 0.06);
