{% extends 'base.html.twig' %}

{% block title %}Fitness Planner | Fitopia{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root {
      --fp-bg: linear-gradient(145deg, #f3f8f7 0%, #eef4f7 100%);
      --fp-card: #ffffff;
      --fp-text: #0f2730;
      --fp-muted: #5f7180;
      --fp-primary: #0f6b63;
      --fp-primary-dark: #0a4d48;
      --fp-border: #dbe5eb;
      --fp-soft: #f0f6f7;
      --fp-shadow: 0 14px 42px rgba(10, 36, 54, 0.1);
      --fp-radius: 18px;
      --fp-page-gutter: clamp(18px, 2.6vw, 52px);
    }

    .fitness-page {
      background: var(--fp-bg);
      min-height: calc(100vh - 160px);
      padding: 1.6rem 0 3.2rem;
    }

    .fitness-shell {
      width: calc(100% - (var(--fp-page-gutter) * 2));
      max-width: none;
      margin: 0 auto;
      display: grid;
      gap: 1.5rem;
    }

    .fitness-hero {
      border-radius: 34px;
      background: linear-gradient(180deg, rgba(250, 255, 251, 0.96), rgba(245, 251, 248, 0.96));
      border: 1px solid #d7ebe2;
      box-shadow: var(--fp-shadow);
      padding: 22px;
      position: relative;
      overflow: hidden;
    }

    .fitness-hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 8% 10%, rgba(30, 197, 143, 0.12), transparent 24%),
        radial-gradient(circle at 95% 0%, rgba(204, 233, 221, 0.55), transparent 28%);
      pointer-events: none;
    }

    .fitness-hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.95fr);
      gap: 38px;
      align-items: stretch;
    }

    .fitness-hero-visual {
      min-height: 720px;
      border-radius: 0;
      overflow: hidden;
      position: relative;
      background:
        linear-gradient(180deg, rgba(3, 35, 24, 0.18) 0%, rgba(3, 35, 24, 0.2) 100%),
        url('{{ asset('images/fitness/fitness_planner_banner.png') }}') center/cover no-repeat;
      box-shadow: 0 18px 40px rgba(6, 28, 34, 0.16);
    }

    .fitness-hero-visual::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8, 25, 32, 0.08) 0%, rgba(6, 55, 43, 0.58) 100%);
    }

    .fitness-hero-overlay {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1;
      padding: 0 28px 28px;
      display: grid;
      gap: 14px;
    }

    .fitness-hero-chip {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      padding: 10px 18px;
      border-radius: 50%;
      border-radius: 999px;
      background: #ffffff;
      color: #0d7c61;
      font-size: 14px;
      font-weight: 900;
      letter-spacing: .01em;
      text-transform: uppercase;
      box-shadow: 0 14px 28px rgba(12, 63, 56, 0.12);
    }

    .fitness-hero-visual-copy {
      max-width: 500px;
      color: #ffffff;
      font-size: clamp(28px, 3.2vw, 46px);
      font-weight: 900;
      line-height: 1.16;
      margin: 0;
      text-shadow: 0 12px 24px rgba(0, 0, 0, 0.22);
    }

    .fitness-hero-copy {
      display: grid;
      align-content: start;
      gap: 18px;
      padding: 22px 12px 0 0;
      position: relative;
      z-index: 1;
    }

    .fitness-hero-kicker {
      color: #00a878;
      font-size: 15px;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      margin: 0;
    }

    .fitness-hero-title {
      color: #04263b;
      font-size: clamp(42px, 4.2vw, 82px);
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -0.03em;
      margin: 0;
      max-width: 12ch;
    }

    .fitness-hero-subtitle {
      color: #476477;
      max-width: 26ch;
      margin: 0;
      font-size: clamp(17px, 1.5vw, 22px);
      line-height: 1.5;
    }

    .fitness-hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .fitness-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .fitness-stat {
      border: 1px solid #dcebe3;
      background: #ffffff;
      border-radius: 28px;
      padding: 22px 20px 18px;
      box-shadow: 0 12px 32px rgba(10, 36, 54, 0.07);
    }

    .fitness-stat .v {
      color: #063b39;
      font-size: clamp(26px, 2vw, 40px);
      font-weight: 900;
      line-height: 1.05;
    }

    .fitness-stat .l {
      margin-top: 8px;
      display: block;
      color: #6a7d91;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.35;
    }

    .fitness-hero-note {
      border-radius: 28px;
      background: #1b9669;
      color: #ffffff;
      padding: 22px 22px 18px;
      display: grid;
      gap: 8px;
      box-shadow: 0 18px 42px rgba(17, 108, 79, 0.18);
    }

    .fitness-hero-note strong {
      font-size: 18px;
      font-weight: 900;
    }

    .fitness-hero-note p {
      margin: 0;
      color: rgba(255, 255, 255, 0.96);
      font-size: 15px;
      line-height: 1.6;
    }

    .fitness-info-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    .fitness-info-card {
      background: #ffffff;
      border: 1px solid #dcebe3;
      border-radius: 28px;
      padding: 24px 26px;
      box-shadow: 0 12px 32px rgba(10, 36, 54, 0.06);
    }

    .fitness-info-card h3 {
      margin: 0 0 10px;
      color: #04263b;
      font-size: clamp(22px, 1.8vw, 32px);
      font-weight: 900;
      letter-spacing: -0.02em;
    }

    .fitness-info-card p {
      margin: 0;
      color: #4f697b;
      font-size: 15px;
      line-height: 1.45;
    }

    .fitness-nav {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 18px;
      background: #ffffff;
      border: 1px solid #dcebe3;
      border-radius: 28px;
      padding: 18px 24px;
      box-shadow: 0 12px 32px rgba(10, 36, 54, 0.06);
    }

    .fitness-nav-title {
      color: #063b39;
      font-size: 22px;
      font-weight: 900;
      margin: 0;
      white-space: nowrap;
    }

    .fitness-nav-tabs {
      display: flex;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 10px;
    }

    .fitness-tab {
      border: 1px solid transparent;
      background: transparent;
      border-radius: 999px;
      padding: 14px 22px;
      font-weight: 800;
      font-size: 15px;
      color: var(--fp-text);
      cursor: pointer;
      transition: all .2s ease;
    }

    .fitness-tab:hover { transform: translateY(-1px); }
    .fitness-tab.is-active {
      background: #e7f8f0;
      color: #00a878;
      border-color: #cfeadf;
      box-shadow: inset 0 -3px 0 #1cc58f;
    }

    .fitness-card {
      background: var(--fp-card);
      border-radius: 30px;
      border: 1px solid #dcebe3;
      box-shadow: 0 12px 32px rgba(10, 36, 54, 0.06);
      padding: 26px;
    }

    .fitness-toolbar {
      display: grid;
      gap: .8rem;
      grid-template-columns: 1fr auto auto;
      align-items: center;
    }

    .fitness-toolbar input,
    .fitness-toolbar select,
    .fitness-form input,
    .fitness-form select,
    .fitness-form textarea {
      border: 1px solid var(--fp-border);
      border-radius: 12px;
      min-height: 42px;
      padding: .52rem .72rem;
      width: 100%;
      color: var(--fp-text);
      background: #fff;
    }

    .fitness-form textarea { min-height: 94px; resize: vertical; }

    .fitness-btn {
      border: none;
      border-radius: 12px;
      font-weight: 700;
      min-height: 42px;
      padding: .55rem 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .45rem;
      transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
      cursor: pointer;
    }

    .fitness-btn:hover { transform: translateY(-1px); }
    .fitness-btn-primary { background: var(--fp-primary); color: #fff; }
    .fitness-btn-primary:hover { background: var(--fp-primary-dark); color: #fff; box-shadow: 0 10px 20px rgba(15, 107, 99, .26); }
    .fitness-btn-soft { background: var(--fp-soft); color: var(--fp-text); border: 1px solid var(--fp-border); }
    .fitness-btn-danger { background: #b42318; color: #fff; }
    .fitness-btn-danger:hover { background: #8c1c14; color: #fff; box-shadow: 0 10px 20px rgba(180, 35, 24, .22); }

    .fitness-grid {
      display: grid;
      gap: .95rem;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    }

    .program-card {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      padding: .9rem;
      background: #fff;
      box-shadow: 0 8px 20px rgba(9, 31, 47, .06);
      transition: transform .2s ease, box-shadow .2s ease;
      display: grid;
      gap: .65rem;
    }

    .program-card:hover { transform: translateY(-2px); box-shadow: 0 14px 26px rgba(9, 31, 47, .1); }
    .program-thumb {
      width: 100%;
      aspect-ratio: 16 / 9;
      background-size: cover;
      background-position: center;
      border-radius: 12px;
      background-color: #dfebee;
    }

    .program-title { margin: 0; font-size: 1.14rem; font-weight: 700; color: var(--fp-text); }
    .program-meta { color: var(--fp-muted); font-size: .9rem; display: flex; flex-wrap: wrap; gap: .45rem .75rem; }
    .program-tags { display: flex; gap: .45rem; flex-wrap: wrap; }

    .program-tag {
      font-size: .75rem;
      border: 1px solid #d1e3e7;
      background: #f7fbfc;
      color: #255663;
      border-radius: 999px;
      padding: .2rem .55rem;
      font-weight: 600;
    }

    .program-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
    .program-actions form { margin: 0; }

    .fp-user-plans {
      margin-top: .9rem;
      display: grid;
      gap: .95rem;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    }

    .fp-user-plan-list {
      margin: .2rem 0 0;
      padding-left: 1rem;
      color: var(--fp-muted);
      font-size: .88rem;
      display: grid;
      gap: .2rem;
    }

    .fitness-form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: .7rem;
    }

    .fitness-form-grid .full { grid-column: 1 / -1; }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    .section-head h2 {
      margin: 0;
      font-size: clamp(28px, 2.2vw, 44px);
      color: #183b37;
      font-weight: 900;
      letter-spacing: -0.02em;
    }

    .section-head p {
      margin: 0;
      color: #5f7282;
      font-size: 16px;
      line-height: 1.45;
    }

    .exercise-list {
      display: grid;
      gap: .7rem;
      margin-top: .9rem;
    }

    .exercise-row {
      border: 1px solid var(--fp-border);
      border-radius: 14px;
      padding: .75rem;
      display: grid;
      gap: .35rem;
      background: #fff;
      transition: background-color .18s ease;
    }

    .exercise-row:hover { background: #f8fcfd; }
    .exercise-row .top { display: flex; align-items: center; justify-content: space-between; gap: .7rem; flex-wrap: wrap; }
    .exercise-row .name { font-weight: 700; color: var(--fp-text); }
    .exercise-row .meta { color: var(--fp-muted); font-size: .9rem; display: flex; gap: .7rem; flex-wrap: wrap; }
    .section { display: none; }
    .section.is-active { display: block; animation: fpFade .25s ease both; }

    @keyframes fpFade {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .explore-card {
      padding: 1rem;
    }

    .explore-shell {
      position: relative;
      margin-top: .8rem;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid #1a3a48;
      background: #081821;
      height: min(78vh, 760px);
    }

    .explore-feed {
      height: 100%;
      overflow-y: auto;
      scroll-snap-type: y mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .explore-slide {
      min-height: 100%;
      position: relative;
      scroll-snap-align: start;
      color: #fff;
      display: grid;
      align-items: end;
    }

    .explore-media {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 35% 20%, #2a7489 0%, #0a2331 70%);
    }

    .explore-media img,
    .explore-media video,
    .explore-media iframe {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .explore-media-fallback {
      position: absolute;
      inset: 0;
      display: grid;
      align-content: center;
      justify-items: center;
      gap: .7rem;
      padding: 1rem;
      text-align: center;
      background:
        radial-gradient(circle at 30% 22%, rgba(68, 168, 159, .35) 0%, rgba(8, 24, 33, .94) 68%),
        linear-gradient(120deg, rgba(8, 24, 33, .98), rgba(14, 38, 51, .98));
      color: #fff;
    }

    .explore-media-fallback-label {
      margin: 0;
      font-size: .95rem;
      font-weight: 700;
      max-width: 42ch;
    }

    .explore-media-fallback-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: .45rem;
    }

    .explore-fallback-btn {
      border: 1px solid rgba(255, 255, 255, .45);
      background: rgba(255, 255, 255, .08);
      color: #fff;
      border-radius: 999px;
      min-height: 36px;
      padding: .35rem .78rem;
      font-size: .8rem;
      font-weight: 700;
      cursor: pointer;
    }

    .explore-fallback-btn:hover {
      background: rgba(255, 255, 255, .16);
    }

    .explore-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(5, 12, 17, .86) 15%, rgba(5, 12, 17, .38) 58%, rgba(5, 12, 17, .2) 100%);
      pointer-events: none;
    }

    .explore-content {
      position: relative;
      z-index: 1;
      padding: 1rem 1rem 1.2rem;
      display: grid;
      gap: .8rem;
    }

    .explore-top h3 {
      margin: 0 0 .35rem;
      font-size: clamp(1.4rem, 2.4vw, 2rem);
      font-weight: 800;
      letter-spacing: .02em;
    }

    .explore-badges {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
      margin-bottom: .35rem;
    }

    .explore-badge {
      background: rgba(255, 255, 255, .15);
      border: 1px solid rgba(255, 255, 255, .35);
      border-radius: 999px;
      padding: .2rem .55rem;
      font-size: .75rem;
      font-weight: 700;
      backdrop-filter: blur(4px);
    }

    .explore-meta {
      font-size: .85rem;
      color: rgba(255, 255, 255, .86);
      font-weight: 600;
    }

    .explore-tip {
      margin: 0;
      font-size: .95rem;
      color: rgba(255, 255, 255, .92);
      max-width: 62ch;
    }

    .explore-actions {
      display: flex;
      flex-wrap: wrap;
      gap: .45rem;
    }

    .explore-btn {
      border: 1px solid rgba(255, 255, 255, .34);
      background: rgba(7, 20, 29, .45);
      color: #fff;
      border-radius: 999px;
      min-height: 38px;
      padding: .4rem .8rem;
      font-size: .82rem;
      font-weight: 700;
      cursor: pointer;
    }

    .explore-btn.is-active {
      background: #ff2f63;
      border-color: #ff2f63;
    }

    .explore-ai-bar {
      margin-top: .65rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .5rem;
      align-items: center;
    }

    .explore-ai-input {
      border: 1px solid var(--fp-border);
      border-radius: 999px;
      min-height: 40px;
      padding: .45rem .8rem;
      width: 100%;
    }

    .explore-progress {
      position: absolute;
      right: .55rem;
      top: .7rem;
      z-index: 4;
      width: 34px;
      display: grid;
      justify-items: center;
      gap: .4rem;
    }

    .explore-progress-count {
      font-size: .74rem;
      font-weight: 800;
      color: rgba(255, 255, 255, .92);
      text-shadow: 0 2px 8px rgba(0, 0, 0, .55);
    }

    .explore-progress-track {
      width: 4px;
      height: 88px;
      border-radius: 999px;
      background: rgba(255, 255, 255, .36);
      overflow: hidden;
    }

    .explore-progress-fill {
      width: 100%;
      height: 0;
      background: #44f1cb;
      transition: height .2s ease;
    }

    .alert-inline {
      border-radius: 12px;
      border: 1px solid #f3ccc8;
      background: #fff6f5;
      color: #942f25;
      padding: .8rem .95rem;
    }

    .programs-structure-shell {
      background: transparent;
      border: 0;
      box-shadow: none;
      padding: 0;
    }

    .program-category-list {
      display: grid;
      grid-template-columns: repeat(10, minmax(0, 1fr));
      gap: 28px 34px;
      padding: 22px 34px 0;
      align-items: stretch;
    }

    .program-hero-card {
      position: relative;
      width: 100%;
      grid-column: span 2;
      min-height: 118px;
      border-radius: 26px;
      overflow: hidden;
      background: #ffffff;
      border: 1px solid #e3edf1;
      box-shadow: 0 14px 32px rgba(10, 36, 54, .08);
      display: grid;
      align-content: center;
      justify-items: center;
      padding: 20px 16px;
      text-align: center;
      transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease, background .22s ease;
    }

    .program-hero-card::after {
      display: none;
    }

    .program-hero-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 38px rgba(18, 105, 81, .14);
      border-color: #bde5d1;
      background: linear-gradient(140deg, #ffffff 0%, #f2fff8 100%);
    }

    .program-hero-title {
      position: relative;
      z-index: 1;
      color: #064e3b;
      font-weight: 900;
      font-size: 20px;
      letter-spacing: -.01em;
      text-transform: none;
      margin: 0;
    }

    .program-hero-subtitle {
      position: relative;
      z-index: 1;
      margin: 6px 0 0;
      color: #64748b;
      font-size: 13px;
      font-weight: 700;
      line-height: 1.35;
    }

    .program-category-list .program-hero-card:nth-child(6) { grid-column: 2 / span 2; }
    .program-category-list .program-hero-card:nth-child(7) { grid-column: 4 / span 2; }
    .program-category-list .program-hero-card:nth-child(8) { grid-column: 6 / span 2; }
    .program-category-list .program-hero-card:nth-child(9) { grid-column: 8 / span 2; }


    .planner-action-btn {
      min-width: 128px;
      min-height: 56px;
      border-radius: 18px;
      font-size: 16px;
      font-weight: 900;
      padding: 0 22px;
    }

    .programs-footer-strip {
      margin-top: 36px;
      border-radius: 28px 28px 0 0;
      background: #178a60;
      color: #ffffff;
      text-align: center;
      padding: 22px 18px 20px;
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 0.01em;
      box-shadow: 0 18px 34px rgba(17, 108, 79, 0.18);
    }

    .fitness-page-footer-strip {
      width: calc(100% - (var(--fp-page-gutter) * 2));
      margin: 28px auto 0;
      border-radius: 28px 28px 0 0;
      background: #178a60;
      color: #ffffff;
      text-align: center;
      padding: 22px 18px 20px;
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 0.01em;
      box-shadow: 0 18px 34px rgba(17, 108, 79, 0.18);
    }

    .program-hero-card.is-clickable { cursor: pointer; }

    .program-level-grid {
      display: grid;
      gap: .9rem;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    }

    .program-level-card {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      padding: .9rem;
      background: #fff;
      box-shadow: 0 8px 18px rgba(10, 36, 54, .06);
    }

    .program-level-title {
      font-weight: 800;
      margin: 0 0 .7rem;
      color: var(--fp-text);
      font-size: 1.02rem;
    }

    .trend-grid {
      display: grid;
      gap: .9rem;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    }

    .trends-toolbar {
      margin: .35rem 0 .75rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .55rem;
      align-items: center;
    }

    .trends-toolbar input {
      min-width: 220px;
    }

    .trends-status {
      margin: 0 0 .8rem;
      color: var(--fp-muted);
      font-size: .88rem;
    }

    .trend-card {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 8px 18px rgba(10, 36, 54, .06);
      display: grid;
      gap: .6rem;
    }

    .trend-thumb {
      width: 100%;
      height: 150px;
      background-size: cover;
      background-position: center;
      background-color: #dfeaec;
    }

