      box-shadow: 0 18px 36px rgba(26, 160, 111, 0.12);
      transform: translateY(-1px);
    }

    .coach-item-photo {
      width: 124px;
      height: 124px;
      border-radius: 999px;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-color: #dce9ee;
      border: 3px solid #10b981;
      box-shadow: 0 10px 20px rgba(16, 185, 129, 0.12);
    }

    .coach-item-body {
      padding: 0;
      display: grid;
      gap: 8px;
      align-content: center;
    }

    .coach-item-badge {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      min-height: 32px;
      padding: 0 16px;
      border-radius: 999px;
      background: #effcf5;
      color: #00b06b;
      font-size: 13px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .coach-item-name {
      margin: 0;
      font-size: 22px;
      font-weight: 900;
      color: #063b39;
      line-height: 1.2;
    }

    .coach-item-speciality {
      display: none;
    }

    .coach-item-meta {
      display: grid;
      gap: 4px;
      color: #7b8ca1;
      font-size: 14px;
      font-weight: 500;
    }

    .coach-item-meta-line {
      color: #7b8ca1;
      font-size: 14px;
      line-height: 1.35;
    }

    .coach-item-cta {
      min-width: 226px;
      min-height: 58px;
      border-radius: 20px;
      background: #1aa06f;
      color: #ffffff;
      border: 0;
      font-size: 16px;
      font-weight: 900;
      padding: 0 24px;
    }

    .coach-profile {
      border: 1px solid #dcebe3;
      border-radius: 28px;
      background: #ffffff;
      padding: 22px 28px 28px;
      display: none;
      gap: 18px;
      box-shadow: 0 12px 30px rgba(10, 36, 54, .06);
    }

    .coach-profile.is-visible {
      display: grid;
    }

    .coach-profile-head {
      display: grid;
      gap: 6px;
    }

    .coach-profile-topline {
      margin: 0;
      color: #6f8094;
      font-size: 14px;
      line-height: 1.45;
    }

    .coach-profile-divider {
      height: 1px;
      background: #dcebe3;
    }

    .coach-profile-section {
      display: grid;
      gap: 14px;
    }

    .coach-profile-section h4 {
      margin: 0;
      color: #063b39;
      font-size: 15px;
      font-weight: 900;
    }

    .coach-profile-helper {
      margin: 0;
      color: #6f8094;
      font-size: 14px;
    }

    .coach-form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .coach-form-grid input,
    #fp-coach-message-input,
    #fp-coach-slot-select {
      border: 1px solid #dcebe3;
      border-radius: 22px;
      min-height: 58px;
      padding: 0 20px;
      background: #fbfefd;
      color: #063b39;
      font-size: 15px;
      width: 100%;
    }

    .coach-form-grid input:nth-child(3) {
      grid-column: 1 / 2;
    }

    .coach-slot-row {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 8px;
    }

    #fp-coach-slot-select {
      max-width: 310px;
      color: #6f8094;
      appearance: none;
      background-image: linear-gradient(45deg, transparent 50%, #b3bcc7 50%), linear-gradient(135deg, #b3bcc7 50%, transparent 50%);
      background-position: calc(100% - 26px) calc(50% - 2px), calc(100% - 18px) calc(50% - 2px);
      background-size: 8px 8px, 8px 8px;
      background-repeat: no-repeat;
      padding-right: 42px;
    }

    #fp-coach-message-input {
      min-height: 88px;
      padding-top: 16px;
      padding-bottom: 16px;
      resize: vertical;
    }

    .coach-date-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .coach-date-btn {
      border: 1px solid #cfe4db;
      background: #ffffff;
      color: #063b39;
      border-radius: 999px;
      padding: 10px 18px;
      font-size: 14px;
      font-weight: 900;
      cursor: pointer;
      transition: border-color .2s ease, background .2s ease, color .2s ease;
    }

    .coach-date-btn.is-active {
      background: #1aa06f;
      border-color: #1aa06f;
      color: #fff;
    }

    .coach-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .coach-actions .fitness-btn {
      min-height: 58px;
      border-radius: 20px;
      padding-left: 24px;
      padding-right: 24px;
      font-size: 15px;
      font-weight: 900;
      flex: 0 0 auto;
    }

    .coach-message-hint {
      margin: 0;
      color: #6f8094;
      font-size: 13px;
      line-height: 1.45;
    }

    .coach-date-grid {
      display: flex;
      flex-wrap: wrap;
      gap: .42rem;
    }

    .coach-date-btn {
      border: 1px solid var(--fp-border);
      background: #fff;
      color: var(--fp-text);
      border-radius: 999px;
      padding: .35rem .72rem;
      font-size: .8rem;
      font-weight: 700;
      cursor: pointer;
    }

    .coach-date-btn.is-active {
      background: #0f6b63;
      border-color: #0f6b63;
      color: #fff;
    }

    #fp-coach-slot-select {
      border: 1px solid var(--fp-border);
      border-radius: 10px;
      min-height: 40px;
      padding: .45rem .65rem;
      background: #fff;
      color: var(--fp-text);
      font-size: .9rem;
    }

    .hiit-card {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      padding: .95rem 1rem;
      background: #fff;
      box-shadow: 0 8px 18px rgba(10, 36, 54, .06);
      display: grid;
      gap: .8rem;
    }

    .hiit-title {
      margin: 0;
      font-size: 1.02rem;
      font-weight: 800;
      color: var(--fp-text);
    }

    .hiit-meta {
      color: var(--fp-muted);
      font-size: .9rem;
      display: flex;
      gap: .75rem;
      flex-wrap: wrap;
    }

    .hiit-meta strong { color: var(--fp-text); }

    .hiit-timer {
      display: grid;
      gap: .6rem;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      align-items: center;
    }

    .hiit-phase {
      border: 1px solid #e2ecef;
      border-radius: 12px;
      padding: .6rem .75rem;
      background: #f8fbfc;
    }

    .hiit-phase .label { font-weight: 700; color: var(--fp-text); }
    .hiit-phase .value { font-size: 1.05rem; font-weight: 800; }
    .hiit-phase .value.is-work { color: #b42318; }
    .hiit-phase .value.is-rest { color: #0f6b63; }
    .hiit-phase .value.is-done { color: #1f2937; }
    .hiit-phase .value.is-stretch { color: #1d4ed8; }

    .hiit-audio-grid {
      display: grid;
      gap: .65rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      align-items: end;
    }

    .hiit-field {
      display: grid;
      gap: .35rem;
    }

    .hiit-field > span {
      font-size: .84rem;
      color: var(--fp-muted);
      font-weight: 650;
    }

    .hiit-field select {
      border: 1px solid var(--fp-border);
      border-radius: 12px;
      min-height: 42px;
      padding: .52rem .72rem;
      width: 100%;
      color: var(--fp-text);
      background: #fff;
    }

    .hiit-field input[type="range"] {
      width: 100%;
      accent-color: var(--fp-primary);
    }

    .hiit-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
    .hiit-actions .fitness-btn { flex: 1 1 170px; }

    .hiit-coach-line {
      border: 1px dashed #c9d8df;
      border-radius: 12px;
      padding: .55rem .7rem;
      background: #f8fbfc;
      color: var(--fp-text);
      font-size: .88rem;
      font-weight: 650;
    }

    .hiit-hidden-audio {
      width: 0;
      height: 0;
      opacity: 0;
      pointer-events: none;
      position: absolute;
    }

    @media (max-width: 860px) {
      .fitness-shell,
      .fitness-page-footer-strip {
        width: calc(100% - 18px);
      }

      .fitness-hero-grid,
      .fitness-info-grid,
      .program-category-list {
        grid-template-columns: 1fr;
      }

      .fitness-hero-copy {
        padding-right: 0;
      }

      .fitness-hero-visual {
        min-height: 420px;
      }

      .fitness-nav {
        grid-template-columns: 1fr;
      }

      .fitness-nav-tabs {
        justify-content: flex-start;
      }

      .fitness-stats {
        grid-template-columns: 1fr;
      }

      .program-category-list {
        padding-left: 0;
        padding-right: 0;
      }

      .program-hero-card,
      .program-category-list .program-hero-card:nth-child(6),
      .program-category-list .program-hero-card:nth-child(7),
      .program-category-list .program-hero-card:nth-child(8),
      .program-category-list .program-hero-card:nth-child(9) {
        grid-column: auto;
      }

      .coach-item {
        grid-template-columns: 1fr;
        justify-items: start;
      }

      .coach-form-grid {
        grid-template-columns: 1fr;
      }

      .coach-form-grid input:nth-child(3) {
        grid-column: auto;
      }

      .coach-slot-row {
        align-items: stretch;
      }

      #fp-coach-slot-select {
        max-width: none;
      }

      .fitness-toolbar { grid-template-columns: 1fr; }
      .trends-toolbar { grid-template-columns: 1fr; }
      .coach-layout { grid-template-columns: 1fr; }
    }

  </style>
{% endblock %}

{% block body %}
<section class="fitness-page">
  <div class="fitness-shell">
    <div class="fitness-hero">
      <div class="fitness-hero-grid">
        <div class="fitness-hero-visual">
          <div class="fitness-hero-overlay">
            <span class="fitness-hero-chip">Fitness Stories</span>
            <p class="fitness-hero-visual-copy">Train smarter, recover better, and stay consistent with a routine that feels premium.</p>
          </div>
        </div>
        <div class="fitness-hero-copy">
          <p class="fitness-hero-kicker">Fitopia Fitness</p>
          <h1 class="fitness-hero-title">A wow fitness hub built for real training momentum</h1>
          <p class="fitness-hero-subtitle">Programs, exercise management, workout tracking, video explore feed and private coaching now live inside one white-and-green experience.</p>
          <div class="fitness-hero-actions">
            <button type="button" class="fitness-btn fitness-btn-primary planner-action-btn" id="fp-scroll-planner">See the planner</button>
            <button type="button" class="fitness-btn fitness-btn-soft planner-action-btn" id="fp-open-space">Open my space</button>
          </div>
          <div class="fitness-stats">
            <div class="fitness-stat">
              <div class="v">1500+</div>
              <span class="l">members supported</span>
            </div>
            <div class="fitness-stat">
              <div class="v">6</div>
              <span class="l">private coaches</span>
            </div>
            <div class="fitness-stat">
              <div class="v">24/7</div>
              <span class="l">training inspiration</span>
            </div>
          </div>
          <div class="fitness-hero-note">
            <strong>Inside this hub</strong>
            <p>Create exercises, launch guided programs, monitor progress, watch fitness videos and book a coach without leaving the page.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="fitness-info-grid">
      <article class="fitness-info-card">
        <h3>Plans that keep moving</h3>
        <p>Confirmed sessions, recent history and performance tracking stay visible in one place.</p>
      </article>
      <article class="fitness-info-card">
        <h3>Explore that feels alive</h3>
        <p>A real fitness video feed with filters, autoplay controls and a brighter premium player.</p>
      </article>
      <article class="fitness-info-card">
        <h3>Coaching with impact</h3>
        <p>Book private sessions, calculate BMI and jump into the right program faster.</p>
      </article>
    </div>

    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    {% set externalImageMap = {
      'Poitrine': asset('images/fitness/poitrine-1.jpg'),
      'Dos': asset('images/fitness/dos.jpg'),
      'Jambes': asset('images/fitness/jambes.jpg'),
      'Fessier': asset('images/fitness/fessier.jpg'),
      'Epaules': asset('images/fitness/epaules.jpg'),
      'Biceps': asset('images/fitness/biceps.jpg'),
      'Triceps': asset('images/fitness/triceps.jpg'),
      'Avant-bras': asset('images/fitness/avant-bras.jpg'),
      'Abdos': asset('images/fitness/abdos.jpg'),
      'Entrainement du corps entier': asset('images/fitness/corps-entier.jpg')
    } %}
    {% set programTitleMap = {
      'Poitrine': 'Poitrine',
      'Dos': 'Dos',
      'Jambes': 'Jambes',
      'Fessier': 'Fessier',
      'Epaules': 'Epaules',
      'Biceps': 'Biceps',
      'Triceps': 'Triceps',
      'Avant-bras': 'Avant-bras',
      'Abdos': 'Abdos',
      'Entrainement du corps entier': 'Corps entier'
    } %}
    {% set programSubtitleMap = {
      'Poitrine': 'Pectoraux & Force',
      'Dos': 'Largeur & Epaisseur',
      'Jambes': 'Puissance & Appuis',
      'Fessier': 'Tonification & Galbe',
      'Epaules': 'Carrure & Mobilite',
      'Biceps': 'Volume & Definition',
      'Triceps': 'Force & Extension',
      'Avant-bras': 'Grip & Endurance',
      'Abdos': 'Gainage & Core',
      'Entrainement du corps entier': 'Full Body & Cardio'
    } %}
    {% set exerciseImageMap = {} %}
    {% for ex in exercises %}
      {% set exerciseImageMap = exerciseImageMap|merge({ (ex.name): ex.imageUrl }) %}
    {% endfor %}
    {% set exerciseCountByGroup = {} %}
    {% for group in exerciseGroups %}
      {% set exerciseCountByGroup = exerciseCountByGroup|merge({ (group.label): group.items|length }) %}
    {% endfor %}

    <div class="fitness-nav" id="fp-planner-anchor">
      <h2 class="fitness-nav-title">Fitness Hub</h2>
      <div class="fitness-nav-tabs">
        <a class="fitness-tab {{ activeView == 'plans' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'plans'}) }}" data-view="plans">Mes seances</a>
        <a class="fitness-tab {{ activeView == 'manage' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'manage'}) }}" data-view="manage">My Programs</a>
        <a class="fitness-tab {{ activeView == 'exercises' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'exercises'}) }}" data-view="exercises">Exercises</a>
        <a class="fitness-tab {{ activeView == 'explore' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'explore'}) }}" data-view="explore">Explore</a>
        <a class="fitness-tab {{ activeView == 'coach' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'coach'}) }}" data-view="coach">Coach</a>
      </div>
    </div>

    <div class="section {{ activeView == 'plans' ? 'is-active' : '' }}" data-section="plans">
      <div class="fitness-card">
        <div class="section-head">
          <div>
            <h2>Mes seances enregistrees</h2>
            <p>Quand vous ajoutez des exercices depuis My Programs puis cliquez sur Confirmer, votre seance apparait ici.</p>
          </div>
        </div>
        <div id="fp-user-plans-list" class="fp-user-plans"></div>
      </div>
    </div>

    <div class="section {{ activeView == 'manage' ? 'is-active' : '' }}" data-section="manage">
      {% set programCategories = [
        'Poitrine',
        'Dos',
        'Jambes',
        'Fessier',
        'Epaules',
        'Biceps',
        'Triceps',
        'Abdos',
        'Entrainement du corps entier'
      ] %}
      {% set poitrineLevels = {
        'Débutant': [
          'Developpe couche avec barre',
          'Developpe couche incline avec barre',
          'Arm chest flyes plies a la poulie'
        ],
        'Avance': [
          'Developpe assis poitrine prise marteau',
          'Developpe incline a la machine',
          'Dips pectoraux'
        ],
        'Expert': [
          'Developpe couche allonge avec elastique',
          'Developpe couche a la poulie vis a vis',
          'Developpe poitrine prise marteau a un bras assis'
        ]
      } %}
      {% set programImageMap = {} %}
      {% for plan in programs %}
        {% set programImageMap = programImageMap|merge({ (plan.title): plan.imageUrl }) %}
      {% endfor %}

      <div class="fitness-card programs-structure-shell mt-3">
        <div class="section-head">
          <div>
            <h2>Liste des programmes</h2>
            <p>Acces rapide par groupe musculaire. Calcule ton IMC pour une recommandation personnalisee.</p>
          </div>
          <button type="button" class="fitness-btn fitness-btn-primary planner-action-btn" id="fp-open-imc">Mon IMC</button>
        </div>
        <div class="program-category-list">
          {% for category in programCategories %}
            <div class="program-hero-card is-clickable" data-program="{{ category }}">
              <h3 class="program-hero-title">{{ programTitleMap[category]|default(category) }}</h3>
              <p class="program-hero-subtitle">
                {{ exerciseCountByGroup[category]|default(0) }} exercice(s) - {{ programSubtitleMap[category]|default('Programme premium') }}
              </p>
            </div>
          {% endfor %}
        </div>
        {# Poitrine levels table removed per request #}
      </div>
    </div>

    <div class="section {{ activeView == 'exercises' ? 'is-active' : '' }}" data-section="exercises">
      <div class="fitness-card">
        <div class="section-head">
          <div>
            <h2>Gestion des exercices</h2>
            <p>Ajoute, modifie et organise ta bibliotheque d'exercices comme dans le planner Java.</p>
          </div>
          {% if exerciseInEdit %}
            <a href="{{ path('fitness_planner', {view: 'exercises'}) }}" class="fitness-btn fitness-btn-soft"><i class="fa fa-times"></i> Annuler</a>
          {% endif %}
        </div>

        <form method="post" action="{{ path('fitness_planner') }}" class="fitness-form" novalidate="novalidate">
          <input type="hidden" name="_token" value="{{ csrf_token('fitness_planner') }}">
          <input type="hidden" name="action" value="{{ exerciseInEdit ? 'update_exercise' : 'create_exercise' }}">
          <input type="hidden" name="redirect_view" value="exercises">
          {% if exerciseInEdit %}
            <input type="hidden" name="id" value="{{ exerciseInEdit.id }}">
          {% endif %}
          <div class="fitness-form-grid">
            <input type="text" name="name" required placeholder="Exercise name" value="{{ exerciseInEdit ? exerciseInEdit.name : '' }}">
            <select name="muscle_group" required>
              <option value="">Muscle group</option>
              <option value="Poitrine" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Poitrine' ? 'selected' : '' }}>Poitrine</option>
              <option value="Dos" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Dos' ? 'selected' : '' }}>Dos</option>
              <option value="Jambes" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Jambes' ? 'selected' : '' }}>Jambes</option>
              <option value="Fessier" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Fessier' ? 'selected' : '' }}>Fessier</option>
              <option value="Epaules" {{ exerciseInEdit and (exerciseInEdit.muscleGroup == 'Epaules' or exerciseInEdit.muscleGroup == 'Épaules') ? 'selected' : '' }}>Epaules</option>
              <option value="Biceps" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Biceps' ? 'selected' : '' }}>Biceps</option>
              <option value="Triceps" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Triceps' ? 'selected' : '' }}>Triceps</option>
              <option value="Avant-bras" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Avant-bras' ? 'selected' : '' }}>Avant-bras</option>
              <option value="Abdos" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Abdos' ? 'selected' : '' }}>Abdos</option>
            </select>
            <select name="difficulty" required>
              <option value="">Difficulty...</option>
              {% for level in ['Beginner', 'Intermediate', 'Advanced'] %}
                <option value="{{ level }}" {{ exerciseInEdit and exerciseInEdit.difficulty == level ? 'selected' : '' }}>{{ level }}</option>
              {% endfor %}
            </select>
            <input type="number" min="1" name="sets" placeholder="Sets" value="{{ exerciseInEdit and exerciseInEdit.sets ? exerciseInEdit.sets : '' }}">
            <input type="number" min="1" name="repetitions" placeholder="Repetitions" value="{{ exerciseInEdit and exerciseInEdit.repetitions ? exerciseInEdit.repetitions : '' }}">
            <input type="number" min="1" name="duration" placeholder="Duration (min)" value="{{ exerciseInEdit and exerciseInEdit.duration ? exerciseInEdit.duration : '' }}">
            <select name="place">
              <option value="both" {{ not exerciseInEdit or exerciseInEdit.place == 'both' ? 'selected' : '' }}>Salle / Maison</option>
              <option value="gym" {{ exerciseInEdit and exerciseInEdit.place == 'gym' ? 'selected' : '' }}>Salle de sport</option>
              <option value="home" {{ exerciseInEdit and exerciseInEdit.place == 'home' ? 'selected' : '' }}>Maison</option>
            </select>
            <input type="url" name="image_url" placeholder="Image URL" value="{{ exerciseInEdit ? exerciseInEdit.imageUrl : '' }}">
            <input type="url" name="video_url" placeholder="Video URL" value="{{ exerciseInEdit ? exerciseInEdit.videoUrl : '' }}">
            <textarea class="full" name="description" placeholder="Description">{{ exerciseInEdit ? exerciseInEdit.description : '' }}</textarea>
          </div>
          <div class="program-actions mt-3">
            <button class="fitness-btn fitness-btn-primary" type="submit"><i class="fa fa-save"></i> {{ exerciseInEdit ? 'Enregistrer l\'exercice' : 'Ajouter l\'exercice' }}</button>
          </div>
        </form>

        <div class="exercise-list">
          {% for group in exerciseGroups %}
            <article class="exercise-row">
              <div class="top">
                <div class="name">{{ group.label }}</div>
                <div class="meta">{{ group.items|length }} exercice(s)</div>
              </div>
            </article>
            {% for ex in group.items %}
              <article class="exercise-row">
                <div class="top">
                  <div class="name">{{ ex.name }}</div>
                  <div class="program-actions">
                    <a class="fitness-btn fitness-btn-soft" href="{{ path('fitness_planner', {view: 'exercises', exercise_edit: ex.id}) }}"><i class="fa fa-pencil"></i> Edit</a>
                    <form method="post" action="{{ path('fitness_planner') }}" onsubmit="return confirm('Delete this exercise?')">
                      <input type="hidden" name="_token" value="{{ csrf_token('fitness_planner') }}">
                      <input type="hidden" name="action" value="delete_exercise">
                      <input type="hidden" name="id" value="{{ ex.id }}">
                      <input type="hidden" name="redirect_view" value="exercises">
                      <button class="fitness-btn fitness-btn-danger" type="submit"><i class="fa fa-trash"></i> Delete</button>
                    </form>
                  </div>
                </div>
                <div class="meta">
                <span><i class="fa fa-map-signs"></i> {{ group.label }}</span>
                <span><i class="fa fa-signal"></i> {{ ex.difficulty }}</span>
                <span><i class="fa fa-home"></i> {{ ex.place == 'gym' ? 'Salle' : (ex.place == 'home' ? 'Maison' : 'Salle / Maison') }}</span>
                {% if ex.sets %}<span>{{ ex.sets }} sets</span>{% endif %}
                {% if ex.repetitions %}<span>{{ ex.repetitions }} reps</span>{% endif %}
                {% if ex.duration %}<span>{{ ex.duration }} min</span>{% endif %}
                </div>
              </article>
            {% endfor %}
          {% else %}
            <article class="exercise-row">
              <div class="name">No exercises yet</div>
              <div class="meta">Create your first exercise above.</div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>


    <div class="section {{ activeView == 'explore' ? 'is-active' : '' }}" data-section="explore">
      <div class="fitness-card explore-card">
        <div class="section-head">
          <div>
            <h2>Explore - Fitness video feed</h2>
            <p>Filter, autoplay and switch between local clips and YouTube inspiration in one smoother player.</p>
          </div>
        </div>
        <div class="explore-premium-toolbar">
          <input id="fp-explore-ai-query" class="explore-ai-input" type="text" placeholder="Filtrer : abdos, dos, biceps, HIIT...">
          <button id="fp-explore-ai-generate" type="button" class="fitness-btn fitness-btn-primary explore-filter-btn">Filtrer</button>
          <button id="fp-explore-reset" type="button" class="explore-reset-btn">Tout</button>
        </div>
        <div class="explore-premium-status">
          <span id="fp-explore-count-line">0 videos disponibles</span>
          <strong id="fp-explore-now-playing">Selectionne une video</strong>
        </div>

        <div class="explore-premium-layout">
          <div class="explore-premium-player">
            <div class="explore-premium-stage" id="fp-explore-stage">
              <div id="fp-explore-stage-media"></div>
              <div class="explore-premium-caption" id="fp-explore-stage-caption">Aucune video selectionnee</div>
            </div>
            <div class="explore-premium-controls">
              <button type="button" class="explore-premium-btn" id="fp-explore-prev">Prec</button>
              <button type="button" class="explore-premium-btn is-primary" id="fp-explore-play">Pause</button>
              <button type="button" class="explore-premium-btn" id="fp-explore-next">Suiv</button>
              <button type="button" class="explore-premium-btn" id="fp-explore-mute">Mute</button>
              <input type="range" min="0" max="1" step="0.01" value="0.8" class="explore-premium-volume" id="fp-explore-volume">
              <button type="button" class="explore-premium-btn explore-premium-like" id="fp-explore-like">❤️ 0</button>
            </div>
          </div>
          <aside class="explore-premium-playlist">
            <h3>Playlist</h3>
            <div class="explore-playlist-box" id="fp-explore-playlist"></div>
          </aside>
        </div>
      </div>
    </div>

    <div class="section {{ activeView == 'coach' ? 'is-active' : '' }}" data-section="coach">
      <div class="fitness-card coach-shell">
        <div class="section-head">
          <div>
            <h2>Private coaches</h2>
            <p>Choisissez un coach, reservez un creneau et lancez votre accompagnement prive.</p>
          </div>
        </div>

        <div class="coach-layout">
          <div class="coach-grid" id="fp-coach-grid"></div>

          <aside class="coach-profile" id="fp-coach-profile">
            <div class="coach-profile-head">
              <h3 class="coach-profile-name" id="fp-coach-booking-title">Reserver avec un coach</h3>
              <p class="coach-profile-topline" id="fp-coach-booking-subtitle">Selectionnez un coach pour afficher le formulaire de reservation.</p>
            </div>
            <div class="coach-profile-divider"></div>

            <div class="coach-profile-section">
              <h4>Vos informations</h4>
              <div class="coach-form-grid">
                <input type="text" id="fp-coach-client-name" placeholder="Nom complet *" value="{{ app.user ? ((app.user.firstName ?? '') ~ ' ' ~ (app.user.lastName ?? ''))|trim : '' }}">
                <input type="email" id="fp-coach-client-email" placeholder="Email *" value="{{ app.user ? app.user.email : '' }}">
                <input type="text" id="fp-coach-client-phone" placeholder="Telephone *">
              </div>
            </div>

            <div class="coach-profile-section">
              <h4>Choisissez un creneau disponible</h4>
              <p class="coach-profile-helper">Cliquez sur une date puis selectionnez l'heure</p>
              <div class="coach-date-grid" id="fp-coach-date-grid"></div>
              <div class="coach-slot-row">
                <label class="coach-message-label" for="fp-coach-slot-select">Heure :</label>
                <select id="fp-coach-slot-select" disabled>
                  <option value="">Selectionner l'heure</option>
                </select>
              </div>
            </div>

            <div class="coach-profile-section">
              <textarea id="fp-coach-message-input" rows="3" placeholder="Message optionnel (objectifs, niveau, questions...)"></textarea>
            </div>

            <div class="coach-actions">
              <button type="button" class="fitness-btn fitness-btn-primary" id="fp-coach-book-confirm">Confirmer la reservation</button>
              <button type="button" class="fitness-btn fitness-btn-soft" id="fp-coach-book-cancel">Annuler</button>
            </div>
            <p class="coach-message-hint" id="fp-coach-message-hint">La reservation sera envoyee au coach selectionne par email.</p>
          </aside>
        </div>
      </div>
    </div>

  </div>
  <div class="fitness-page-footer-strip">Fitopia Fitness Planner - premium white and green front experience</div>
</section>

