      const getCoachAvailableDates = (coach, horizonDays = 35) => {
        if (!coach || !Array.isArray(coach.scheduleSlots)) return [];

        const start = new Date();
        start.setHours(0, 0, 0, 0);
        const result = [];

        for (let offset = 0; offset <= horizonDays; offset += 1) {
          const date = new Date(start);
          date.setDate(start.getDate() + offset);
          const dayIndex = date.getDay();

          const slotRanges = coach.scheduleSlots
            .filter((slot) => Array.isArray(slot.days) && slot.days.includes(dayIndex))
            .map((slot) => `${slot.from}-${slot.to}`);

          const uniqueRanges = Array.from(new Set(slotRanges));
          if (uniqueRanges.length === 0) continue;

          result.push({
            key: toDateKey(date),
            label: formatDateShort(date),
            longLabel: formatDateLong(date),
            ranges: uniqueRanges
          });
        }

        return result;
      };

