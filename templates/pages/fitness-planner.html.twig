<div class="fp-modal" id="fp-video-modal" aria-hidden="true">
  <div class="fp-modal-card fp-video-modal-card" role="dialog" aria-modal="true" aria-labelledby="fp-video-title">
    <div class="fp-modal-header">
      <button class="fp-modal-back" type="button" id="fp-video-close">&#8592; Retour</button>
      <div>
        <h3 class="fp-modal-title" id="fp-video-title">Session d'entrainement</h3>
        <p class="fp-modal-subtitle" id="fp-video-subtitle">Exercice</p>
      </div>
      <div></div>
    </div>
    <div class="fp-training-shell">
      <div class="fp-training-topstats">
        <div class="fp-training-stat">
          <span>ROUND</span>
          <strong id="hiit-round-label">1 / 8</strong>
        </div>
        <div class="fp-training-stat">
          <span>CHRONO</span>
          <strong id="hiit-time-remaining">00:30</strong>
        </div>
      </div>

      <div class="fp-training-body">
        <div class="fp-training-main">
          <div class="fp-training-intro">
            <div class="fp-training-phase-pill" id="hiit-phase-label">WORK</div>
            <div class="fp-video-meta fp-training-meta">
              <p class="fp-video-title" id="fp-video-name"></p>
              <p class="fp-video-subtitle" id="fp-video-desc">Video demo, timer and integrated playlist.</p>
            </div>
          </div>

          <div class="fp-training-media">
            <video class="fp-video-player" id="fp-video-player" controls playsinline disablepictureinpicture></video>
            <iframe
              class="fp-video-player"
              id="fp-video-iframe"
              title="Video exercice"
              frameborder="0"
              allow="autoplay; encrypted-media"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              hidden
            ></iframe>
          </div>

        </div>

        <aside class="fp-training-sidebar">
          <div class="fp-training-sidecard">
            <h4>Audio &amp; IA</h4>
            <div class="fp-training-icon-row">
              <button class="fp-training-icon-btn" type="button" id="hiit-music-toggle" aria-label="Musique"><i class="fa fa-music"></i></button>
              <button class="fp-training-icon-btn" type="button" id="hiit-next-track" aria-label="Playlist suivante"><i class="fa fa-step-forward"></i></button>
              <button class="fp-training-icon-btn" type="button" id="hiit-mute" aria-label="Activer ou couper le son"><i class="fa fa-volume-up"></i></button>
            </div>
            <input id="hiit-volume" class="fp-training-volume" type="range" min="0" max="1" step="0.01" value="1" />
            <button class="fp-training-sidebtn" type="button" id="hiit-coach-toggle">Coach IA On</button>
            <button class="fp-training-sidebtn" type="button" id="session-next">Exercice suivant</button>
            <div class="fp-training-coach-line" id="hiit-coach-line" aria-live="polite">Coach IA: pret.</div>
          </div>

          <div class="fp-training-sidecard">
            <h4>Session Playlist</h4>
            <div class="fp-training-playlist" id="fp-training-playlist"></div>
          </div>

          <div class="fp-training-hidden" aria-hidden="true">
            <div id="hiit-round-meta">1/8</div>
            <div id="hiit-volume-label">100%</div>
            <div id="hiit-track-label">Cardio Pulse</div>
            <button type="button" id="hiit-reset">Reset</button>
            <select id="hiit-playlist">
              <option value="cardio">Cardio Pulse</option>
              <option value="hiit">HIIT Energy</option>
              <option value="strength">Strength Drive</option>
              <option value="chill">Chill Focus</option>
            </select>
          </div>
        </aside>
      </div>

      <div class="fp-training-footer-actions">
        <button class="fitness-btn fitness-btn-primary" type="button" id="hiit-start">Demarrer l'exercice</button>
        <button class="fitness-btn fitness-btn-soft" type="button" id="hiit-pause">Pause</button>
      </div>
      <audio class="hiit-hidden-audio" id="hiit-music-audio" preload="auto" loop src="{{ asset('audio/hiit.mp3') }}"></audio>
      <audio class="hiit-hidden-audio" id="hiit-beep-audio" preload="auto" src="{{ asset('audio/beep.mp3') }}"></audio>
    </div>
  </div>
</div>
{% endblock %}

{% block footer %}{% endblock %}

{% block javascripts %}
  {{ parent() }}
  {% set exerciseImageMapJs = {} %}
  {% for ex in exercises %}
    {% set exerciseImageMapJs = exerciseImageMapJs|merge({ (ex.name): ex.imageUrl }) %}
  {% endfor %}
  {% set trendsDataJs = [] %}
  {% for t in trends %}
    {% set trendsDataJs = trendsDataJs|merge([{
      id: t.id,
      title: t.title,
      category: t.category,
      description: t.description,
      imageUrl: t.imageUrl
    }]) %}
  {% endfor %}
  {% set externalImageMapJs = {
    'Poitrine': asset('images/fitness/poitrine-1.jpg'),
    'Dos': asset('images/fitness/dos.jpg'),
    'Jambes': asset('images/fitness/jambes.jpg'),
    'Fessier': asset('images/fitness/fessier.jpg'),
    'Epaules': asset('images/fitness/epaules.jpg'),
    'Biceps': asset('images/fitness/biceps.jpg'),
    'Triceps': asset('images/fitness/triceps.jpg'),
    'Avant-bras': asset('images/fitness/avant-bras.jpg'),
    'Abdos': asset('images/fitness/abdos.jpg'),
    'Entrainement du corps entier': asset('images/fitness/corps-entier.jpg')
  } %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const tabs = Array.from(document.querySelectorAll('.fitness-tab'));
      const sections = Array.from(document.querySelectorAll('.section'));
      const setView = (view) => {
        tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.view === view));
        sections.forEach((section) => section.classList.toggle('is-active', section.dataset.section === view));
      };
      const syncViewInUrl = (view) => {
        const url = new URL(window.location.href);
        url.searchParams.set('view', view);
        window.history.replaceState({}, '', url.toString());
      };
      tabs.forEach((tab) => tab.addEventListener('click', (event) => {
        event.preventDefault();
        const view = tab.dataset.view || 'plans';
        setView(view);
        syncViewInUrl(view);
        if (view === 'explore') {
          window.setTimeout(() => {
            if (typeof updateExploreProgress === 'function') {
              updateExploreProgress();
            }
          }, 30);
        }
      }));

      const plannerAnchor = document.getElementById('fp-planner-anchor');
      const scrollPlannerBtn = document.getElementById('fp-scroll-planner');
      const openSpaceBtn = document.getElementById('fp-open-space');
      const imcModal = document.getElementById('fp-imc-modal');
      const imcOpenBtn = document.getElementById('fp-open-imc');
      const imcCloseBtn = document.getElementById('fp-imc-close');
      const imcCalculateBtn = document.getElementById('fp-imc-calculate');
      const imcLaunchBtn = document.getElementById('fp-imc-launch');
      const imcWeightInput = document.getElementById('fp-imc-weight');
      const imcHeightInput = document.getElementById('fp-imc-height');
      const imcSexInput = document.getElementById('fp-imc-sex');
      const imcResult = document.getElementById('fp-imc-result');
      const imcValue = document.getElementById('fp-imc-value');
      const imcCategory = document.getElementById('fp-imc-category');
      const imcAdvice = document.getElementById('fp-imc-advice');
      const imcProgram = document.getElementById('fp-imc-program');
      const modal = document.getElementById('fp-program-modal');
      const modalTitle = document.getElementById('fp-modal-title');
      const modalSubtitle = document.getElementById('fp-modal-subtitle');
      const modalClose = document.getElementById('fp-modal-close');
      const cards = Array.from(document.querySelectorAll('.program-hero-card'));
      const levelModal = document.getElementById('fp-level-modal');
      const levelTitle = document.getElementById('fp-level-title');
      const levelSubtitle = document.getElementById('fp-level-subtitle');
      const levelClose = document.getElementById('fp-level-close');
      const levelCards = Array.from(document.querySelectorAll('.fp-level-card'));
      const gymCard = document.getElementById('fp-modal-gym');
      const homeCard = document.getElementById('fp-modal-home');
      const exerciseModal = document.getElementById('fp-exercise-modal');
      const exerciseTitle = document.getElementById('fp-exercise-title');
      const exerciseSubtitle = document.getElementById('fp-exercise-subtitle');
      const exerciseClose = document.getElementById('fp-exercise-close');
      const exerciseList = document.getElementById('fp-exercise-list');
      const videoModal = document.getElementById('fp-video-modal');
      const videoClose = document.getElementById('fp-video-close');
      const videoTitle = document.getElementById('fp-video-title');
      const videoSubtitle = document.getElementById('fp-video-subtitle');
      const videoName = document.getElementById('fp-video-name');
      const videoDesc = document.getElementById('fp-video-desc');
      const videoPlayer = document.getElementById('fp-video-player');
      const videoIframe = document.getElementById('fp-video-iframe');
      const sessionCount = document.getElementById('fp-session-count');
      const sessionTime = document.getElementById('fp-session-time');
      const sessionList = document.getElementById('fp-session-list');
      const sessionStart = document.getElementById('fp-session-start');
      const sessionClear = document.getElementById('fp-session-clear');
      const sessionStatus = document.getElementById('fp-selection-status');
      const sessionProgress = document.getElementById('session-progress');
      const sessionRest = document.getElementById('session-rest');
      const sessionNext = document.getElementById('session-next');
      const trainingPlaylist = document.getElementById('fp-training-playlist');
      const userPlansList = document.getElementById('fp-user-plans-list');
      const planCreateUrl = '{{ path('fitness_planner_plan_create') }}';
      const planDeleteUrlTemplate = '{{ path('fitness_planner_plan_delete', {id: '__ID__'}) }}';
      const coachEmailSendUrl = '{{ path('fitness_planner_coach_send_email') }}';
      const plannerCsrfToken = '{{ csrf_token('fitness_planner') }}';
      const plansPersistAvailable = {{ plansPersistAvailable ? 'true' : 'false' }};
      const initialSavedPlans = {{ savedPlans|json_encode|raw }};
      const initialTrends = {{ trendsDataJs|json_encode|raw }};
      const trendsGrid = document.getElementById('fp-trends-grid');
      const trendsQueryInput = document.getElementById('fp-trends-query');
      const trendsRefreshBtn = document.getElementById('fp-trends-refresh');
      const trendsStatus = document.getElementById('fp-trends-status');
      let selectedProgram = '';
      let selectedPlace = '';
      let selectedDifficulty = '';
      let sessionExercises = [];
      let sessionIndex = 0;
      let sessionRestTimer = null;
      const localPlansKey = 'fp_confirmed_plans';
      const loadLocalPlans = () => {
        if (!window.localStorage) return [];
        try {
          const raw = localStorage.getItem(localPlansKey);
          const parsed = raw ? JSON.parse(raw) : [];
          return Array.isArray(parsed) ? parsed : [];
        } catch (error) {
          return [];
        }
      };
      const saveLocalPlans = () => {
        if (!window.localStorage) return;
        try {
          localStorage.setItem(localPlansKey, JSON.stringify(confirmedPlans));
        } catch (error) {
          // Local storage can be unavailable (private mode, quota, etc).
        }
      };
      const buildLocalPlanId = () => `local-${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;

      let confirmedPlans = Array.isArray(initialSavedPlans) ? initialSavedPlans : [];
      if (!plansPersistAvailable) {
        confirmedPlans = loadLocalPlans();
      }
      const allTrends = Array.isArray(initialTrends) ? initialTrends : [];
      let trendsFetchDebounce = null;
      let imcRecommendedProgram = '';

      scrollPlannerBtn?.addEventListener('click', () => {
        plannerAnchor?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      openSpaceBtn?.addEventListener('click', () => {
        setView('plans');
        syncViewInUrl('plans');
        plannerAnchor?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      const openImcModal = () => {
        if (!imcModal) return;
        imcModal.classList.add('is-open');
        imcModal.setAttribute('aria-hidden', 'false');
      };

      const closeImcModal = () => {
        if (!imcModal) return;
        imcModal.classList.remove('is-open');
        imcModal.setAttribute('aria-hidden', 'true');
      };

      const computeImcRecommendation = (bmi) => {
        if (bmi < 18.5) {
          return {
            category: 'Insuffisance ponderale',
            color: '#3b82f6',
            advice: 'Augmentez votre apport calorique et faites de la musculation.',
            program: 'Corps entier',
            label: 'Prise de masse - Corps entier (Debutant)'
          };
        }
        if (bmi < 25) {
          return {
            category: 'Poids normal',
            color: '#22c55e',
            advice: 'Excellent. Maintenez votre condition avec un programme equilibre.',
            program: 'Poitrine',
            label: 'Programme equilibre - Poitrine + Dos'
          };
        }
        if (bmi < 30) {
          return {
            category: 'Surpoids',
            color: '#f59e0b',
            advice: 'Combinez cardio et musculation pour perdre du poids progressivement.',
            program: 'Jambes',
            label: 'Cardio + Jambes (Debutant)'
          };
        }
        if (bmi < 35) {
          return {
            category: 'Obesite moderee',
            color: '#f97316',
            advice: 'Commencez doucement avec des exercices a faible impact.',
            program: 'Entrainement du corps entier',
            label: 'Corps entier leger (Debutant)'
          };
        }
        return {
          category: 'Obesite severe',
          color: '#ef4444',
          advice: 'Consultez un medecin avant de commencer. Marche et mobilite recommandees.',
          program: 'Abdos',
          label: 'Mobilite & Abdos (Debutant)'
        };
      };

      imcOpenBtn?.addEventListener('click', openImcModal);
      imcCloseBtn?.addEventListener('click', closeImcModal);
      imcModal?.addEventListener('click', (event) => {
        if (event.target === imcModal) {
          closeImcModal();
        }
      });

      imcCalculateBtn?.addEventListener('click', () => {
        const weight = Number(String(imcWeightInput?.value || '').replace(',', '.'));
        const heightCm = Number(String(imcHeightInput?.value || '').replace(',', '.'));
        const sex = String(imcSexInput?.value || 'Homme');
        if (!weight || !heightCm || weight <= 0 || heightCm <= 0) {
          if (imcResult) imcResult.hidden = false;
          if (imcValue) imcValue.textContent = '--';
          if (imcCategory) {
            imcCategory.textContent = 'Valeurs invalides';
            imcCategory.style.color = '#ef4444';
          }
          if (imcAdvice) imcAdvice.textContent = 'Entrez des valeurs valides (poids en kg, taille en cm).';
          if (imcProgram) imcProgram.textContent = '--';
          if (imcLaunchBtn) imcLaunchBtn.disabled = true;
          imcRecommendedProgram = '';
          return;
        }

        const bmi = weight / Math.pow(heightCm / 100, 2);
        const result = computeImcRecommendation(bmi, sex);
        imcRecommendedProgram = result.program;
        if (imcResult) imcResult.hidden = false;
        if (imcValue) imcValue.textContent = bmi.toFixed(1);
        if (imcCategory) {
          imcCategory.textContent = result.category;
          imcCategory.style.color = result.color;
        }
        if (imcAdvice) imcAdvice.textContent = result.advice;
        if (imcProgram) imcProgram.textContent = result.label;
        if (imcLaunchBtn) imcLaunchBtn.disabled = false;
      });

      imcLaunchBtn?.addEventListener('click', () => {
        if (!imcRecommendedProgram) return;
        closeImcModal();
        setView('manage');
        syncViewInUrl('manage');
        plannerAnchor?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.setTimeout(() => openModal(imcRecommendedProgram), 180);
      });

      const clearVideoPlayer = () => {
        if (!videoPlayer) return;
        videoPlayer.pause();
        videoPlayer.removeAttribute('src');
        videoPlayer.load();
        videoPlayer.hidden = true;
      };

      const clearVideoIframe = () => {
        if (!videoIframe) return;
        videoIframe.removeAttribute('src');
        videoIframe.hidden = true;
      };

      const closeVideoModal = () => {
        clearVideoPlayer();
        clearVideoIframe();
        if (!videoModal) return;
        videoModal.classList.remove('is-open');
        videoModal.setAttribute('aria-hidden', 'true');
        stopSessionRestTimer();
        forceStopHiitAndMusic();
      };

      const openVideoModalWithSource = (source, metadata = {}) => {
        if (!videoModal || !source || !source.src) return false;
        clearVideoPlayer();
        clearVideoIframe();

        if (source.type === 'video' && videoPlayer) {
          videoPlayer.hidden = false;
          videoPlayer.disablePictureInPicture = true;
          videoPlayer.setAttribute('disablepictureinpicture', 'disablepictureinpicture');
          videoPlayer.src = source.src;
          videoPlayer.poster = metadata.image || '';
          videoPlayer.setAttribute('controls', 'controls');
          videoPlayer.controls = true;
          videoPlayer.playsInline = true;
          videoPlayer.load();
        } else if (source.type === 'youtube' && videoIframe) {
          videoIframe.hidden = false;
          videoIframe.src = source.src;
        } else {
          return false;
        }

        if (videoTitle) videoTitle.textContent = metadata.title || "Session d'entrainement";
        if (videoSubtitle) videoSubtitle.textContent = metadata.subtitle || 'Exercice';
        if (videoName) videoName.textContent = metadata.name || '';
        if (videoDesc) {
          videoDesc.textContent = metadata.description || (source.type === 'youtube'
            ? 'Video YouTube integree.'
            : 'Clique sur lecture pour demarrer.');
        }

        const modalCard = videoModal.querySelector('.fp-modal-card');
        if (modalCard) {
          modalCard.scrollTop = 0;
        }

        videoModal.classList.add('is-open');
        videoModal.setAttribute('aria-hidden', 'false');
        return true;
      };

      const openModal = (programName) => {
        if (modalTitle) modalTitle.textContent = `Ou s'entrainer`;
        if (modalSubtitle) modalSubtitle.textContent = programName;
        selectedProgram = programName || '';
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
      };

      const closeModal = () => {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
      };

      const openLevelModal = (placeLabel) => {
        selectedPlace = placeLabel || '';
        if (levelTitle) levelTitle.textContent = 'Niveau de difficulté';
        if (levelSubtitle) {
          levelSubtitle.textContent = selectedProgram ? `${selectedProgram} - ${placeLabel}` : placeLabel;
        }
        levelModal.classList.add('is-open');
        levelModal.setAttribute('aria-hidden', 'false');
      };

      const closeLevelModal = () => {
        levelModal.classList.remove('is-open');
        levelModal.setAttribute('aria-hidden', 'true');
      };

      const openExerciseModal = (levelLabel) => {
        selectedDifficulty = levelLabel || '';
        if (exerciseTitle) {
          exerciseTitle.textContent = selectedProgram || 'Programme';
        }
        if (exerciseSubtitle) {
          exerciseSubtitle.textContent = `${selectedPlace} - ${levelLabel}`;
        }

        const exerciseImageMap = {{ exerciseImageMapJs|json_encode|raw }};
        const dynamicProgramExercises = {{ exerciseLibraryByGroup|json_encode|raw }};
        const programImageMap = {{ externalImageMapJs|json_encode|raw }};
        const overrideExerciseImages = {
          'Developpe couche avec barre': '{{ asset('images/fitness/exercises/developpe-couche-avec-barre.webp') }}',
          'Developpe couche incline avec barre': '{{ asset('images/fitness/exercises/developpe-incline-machine.gif') }}',
          'Arm chest flyes plies a la poulie': '{{ asset('images/fitness/exercises/arm-chest-flyes-poulie.jpg') }}',
          'Developpe assis poitrine prise marteau': '{{ asset('images/fitness/exercises/developpe-assis-prise-marteau.gif') }}',
          'Developpe incline a la machine': '{{ asset('images/fitness/exercises/developpe-incline-machine.gif') }}',
          'Dips pectoraux': '{{ asset('images/fitness/exercises/dips-pectoraux.png') }}',
          'Developpe couche allonge avec elastique': '{{ asset('images/fitness/exercises/developpe-couche-allonge-elastique.webp') }}',
          'Developpe couche a la poulie vis a vis': '{{ asset('images/fitness/exercises/developpe-couche-poulie-vis-a-vis.webp') }}',
          'Developpe poitrine prise marteau a un bras assis': '{{ asset('images/fitness/exercises/developpe-prise-marteau-un-bras-assis.gif') }}'
        };
        const exerciseVideoMap = {
          'Developpe couche avec barre': '{{ asset('videos/fitness/developpe-couche-avec-barre.mp4') }}',
          'Developpe couche incline avec barre': '{{ asset('videos/fitness/developpe-couche-incline-avec-barre.mp4') }}',
          'Arm chest flyes plies a la poulie': '{{ asset('videos/fitness/arm-chest-flyes-poulie.mp4') }}',
          'Developpe assis poitrine prise marteau': '{{ asset('videos/fitness/developpe-assis-prise-marteau.mp4') }}',
          'Developpe incline a la machine': '{{ asset('videos/fitness/developpe-incline-machine.mp4') }}',
          'Dips pectoraux': '{{ asset('videos/fitness/dips-pectoraux.mp4') }}',
          'Developpe couche allonge avec elastique': '{{ asset('videos/fitness/developpe-couche-allonge-elastique.mp4') }}',
          'Developpe couche a la poulie vis a vis': '{{ asset('videos/fitness/developpe-couche-poulie-vis-a-vis.mp4') }}',
          'Developpe poitrine prise marteau a un bras assis': '{{ asset('videos/fitness/developpe-prise-marteau-un-bras-assis.mp4') }}'
        };
        const hardcodedProgramExercises = {
          'Poitrine': {
            'Débutant': [
              'Developpe couche avec barre',
              'Developpe couche incline avec barre',
              'Arm chest flyes plies a la poulie'
            ],
            'Avance': [
              'Developpe assis poitrine prise marteau',
              'Developpe incline a la machine',
              'Dips pectoraux'
            ],
            'Expert': [
              'Developpe couche allonge avec elastique',
              'Developpe couche a la poulie vis a vis',
              'Developpe poitrine prise marteau a un bras assis'
            ]
          }
        };

        const levelKeyMap = {
          'Débutant': 'Beginner',
          'Avance': 'Intermediate',
          'Expert': 'Advanced'
        };
        const selectedPlaceKey = selectedPlace === 'À la salle de sport' ? 'gym' : 'home';
        const dbGroup = dynamicProgramExercises[selectedProgram] || {};
        const dbExercises = (dbGroup[levelKeyMap[levelLabel] || ''] || []).filter((entry) => !entry.place || entry.place === 'both' || entry.place === selectedPlaceKey);
        const dbAnyLevelExercises = Object.values(dbGroup).flat().filter((entry) => !entry.place || entry.place === 'both' || entry.place === selectedPlaceKey);
        const fallbackExercises = (hardcodedProgramExercises[selectedProgram] && hardcodedProgramExercises[selectedProgram][levelLabel]) || [];
        const list = dbExercises.length > 0
          ? dbExercises
          : dbAnyLevelExercises.length > 0
            ? dbAnyLevelExercises
          : fallbackExercises.map((name) => ({ name, image: '', video: '' }));
        if (exerciseList) {
          exerciseList.innerHTML = '';
          if (list.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'program-meta';
            empty.textContent = 'Aucun exercice disponible pour ce choix.';
            exerciseList.appendChild(empty);
          } else {
            list.forEach((exerciseEntry) => {
              const name = typeof exerciseEntry === 'string' ? exerciseEntry : (exerciseEntry.name || '');
              const image = (exerciseEntry && exerciseEntry.image)
                || (overrideExerciseImages && overrideExerciseImages[name])
                || (exerciseImageMap && exerciseImageMap[name])
                || (programImageMap && programImageMap[selectedProgram])
                || '';
              const video = (exerciseEntry && exerciseEntry.video)
                || (exerciseVideoMap && exerciseVideoMap[name])
                || '';
              const place = (exerciseEntry && exerciseEntry.place)
                ? (exerciseEntry.place === 'gym' ? 'Salle' : exerciseEntry.place === 'home' ? 'Maison' : 'Salle / Maison')
                : (selectedPlaceKey === 'gym' ? 'Salle' : 'Maison');
              const item = document.createElement('div');
              item.className = 'fp-java-exercise-card';
              if (video) {
                item.classList.add('is-demo');
                item.dataset.video = video;
                item.dataset.exercise = name;
              }

              const media = document.createElement('div');
              media.className = 'fp-java-exercise-media';
              if (image) {
                const thumb = document.createElement('img');
                thumb.src = image;
                thumb.alt = name;
                media.appendChild(thumb);
              } else {
                media.textContent = name.slice(0, 2).toUpperCase();
              }

              const copy = document.createElement('div');
              copy.className = 'fp-java-exercise-copy';
              const label = document.createElement('h4');
              label.className = 'fp-java-exercise-name';
              label.textContent = name;
              const subtitle = document.createElement('p');
              subtitle.className = 'fp-java-exercise-subtitle';
              subtitle.textContent = 'Video demo, timer and integrated playlist';
              const chips = document.createElement('div');
              chips.className = 'fp-java-exercise-chips';
              const placeChip = document.createElement('span');
              placeChip.className = 'fp-java-exercise-chip';
              placeChip.textContent = selectedPlace || 'Programme';
              const levelChip = document.createElement('span');
              levelChip.className = 'fp-java-exercise-chip';
              levelChip.textContent = levelLabel || 'Debutant';
              const placeChipInfo = document.createElement('span');
              placeChipInfo.className = 'fp-java-exercise-chip';
              placeChipInfo.textContent = place;
              chips.appendChild(placeChip);
              chips.appendChild(levelChip);
              chips.appendChild(placeChipInfo);
              copy.appendChild(label);
              copy.appendChild(subtitle);
              copy.appendChild(chips);

              const actionWrap = document.createElement('div');
              actionWrap.className = 'fp-java-exercise-actions';
              const demoBtn = document.createElement('button');
              demoBtn.type = 'button';
              demoBtn.className = 'fp-java-demo-btn';
              demoBtn.textContent = 'Voir la demo';
              const openPreview = () => {
                if (!video) return;
                const source = normalizeVideoSource(video);
                const opened = openVideoModalWithSource(source, {
                  title: "Session d'entrainement",
                  subtitle: [selectedProgram, selectedPlace, selectedDifficulty].filter(Boolean).join(' - '),
                  name,
                  image,
                  description: 'Video demo, timer and integrated playlist'
                });
                if (!opened) {
                  alert('Impossible d\'ouvrir cette video en incrustation.');
                }
              };
              demoBtn.addEventListener('click', (evt) => {
                evt.stopPropagation();
                openPreview();
              });

              const addBtn = document.createElement('button');
              addBtn.type = 'button';
              addBtn.className = 'fp-java-add-btn';
              const alreadyAdded = sessionExercises.some((e) => e.name === name);
              addBtn.textContent = alreadyAdded ? '+ Ajouter a ma seance (1)' : '+ Ajouter a ma seance';
              if (alreadyAdded) {
                addBtn.classList.add('is-added');
              }
              addBtn.addEventListener('click', (evt) => {
                evt.stopPropagation();
                if (!sessionExercises.find((e) => e.name === name)) {
                  sessionExercises.push({ name, video });
                  addBtn.textContent = '+ Ajouter a ma seance (1)';
                  addBtn.classList.add('is-added');
                  renderSessionPanel();
                }
              });
              actionWrap.appendChild(demoBtn);
              actionWrap.appendChild(addBtn);
              item.appendChild(media);
              item.appendChild(copy);
              item.appendChild(actionWrap);
              item.addEventListener('click', () => {
                openPreview();
              });
              exerciseList.appendChild(item);
            });
          }
        }

        exerciseModal.classList.add('is-open');
        exerciseModal.setAttribute('aria-hidden', 'false');
      };

      const closeExerciseModal = () => {
        exerciseModal.classList.remove('is-open');
        exerciseModal.setAttribute('aria-hidden', 'true');
      };

      cards.forEach((card) => {
        card.addEventListener('click', () => openModal(card.dataset.program || 'Programme'));
      });

      if (modalClose) modalClose.addEventListener('click', closeModal);
      if (levelClose) levelClose.addEventListener('click', closeLevelModal);
      if (exerciseClose) exerciseClose.addEventListener('click', closeExerciseModal);
      if (videoClose) {
        videoClose.addEventListener('click', () => {
          closeVideoModal();
        });
      }

      if (gymCard) {
        gymCard.addEventListener('click', () => openLevelModal('À la salle de sport'));
      }
      if (homeCard) {
        homeCard.addEventListener('click', () => openLevelModal('Chez soi'));
      }

      levelCards.forEach((card) => {
        card.addEventListener('click', () => openExerciseModal(card.dataset.level || 'Niveau'));
      });

      modal.addEventListener('click', (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });

      levelModal.addEventListener('click', (event) => {
        if (event.target === levelModal) {
          closeLevelModal();
        }
      });

      exerciseModal.addEventListener('click', (event) => {
        if (event.target === exerciseModal) {
          closeExerciseModal();
        }
      });

      if (videoModal) {
        videoModal.addEventListener('click', (event) => {
          if (event.target === videoModal) {
            closeVideoModal();
          }
        });
      }

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeImcModal();
          closeModal();
          closeLevelModal();
          closeExerciseModal();
          if (videoModal && videoModal.classList.contains('is-open')) {
            closeVideoModal();
          }
        }
      });

      const hiitStart = document.getElementById('hiit-start');
      const hiitPause = document.getElementById('hiit-pause');
      const hiitReset = document.getElementById('hiit-reset');
      const hiitMusicToggle = document.getElementById('hiit-music-toggle');
      const hiitNextTrack = document.getElementById('hiit-next-track');
      const hiitMute = document.getElementById('hiit-mute');
      const hiitCoachToggle = document.getElementById('hiit-coach-toggle');
      const hiitCoachLine = document.getElementById('hiit-coach-line');
      const hiitPhaseLabel = document.getElementById('hiit-phase-label');
      const hiitRoundLabel = document.getElementById('hiit-round-label');
      const hiitRoundMeta = document.getElementById('hiit-round-meta');
      const hiitTimeRemaining = document.getElementById('hiit-time-remaining');
      const hiitTrackLabel = document.getElementById('hiit-track-label');
      const hiitPlaylist = document.getElementById('hiit-playlist');
      const hiitVolume = document.getElementById('hiit-volume');
      const hiitVolumeLabel = document.getElementById('hiit-volume-label');
      const hiitMusicAudio = document.getElementById('hiit-music-audio');
      const hiitBeepAudio = document.getElementById('hiit-beep-audio');
      const hiitWorkSeconds = 30;
      const hiitRestSeconds = 15;
      const hiitRounds = 8;
      const hiitWorkVolume = 0.8;
      const hiitRestVolume = 0.3;
      const hiitStretchVolume = 0.2;

      const hiitPlaylists = [
        { id: 'cardio', label: 'Cardio Pulse', src: '{{ asset('audio/cardio.mp3') }}' },
        { id: 'hiit', label: 'HIIT Energy', src: '{{ asset('audio/hiit.mp3') }}' },
        { id: 'strength', label: 'Strength Drive', src: '{{ asset('audio/strength.mp3') }}' },
        { id: 'chill', label: 'Chill Focus', src: '{{ asset('audio/chill.m4a') }}' }
      ];

      let hiitPhase = 'work';
      let hiitRemaining = hiitWorkSeconds;
      let hiitRound = 1;
      let hiitIsDone = false;
      let hiitTimerId = null;
      let hiitMasterVolume = 1;
      let hiitMuted = false;
      let hiitPlaylistIndex = 0;
      let hiitBeepCtx = null;
      let hiitCoachEnabled = true;
      let hiitCoachVoice = null;
      const hiitCoachCueRegistry = new Set();
      const hiitSpeechSupported = typeof window.speechSynthesis !== 'undefined' && typeof window.SpeechSynthesisUtterance !== 'undefined';

      const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
      const formatClock = (seconds) => {
        const safe = Math.max(0, Number(seconds) || 0);
        const mins = Math.floor(safe / 60);
        const secs = safe % 60;
        return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      };

      const updateMusicToggleLabel = () => {
        if (!hiitMusicToggle || !hiitMusicAudio) return;
        hiitMusicToggle.innerHTML = '<i class="fa fa-music"></i>';
        hiitMusicToggle.classList.toggle('is-active', !hiitMusicAudio.paused);
        hiitMusicToggle.setAttribute('aria-label', hiitMusicAudio.paused ? 'Lancer la musique' : 'Pause musique');
      };

      const updateMuteLabel = () => {
        if (!hiitMute) return;
        hiitMute.innerHTML = `<i class="fa ${hiitMuted ? 'fa-volume-off' : 'fa-volume-up'}"></i>`;
        hiitMute.classList.toggle('is-active', hiitMuted);
        hiitMute.setAttribute('aria-label', hiitMuted ? 'Activer le son' : 'Couper le son');
      };

      const updateCoachToggleLabel = () => {
        if (!hiitCoachToggle) return;
        hiitCoachToggle.textContent = hiitCoachEnabled ? 'Coach IA On' : 'Coach IA Off';
      };

      const setCoachLine = (message) => {
        if (!hiitCoachLine) return;
        hiitCoachLine.textContent = `Coach IA: ${message}`;
      };

      const getPlaylistIndexById = (id) => hiitPlaylists.findIndex((entry) => entry.id === id);

      const renderTrainingPlaylist = () => {
        if (!trainingPlaylist) return;
        trainingPlaylist.innerHTML = '';
        hiitPlaylists.forEach((track, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'fp-training-playlist-item';
          button.textContent = track.label;
          if (index === hiitPlaylistIndex) {
            button.classList.add('is-active');
          }
          button.addEventListener('click', () => {
            setHiitPlaylistByIndex(index, true);
          });
          trainingPlaylist.appendChild(button);
        });
      };

      const pickCoachVoice = () => {
        if (!hiitSpeechSupported) return;
        const voices = window.speechSynthesis.getVoices();
        if (!Array.isArray(voices) || voices.length === 0) return;
        hiitCoachVoice = voices.find((voice) => String(voice.lang || '').toLowerCase().startsWith('fr'))
          || voices.find((voice) => String(voice.lang || '').toLowerCase().startsWith('en'))
          || voices[0]
          || null;
      };

      const stopCoachSpeech = () => {
        if (!hiitSpeechSupported) return;
        window.speechSynthesis.cancel();
      };

      const speakCoach = (message, options = {}) => {
        const text = String(message || '').trim();
        if (!text) return;

        setCoachLine(text);
        if (!hiitCoachEnabled || hiitMuted || !hiitSpeechSupported) return;

        const shouldInterrupt = options.interrupt !== false;
        if (shouldInterrupt) {
          window.speechSynthesis.cancel();
        }

        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'fr-FR';
        utterance.rate = hiitPhase === 'rest' || hiitPhase === 'stretch' ? 0.98 : 1.05;
        utterance.pitch = 1;
        utterance.volume = clamp(hiitMasterVolume * 1.35, 0.45, 1);
        if (hiitCoachVoice) {
          utterance.voice = hiitCoachVoice;
        }
        window.speechSynthesis.speak(utterance);
      };

      const speakCoachOnce = (key, message, options = {}) => {
        if (hiitCoachCueRegistry.has(key)) return;
        hiitCoachCueRegistry.add(key);
        speakCoach(message, options);
      };

      const resetCoachCues = () => {
        hiitCoachCueRegistry.clear();
      };

      const getHiitPhaseMultiplier = () => {
        if (hiitPhase === 'rest') return hiitRestVolume;
        if (hiitPhase === 'stretch') return hiitStretchVolume;
        if (hiitPhase === 'work' && hiitRound >= hiitRounds) {
          return Math.min(1, hiitWorkVolume + 0.12);
        }
        return hiitWorkVolume;
      };

      const applyHiitVolumes = () => {
        if (hiitMusicAudio) {
          // Auto-duck music volume in REST and restore it in WORK.
          const computedMusicVolume = hiitMuted ? 0 : clamp(hiitMasterVolume * getHiitPhaseMultiplier(), 0, 1);
          hiitMusicAudio.volume = computedMusicVolume;
          hiitMusicAudio.muted = hiitMuted;
        }
        if (hiitBeepAudio) {
          hiitBeepAudio.volume = hiitMuted ? 0 : clamp(hiitMasterVolume, 0, 1);
          hiitBeepAudio.muted = hiitMuted;
        }
        if (hiitVolumeLabel) {
          hiitVolumeLabel.textContent = `${Math.round(hiitMasterVolume * 100)}%`;
        }
      };

      const renderHiit = () => {
        // Keep volume in sync with current phase at every render/tick.
        applyHiitVolumes();

        if (hiitPhaseLabel) {
          const phaseText = hiitPhase === 'stretch'
            ? 'STRETCH'
            : (hiitIsDone ? 'DONE' : (hiitPhase === 'work' ? 'WORK' : 'REST'));
          hiitPhaseLabel.textContent = phaseText;
          hiitPhaseLabel.classList.remove('is-work', 'is-rest', 'is-done', 'is-stretch');
          if (phaseText === 'WORK') hiitPhaseLabel.classList.add('is-work');
          if (phaseText === 'REST') hiitPhaseLabel.classList.add('is-rest');
          if (phaseText === 'DONE') hiitPhaseLabel.classList.add('is-done');
          if (phaseText === 'STRETCH') hiitPhaseLabel.classList.add('is-stretch');
        }
        if (hiitTimeRemaining) {
          hiitTimeRemaining.textContent = formatClock(hiitRemaining);
        }
        const roundText = `${Math.min(hiitRound, hiitRounds)}/${hiitRounds}`;
        if (hiitRoundLabel) hiitRoundLabel.textContent = roundText;
        if (hiitRoundMeta) hiitRoundMeta.textContent = roundText;
        if (hiitTrackLabel && hiitPlaylists[hiitPlaylistIndex]) {
          hiitTrackLabel.textContent = hiitPlaylists[hiitPlaylistIndex].label;
        }
        renderTrainingPlaylist();
      };

      const playHiitMusic = () => {
        if (!hiitMusicAudio) return;
        applyHiitVolumes();
        hiitMusicAudio.play().catch(() => {
          // Ignore autoplay errors if browser blocks playback.
        });
      };

      const pauseHiitMusic = () => {
        if (!hiitMusicAudio) return;
        hiitMusicAudio.pause();
      };

      const stopHiitMusic = () => {
        if (!hiitMusicAudio) return;
        hiitMusicAudio.pause();
        hiitMusicAudio.currentTime = 0;
      };

      const stopHiitTimer = () => {
        if (!hiitTimerId) return;
        clearInterval(hiitTimerId);
        hiitTimerId = null;
      };

      const playHiitBeep = () => {
        if (hiitMuted || hiitMasterVolume <= 0) return;

        const playHiitFallbackBeep = () => {
          const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextCtor) return;

          if (!hiitBeepCtx) {
            hiitBeepCtx = new AudioContextCtor();
          }

          if (hiitBeepCtx.state === 'suspended') {
            hiitBeepCtx.resume().catch(() => {});
          }

          const now = hiitBeepCtx.currentTime;
          const oscillator = hiitBeepCtx.createOscillator();
          const gainNode = hiitBeepCtx.createGain();
          const maxBeepVolume = Math.max(0.001, clamp(hiitMasterVolume * 0.35, 0, 1));

          oscillator.type = 'sine';
          oscillator.frequency.setValueAtTime(880, now);
          gainNode.gain.setValueAtTime(0.0001, now);
          gainNode.gain.exponentialRampToValueAtTime(maxBeepVolume, now + 0.01);
          gainNode.gain.exponentialRampToValueAtTime(0.0001, now + 0.14);

          oscillator.connect(gainNode);
          gainNode.connect(hiitBeepCtx.destination);
          oscillator.start(now);
          oscillator.stop(now + 0.15);
        };

        if (!hiitBeepAudio) {
          playHiitFallbackBeep();
          return;
        }

        hiitBeepAudio.currentTime = 0;
        const playPromise = hiitBeepAudio.play();
        if (playPromise && typeof playPromise.catch === 'function') {
          playPromise.catch(() => {
            playHiitFallbackBeep();
          });
        }
      };

      const setHiitPlaylistByIndex = (nextIndex, keepPlayback) => {
        if (!hiitMusicAudio || hiitPlaylists.length === 0) return;
        const boundedIndex = ((nextIndex % hiitPlaylists.length) + hiitPlaylists.length) % hiitPlaylists.length;
        const shouldResume = Boolean(keepPlayback && !hiitMusicAudio.paused);
        hiitPlaylistIndex = boundedIndex;
        hiitMusicAudio.pause();
        hiitMusicAudio.src = hiitPlaylists[hiitPlaylistIndex].src;
        hiitMusicAudio.currentTime = 0;
        hiitMusicAudio.load();
        applyHiitVolumes();
        renderHiit();
        if (hiitPlaylist) {
          hiitPlaylist.value = hiitPlaylists[hiitPlaylistIndex].id;
        }
        if (shouldResume) {
          hiitMusicAudio.play().catch(() => {
            // Ignore autoplay errors after changing playlist.
          });
        }
        updateMusicToggleLabel();
      };

      const completeHiitSession = () => {
        stopHiitTimer();
        hiitIsDone = true;
        hiitPhase = 'stretch';
        hiitRemaining = 0;

        const chillIndex = getPlaylistIndexById('chill');
        if (chillIndex >= 0 && chillIndex !== hiitPlaylistIndex) {
          setHiitPlaylistByIndex(chillIndex, true);
        } else {
          applyHiitVolumes();
          playHiitMusic();
        }

        speakCoachOnce('session-complete', 'Session terminee. Stretching calme, respire.');
        renderHiit();
        updateMusicToggleLabel();
      };

      const switchHiitPhase = () => {
        playHiitBeep();

        if (hiitPhase === 'work') {
          if (hiitRound >= hiitRounds) {
            completeHiitSession();
            return;
          }
          hiitPhase = 'rest';
          hiitRemaining = hiitRestSeconds;
          speakCoachOnce(`rest-${hiitRound}-start`, `Repose-toi maintenant ${hiitRestSeconds} secondes.`);
        } else {
          hiitPhase = 'work';
          hiitRound += 1;
          hiitRemaining = hiitWorkSeconds;
          if (hiitRound >= hiitRounds) {
            const cardioIndex = getPlaylistIndexById('cardio');
            if (cardioIndex >= 0 && cardioIndex !== hiitPlaylistIndex) {
              setHiitPlaylistByIndex(cardioIndex, true);
            }
            speakCoachOnce(`work-${hiitRound}-start-final`, 'Dernier effort !');
          } else {
            speakCoachOnce(`work-${hiitRound}-start`, 'Go !');
          }
        }

        applyHiitVolumes();
        renderHiit();
      };

      const emitHiitCoachCues = () => {
        if (hiitIsDone) return;

        if (hiitPhase === 'work') {
          const halfThreshold = Math.max(12, Math.floor(hiitWorkSeconds / 2));
          if (hiitRemaining === halfThreshold) {
            speakCoachOnce(`work-${hiitRound}-rhythm`, 'Tres bon rythme.');
          }
          if (hiitRemaining === 10) {
            speakCoachOnce(`work-${hiitRound}-10`, 'Encore 10 secondes.');
          }
          if (hiitRemaining === 6) {
            speakCoachOnce(`work-${hiitRound}-breath`, 'Respire.');
          }
          return;
        }

        if (hiitPhase === 'rest' && hiitRemaining === 3) {
          speakCoachOnce(`rest-${hiitRound}-3`, 'On repart dans 3 secondes.');
        }
      };

      const tickHiit = () => {
        if (hiitIsDone) return;
        if (hiitRemaining > 1) {
          hiitRemaining -= 1;
          renderHiit();
          emitHiitCoachCues();
          return;
        }
        switchHiitPhase();
      };

      const startHiit = () => {
        if (hiitTimerId) return;
        if (hiitIsDone) {
          hiitIsDone = false;
          hiitPhase = 'work';
          hiitRound = 1;
          hiitRemaining = hiitWorkSeconds;
        }

        // Prime WebAudio during user gesture so fallback beep can play later.
        if (!hiitBeepCtx) {
          const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
          if (AudioContextCtor) {
            hiitBeepCtx = new AudioContextCtor();
          }
        }
        if (hiitBeepCtx && hiitBeepCtx.state === 'suspended') {
          hiitBeepCtx.resume().catch(() => {});
        }
        if (hiitSpeechSupported && window.speechSynthesis.paused) {
          window.speechSynthesis.resume();
        }

        applyHiitVolumes();
        renderHiit();
        playHiitMusic();
        hiitTimerId = setInterval(tickHiit, 1000);

        if (hiitPhase === 'work' && hiitRound >= hiitRounds) {
          const cardioIndex = getPlaylistIndexById('cardio');
          if (cardioIndex >= 0 && cardioIndex !== hiitPlaylistIndex) {
            setHiitPlaylistByIndex(cardioIndex, true);
          }
          speakCoachOnce(`work-${hiitRound}-start-final`, 'Dernier effort !');
          return;
        }

        if (hiitPhase === 'rest') {
          if (hiitRemaining >= hiitRestSeconds) {
            speakCoachOnce(`rest-${hiitRound}-start`, `Repose-toi maintenant ${Math.max(1, hiitRemaining)} secondes.`);
          } else {
            speakCoach('On repart.');
          }
          return;
        }

        if (hiitRemaining >= hiitWorkSeconds) {
          speakCoachOnce(`work-${hiitRound}-start`, 'Go !');
        } else {
          speakCoach('On repart.');
        }
      };

      const pauseHiit = () => {
        stopHiitTimer();
        pauseHiitMusic();
        stopCoachSpeech();
        setCoachLine('pause.');
        updateMusicToggleLabel();
      };

      const resetHiit = () => {
        stopHiitTimer();
        stopHiitMusic();
        stopCoachSpeech();
        resetCoachCues();
        hiitPhase = 'work';
        hiitRound = 1;
        hiitRemaining = hiitWorkSeconds;
        hiitIsDone = false;
        hiitMasterVolume = 1;
        hiitMuted = false;
        if (hiitVolume) hiitVolume.value = '1';
        setCoachLine('pret.');
        updateMuteLabel();
        applyHiitVolumes();
        renderHiit();
        updateMusicToggleLabel();
      };

      const forceStopHiitAndMusic = () => {
        resetHiit();
      };

      if (hiitStart) hiitStart.addEventListener('click', () => {
        startHiit();
        if (videoPlayer && !videoPlayer.hidden && videoPlayer.src) {
          videoPlayer.play().catch(() => {});
        }
      });
      if (hiitPause) hiitPause.addEventListener('click', () => {
        pauseHiit();
        if (videoPlayer && !videoPlayer.hidden) {
          videoPlayer.pause();
        }
      });
      if (hiitReset) hiitReset.addEventListener('click', resetHiit);

      if (hiitMusicToggle) {
        hiitMusicToggle.addEventListener('click', () => {
          if (!hiitMusicAudio) return;
          if (hiitMusicAudio.paused) {
            playHiitMusic();
          } else {
            pauseHiitMusic();
          }
          updateMusicToggleLabel();
        });
      }

      if (hiitNextTrack) {
        hiitNextTrack.addEventListener('click', () => {
          setHiitPlaylistByIndex(hiitPlaylistIndex + 1, true);
        });
      }

      if (hiitPlaylist) {
        hiitPlaylist.addEventListener('change', () => {
          const nextIndex = hiitPlaylists.findIndex((entry) => entry.id === hiitPlaylist.value);
          if (nextIndex < 0) return;
          setHiitPlaylistByIndex(nextIndex, true);
        });
      }

      if (hiitVolume) {
        hiitVolume.addEventListener('input', () => {
          hiitMasterVolume = clamp(parseFloat(hiitVolume.value || '1'), 0, 1);
          applyHiitVolumes();
        });
      }

      if (hiitMute) {
        hiitMute.addEventListener('click', () => {
          hiitMuted = !hiitMuted;
          updateMuteLabel();
          applyHiitVolumes();
          if (hiitMuted) {
            stopCoachSpeech();
          }
        });
      }

      if (hiitCoachToggle) {
        hiitCoachToggle.addEventListener('click', () => {
          hiitCoachEnabled = !hiitCoachEnabled;
          updateCoachToggleLabel();
          if (!hiitCoachEnabled) {
            stopCoachSpeech();
            setCoachLine('desactive.');
            return;
          }
          setCoachLine('active.');
          speakCoach('Coach IA active.');
        });
      }

      if (hiitMusicAudio) {
        hiitMusicAudio.addEventListener('play', updateMusicToggleLabel);
        hiitMusicAudio.addEventListener('pause', updateMusicToggleLabel);
        hiitMusicAudio.addEventListener('play', applyHiitVolumes);
        hiitMusicAudio.addEventListener('timeupdate', applyHiitVolumes);
        hiitMusicAudio.addEventListener('loadedmetadata', applyHiitVolumes);
      }

      if (hiitSpeechSupported) {
        pickCoachVoice();
        if (typeof window.speechSynthesis.addEventListener === 'function') {
          window.speechSynthesis.addEventListener('voiceschanged', pickCoachVoice);
        } else {
          window.speechSynthesis.onvoiceschanged = pickCoachVoice;
        }
      } else {
        setCoachLine('mode texte (voix indisponible).');
      }

      updateCoachToggleLabel();
      updateMuteLabel();
      setHiitPlaylistByIndex(0, false);
      resetHiit();

      const renderSessionPanel = () => {
        const exerciseCount = sessionExercises.length;
        if (sessionCount) {
          sessionCount.textContent = `${exerciseCount} exercices`;
        }
        const estimatedSeconds = sessionExercises.length * 90;
        const mins = Math.max(0, Math.ceil(estimatedSeconds / 60));
        if (sessionTime) {
          sessionTime.textContent = `Temps estime : ${mins} min`;
        }
        if (sessionStatus) {
          sessionStatus.textContent = exerciseCount === 0
            ? 'Aucun exercice selectionne.'
            : `${exerciseCount} exercice(s) en attente de confirmation.`;
        }
        if (sessionStart) {
          sessionStart.disabled = exerciseCount === 0;
        }
        if (!sessionList) return;
        sessionList.innerHTML = '';
        sessionExercises.forEach((ex) => {
          const row = document.createElement('div');
          row.className = 'fp-session-item';
          row.textContent = ex.name;
          sessionList.appendChild(row);
        });
      };

      const setTrendsStatus = (message) => {
        if (trendsStatus) {
          trendsStatus.textContent = message;
        }
      };

      const createTrendCard = (trend) => {
        const card = document.createElement('article');
        card.className = 'trend-card';

        const thumb = document.createElement('div');
        thumb.className = 'trend-thumb';
        if (trend.imageUrl) {
          thumb.style.backgroundImage = `url("${trend.imageUrl}")`;
        }
        card.appendChild(thumb);

        const body = document.createElement('div');
        body.className = 'trend-body';

        const category = document.createElement('div');
        category.className = 'trend-category';
        category.textContent = trend.category || 'Tendance';
        body.appendChild(category);

        const title = document.createElement('h3');
        title.className = 'trend-title';
        title.textContent = trend.title || 'Sans titre';
        body.appendChild(title);

        if (trend.description) {
          const description = document.createElement('div');
          description.className = 'program-meta';
          description.textContent = trend.description;
          body.appendChild(description);
        }

        card.appendChild(body);
        return card;
      };

      const renderTrends = (items, query) => {
        if (!trendsGrid) return;
        trendsGrid.innerHTML = '';

        if (!Array.isArray(items) || items.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'program-card';

          const title = document.createElement('div');
          title.className = 'program-title';
          title.textContent = 'Aucune tendance disponible';

          const meta = document.createElement('div');
          meta.className = 'program-meta';
          meta.textContent = query
            ? `Aucune tendance en cours pour "${query}".`
            : 'Ajoute-les depuis l’admin.';

          empty.appendChild(title);
          empty.appendChild(meta);
          trendsGrid.appendChild(empty);
          return;
        }

        items.forEach((trend) => {
          trendsGrid.appendChild(createTrendCard(trend));
        });
      };

      const refreshTrends = () => {
        if (!trendsGrid) return;
        const query = String(trendsQueryInput?.value || '').trim().toLowerCase();
        const items = !query
          ? allTrends
          : allTrends.filter((trend) => {
              const title = String(trend.title || '').toLowerCase();
              const category = String(trend.category || '').toLowerCase();
              const description = String(trend.description || '').toLowerCase();
              return title.includes(query) || category.includes(query) || description.includes(query);
            });
        renderTrends(items, query);
        const count = items.length;
        const label = count > 1 ? 'tendances' : 'tendance';
        const suffix = query ? ` pour "${query}"` : '';
        setTrendsStatus(`${count} ${label} en cours${suffix}.`);
