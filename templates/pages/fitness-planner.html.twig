      const openExploreSource = (rawUrl) => {
        const source = normalizeVideoSource(rawUrl);
        const target = source.openUrl || source.src;
        if (!target) return false;
        const popup = window.open(target, '_blank', 'noopener');
        return !!popup;
      };

      const isYoutubeVideoAvailable = async (rawUrl) => {
        const source = normalizeVideoSource(rawUrl);
        if (source.type !== 'youtube') return source.type === 'video';
        if (aiVideoValidationCache.has(source.src)) {
          return aiVideoValidationCache.get(source.src);
        }
        try {
          const watchUrl = source.openUrl || rawUrl;
          const endpoint = `https://www.youtube.com/oembed?url=${encodeURIComponent(watchUrl)}&format=json`;
          const response = await fetch(endpoint, { method: 'GET' });
          const ok = response.ok;
          aiVideoValidationCache.set(source.src, ok);
          return ok;
        } catch (error) {
          aiVideoValidationCache.set(source.src, false);
          return false;
        }
      };

      const renderExploreMediaFallback = (media, source, message) => {
        media.innerHTML = '';
        const fallback = document.createElement('div');
        fallback.className = 'explore-media-fallback';

        const label = document.createElement('p');
        label.className = 'explore-media-fallback-label';
        label.textContent = message || 'Lecture indisponible pour le moment.';
        fallback.appendChild(label);

        const actions = document.createElement('div');
        actions.className = 'explore-media-fallback-actions';

        if (source.openUrl) {
          const openBtn = document.createElement('button');
          openBtn.type = 'button';
          openBtn.className = 'explore-fallback-btn';
          openBtn.dataset.action = 'open-source';
          openBtn.textContent = 'Ouvrir la video';
          actions.appendChild(openBtn);
        }

        if (source.type === 'youtube' || source.type === 'video') {
          const retryBtn = document.createElement('button');
          retryBtn.type = 'button';
          retryBtn.className = 'explore-fallback-btn';
          retryBtn.dataset.action = 'retry-media';
          retryBtn.textContent = 'Reessayer';
          actions.appendChild(retryBtn);
        }

        if (actions.childNodes.length) {
          fallback.appendChild(actions);
        }

        media.appendChild(fallback);
      };

      const renderExploreMedia = (slide) => {
        const media = slide.querySelector('.explore-media');
        if (!media) return;

        const videoUrl = slide.dataset.video || '';
        const imageUrl = slide.dataset.image || '';
        const source = normalizeVideoSource(videoUrl);

        if (source.type === 'youtube') {
          media.innerHTML = '';
          const iframe = document.createElement('iframe');
          iframe.src = source.src;
          iframe.title = 'Explore video';
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allow', 'autoplay; encrypted-media');
          iframe.setAttribute('allowfullscreen', 'allowfullscreen');
          iframe.setAttribute('loading', 'lazy');
          iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
          media.appendChild(iframe);

          let loaded = false;
          const timer = window.setTimeout(() => {
            if (loaded) return;
            renderExploreMediaFallback(media, source, 'Video YouTube lente ou bloquee. Ouvre-la directement.');
          }, 7000);

          iframe.addEventListener('load', () => {
            loaded = true;
            clearTimeout(timer);
          }, { once: true });
          return;
        }

        if (source.type === 'video') {
          media.innerHTML = '';
          const video = document.createElement('video');
          video.src = source.src;
          video.autoplay = true;
          video.muted = true;
          video.loop = true;
          video.playsInline = true;
          video.controls = true;
          video.preload = 'metadata';
          video.addEventListener('error', () => {
            renderExploreMediaFallback(media, source, 'Lecture video impossible. Ouvre la source ou reessaye.');
          }, { once: true });
          video.addEventListener('stalled', () => {
            renderExploreMediaFallback(media, source, 'Video en attente trop longue. Ouvre la source ou reessaye.');
          }, { once: true });
          media.appendChild(video);
          return;
        }

        if (source.type === 'external') {
          renderExploreMediaFallback(media, source, 'Source externe detectee. Ouvre la video directement.');
          return;
        }

        if (imageUrl) {
          media.innerHTML = `<img src="${imageUrl}" alt="${slide.dataset.name || 'Exercise'}">`;
          return;
        }

        media.innerHTML = '';
      };

      const createExploreSlide = (item) => {
        const article = document.createElement('article');
        article.className = 'explore-slide';
        article.dataset.name = item.name || 'Exercise';
        article.dataset.video = item.video || '';
        article.dataset.image = item.image || '';
        article.dataset.description = item.tip || 'Garde le dos droit et controle le mouvement.';
        article.dataset.muscle = item.muscle || 'Corps entier';
        article.dataset.difficulty = item.difficulty || 'Beginner';
        article.dataset.duration = String(item.duration || 3);
        article.innerHTML = `
          <div class="explore-media"></div>
          <div class="explore-overlay"></div>
          <div class="explore-content">
            <div class="explore-top">
              <h3>${item.name || 'Exercise'}</h3>
              <div class="explore-badges">
                <span class="explore-badge">${item.muscle || 'Corps entier'}</span>
                <span class="explore-badge">${item.difficulty || 'Beginner'}</span>
                <span class="explore-badge">Sans materiel</span>
              </div>
              <div class="explore-meta">~${item.duration || 3} min a maitriser</div>
            </div>
            <p class="explore-tip">${item.tip || 'Garde le dos droit et controle le mouvement.'}</p>
            <div class="explore-actions">
              <button type="button" class="explore-btn" data-action="favorite">&#10084; Favori</button>
              <button type="button" class="explore-btn" data-action="add">+ Ajouter au plan</button>
              <button type="button" class="explore-btn" data-action="try">30s Essayer</button>
              <button type="button" class="explore-btn" data-action="details">i Details</button>
            </div>
          </div>
        `;
        renderExploreMedia(article);
        return article;
      };

      const stopExploreTryTimer = () => {
        if (exploreTryInterval) {
          clearInterval(exploreTryInterval);
          exploreTryInterval = null;
        }
        if (exploreTryButton) {
          exploreTryButton.textContent = '30s Essayer';
          exploreTryButton.disabled = false;
          exploreTryButton = null;
        }
      };

      const updateExploreProgress = () => {
        const exploreSlides = getExploreSlides();
        if (!exploreFeed || exploreSlides.length === 0) return;
        const rawIndex = Math.round(exploreFeed.scrollTop / Math.max(1, exploreFeed.clientHeight));
        const index = Math.min(Math.max(rawIndex, 0), exploreSlides.length - 1);
        if (exploreCount) {
          exploreCount.textContent = `${index + 1}/${exploreSlides.length}`;
        }
        if (exploreFill) {
          const ratio = (index + 1) / exploreSlides.length;
          exploreFill.style.height = `${Math.max(6, Math.round(ratio * 100))}%`;
        }
      };

      const openExploreDetails = (slide) => {
        const name = slide.dataset.name || 'Exercice';
        const muscle = slide.dataset.muscle || 'Corps entier';
        const difficulty = slide.dataset.difficulty || 'Beginner';
        const duration = slide.dataset.duration || '3';
        const description = slide.dataset.description || '';
        const video = slide.dataset.video || '';
        const source = normalizeVideoSource(video);

        if (source.type === 'video' || source.type === 'youtube') {
          resetHiit();
          startHiit();
          const opened = openVideoModalWithSource(source, {
            title: 'Explore - Details exercice',
            subtitle: `${muscle} - ${difficulty} - ~${duration} min`,
            name
          });
          if (!opened) {
            alert('Impossible d\'ouvrir cette video en incrustation.');
          }
          return;
        }

        if (source.type === 'external') {
          if (!openExploreSource(video)) {
            alert('Impossible d\'ouvrir cette source video.');
          }
          return;
        }

        alert(`${name}\n${muscle} - ${difficulty}\n~${duration} min\n\n${description}`);
      };

      if (exploreFeed) {
        getExploreSlides().forEach((slide) => renderExploreMedia(slide));
        exploreFeed.addEventListener('scroll', updateExploreProgress, { passive: true });
        updateExploreProgress();
      }

      window.addEventListener('resize', updateExploreProgress);

      if (exploreAiGenerate && exploreFeed) {
        exploreAiGenerate.addEventListener('click', async () => {
          const query = String(exploreAiQuery?.value || '').toLowerCase().trim();
          const baseTokens = query.split(/\s+/).filter(Boolean);
          const expandedTokens = new Set(baseTokens);
          baseTokens.forEach((token) => {
            (aiTagAliases[token] || []).forEach((alias) => expandedTokens.add(alias));
          });
          const tokens = Array.from(expandedTokens);
          const ranked = aiVideoLibrary
            .map((entry) => {
              let score = 0;
              tokens.forEach((token) => {
                if (entry.name.toLowerCase().includes(token)) score += 3;
                if (entry.muscle.toLowerCase().includes(token)) score += 4;
                if (entry.difficulty.toLowerCase().includes(token)) score += 2;
                if (entry.tags.some((tag) => tag.includes(token))) score += 5;
              });
              return { entry, score };
            })
            .sort((a, b) => b.score - a.score);

          const rawPool = (tokens.length ? ranked.filter((item) => item.score > 0) : ranked).map((item) => item.entry);
          const pool = rawPool.filter((entry) => {
            const srcType = normalizeVideoSource(entry.video).type;
            return srcType === 'youtube' || srcType === 'video';
          });
          if (pool.length === 0) {
            alert('Aucune video trouvee pour cette demande IA.');
            return;
          }

          const queryKey = tokens.length ? tokens.join('|') : '__all__';
          const poolSignature = pool.map((entry) => entry.name).join('|');
          let state = aiFeedState.get(queryKey);

          if (!state || state.poolSignature !== poolSignature) {
            state = {
              pool,
              poolSignature,
              remaining: buildRemainingQueue(pool, []),
              lastBatchNames: []
            };
            aiFeedState.set(queryKey, state);
          }

          const pickCount = Math.min(5, pool.length);
          const selected = [];
          let guard = 0;
          while (selected.length < pickCount && guard < pool.length * 5) {
            guard += 1;
            if (!state.remaining.length) {
              state.remaining = buildRemainingQueue(state.pool, state.lastBatchNames || []);
            }
            const next = state.remaining.shift();
            if (!next || selected.find((entry) => entry.name === next.name)) {
              continue;
            }
            const available = await isYoutubeVideoAvailable(next.video);
            if (!available) {
              continue;
            }
            selected.push(next);
          }

          if (selected.length === 0) {
            alert('Aucune video YouTube disponible pour cette demande.');
            return;
          }

          state.lastBatchNames = selected.map((entry) => entry.name);

          exploreFeed.innerHTML = '';
          selected.forEach((entry) => {
            exploreFeed.appendChild(createExploreSlide(entry));
          });
          exploreFeed.scrollTop = 0;
          updateExploreProgress();
        });
      }

      if (exploreFeed) {
        exploreFeed.addEventListener('click', (event) => {
          const actionBtn = event.target.closest('[data-action]');
          if (!actionBtn) return;
          const slide = actionBtn.closest('.explore-slide');
          if (!slide) return;

          const action = actionBtn.dataset.action;
          const exerciseName = slide.dataset.name || '';
          const exerciseVideo = slide.dataset.video || '';
          const source = normalizeVideoSource(exerciseVideo);

          if (action === 'retry-media') {
            renderExploreMedia(slide);
            return;
          }

          if (action === 'open-source') {
            if (!openExploreSource(exerciseVideo)) {
              alert('Source video indisponible.');
            }
            return;
          }

          if (action === 'favorite') {
            if (exploreFavorites.has(exerciseName)) {
              exploreFavorites.delete(exerciseName);
              actionBtn.classList.remove('is-active');
              actionBtn.setAttribute('aria-pressed', 'false');
              actionBtn.innerHTML = '&#10084; Favori';
            } else {
              exploreFavorites.add(exerciseName);
              actionBtn.classList.add('is-active');
              actionBtn.setAttribute('aria-pressed', 'true');
              actionBtn.innerHTML = '&#10084; Favori';
            }
            return;
          }

          if (action === 'add') {
            if (!sessionExercises.find((entry) => entry.name === exerciseName)) {
              sessionExercises.push({ name: exerciseName, video: source.type === 'video' ? source.src : '' });
              renderSessionPanel();
            }
            actionBtn.textContent = 'Ajoute au plan';
            return;
          }

          if (action === 'try') {
            stopExploreTryTimer();
            let remaining = 30;
            exploreTryButton = actionBtn;
            exploreTryButton.disabled = true;
            exploreTryButton.textContent = `${remaining}s`;
            exploreTryInterval = setInterval(() => {
              remaining -= 1;
              if (!exploreTryButton) return;
              if (remaining <= 0) {
                stopExploreTryTimer();
                return;
              }
              exploreTryButton.textContent = `${remaining}s`;
            }, 1000);
            return;
          }

          if (action === 'details') {
            openExploreDetails(slide);
          }
        });
      }

      const estimateMinutes = (exerciseCount) => Math.max(0, Math.ceil((exerciseCount * 90) / 60));

      const createPlanOnServer = async (payload) => {
        const body = new URLSearchParams();
        body.set('_token', plannerCsrfToken);
        body.set('title', payload.title || '');
        body.set('place', payload.place || '');
        body.set('program_label', payload.programLabel || '');
        body.set('estimated_minutes', String(payload.estimatedMinutes || 0));
        body.set('exercises', JSON.stringify(payload.exercises || []));

        const response = await fetch(planCreateUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: body.toString()
        });

        const data = await response.json().catch(() => ({ ok: false }));
        if (!response.ok || !data.ok) {
          throw new Error((data && data.error) || 'create_failed');
        }

        return data.plan;
      };

      const deletePlanOnServer = async (planId) => {
        const body = new URLSearchParams();
        body.set('_token', plannerCsrfToken);

        const response = await fetch(planDeleteUrlTemplate.replace('__ID__', String(planId)), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: body.toString()
        });

        const data = await response.json().catch(() => ({ ok: false }));
        if (!response.ok || !data.ok) {
          throw new Error((data && data.error) || 'delete_failed');
        }
      };

      const startConfirmedPlan = (planId) => {
        const plan = confirmedPlans.find((entry) => entry.id === planId);
        if (!plan || !Array.isArray(plan.exercises) || plan.exercises.length === 0) return;
        selectedProgram = plan.program || '';
        selectedPlace = plan.place || '';
        sessionExercises = plan.exercises.map((exercise) => ({
          name: exercise.name || '',
          video: exercise.video || ''
        }));
        renderSessionPanel();
        openSessionExercise(0);
      };

      const deleteConfirmedPlan = async (planId) => {
        if (!plansPersistAvailable) {
          confirmedPlans = confirmedPlans.filter((entry) => String(entry.id) !== String(planId));
          saveLocalPlans();
          renderConfirmedPlans();
          return;
        }

        try {
          await deletePlanOnServer(planId);
          confirmedPlans = confirmedPlans.filter((entry) => String(entry.id) !== String(planId));
          renderConfirmedPlans();
        } catch (error) {
          alert('Suppression impossible pour le moment.');
        }
      };

      const renderConfirmedPlans = () => {
        if (!userPlansList) return;
        userPlansList.innerHTML = '';

        if (!confirmedPlans.length) {
          const empty = document.createElement('article');
          empty.className = 'program-card';
          empty.innerHTML = `
            <h3 class="program-title">Mes seances confirmees</h3>
            <div class="program-meta">Confirme une seance depuis le panneau "Ma seance" pour la retrouver ici.</div>
          `;
          userPlansList.appendChild(empty);
          return;
        }

        confirmedPlans.forEach((plan) => {
          const card = document.createElement('article');
          card.className = 'program-card';

          const title = document.createElement('h3');
          title.className = 'program-title';
          title.textContent = plan.title || 'Seance personnalisee';
          card.appendChild(title);

          const meta = document.createElement('div');
          meta.className = 'program-meta';
          const locationText = [plan.program || 'Programme libre', plan.place || 'Lieu libre'].join(' - ');
          meta.textContent = `${locationText} - ${estimateMinutes((plan.exercises || []).length)} min`;
          card.appendChild(meta);

          const list = document.createElement('ul');
          list.className = 'fp-user-plan-list';
          (plan.exercises || []).forEach((exercise) => {
            const item = document.createElement('li');
            item.textContent = exercise.name || 'Exercice';
            list.appendChild(item);
          });
          card.appendChild(list);

          const actions = document.createElement('div');
          actions.className = 'program-actions';

          const startBtn = document.createElement('button');
          startBtn.type = 'button';
          startBtn.className = 'fitness-btn fitness-btn-primary';
          startBtn.textContent = 'Commencer';
          startBtn.addEventListener('click', () => startConfirmedPlan(plan.id));

          const deleteBtn = document.createElement('button');
          deleteBtn.type = 'button';
          deleteBtn.className = 'fitness-btn fitness-btn-danger';
          deleteBtn.textContent = 'Supprimer';
          deleteBtn.addEventListener('click', () => {
            deleteConfirmedPlan(plan.id);
          });

          actions.appendChild(startBtn);
          actions.appendChild(deleteBtn);
          card.appendChild(actions);

          userPlansList.appendChild(card);
        });
      };

      const confirmCurrentSession = async () => {
        if (sessionExercises.length === 0) {
          alert('Ajoute des exercices a ta seance.');
          return;
        }

        if (!plansPersistAvailable) {
          const localPlan = {
            id: buildLocalPlanId(),
            title: `Ma seance (${sessionExercises.length} exercices)`,
            program: selectedProgram || '',
            place: selectedPlace || '',
            exercises: sessionExercises.map((exercise) => ({
              name: exercise.name,
              video: exercise.video || ''
            }))
          };
          confirmedPlans.unshift(localPlan);
          saveLocalPlans();
          renderConfirmedPlans();
          setView('plans');
          syncViewInUrl('plans');
          closeExerciseModal();
          closeLevelModal();
          closeModal();
          return;
        }

        const payload = {
          title: `Ma seance (${sessionExercises.length} exercices)`,
          programLabel: selectedProgram || '',
          place: selectedPlace || '',
          estimatedMinutes: estimateMinutes(sessionExercises.length),
          exercises: sessionExercises.map((exercise) => ({
            name: exercise.name,
            video: exercise.video || ''
          }))
        };

        try {
          const savedPlan = await createPlanOnServer(payload);
          confirmedPlans.unshift(savedPlan);
          renderConfirmedPlans();
          setView('plans');
          syncViewInUrl('plans');
          closeExerciseModal();
          closeLevelModal();
          closeModal();
        } catch (error) {
          if (String(error.message || '').includes('unauthorized')) {
            alert('Tu dois être connecté pour confirmer une séance.');
            return;
          }
          alert('Confirmation impossible pour le moment.');
        }
      };

      const stopSessionRestTimer = () => {
        if (sessionRestTimer) {
          clearInterval(sessionRestTimer);
          sessionRestTimer = null;
        }
      };

      const startSessionRestTimer = () => {
        if (!sessionRest) return;
        stopSessionRestTimer();
        let remaining = 60;
        sessionRest.textContent = `Timer repos : ${remaining}s`;
        sessionRestTimer = setInterval(() => {
          remaining -= 1;
          sessionRest.textContent = `Timer repos : ${remaining}s`;
          if (remaining <= 0) {
            stopSessionRestTimer();
          }
        }, 1000);
      };

      const openSessionExercise = (index) => {
        if (!sessionExercises.length) return;
        sessionIndex = Math.min(Math.max(index, 0), sessionExercises.length - 1);
        const current = sessionExercises[sessionIndex];
        const source = normalizeVideoSource(current.video || '');
        if (sessionProgress) {
          sessionProgress.textContent = `Progression (${sessionIndex + 1}/${sessionExercises.length})`;
        }

        if (source.type === 'external') {
          if (!openExploreSource(current.video)) {
            alert('Source video indisponible.');
          }
          return;
        }

        if (source.type !== 'video' && source.type !== 'youtube') {
          alert('Aucune video disponible pour cet exercice.');
          return;
        }

        const opened = openVideoModalWithSource(source, {
          title: "Session d'entrainement",
          subtitle: [selectedProgram, selectedPlace, selectedDifficulty].filter(Boolean).join(' - '),
          name: current.name,
          image: ({{ exerciseImageMapJs|json_encode|raw }})[current.name] || '',
          description: 'Video demo, timer and integrated playlist'
        });
        if (!opened) {
          alert('Impossible d\'ouvrir cette video en incrustation.');
          return;
        }
        startSessionRestTimer();
      };

      if (sessionStart) {
        sessionStart.addEventListener('click', () => {
          confirmCurrentSession();
        });
      }

      if (sessionNext) {
        sessionNext.addEventListener('click', () => {
          if (sessionExercises.length === 0) return;
          const nextIndex = Math.min(sessionIndex + 1, sessionExercises.length - 1);
          openSessionExercise(nextIndex);
        });
      }

      if (sessionClear) {
        sessionClear.addEventListener('click', () => {
          sessionExercises = [];
          renderSessionPanel();
        });
      }

      const premiumExploreQuery = document.getElementById('fp-explore-ai-query');
      const premiumExploreFilterBtn = document.getElementById('fp-explore-ai-generate');
      const premiumExploreResetBtn = document.getElementById('fp-explore-reset');
      const premiumExplorePlaylist = document.getElementById('fp-explore-playlist');
      const premiumExploreStageMedia = document.getElementById('fp-explore-stage-media');
      const premiumExploreCaption = document.getElementById('fp-explore-stage-caption');
      const premiumExploreCountLine = document.getElementById('fp-explore-count-line');
      const premiumExploreNowPlaying = document.getElementById('fp-explore-now-playing');
      const premiumExplorePrev = document.getElementById('fp-explore-prev');
      const premiumExplorePlay = document.getElementById('fp-explore-play');
      const premiumExploreNext = document.getElementById('fp-explore-next');
      const premiumExploreMute = document.getElementById('fp-explore-mute');
      const premiumExploreVolume = document.getElementById('fp-explore-volume');
      const premiumExploreLike = document.getElementById('fp-explore-like');

      const premiumExploreLibrary = [
        { id: 'back-home-5', title: 'Back Intense at Home - 5 min', desc: 'Workout dos intense 5 min sans equipement.', meta: 'Dos | Maison | 5 min', category: 'dos', sourceType: 'video', src: '{{ asset('videos/fitness/local/back-home-5min.mp4') }}' },
        { id: 'circuit-abdos-20', title: 'Circuit Abdos Complet - 20 min', desc: 'Circuit abdos complet a suivre en temps reel.', meta: 'Abdos | Core | 20 min', category: 'abdos', sourceType: 'video', src: '{{ asset('videos/fitness/local/abdos-complet-20min.mp4') }}' },
        { id: 'pectoraux-builder', title: 'Pectoraux Muscles - 5 min', desc: 'Entrainement pectoraux a la maison.', meta: 'Poitrine | Maison | 5 min', category: 'poitrine', sourceType: 'video', src: '{{ asset('videos/fitness/local/pectoraux-5min.mp4') }}' },
        { id: 'triceps-dumbbells', title: 'Triceps Workout - Dumbbells 10 min', desc: '10 min de triceps avec halteres.', meta: 'Triceps | Halteres | 10 min', category: 'triceps', sourceType: 'video', src: '{{ asset('videos/fitness/local/triceps-dumbbells-10min.mp4') }}' },
        { id: 'biceps-burning', title: 'Biceps Burning - 15 min', desc: '15 min de biceps avec halteres par Caroline Girvan.', meta: 'Biceps | Halteres | 15 min', category: 'biceps', sourceType: 'video', src: '{{ asset('videos/fitness/local/biceps-15min.mp4') }}' },
        { id: 'chest-youtube', title: 'Chest Workout - Poitrine Builder', desc: 'Seance poitrine complete pour debutants.', meta: 'Poitrine | YouTube | Gym', category: 'poitrine', sourceType: 'youtube', youtubeId: 'IODxDxX7oi4' },
        { id: 'dos-strong-flow', title: 'Dos Strong Flow', desc: 'Renforcement du dos, colonne neutre.', meta: 'Dos | YouTube | Posture', category: 'dos', sourceType: 'youtube', youtubeId: 'roCP6wCXPqo' },
        { id: 'jambes-power-squat', title: 'Jambes Power Squat', desc: 'Squats et fentes pour des jambes puissantes.', meta: 'Jambes | YouTube | Force', category: 'jambes', sourceType: 'youtube', youtubeId: 'aclHkVaku9U' },
        { id: 'fessier-focus', title: 'Fessier Focus - Hip Thrust', desc: 'Contracte les fessiers en haut du mouvement.', meta: 'Fessier | YouTube | Maison', category: 'fessier', sourceType: 'youtube', youtubeId: 'Xyd_fa5zoEU' },
        { id: 'epaules-sculpt', title: 'Epaules Sculpt', desc: 'Amplitude controlee, ne monte pas les epaules.', meta: 'Epaules | YouTube | Halteres', category: 'epaules', sourceType: 'youtube', youtubeId: 'qEwKCR5JCog' },
        { id: 'abdos-core-10', title: 'Abdos Core 10 min', desc: '10 min de core intense, dos colle au sol.', meta: 'Abdos | YouTube | Core', category: 'abdos', sourceType: 'youtube', youtubeId: 'AnYl6Nk9GOA' },
        { id: 'corps-entier-hiit', title: 'Corps Entier HIIT', desc: 'Full body haute intensite, respire en rythme.', meta: 'HIIT | YouTube | Corps entier', category: 'hiit', sourceType: 'youtube', youtubeId: 'ml6cT4AZdqI' }
      ];

      let premiumExploreItems = [...premiumExploreLibrary];
      let premiumExploreIndex = 0;
      let premiumExploreLikes = Number(window.localStorage?.getItem('fp_explore_like_count') || '0') || 0;
      let premiumExplorePlayer = null;
      let premiumExplorePlayerType = 'none';
      let premiumExploreYoutubeReady = null;
      let premiumExploreMountVersion = 0;

      const renderPremiumExploreLike = () => {
        if (premiumExploreLike) {
          premiumExploreLike.textContent = `❤️ ${premiumExploreLikes}`;
        }
      };

      const loadPremiumExploreYoutubeApi = () => {
        if (window.YT?.Player) {
          return Promise.resolve(window.YT);
        }

        if (premiumExploreYoutubeReady) {
          return premiumExploreYoutubeReady;
        }

        premiumExploreYoutubeReady = new Promise((resolve, reject) => {
          const previousHandler = window.onYouTubeIframeAPIReady;
          window.onYouTubeIframeAPIReady = () => {
            if (typeof previousHandler === 'function') {
              previousHandler();
            }
            resolve(window.YT);
          };

          const existingScript = document.querySelector('script[data-fp-youtube-api="true"]');
          if (existingScript) {
            window.setTimeout(() => {
              if (window.YT?.Player) {
                resolve(window.YT);
              }
            }, 50);
            return;
          }

          const script = document.createElement('script');
          script.src = 'https://www.youtube.com/iframe_api';
          script.async = true;
          script.dataset.fpYoutubeApi = 'true';
          script.onerror = () => reject(new Error('YouTube API load failed'));
          document.head.appendChild(script);
        });

        return premiumExploreYoutubeReady;
      };

      const destroyPremiumExplorePlayer = () => {
        if (premiumExplorePlayerType === 'video' && premiumExplorePlayer?.pause) {
          premiumExplorePlayer.pause();
        }
        if (premiumExplorePlayerType === 'youtube' && premiumExplorePlayer?.destroy) {
          premiumExplorePlayer.destroy();
        }
        premiumExplorePlayer = null;
        premiumExplorePlayerType = 'none';
      };

      const mountPremiumExploreVideo = (item) => {
        if (!premiumExploreStageMedia) return;
        premiumExploreMountVersion += 1;
        const mountVersion = premiumExploreMountVersion;
        destroyPremiumExplorePlayer();
        premiumExploreStageMedia.innerHTML = '';
        if (item.sourceType === 'youtube' && item.youtubeId) {
          const mount = document.createElement('div');
          mount.id = `fp-explore-youtube-${item.id}`;
          premiumExploreStageMedia.appendChild(mount);
          premiumExplorePlayerType = 'youtube';
          if (premiumExplorePlay) premiumExplorePlay.textContent = 'Pause';
          if (premiumExploreMute) premiumExploreMute.textContent = 'Mute';

          loadPremiumExploreYoutubeApi()
            .then(() => {
              if (mountVersion !== premiumExploreMountVersion || !document.getElementById(mount.id)) {
                return;
              }
              premiumExplorePlayer = new window.YT.Player(mount.id, {
                videoId: item.youtubeId,
                playerVars: {
                  autoplay: 1,
                  controls: 1,
                  rel: 0,
                  playsinline: 1,
                  modestbranding: 1
                },
                events: {
                  onReady: (event) => {
                    try {
                      event.target.setVolume(Math.round(Number(premiumExploreVolume?.value || '0.8') * 100));
                      event.target.unMute();
                      event.target.playVideo();
                    } catch (error) {}
                  },
                  onStateChange: (event) => {
                    if (!premiumExplorePlay) return;
                    if (event.data === window.YT.PlayerState.PLAYING) {
                      premiumExplorePlay.textContent = 'Pause';
                    }
                    if (event.data === window.YT.PlayerState.PAUSED || event.data === window.YT.PlayerState.ENDED) {
                      premiumExplorePlay.textContent = 'Play';
                    }
                  }
                }
              });
            })
            .catch(() => {
              premiumExploreStageMedia.innerHTML = '<div class="explore-media-fallback"><p class="explore-media-fallback-label">Impossible de charger la video YouTube pour le moment.</p></div>';
            });
          return;
        }

        const video = document.createElement('video');
        video.src = item.src;
        video.autoplay = true;
        video.loop = false;
        video.controls = false;
        video.muted = false;
        video.playsInline = true;
        video.preload = 'metadata';
        video.volume = Number(premiumExploreVolume?.value || '0.8');
        premiumExploreStageMedia.appendChild(video);
        premiumExplorePlayer = video;
        premiumExplorePlayerType = 'video';
        video.play().catch(() => {});
        if (premiumExplorePlay) premiumExplorePlay.textContent = 'Pause';
        if (premiumExploreMute) premiumExploreMute.textContent = video.muted ? 'Unmute' : 'Mute';
      };

      const setPremiumExploreActive = (index) => {
        if (!premiumExploreItems.length) {
          destroyPremiumExplorePlayer();
          if (premiumExplorePlaylist) premiumExplorePlaylist.innerHTML = '';
          if (premiumExploreStageMedia) premiumExploreStageMedia.innerHTML = '<div class="explore-media-fallback"><p class="explore-media-fallback-label">Aucune video ne correspond a ce filtre.</p></div>';
          if (premiumExploreCaption) premiumExploreCaption.textContent = 'Aucune video';
          if (premiumExploreNowPlaying) premiumExploreNowPlaying.textContent = 'Aucune video disponible';
          if (premiumExploreCountLine) premiumExploreCountLine.textContent = '0 videos disponibles';
          return;
        }

        premiumExploreIndex = ((index % premiumExploreItems.length) + premiumExploreItems.length) % premiumExploreItems.length;
        const current = premiumExploreItems[premiumExploreIndex];
        mountPremiumExploreVideo(current);
        if (premiumExploreCaption) premiumExploreCaption.textContent = current.title;
        if (premiumExploreNowPlaying) premiumExploreNowPlaying.textContent = current.title;
        if (premiumExploreCountLine) premiumExploreCountLine.textContent = `${premiumExploreItems.length} videos disponibles`;

        Array.from(premiumExplorePlaylist?.querySelectorAll('.explore-playlist-item') || []).forEach((node, nodeIndex) => {
          node.classList.toggle('is-active', nodeIndex === premiumExploreIndex);
        });
      };

      const renderPremiumExplorePlaylist = () => {
        if (!premiumExplorePlaylist) return;
        premiumExplorePlaylist.innerHTML = '';
        premiumExploreItems.forEach((item, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'explore-playlist-item';
          const prefix = item.sourceType === 'youtube' ? '[>]' : '[V]';
          button.innerHTML = `
            <div class="explore-playlist-title"><span class="explore-playlist-prefix">${prefix}</span>${item.title}</div>
            <div class="explore-playlist-meta">${item.meta}</div>
          `;
          button.addEventListener('click', () => setPremiumExploreActive(index));
          premiumExplorePlaylist.appendChild(button);
        });
        setPremiumExploreActive(0);
      };

      const filterPremiumExplore = () => {
        const query = String(premiumExploreQuery?.value || '').trim().toLowerCase();
        premiumExploreItems = premiumExploreLibrary.filter((item) => {
          if (query === '') return true;
          return `${item.title} ${item.desc} ${item.meta} ${item.category}`.toLowerCase().includes(query);
        });
        renderPremiumExplorePlaylist();
      };

      if (premiumExplorePlaylist && premiumExploreStageMedia) {
        renderPremiumExplorePlaylist();
        renderPremiumExploreLike();

        premiumExploreFilterBtn?.addEventListener('click', filterPremiumExplore);
        premiumExploreQuery?.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            filterPremiumExplore();
          }
        });
        premiumExploreResetBtn?.addEventListener('click', () => {
          if (premiumExploreQuery) premiumExploreQuery.value = '';
          premiumExploreItems = [...premiumExploreLibrary];
          renderPremiumExplorePlaylist();
        });
        premiumExplorePrev?.addEventListener('click', () => setPremiumExploreActive(premiumExploreIndex - 1));
        premiumExploreNext?.addEventListener('click', () => setPremiumExploreActive(premiumExploreIndex + 1));
        premiumExplorePlay?.addEventListener('click', () => {
          if (!premiumExplorePlayer) return;
          if (premiumExplorePlayerType === 'youtube' && window.YT?.PlayerState) {
            const state = premiumExplorePlayer.getPlayerState?.();
            if (state === window.YT.PlayerState.PLAYING) {
              premiumExplorePlayer.pauseVideo?.();
              premiumExplorePlay.textContent = 'Play';
            } else {
              premiumExplorePlayer.playVideo?.();
              premiumExplorePlay.textContent = 'Pause';
            }
            return;
          }
          if (premiumExplorePlayer.paused) {
            premiumExplorePlayer.play().catch(() => {});
            premiumExplorePlay.textContent = 'Pause';
          } else {
            premiumExplorePlayer.pause();
            premiumExplorePlay.textContent = 'Play';
          }
        });
        premiumExploreMute?.addEventListener('click', () => {
          if (!premiumExplorePlayer) return;
          if (premiumExplorePlayerType === 'youtube') {
            const muted = premiumExplorePlayer.isMuted?.();
            if (muted) {
              premiumExplorePlayer.unMute?.();
              premiumExploreMute.textContent = 'Mute';
            } else {
              premiumExplorePlayer.mute?.();
              premiumExploreMute.textContent = 'Unmute';
            }
            return;
          }
          premiumExplorePlayer.muted = !premiumExplorePlayer.muted;
          premiumExploreMute.textContent = premiumExplorePlayer.muted ? 'Unmute' : 'Mute';
        });
        premiumExploreVolume?.addEventListener('input', () => {
          if (!premiumExplorePlayer) return;
          if (premiumExplorePlayerType === 'youtube') {
            premiumExplorePlayer.setVolume?.(Math.round(Number(premiumExploreVolume.value || '0.8') * 100));
            return;
          }
          premiumExplorePlayer.volume = Number(premiumExploreVolume.value || '0.8');
        });
        premiumExploreLike?.addEventListener('click', () => {
          premiumExploreLikes += 1;
          try {
            window.localStorage?.setItem('fp_explore_like_count', String(premiumExploreLikes));
          } catch (error) {
            // Ignore storage issues.
          }
          renderPremiumExploreLike();
        });
      }

      renderConfirmedPlans();
      renderSessionPanel();

    });
  </script>
{% endblock %}























