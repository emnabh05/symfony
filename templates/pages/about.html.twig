{% extends 'base.html.twig' %}

{% block title %}About Fitopia{% endblock %}

{% block stylesheets %}
<style>
  :root {
    --about-bg: #f5f7fb;
    --about-card: #ffffff;
    --about-border: #e6edf5;
    --about-text: #1f2937;
    --about-muted: #5f6b7a;
    --about-accent: #0b3a3d;
    --about-accent-2: #0f7a5f;
  }
  .about-page { background: var(--about-bg); padding: 2.5rem 0 3.5rem; }
  .about-wrap { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
  .about-hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2rem;
    align-items: center;
    background: var(--about-card);
    border-radius: 18px;
    border: 1px solid var(--about-border);
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }
  .about-hero img { width: 100%; height: 100%; object-fit: cover; }
  .hero-copy { padding: 2rem; }
  .hero-copy h1 { font-weight: 800; color: var(--about-text); }
  .hero-copy h3 { color: var(--about-accent); font-weight: 700; }
  .hero-copy p { color: var(--about-muted); margin-top: 1rem; }
  .section {
    margin-top: 2.5rem;
  }
  .section-title {
    font-weight: 800;
    color: var(--about-text);
    margin-bottom: 1rem;
  }
  .section-sub {
    color: var(--about-muted);
    margin-bottom: 1.25rem;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .card {
    background: var(--about-card);
    border-radius: 16px;
    border: 1px solid var(--about-border);
    padding: 1.4rem;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 30px rgba(15, 23, 42, 0.12);
  }
  .icon-badge {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #e8f3f0;
    color: var(--about-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    margin-bottom: 0.6rem;
    box-shadow: 0 8px 18px rgba(11, 58, 61, 0.12);
  }
  .icon-badge i {
    font-size: 1rem;
  }
  .story-wrap {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2rem;
    align-items: center;
  }
  .story-img img {
    width: 100%;
    border-radius: 16px;
    object-fit: cover;
  }
  .value-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }
  .value-list li {
    padding: 0.45rem 0;
    color: var(--about-muted);
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .team-card {
    background: var(--about-card);
    border-radius: 16px;
    border: 1px solid var(--about-border);
    padding: 1.4rem;
    text-align: center;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .team-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 30px rgba(15, 23, 42, 0.12);
  }
  .team-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    margin: 0 auto 0.8rem;
    object-fit: cover;
    border: 4px solid #eef6f4;
  }
  .cta {
    margin-top: 2.5rem;
    background: linear-gradient(135deg, #0b3a3d, #0f7a5f);
    color: #fff;
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cta h3 { margin: 0; font-weight: 800; }
  .cta a {
    background: #fff;
    color: var(--about-accent);
    border-radius: 999px;
    padding: 0.6rem 1.3rem;
    font-weight: 700;
    text-decoration: none;
  }
  .cta button {
    background: #fff;
    color: var(--about-accent);
    border-radius: 999px;
    padding: 0.6rem 1.3rem;
    font-weight: 700;
    border: none;
  }
  .cta-modal {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1100;
  }
  .cta-modal.show {
    display: flex;
    animation: fadeIn 0.25s ease;
  }
  .cta-modal-card {
    background: #fff;
    border-radius: 18px;
    padding: 2rem;
    width: min(560px, 92vw);
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.25);
    text-align: center;
    transform: translateY(10px);
    animation: slideUp 0.35s ease forwards;
  }
  .cta-modal-card h4 {
    font-weight: 800;
    color: var(--about-accent);
    margin-bottom: 0.5rem;
  }
  .cta-modal-card p {
    color: var(--about-muted);
    margin-bottom: 1.5rem;
  }
  .cta-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-actions a {
    border-radius: 10px;
    padding: 0.6rem 1.2rem;
    font-weight: 700;
    text-decoration: none;
  }
  .cta-login {
    background: var(--about-accent);
    color: #fff;
  }
  .cta-register {
    background: #fff;
    border: 1px solid var(--about-accent);
    color: var(--about-accent);
  }
  .cta-close {
    position: absolute;
    right: 16px;
    top: 14px;
    background: transparent;
    border: none;
    font-size: 1.2rem;
    color: #64748b;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slideUp {
    to { transform: translateY(0); }
  }
  @media (max-width: 991px) {
    .about-hero,
    .story-wrap,
    .card-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
{% endblock %}

{% block body %}
<section class="about-page">
  <div class="about-wrap">
    <div class="about-hero">
      <img src="{{ asset('images/FITOPIA_logo_2000x1333.png') }}" alt="Fitopia hero">
      <div class="hero-copy">
        <h1>About Fitopia</h1>
        <h3>Where your well-being takes shape</h3>
        <p>
          Fitopia is a digital health and well-being platform designed to help people
          adopt sustainable, healthy habits by centralizing nutrition, fitness, and
          personal progress in one intuitive solution.
        </p>
      </div>
    </div>

    <div class="section">
      <div class="story-wrap">
        <div class="story-img">
          <img src="{{ asset('images/image_2.jpg') }}" alt="Our story">
        </div>
        <div>
          <h2 class="section-title">Our Story</h2>
          <p class="section-sub">
            Fitopia was born from a simple observation: managing health today often means
            using multiple disconnected apps. Nutrition here, workouts there, motivation
            lost along the way. We created Fitopia to unify everything into one personalized,
            motivating, and human-centered platform.
          </p>
          <div class="card-grid">
            <div class="card">
              <div class="icon-badge"><i class="fa fa-puzzle-piece"></i></div>
              <strong>Fragmented tools</strong>
              <p class="section-sub">Nutrition here, fitness there, motivation suffers.</p>
            </div>
            <div class="card">
              <div class="icon-badge"><i class="fa fa-battery-half"></i></div>
              <strong>Motivation drops</strong>
              <p class="section-sub">Without personalization, engagement fades.</p>
            </div>
            <div class="card">
              <div class="icon-badge"><i class="fa fa-link"></i></div>
              <strong>No central hub</strong>
              <p class="section-sub">No easy way to connect with professionals in one place.</p>
            </div>
            <div class="card">
              <div class="icon-badge"><i class="fa fa-users"></i></div>
              <strong>No central hub</strong>
              <p class="section-sub">No easy way to connect with professionals in one place.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <h2 class="section-title">Our Mission &amp; Vision</h2>
      <div class="card-grid">
        <div class="card">
          <div class="icon-badge"><i class="fa fa-bullseye"></i></div>
          <strong>Our Mission</strong>
          <p class="section-sub">
            To help users improve their health sustainably by offering a personalized,
            centralized, and motivating digital experience.
          </p>
        </div>
        <div class="card">
          <div class="icon-badge"><i class="fa fa-globe"></i></div>
          <strong>Our Vision</strong>
          <p class="section-sub">
            We believe technology should empower healthier lifestyles, not complicate them.
            Fitopia aims to become a trusted companion for everyday well-being.
          </p>
        </div>
      </div>
    </div>

    <div class="section">
      <h2 class="section-title">What Makes Fitopia Different</h2>
      <div class="card-grid">
        <div class="card">
          <div class="icon-badge"><i class="fa fa-th-large"></i></div>
          <strong>All-in-one platform</strong>
          <p class="section-sub">Nutrition, fitness, and progress tracking.</p>
        </div>
        <div class="card">
          <div class="icon-badge"><i class="fa fa-sliders"></i></div>
          <strong>Personalized goals &amp; tracking</strong>
          <p class="section-sub">Custom plans adapted to each user.</p>
        </div>
        <div class="card">
          <div class="icon-badge"><i class="fa fa-life-ring"></i></div>
          <strong>Professional support</strong>
          <p class="section-sub">Coaches and nutritionists just a click away.</p>
        </div>
        <div class="card">
          <div class="icon-badge"><i class="fa fa-comments"></i></div>
          <strong>Community interaction</strong>
          <p class="section-sub">Forum and blog for support and inspiration.</p>
        </div>
        <div class="card">
          <div class="icon-badge"><i class="fa fa-desktop"></i></div>
          <strong>Web + Desktop</strong>
          <p class="section-sub">Synchronized experience across platforms.</p>
        </div>
      </div>
    </div>

    <div class="section">
      <h2 class="section-title">Our Impact &amp; Values</h2>
      <div class="card-grid">
        <div class="card">
          <strong>Our Values</strong>
          <ul class="value-list">
            <li>Health &amp; well-being</li>
            <li>Motivation &amp; consistency</li>
            <li>Accessibility</li>
            <li>Data security &amp; trust</li>
          </ul>
        </div>
        <div class="card">
          <strong>Sustainable Development</strong>
          <p class="section-sub">
            Fitopia contributes to the UN Sustainable Development Goal 3: Good Health and
            Well-Being, by encouraging healthy habits through accessible digital solutions.
          </p>
        </div>
      </div>
    </div>

    <div class="section">
      <h2 class="section-title">Meet the Team</h2>
      <div class="team-grid">
        <div class="team-card">
          <img class="team-avatar" src="{{ asset('images/person-1.jpg') }}" alt="Med Omar Selmi">
          <strong>Med Omar Selmi</strong>
          <div class="section-sub">QA &amp; Testing</div>
          <small class="text-muted">Responsible for ensuring a smooth project workflow and delivery.</small>
        </div>
        <div class="team-card">
          <img class="team-avatar" src="{{ asset('images/person-2.jpg') }}" alt="Emna Ben Hassine">
          <strong>Emna Ben Hassine</strong>
          <div class="section-sub">Developer</div>
          <small class="text-muted">Developing and maintaining the Fitopia platform.</small>
        </div>
        <div class="team-card">
          <img class="team-avatar" src="{{ asset('images/person-3.jpg') }}" alt="Sarah Jardak">
          <strong>Sarah Jardak</strong>
          <div class="section-sub">Project Manager</div>
          <small class="text-muted">Responsible for ensuring a smooth project workflow and delivery.</small>
        </div>
        <div class="team-card">
          <img class="team-avatar" src="{{ asset('images/staff-4.jpg') }}" alt="Ali Touati">
          <strong>Ali Touati</strong>
          <div class="section-sub">UI/UX Designer</div>
          <small class="text-muted">Designing intuitive and user-friendly app experiences.</small>
        </div>
        <div class="team-card">
          <img class="team-avatar" src="{{ asset('images/staff-5.jpg') }}" alt="Ahmed Chebbi">
          <strong>Ahmed Chebbi</strong>
          <div class="section-sub">Community &amp; Marketing</div>
          <small class="text-muted">Building engagement and community growth.</small>
        </div>
        <div class="team-card">
          <img class="team-avatar" src="{{ asset('images/staff-6.jpg') }}" alt="Rania Landolsi">
          <strong>Rania Landolsi</strong>
          <div class="section-sub">Documentation &amp; Content</div>
          <small class="text-muted">Creating clear documentation and content experiences.</small>
        </div>
      </div>
    </div>

    <div class="cta">
      <div>
        <h3>Ready to shape your well-being with Fitopia?</h3>
        <p class="mb-0">Join the community and start your personalized journey today.</p>
      </div>
      <button type="button" id="cta-get-started-btn">Get Started</button>
    </div>
  </div>
</section>
<div class="cta-modal" id="cta-modal">
  <div class="cta-modal-card">
    <button class="cta-close" type="button" id="cta-close-btn">&times;</button>
    <h4>Welcome to Fitopia</h4>
    <p>Do you already have an account, or would you like to join us?</p>
    <div class="cta-actions">
      <a class="cta-login" href="{{ path('app_login') }}">I have an account</a>
      <a class="cta-register" href="{{ path('app_register') }}">Create new account</a>
    </div>
  </div>
</div>
{% endblock %}

{% block footer %}{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('cta-get-started-btn');
    const modal = document.getElementById('cta-modal');
    const closeBtn = document.getElementById('cta-close-btn');
    if (!btn || !modal || !closeBtn) return;
    btn.addEventListener('click', () => {
      modal.classList.add('show');
    });
    closeBtn.addEventListener('click', () => {
      modal.classList.remove('show');
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.remove('show');
    });
  });
</script>
{% endblock %}
