{% extends 'base.html.twig' %}

{% block title %}About Fitopia{% endblock %}

{% block stylesheets %}
<style>
  :root {
    --f-green: #15996a;
    --f-dark: #13231d;
    --f-muted: #5f756d;
    --f-bg-light: #f7fbf8;
    --f-card-bg: #ffffff;
    --f-border: #e3eee7;
  }

  .about-container {
    background-color: #ffffff;
    padding: 40px 0;
  }

  .about-shell {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .about-hero-box {
    display: flex;
    background: linear-gradient(to bottom right, #f8fcfa, #edf5f0);
    border-radius: 28px;
    border: 1px solid var(--f-border);
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.08);
  }

  .hero-copy-box {
    padding: 50px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero-kicker {
    color: var(--f-green);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hero-title {
    color: var(--f-dark);
    font-size: 50px;
    font-weight: 400;
    line-height: 1.2;
  }

  .hero-subtitle {
    color: var(--f-muted);
    font-size: 18px;
    font-weight: 600;
  }

  .hero-desc {
    color: var(--f-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .hero-visual {
    width: 520px;
    background-size: cover;
    background-position: center;
  }

  .stats-row {
    display: flex;
    gap: 18px;
  }

  .stat-pill {
    flex: 1;
    background: linear-gradient(to bottom, #ffffff, #f8fcfa);
    border-radius: 22px;
    border: 1px solid var(--f-border);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-number {
    color: var(--f-green);
    font-size: 26px;
    font-weight: 800;
  }

  .stat-label {
    color: var(--f-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .story-box {
    display: flex;
    gap: 22px;
    background: linear-gradient(to bottom, #f7f9fc, #eff3f8);
    border-radius: 28px;
    border: 1px solid #e1e8f0;
    overflow: hidden;
    padding: 0;
  }

  .story-visual {
    width: 320px;
    background-size: cover;
    background-position: center;
  }

  .story-copy {
    flex: 1;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .section-title-dark {
    color: #172554;
    font-size: 34px;
    font-weight: 800;
  }

  .section-copy {
    color: #5b6777;
    font-size: 15px;
    line-height: 1.6;
  }

  .points-grid {
    display: flex;
    gap: 16px;
    margin-top: 10px;
  }

  .point-card {
    flex: 1;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e6edf5;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mini-badge {
    background: #e8f3f0;
    color: #0b3a3d;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 800;
    width: fit-content;
    font-size: 12px;
  }

  .dual-grid {
    display: flex;
    gap: 18px;
  }

  .dual-card {
    flex: 1;
    background: linear-gradient(to bottom, #ffffff, #f8fcfa);
    border-radius: 22px;
    border: 1px solid var(--f-border);
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .features-shell {
    background: linear-gradient(to bottom, #f7fcf9, #eef8f2);
    border-radius: 24px;
    border: 1px solid #e0ede5;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .features-grid {
    display: flex;
    gap: 18px;
  }

  .feature-card-clean {
    flex: 1;
    background: #ffffff;
    border-radius: 22px;
    border: 1px solid #e5efe9;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 0 18px 36px rgba(15, 23, 42, 0.05);
  }

  .team-shell {
    background: linear-gradient(to bottom, #f7f9fc, #eff3f8);
    border-radius: 24px;
    border: 1px solid #e1e8f0;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .team-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    justify-content: center;
  }

  .team-card {
    width: calc(33.333% - 12px);
    min-width: 200px;
    background: #ffffff;
    border-radius: 22px;
    border: 1px solid #e6edf5;
    padding: 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    box-shadow: 0 18px 36px rgba(15, 23, 42, 0.05);
  }

  .team-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #f1f5f9;
  }

  .team-name {
    color: #172554;
    font-weight: 800;
    font-size: 18px;
  }

  .team-role {
    color: var(--f-green);
    font-weight: 700;
    font-size: 14px;
  }

  .team-copy {
    color: #5b6777;
    font-size: 13px;
    line-height: 1.5;
  }

  .cta-banner {
    background: linear-gradient(to right, #0b3a3d, #0f7a5f);
    border-radius: 24px;
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: white;
  }

  .cta-title {
    font-size: 30px;
    font-weight: 800;
  }

  .cta-copy {
    font-size: 15px;
    opacity: 0.9;
  }

  .cta-btn {
    background: #ffffff;
    color: #16384c;
    border: none;
    border-radius: 8px;
    padding: 14px 28px;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
  }

  .cta-btn:hover {
    background: #f1f5f9;
    text-decoration: none;
  }

  @media (max-width: 991px) {
    .about-hero-box, .story-box { flex-direction: column; }
    .hero-visual, .story-visual { width: 100%; height: 300px; }
    .stats-row, .points-grid, .dual-grid, .features-grid { flex-direction: column; }
    .team-card { width: 100%; }
  }
</style>
{% endblock %}

{% block body %}
<div class="about-container">
  <div class="about-shell">
    
    <!-- Hero Section -->
    <div class="about-hero-box">
      <div class="hero-copy-box">
        <span class="hero-kicker">ABOUT FITOPIA</span>
        <h1 class="hero-title">A calmer and smarter way to stay healthy every day</h1>
        <p class="hero-subtitle">Fitopia combines nutrition, fitness and supportive coaching in one elegant wellness platform.</p>
        <p class="hero-desc">We designed Fitopia for people who want a healthier routine without jumping between disconnected tools. Everything is brought together in one simple and motivating experience.</p>
        <div style="display: flex; gap: 12px; margin-top: 10px;">
          <a href="{{ path('app_register') }}" class="cta-btn" style="background: #16384c; color: white;">Get Started</a>
          <a href="{{ path('home') }}" class="cta-btn" style="border: 1px solid #e9edf3;">Back to Home</a>
        </div>
      </div>
      <div class="hero-visual" style="background-image: url('{{ asset('images/coach-1.jpg') }}');"></div>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
      <div class="stat-pill">
        <span class="stat-number">3 in 1</span>
        <span class="stat-label">Nutrition, movement and coaching brought together.</span>
      </div>
      <div class="stat-pill">
        <span class="stat-number">Daily</span>
        <span class="stat-label">Healthy habits that feel easier to follow every day.</span>
      </div>
      <div class="stat-pill">
        <span class="stat-number">One place</span>
        <span class="stat-label">A clearer wellness journey from start to progress.</span>
      </div>
    </div>

    <!-- Story Section -->
    <div class="story-box">
      <div class="story-visual" style="background-image: url('{{ asset('images/services-2.jpg') }}');"></div>
      <div class="story-copy">
        <span class="hero-kicker">OUR STORY</span>
        <h2 class="section-title-dark">Fitopia was created to remove the friction from healthy living</h2>
        <p class="section-copy">Most people use one app for food, another for workouts and somewhere else for motivation. Fitopia unifies that journey into a single digital space that feels easier to use and easier to stay consistent with.</p>
        
        <div class="points-grid">
          <div class="point-card">
            <span class="mini-badge">01</span>
            <span class="team-name" style="font-size: 16px;">Less fragmentation</span>
            <span class="section-copy" style="font-size: 13px;">One place for meals, workouts and progress tracking.</span>
          </div>
          <div class="point-card">
            <span class="mini-badge">02</span>
            <span class="team-name" style="font-size: 16px;">More consistency</span>
            <span class="section-copy" style="font-size: 13px;">A routine that feels simpler to maintain over time.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Mission & Vision -->
    <div class="dual-grid">
      <div class="dual-card">
        <span class="hero-kicker">MISSION</span>
        <h3 class="team-name" style="font-size: 21px;">Make healthy change easier to sustain</h3>
        <p class="section-copy">Fitopia helps users improve their well-being through a centralized, motivating and personalized digital experience.</p>
      </div>
      <div class="dual-card">
        <span class="hero-kicker">VISION</span>
        <h3 class="team-name" style="font-size: 21px;">Become a trusted everyday wellness companion</h3>
        <p class="section-copy">We believe technology should simplify healthier lifestyles and make progress feel natural, supportive and beautiful.</p>
      </div>
    </div>

    <!-- Features Section -->
    <div class="features-shell">
      <div>
        <span class="hero-kicker">WHY FITOPIA</span>
        <h2 class="section-title-dark">What makes the experience different</h2>
      </div>
      <div class="features-grid">
        <div class="feature-card-clean">
          <span class="mini-badge">01</span>
          <span class="team-name" style="font-size: 16px;">All-in-one wellness</span>
          <span class="section-copy" style="font-size: 13px;">Nutrition, movement and progress tracking in one space.</span>
        </div>
        <div class="feature-card-clean">
          <span class="mini-badge">02</span>
          <span class="team-name" style="font-size: 16px;">Personalized guidance</span>
          <span class="section-copy" style="font-size: 13px;">A rhythm and goals adapted specifically to the user.</span>
        </div>
        <div class="feature-card-clean">
          <span class="mini-badge">03</span>
          <span class="team-name" style="font-size: 16px;">Supportive experts</span>
          <span class="section-copy" style="font-size: 13px;">Guidance that stays practical, motivating and reachable.</span>
        </div>
        <div class="feature-card-clean">
          <span class="mini-badge">04</span>
          <span class="team-name" style="font-size: 16px;">Inspiring community</span>
          <span class="section-copy" style="font-size: 13px;">Stories, content and encouragement that keep energy high.</span>
        </div>
      </div>
    </div>

    <!-- Team Section -->
    <div class="team-shell">
      <div>
        <span class="hero-kicker">MEET THE TEAM</span>
        <h2 class="section-title-dark">The people behind Fitopia</h2>
      </div>
      <div class="team-grid">
        <div class="team-card">
          <img src="{{ asset('images/person-1.jpg') }}" class="team-avatar">
          <span class="team-name">Med Omar Selmi</span>
          <span class="team-role">QA &amp; Testing</span>
          <p class="team-copy">Ensuring the platform stays smooth, reliable and bug-free.</p>
        </div>
        <div class="team-card">
          <img src="{{ asset('images/person-2.jpg') }}" class="team-avatar">
          <span class="team-name">Emna Ben Hassine</span>
          <span class="team-role">Platform Developer</span>
          <p class="team-copy">Building and evolving the core Fitopia experience.</p>
        </div>
        <div class="team-card">
          <img src="{{ asset('images/person-3.jpg') }}" class="team-avatar">
          <span class="team-name">Sarah Jardak</span>
          <span class="team-role">Project Lead</span>
          <p class="team-copy">Keeping the product vision clear, aligned and on track.</p>
        </div>
        <div class="team-card">
          <img src="{{ asset('images/staff-4.jpg') }}" class="team-avatar">
          <span class="team-name">Ali Touati</span>
          <span class="team-role">UI/UX Designer</span>
          <p class="team-copy">Designing intuitive, elegant and user-centered journeys.</p>
        </div>
        <div class="team-card">
          <img src="{{ asset('images/staff-5.jpg') }}" class="team-avatar">
          <span class="team-name">Ahmed Chebbi</span>
          <span class="team-role">Community Growth</span>
          <p class="team-copy">Creating engagement and support around the Fitopia brand.</p>
        </div>
        <div class="team-card">
          <img src="{{ asset('images/staff-6.jpg') }}" class="team-avatar">
          <span class="team-name">Rania Landolsi</span>
          <span class="team-role">Content &amp; Documentation</span>
          <p class="team-copy">Shaping helpful content and clearer user communication.</p>
        </div>
      </div>
    </div>

    <!-- CTA Banner -->
    <div class="cta-banner">
      <div>
        <h2 class="cta-title">Ready to experience Fitopia for yourself?</h2>
        <p class="cta-copy">Start a cleaner, more consistent wellness journey today with our all-in-one platform.</p>
      </div>
      <a href="{{ path('app_register') }}" class="cta-btn">Get Started Now</a>
    </div>

  </div>
</div>
{% endblock %}

{% block footer %}
{% include 'partials/footer_fitopia.html.twig' %}
{% endblock %}
