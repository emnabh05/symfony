<script>
document.addEventListener('DOMContentLoaded', function () {
  const supplementFavoriteStorageKey = 'fitopiaSupplementFavorites';
  const productsSection = document.getElementById('products');
  const pageMode = productsSection?.dataset.shopMode || 'shop';
  const supplementCatalog = {
    {% for supplement in supplements %}
    '{{ supplement.id }}': {
      name: '{{ supplement.name|e('js') }}',
      brand: '{{ supplement.brand|e('js') }}',
      category: '{{ supplement.category|e('js') }}',
      price: {{ supplement.price + 0 }},
      image: '{{ supplement.image ? asset('uploads/supplements/' ~ supplement.image) : asset('images/image_1.jpg') }}'
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  };

  const readFavoriteIds = function () {
    try {
      const raw = window.localStorage.getItem(supplementFavoriteStorageKey);
      const parsed = raw ? JSON.parse(raw) : [];
      return new Set(Array.isArray(parsed) ? parsed.map((id) => String(id)) : []);
    } catch (error) {
      return new Set();
    }
  };

  const writeFavoriteIds = function (favoriteIds) {
    try {
      window.localStorage.setItem(supplementFavoriteStorageKey, JSON.stringify(Array.from(favoriteIds)));
    } catch (error) {
      console.warn('Unable to save supplement favorites.', error);
    }
  };

  const favoriteIds = readFavoriteIds();
  const favoriteButtons = Array.from(document.querySelectorAll('.js-supplement-favorite'));
  const favoriteShowcaseCards = Array.from(document.querySelectorAll('.favorite-showcase-card'));
  const favoriteShowcaseEmpty = document.getElementById('favoriteShowcaseEmpty');
  const favoriteSavedCount = document.getElementById('favoriteSavedCount');
  const favoritesPanel = document.getElementById('favoritesPanel');
  const favoritesHideBtn = document.getElementById('favoritesHideBtn');

  const renderFavoriteButton = function (button, isFavorite) {
    button.classList.toggle('is-active', isFavorite);
    button.setAttribute('aria-pressed', isFavorite ? 'true' : 'false');
    if (button.dataset.favoriteStyle === 'remove') {
      button.innerHTML = '<i class="fa fa-times"></i>';
      return;
    }
    button.innerHTML = isFavorite ? '<i class="fa fa-heart"></i>' : '<i class="fa fa-heart-o"></i>';
  };

  const syncFavoriteButtons = function (supplementId) {
    const isFavorite = favoriteIds.has(String(supplementId));
    favoriteButtons
      .filter((button) => String(button.dataset.id || '') === String(supplementId))
      .forEach((button) => renderFavoriteButton(button, isFavorite));
  };

  favoriteButtons.forEach((button) => {
    syncFavoriteButtons(button.dataset.id || '');
    button.addEventListener('click', function () {
      const supplementId = String(this.dataset.id || '');
      if (supplementId === '') {
        return;
      }

      if (favoriteIds.has(supplementId)) {
        favoriteIds.delete(supplementId);
      } else {
        favoriteIds.add(supplementId);
      }

      writeFavoriteIds(favoriteIds);
      syncFavoriteButtons(supplementId);
      if (favoriteCountHero) {
        favoriteCountHero.textContent = String(favoriteIds.size);
      }
      renderFavoriteShowcase();
      if (favoritesOnlyMode) {
        filterProducts();
      }
    });
  });

  const products = Array.from(document.querySelectorAll('#productsGrid .product-card'));
  const showingCount = document.getElementById('showing-count');
  const priceSlider = document.getElementById('priceSlider');
  const maxPrice = document.getElementById('maxPrice');
  const productsGrid = document.getElementById('productsGrid');
  const favoritesOnlyMode = pageMode === 'favorites' || productsGrid?.dataset.favoritesOnly === '1';
  const favoriteCountHero = document.getElementById('favorite-count-hero');
  const favoriteEmptyState = (() => {
    if (!productsGrid) return null;
    const node = document.createElement('div');
    node.className = 'ai-suggestion-empty';
    node.style.gridColumn = '1 / -1';
    node.style.display = 'none';
    node.innerHTML = 'Aucun favori enregistr&eacute; pour le moment. Cliquez sur le c&oelig;ur d&apos;un produit pour le retrouver ici.';
    productsGrid.appendChild(node);
    return node;
  })();
  const searchInput = document.getElementById('searchInput');
  const inlineCartPanel = document.getElementById('inlineCartPanel');
  const inlineCheckoutPanel = document.getElementById('inlineCheckoutPanel');
  const flowBackdrop = document.getElementById('flowBackdrop');
  const inlineCartRows = document.getElementById('inlineCartRows');
  const inlineCartCountLabel = document.getElementById('inlineCartCountLabel');
  const inlineCheckoutItems = document.getElementById('inlineCheckoutSummaryItems');
  const floatingCartBtn = document.getElementById('floatingCartBtn');
  const floatingCartCount = document.getElementById('floatingCartCount');
  const quickModal = document.getElementById('quickViewModal');
  const quickClose = document.getElementById('quickViewClose');
  const quickAdd = document.getElementById('quickViewAdd');
  const aiSuggestForm = document.getElementById('aiSuggestForm');
  const aiGoalInput = document.getElementById('aiGoalInput');
  const aiSuggestGrid = document.getElementById('aiSuggestGrid');
  const aiSuggestStatus = document.getElementById('aiSuggestStatus');
  const aiRefreshBtn = document.getElementById('aiRefreshBtn');
  const storeRecoRefreshBtn = document.getElementById('storeRecoRefreshBtn');
  const storeRecoGrid = document.querySelector('.store-reco-grid');
  const productDetailUrlTemplate = '{{ path('app_shop_product_show', {'id': 0}) }}';
  let quickViewSelectedId = null;
  let currentCart = [];
  let aiShownIds = [];
  let aiLastQueryKey = '__default__';
  let inlineCheckoutSubmitting = false;

  if (favoriteCountHero) {
    favoriteCountHero.textContent = String(favoriteIds.size);
  }
  if (favoriteSavedCount) {
    favoriteSavedCount.textContent = String(favoriteIds.size);
  }

  function renderFavoriteShowcase() {
    if (favoriteShowcaseCards.length === 0) return;

    let visibleFavorites = 0;
    favoriteShowcaseCards.forEach((card) => {
      const supplementId = String(card.dataset.supplementId || '');
      const isFavorite = supplementId !== '' && favoriteIds.has(supplementId);
      card.style.display = isFavorite ? '' : 'none';
      if (isFavorite) {
        visibleFavorites += 1;
      }
    });

    if (favoriteSavedCount) {
      favoriteSavedCount.textContent = String(visibleFavorites);
    }
    if (favoriteCountHero) {
      favoriteCountHero.textContent = String(visibleFavorites);
    }
    if (favoriteShowcaseEmpty) {
      favoriteShowcaseEmpty.style.display = visibleFavorites === 0 ? 'block' : 'none';
    }
  }

  const fmt = (v) => Number(v).toFixed(2) + ' DT';
  const shippingFor = (subtotal) => subtotal >= 100 ? 0 : 7;

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function setAiStatus(message, tone = 'muted') {
    if (!aiSuggestStatus) return;
    aiSuggestStatus.textContent = message;
    aiSuggestStatus.setAttribute('data-tone', tone);
  }

  function renderAiSuggestions(suggestions) {
    if (!aiSuggestGrid) return;
    if (!Array.isArray(suggestions) || suggestions.length === 0) {
      aiSuggestGrid.innerHTML = '<div class="ai-suggestion-empty">Aucune suggestion disponible pour cette demande. Essayez un objectif plus pr&eacute;cis.</div>';
      return;
    }

    aiSuggestGrid.innerHTML = suggestions.map((suggestion) => {
      const id = Number(suggestion.id || 0);
      const safeId = id > 0 ? id : 0;
      const source = String(suggestion.source || 'heuristic').toLowerCase();
      const sourceClass = source === 'ai' ? 'ai' : 'heuristic';
      const sourceLabel = source === 'ai' ? 'Match IA' : 'Match intelligent';
      const reason = escapeHtml(suggestion.reason || 'Bonne correspondance pour votre profil de suppl&eacute;mentation.');
      const name = escapeHtml(suggestion.name || 'Supplement');
      const brand = escapeHtml(suggestion.brand || 'Brand');
      const category = escapeHtml(suggestion.category || 'Category');
      const image = escapeHtml(suggestion.image || '{{ asset('images/image_1.jpg') }}');
      const stock = Number(suggestion.stock || 0);
      const score = Number(suggestion.score || 0);
      const productUrl = productDetailUrlTemplate.replace('/0', '/' + String(safeId));

      return `
        <article class="ai-suggestion-card">
          <div class="ai-suggestion-media"><img src="${image}" alt="${name}"></div>
          <div class="ai-suggestion-body">
            <div class="ai-suggestion-meta">
              <span class="ai-source-badge ${sourceClass}">${sourceLabel}</span>
              <span class="ai-score">${Math.round(score)}% match</span>
            </div>
            <h3 class="ai-suggestion-name">${name}</h3>
            <p class="ai-suggestion-note">${reason}</p>
            <div class="ai-suggestion-foot">
              <span>${brand} | ${category}</span>
              <strong>${fmt(suggestion.price || 0)}</strong>
            </div>
            <div class="ai-suggestion-actions">
              <a href="${escapeHtml(productUrl)}" class="btn btn-secondary">Voir</a>
              <button type="button" class="btn btn-primary js-ai-add" data-id="${safeId}" ${stock > 0 ? '' : 'disabled'}>
                ${stock > 0 ? 'Ajouter' : 'Rupture'}
              </button>
            </div>
          </div>
        </article>
      `;
    }).join('');
  }

  function requestAiSuggestions(query = '', focusProductId = null, allowReset = true) {
    if (!aiSuggestGrid) return Promise.resolve();

    const normalizedQuery = String(query || '').trim();
    const queryKey = normalizedQuery !== '' ? normalizedQuery.toLowerCase() : '__default__';
    if (queryKey !== aiLastQueryKey) {
      aiShownIds = [];
      aiLastQueryKey = queryKey;
    }

    setAiStatus('Analyse de votre objectif et de votre panier en cours...', 'loading');
    aiSuggestGrid.innerHTML = '<div class="ai-suggestion-empty">G&eacute;n&eacute;ration des recommandations...</div>';

    return fetch('{{ path('app_shop_ai_suggestions') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        query: normalizedQuery,
        focusProductId: focusProductId ? Number(focusProductId) : null,
        limit: 6,
        excludeIds: aiShownIds
      })
    })
      .then((response) => response.json())
      .then((payload) => {
        const suggestions = Array.isArray(payload.suggestions) ? payload.suggestions : [];
        const returnedIds = suggestions
          .map((item) => Number(item.id || 0))
          .filter((id) => id > 0);

        if (returnedIds.length > 0) {
          aiShownIds = Array.from(new Set([...aiShownIds, ...returnedIds])).slice(-80);
        }

        renderAiSuggestions(suggestions);
        if (suggestions.length === 0) {
          if (allowReset && aiShownIds.length > 0) {
            aiShownIds = [];
            return requestAiSuggestions(normalizedQuery, focusProductId, false);
          }
          setAiStatus('Aucun r&eacute;sultat proche trouv&eacute;. Ajoutez des d&eacute;tails comme le budget, l\'objectif ou le moment d\'utilisation.', 'warning');
          return;
        }

        const hasAi = suggestions.some((item) => String(item.source || '').toLowerCase() === 'ai');
        const sourceLabel = hasAi ? 'recommandations IA' : 'recommandations intelligentes';
        setAiStatus(`${suggestions.length} ${sourceLabel} affich&eacute;es.`, 'success');
      })
      .catch(() => {
        renderAiSuggestions([]);
        setAiStatus('Le service de suggestion est temporairement indisponible. Veuillez r&eacute;essayer.', 'error');
      });
  }

  function shuffleRecommendations() {
    if (!storeRecoGrid) return;
    const cards = Array.from(storeRecoGrid.children);
    if (cards.length < 2) return;
    for (let i = cards.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }
    cards.forEach((card) => storeRecoGrid.appendChild(card));
  }

  function openPanel(panel) {
    [inlineCartPanel, inlineCheckoutPanel].forEach((el) => el && el.classList.remove('is-open'));
    if (panel) {
      panel.classList.add('is-open');
      flowBackdrop?.classList.add('is-open');
    } else {
      flowBackdrop?.classList.remove('is-open');
    }
  }

  function getCartRowsSubtotal() {
    let subtotal = 0;
    currentCart.forEach((item) => {
      const p = supplementCatalog[String(item.id)];
      if (!p) return;
      subtotal += Number(p.price) * Number(item.quantity);
    });
    return subtotal;
  }

  function updateFloatingCartCount() {
    if (!floatingCartCount) return;
    const count = currentCart.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
    floatingCartCount.textContent = String(count);
  }

  function renderInlineCart() {
    if (!inlineCartRows) return;
    const count = currentCart.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
    if (inlineCartCountLabel) {
      inlineCartCountLabel.textContent = String(count);
    }
    if (currentCart.length === 0) {
      inlineCartRows.innerHTML = '<div class="inline-cart-empty"><h4>Votre panier est vide</h4><p>Ajoutez des suppl&eacute;ments pour booster votre routine !</p></div>';
      document.getElementById('inlineSubtotal').textContent = fmt(0);
      document.getElementById('inlineShipping').textContent = fmt(0);
      document.getElementById('inlineTotal').textContent = fmt(0);
      return;
    }

    inlineCartRows.innerHTML = currentCart.map((item) => {
      const p = supplementCatalog[String(item.id)];
      if (!p) return '';
      const lineTotal = Number(p.price) * Number(item.quantity);
      return `
        <div class="inline-cart-row" data-id="${item.id}">
          <div class="inline-cart-thumb"><img src="${p.image}" alt="${p.name}"></div>
          <div><strong>${p.name}</strong><div style="font-size:12px;color:#667a8e;">${p.brand} | ${p.category}</div></div>
          <div><strong>${fmt(p.price)}</strong></div>
          <div class="inline-qty">
            <button type="button" data-act="dec">-</button>
            <span>${item.quantity}</span>
            <button type="button" data-act="inc">+</button>
          </div>
          <div><strong>${fmt(lineTotal)}</strong></div>
          <button type="button" data-act="remove" style="border:0;background:#fee2e2;color:#dc2626;border-radius:8px;width:32px;height:32px;"><i class="fa fa-trash"></i></button>
        </div>
      `;
    }).join('');

    const subtotal = getCartRowsSubtotal();
    const shipping = shippingFor(subtotal);
    document.getElementById('inlineSubtotal').textContent = fmt(subtotal);
    document.getElementById('inlineShipping').textContent = fmt(shipping);
    document.getElementById('inlineTotal').textContent = fmt(subtotal + shipping);
  }

  function renderInlineCheckoutSummary() {
    if (!inlineCheckoutItems) return;
    if (currentCart.length === 0) {
      inlineCheckoutItems.innerHTML = '<div class="inline-cart-empty"><h4>Votre panier est vide</h4><p>Ajoutez des suppl&eacute;ments pour finaliser votre commande.</p></div>';
      document.getElementById('coSubtotal').textContent = fmt(0);
      document.getElementById('coShipping').textContent = fmt(7);
      document.getElementById('coDiscount').textContent = '-' + fmt(0);
      document.getElementById('coTotal').textContent = fmt(7);
      return;
    }

    inlineCheckoutItems.innerHTML = currentCart.map((item) => {
      const p = supplementCatalog[String(item.id)];
      if (!p) return '';
      return `<div class="inline-summary-row"><span>${p.name} x${item.quantity}</span><strong>${fmt(Number(p.price) * Number(item.quantity))}</strong></div>`;
    }).join('');

    const subtotal = getCartRowsSubtotal();
    const shipping = shippingFor(subtotal);
    const code = (document.getElementById('coDiscountCode')?.value || '').trim().toLowerCase();
    const discount = code === 'ali123' ? subtotal * 0.10 : 0;
    document.getElementById('coSubtotal').textContent = fmt(subtotal);
    document.getElementById('coShipping').textContent = fmt(shipping);
    document.getElementById('coDiscount').textContent = '-' + fmt(discount);
    document.getElementById('coTotal').textContent = fmt(subtotal + shipping - discount);
  }

  function setInlineDiscountState(message, tone = '') {
    const node = document.getElementById('coDiscountState');
    if (!node) return;
    node.textContent = message;
    if (tone === '') {
      node.removeAttribute('data-tone');
      return;
    }
    node.setAttribute('data-tone', tone);
  }

  function fetchCartAndRender() {
    return fetch('{{ path('app_shop_cart_get') }}')
      .then((r) => r.json())
      .then((data) => {
        currentCart = Array.isArray(data.cart) ? data.cart : [];
        renderInlineCart();
        renderInlineCheckoutSummary();
        updateFloatingCartCount();
        if (typeof updateCartCount === 'function') updateCartCount();
      });
  }

  function filterProducts() {
    if (products.length === 0) {
      return;
    }
    const selectedCategories = Array.from(document.querySelectorAll('input[name="category"]:checked')).map((el) => el.value);
    const selectedBrands = Array.from(document.querySelectorAll('input[name="brand"]:checked')).map((el) => el.value);
    const ceiling = parseFloat(priceSlider ? priceSlider.value : '500');
    const searchTerm = (searchInput ? searchInput.value : '').trim().toLowerCase();
    let visible = 0;

    products.forEach((product) => {
      const matchCategory = selectedCategories.length === 0 || selectedCategories.includes(product.dataset.category);
      const matchBrand = selectedBrands.length === 0 || selectedBrands.includes(product.dataset.brand);
      const matchPrice = parseFloat(product.dataset.price || '0') <= ceiling;
      const matchSearch = searchTerm === '' || (product.dataset.name || '').toLowerCase().includes(searchTerm);
      const favoriteButton = product.querySelector('.js-supplement-favorite');
      const matchFavorite = !favoritesOnlyMode || favoriteIds.has(String(favoriteButton?.dataset.id || ''));
      const show = matchCategory && matchBrand && matchPrice && matchSearch && matchFavorite;
      product.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (showingCount) showingCount.textContent = String(visible);
    if (favoriteEmptyState) {
      favoriteEmptyState.style.display = favoritesOnlyMode && visible === 0 ? 'block' : 'none';
    }
  }

  favoritesHideBtn?.addEventListener('click', function () {
    const collapsed = favoritesPanel?.classList.toggle('is-collapsed');
    this.textContent = collapsed ? 'Afficher' : 'Masquer';
  });

  document.querySelectorAll('.filter-checkbox').forEach((el) => el.addEventListener('change', filterProducts));
  if (priceSlider) {
    priceSlider.addEventListener('input', function () {
      if (maxPrice) maxPrice.textContent = this.value + ' DT';
      filterProducts();
    });
  }
  if (searchInput) {
    searchInput.addEventListener('input', filterProducts);
  }

  document.getElementById('clearFiltersBtn')?.addEventListener('click', function () {
    document.querySelectorAll('.filter-checkbox').forEach((el) => { el.checked = false; });
    if (priceSlider) {
      priceSlider.value = '500';
      if (maxPrice) maxPrice.textContent = '500 DT';
    }
    if (searchInput) searchInput.value = '';
    filterProducts();
  });

  document.getElementById('sortSelect')?.addEventListener('change', function () {
    const value = this.value;
    const sorted = [...products].sort((a, b) => {
      if (value === 'name-asc') return a.dataset.name.localeCompare(b.dataset.name);
      if (value === 'name-desc') return b.dataset.name.localeCompare(a.dataset.name);
      if (value === 'price-asc') return parseFloat(a.dataset.price || '0') - parseFloat(b.dataset.price || '0');
      if (value === 'price-desc') return parseFloat(b.dataset.price || '0') - parseFloat(a.dataset.price || '0');
      if (value === 'newest') return new Date(b.dataset.created) - new Date(a.dataset.created);
      return 0;
    });
    sorted.forEach((el) => productsGrid?.appendChild(el));
  });

  document.querySelectorAll('.filter-toggle').forEach((btn) => {
    btn.addEventListener('click', function () {
      const group = this.closest('.filter-group');
      if (!group) return;
      group.classList.toggle('collapsed');
    });
  });

  function addProductToCart(supplementId, buttonEl, openCartAfter = true) {
    if (!supplementId) return Promise.resolve();
    if (buttonEl) {
      buttonEl.disabled = true;
      buttonEl.classList.add('adding');
    }
    return fetch('{{ path('app_shop_cart_add') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ supplementId: supplementId, quantity: 1 })
    })
      .then((r) => r.json())
      .then((data) => {
        if (data && data.success) {
          return fetchCartAndRender().then(() => {
            if (openCartAfter) openPanel(inlineCartPanel);
          });
        }
      })
      .catch(() => alert('Erreur lors de l\'ajout du produit au panier'))
      .finally(() => {
        if (buttonEl) {
          buttonEl.disabled = false;
          setTimeout(() => buttonEl.classList.remove('adding'), 220);
        }
      });
  }

  document.querySelectorAll('.add-to-cart-btn[data-id]').forEach((btn) => {
    btn.addEventListener('click', function () {
      addProductToCart(this.dataset.id, this, true);
    });
  });

  document.querySelectorAll('.js-quick-view').forEach((btn) => {
    btn.addEventListener('click', function () {
      const card = this.closest('.product-card');
      if (!card) return;
      const detailUrl = card.dataset.detailUrl || '';
      if (detailUrl !== '') {
        window.location.href = detailUrl;
      }
    });
  });

  quickClose?.addEventListener('click', () => {
    quickModal?.classList.remove('open');
    quickModal?.setAttribute('aria-hidden', 'true');
  });
  quickModal?.addEventListener('click', (e) => {
    if (e.target === quickModal) {
      quickModal.classList.remove('open');
      quickModal.setAttribute('aria-hidden', 'true');
    }
  });
  quickAdd?.addEventListener('click', function () {
    addProductToCart(quickViewSelectedId, this, true).then(() => {
      quickModal?.classList.remove('open');
      quickModal?.setAttribute('aria-hidden', 'true');
    });
  });

  aiSuggestForm?.addEventListener('submit', function (event) {
    event.preventDefault();
    const query = (aiGoalInput?.value || '').trim();
    requestAiSuggestions(query, quickViewSelectedId);
  });

  aiRefreshBtn?.addEventListener('click', function () {
    const query = (aiGoalInput?.value || '').trim();
    requestAiSuggestions(query, quickViewSelectedId);
  });
  storeRecoRefreshBtn?.addEventListener('click', shuffleRecommendations);

  document.querySelectorAll('.js-ai-goal').forEach((button) => {
    button.addEventListener('click', function () {
      const goal = this.getAttribute('data-goal') || '';
      if (aiGoalInput) {
        aiGoalInput.value = goal;
      }
      requestAiSuggestions(goal, quickViewSelectedId);
    });
  });

  aiSuggestGrid?.addEventListener('click', function (event) {
    const addButton = event.target.closest('.js-ai-add');
    if (!addButton) return;
    addProductToCart(addButton.dataset.id, addButton, true);
  });

  document.getElementById('openInlineCartBtn')?.addEventListener('click', function () {
    fetchCartAndRender().then(() => openPanel(inlineCartPanel));
  });
  floatingCartBtn?.addEventListener('click', function () {
    fetchCartAndRender().then(() => openPanel(inlineCartPanel));
  });

  document.getElementById('openInlineCheckoutBtn')?.addEventListener('click', function () {
    fetchCartAndRender().then(() => openPanel(inlineCheckoutPanel));
  });

  document.getElementById('goInlineCheckoutBtn')?.addEventListener('click', function () {
    fetchCartAndRender().then(() => openPanel(inlineCheckoutPanel));
  });

  document.querySelectorAll('[data-close-panel]').forEach((btn) => {
    btn.addEventListener('click', function () {
      const id = this.getAttribute('data-close-panel');
      document.getElementById(id)?.classList.remove('is-open');
      flowBackdrop?.classList.remove('is-open');
    });
  });
  flowBackdrop?.addEventListener('click', function () {
    [inlineCartPanel, inlineCheckoutPanel].forEach((el) => el && el.classList.remove('is-open'));
    flowBackdrop.classList.remove('is-open');
  });

  document.getElementById('coDiscountCode')?.addEventListener('input', function () {
    renderInlineCheckoutSummary();
    if ((this.value || '').trim() === '') {
      setInlineDiscountState('');
    }
  });

  document.getElementById('applyInlineDiscountBtn')?.addEventListener('click', function () {
    const code = (document.getElementById('coDiscountCode')?.value || '').trim();
    if (code === '') {
      setInlineDiscountState('Entrez un code promo si vous en avez un.');
      renderInlineCheckoutSummary();
      return;
    }
    if (code.toLowerCase() === 'ali123') {
      setInlineDiscountState('Code promo appliqu&eacute; : 10% de remise sur le sous-total.', 'success');
    } else {
      setInlineDiscountState('Code promo invalide.', 'error');
    }
    renderInlineCheckoutSummary();
  });

  inlineCartRows?.addEventListener('click', function (event) {
    const btn = event.target.closest('button[data-act]');
    if (!btn) return;
    const row = event.target.closest('.inline-cart-row');
    if (!row) return;
    const id = parseInt(row.getAttribute('data-id'), 10);
    const item = currentCart.find((x) => Number(x.id) === id);
    if (!item) return;
    const act = btn.getAttribute('data-act');

    if (act === 'remove') {
      fetch('{{ path('app_shop_cart_remove') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ supplementId: id })
      }).then(fetchCartAndRender);
      return;
    }

    const nextQty = act === 'inc' ? Number(item.quantity) + 1 : Math.max(1, Number(item.quantity) - 1);
    fetch('{{ path('app_shop_cart_update') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ supplementId: id, quantity: nextQty })
    }).then(fetchCartAndRender);
  });

  document.getElementById('inlineCheckoutForm')?.addEventListener('submit', function (e) {
    e.preventDefault();
    if (inlineCheckoutSubmitting) return;

    const submitButton = this.querySelector('button[type="submit"]');
    const originalSubmitLabel = submitButton ? submitButton.innerHTML : '';
    const subtotal = getCartRowsSubtotal();
    if (subtotal <= 0) {
      alert('Your cart is empty.');
      openPanel(inlineCartPanel);
      return;
    }
    inlineCheckoutSubmitting = true;
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Processing...';
    }

    const discountCode = (document.getElementById('coDiscountCode')?.value || '').trim();
    const payload = {
      firstName: document.getElementById('coFirstName').value,
      lastName: document.getElementById('coLastName').value,
      email: document.getElementById('coEmail').value,
      phone: document.getElementById('coPhone').value,
      address: document.getElementById('coAddress').value,
      city: document.getElementById('coCity').value,
      postalCode: document.getElementById('coPostalCode').value,
      notes: document.getElementById('coNotes').value,
      paymentMethod: document.querySelector('input[name="coPaymentMethod"]:checked')?.value || 'cod',
      discountCode: discountCode
    };

    fetch('{{ path('app_shop_order_create') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(async (r) => {
        const data = await r.json().catch(() => ({}));
        if (!r.ok) {
          const message = data && data.message ? data.message : 'Could not complete order.';
          throw new Error(message);
        }
        return data;
      })
      .then((res) => {
        if (!res || !res.success || !res.orderNumber) {
          alert((res && res.message) ? res.message : 'Could not complete order.');
          return;
        }
        if (res.emailSent === false) {
          console.warn('Order confirmation email was not sent.', {
            transport: res.emailTransport || null,
            error: res.emailError || null
          });
        }
        window.location.href = '{{ path('app_shop_order_success', {orderNumber: '__ORDER__'}) }}'
          .replace('__ORDER__', res.orderNumber);
      })
      .catch((error) => alert(error && error.message ? error.message : 'Error while creating order'))
      .finally(() => {
        inlineCheckoutSubmitting = false;
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.innerHTML = originalSubmitLabel;
        }
      });
  });

  renderFavoriteShowcase();

  fetchCartAndRender()
    .then(() => requestAiSuggestions(''))
    .catch(() => requestAiSuggestions(''));
});
</script>
{% elseif pageMode == 'cart' %}
<section class="cart-section">
  <div class="container">
    {% if cartItems is empty %}
      <div class="cart-empty-state">
        <div class="cart-empty-icon"><i class="fa fa-shopping-basket"></i></div>
        <h2>Your cart is empty</h2>
        <p style="margin:8px 0 18px;color:#5D7488;">Add supplements to unlock personalized checkout and faster payment flow.</p>
        <a href="{{ path('app_shop_index') }}" class="btn btn-primary">Continue Shopping</a>
      </div>
    {% else %}
      <div class="cart-header">
        <div>
          <p class="checkout-step">Checkout Step 1</p>
          <h2>Review your cart</h2>
          <p>Adjust quantity and verify totals before secure checkout.</p>
        </div>
        <a href="{{ path('app_shop_index') }}" class="cart-continue-link">
          <i class="fa fa-arrow-left"></i> Continue Shopping
        </a>
      </div>
      <div class="cart-layout">
        <div class="cart-main">
          <div class="cart-grid-head">
            <span>Product</span>
            <span>Price</span>
            <span>Quantity</span>
            <span>Total</span>
            <span></span>
          </div>
          {% for item in cartItems %}
            <div class="cart-item" data-id="{{ item.supplement.id }}">
              <div class="item-product">
                <div class="item-image">
                  {% if item.supplement.image %}
                    <img src="{{ asset('uploads/supplements/' ~ item.supplement.image) }}" alt="{{ item.supplement.name }}">
                  {% else %}
                    <img src="{{ asset('images/image_1.jpg') }}" alt="{{ item.supplement.name }}">
                  {% endif %}
                </div>
                <div class="item-details">
                  <h3>{{ item.supplement.name }}</h3>
                  <p class="item-brand">{{ item.supplement.brand }}</p>
                  <p class="item-category">{{ item.supplement.category }}</p>
                </div>
              </div>
              <div class="item-price">{{ item.supplement.price }} DT</div>
              <div class="item-quantity">
                <button class="qty-btn qty-minus" data-id="{{ item.supplement.id }}">-</button>
                <input type="number" min="1" value="{{ item.quantity }}" class="qty-input" data-id="{{ item.supplement.id }}">
                <button class="qty-btn qty-plus" data-id="{{ item.supplement.id }}">+</button>
              </div>
              <div class="item-total">{{ item.total }} DT</div>
              <button class="item-remove" data-id="{{ item.supplement.id }}" aria-label="Remove {{ item.supplement.name }}">
                <i class="fa fa-trash"></i>
              </button>
            </div>
          {% endfor %}
        </div>
        <aside class="cart-summary">
          <h3>Order Summary</h3>
          <p class="summary-caption">Shipping becomes free when your subtotal reaches 100 DT.</p>
          <div class="summary-row"><span>Subtotal</span><span>{{ subtotal }} DT</span></div>
          <div class="summary-row"><span>Shipping</span><span>{{ subtotal >= 100 ? 'FREE' : '7 DT' }}</span></div>
          <div class="summary-total"><span>Total</span><span>{{ subtotal + (subtotal >= 100 ? 0 : 7) }} DT</span></div>
          <a href="{{ path('app_shop_checkout') }}" class="btn-checkout">
            <i class="fa fa-lock"></i> Proceed to Checkout
          </a>
        </aside>
      </div>
    {% endif %}
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const postJson = (url, payload) => fetch(url, { method:'POST', headers:{ 'Content-Type':'application/json' }, body:JSON.stringify(payload) });
  document.querySelectorAll('.qty-plus, .qty-minus').forEach((btn) => {
    btn.addEventListener('click', function () {
      const id = this.dataset.id;
      const input = document.querySelector('.qty-input[data-id="' + id + '"]');
      if (!input) return;
      let quantity = parseInt(input.value || '1', 10);
      quantity = this.classList.contains('qty-plus') ? quantity + 1 : Math.max(1, quantity - 1);
      input.value = quantity;
      postJson('{{ path('app_shop_cart_update') }}', { supplementId: id, quantity }).then(() => location.reload());
    });
  });
  document.querySelectorAll('.qty-input').forEach((input) => {
    input.addEventListener('change', function () {
      const quantity = Math.max(1, parseInt(this.value || '1', 10));
      this.value = quantity;
      postJson('{{ path('app_shop_cart_update') }}', { supplementId: this.dataset.id, quantity }).then(() => location.reload());
    });
  });
  document.querySelectorAll('.item-remove').forEach((btn) => {
    btn.addEventListener('click', function () {
      if (!confirm('Remove this item?')) return;
      postJson('{{ path('app_shop_cart_remove') }}', { supplementId: this.dataset.id }).then(() => location.reload());
    });
  });
});
</script>
{% elseif pageMode == 'checkout' %}
<section class="checkout-section">
  <div class="container">
    <div class="checkout-header">
      <div>
        <p class="checkout-step">Checkout Step 2</p>
        <h2>Shipping and payment</h2>
        <p>Fill delivery details, choose payment, and confirm your order.</p>
      </div>
      <a href="{{ path('app_shop_cart') }}" class="cart-continue-link">
        <i class="fa fa-arrow-left"></i> Back to Cart
      </a>
    </div>
    <div class="checkout-layout">
      <div class="checkout-main">
        <form id="checkoutForm" class="checkout-form">
          <section class="checkout-block">
            <h3>Contact and Shipping Details</h3>
            <div class="form-row">
              <div class="form-group"><label for="firstName">First Name *</label><input type="text" id="firstName" required></div>
              <div class="form-group"><label for="lastName">Last Name *</label><input type="text" id="lastName" required></div>
            </div>
            <div class="form-group"><label for="email">Email *</label><input type="email" id="email" required></div>
            <div class="form-group"><label for="phone">Phone *</label><input type="tel" id="phone" required></div>
            <div class="form-group"><label for="address">Address *</label><input type="text" id="address" required></div>
            <div class="form-row">
              <div class="form-group"><label for="city">City *</label><input type="text" id="city" required></div>
              <div class="form-group"><label for="postalCode">Postal Code *</label><input type="text" id="postalCode" required></div>
            </div>
            <div class="form-group"><label for="notes">Notes</label><textarea id="notes" rows="3"></textarea></div>
          </section>

          <section class="checkout-block">
            <div class="checkout-block-head">
