              {% for payment in paymentMethods %}
                <label class="payment-method-option">
                  <input type="radio" name="paymentMethod" value="{{ payment.id }}" {% if loop.first %}checked{% endif %}>
                  <div class="payment-method-card"><i class="{{ payment.icon }}"></i> <span>{{ payment.name }}</span></div>
                </label>
              {% endfor %}
            </div>
          </section>

          <section class="checkout-block discount-block">
            <h3>Promo Code</h3>
            <div class="discount-code-section">
              <input type="text" id="discountCode" placeholder="Discount code">
              <button type="button" id="applyDiscountBtn">Apply</button>
            </div>
            <p class="discount-feedback" id="checkoutDiscountState"></p>
          </section>

          <div class="checkout-submit-row">
            <a href="{{ path('app_shop_cart') }}" class="btn btn-secondary">
              <i class="fa fa-arrow-left"></i> Back to Cart
            </a>
            <button type="submit" class="submit-order-btn">
              <i class="fa fa-lock"></i> Confirm Order
            </button>
          </div>
        </form>
      </div>
      <aside class="order-summary">
        <h3>Order Summary</h3>
        <div class="summary-items">
          {% for item in cartItems %}
            <div class="summary-row summary-product">
              <span>{{ item.supplement.name }} <small>x{{ item.quantity }}</small></span>
              <strong>{{ item.total }} DT</strong>
            </div>
          {% endfor %}
        </div>
        <div class="summary-divider"></div>
        <div class="summary-row"><span>Subtotal</span><span id="checkoutSubtotal">{{ subtotal }} DT</span></div>
        <div class="summary-row"><span>Shipping</span><span id="checkoutShipping">{{ subtotal >= 100 ? 'FREE' : '7 DT' }}</span></div>
        <div class="summary-row"><span>Discount</span><span id="checkoutDiscount">-0.00 DT</span></div>
        <div class="summary-total"><span>Total</span><span id="checkoutGrandTotal">{{ subtotal + (subtotal >= 100 ? 0 : 7) }} DT</span></div>
        <ul class="summary-trust">
          <li><i class="fa fa-lock"></i> Protected payment workflow</li>
          <li><i class="fa fa-truck"></i> Shipping update sent by email</li>
          <li><i class="fa fa-check-circle"></i> Real-time order confirmation</li>
        </ul>
      </aside>
    </div>
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
  let discountCode = '';
  let checkoutSubmitting = false;
  const subtotal = Number('{{ subtotal + 0 }}');
  const shipping = subtotal >= 100 ? 0 : 7;
  const subtotalEl = document.getElementById('checkoutSubtotal');
  const shippingEl = document.getElementById('checkoutShipping');
  const discountEl = document.getElementById('checkoutDiscount');
  const totalEl = document.getElementById('checkoutGrandTotal');
  const discountState = document.getElementById('checkoutDiscountState');
  const fmt = (value) => Number(value).toFixed(2) + ' DT';

  function setDiscountState(message, tone = '') {
    if (!discountState) return;
    discountState.textContent = message;
    if (tone === '') {
      discountState.removeAttribute('data-tone');
      return;
    }
    discountState.setAttribute('data-tone', tone);
  }

  function renderCheckoutTotals() {
    const discountValue = discountCode ? subtotal * 0.10 : 0;
    if (subtotalEl) subtotalEl.textContent = fmt(subtotal);
    if (shippingEl) shippingEl.textContent = shipping === 0 ? 'FREE' : fmt(shipping);
    if (discountEl) discountEl.textContent = '-' + fmt(discountValue);
    if (totalEl) totalEl.textContent = fmt(subtotal + shipping - discountValue);
  }

  renderCheckoutTotals();

  document.getElementById('applyDiscountBtn')?.addEventListener('click', function () {
    const code = (document.getElementById('discountCode')?.value || '').trim();
    if (code === '') {
      discountCode = '';
      setDiscountState('Enter a code if you have one.', '');
      renderCheckoutTotals();
      return;
    }
    if (code.toLowerCase() === 'ali123') {
      discountCode = code;
      setDiscountState('Discount applied: 10% off subtotal.', 'success');
    } else {
      discountCode = '';
      setDiscountState('Invalid discount code.', 'error');
    }
    renderCheckoutTotals();
  });

  document.getElementById('checkoutForm')?.addEventListener('submit', function (e) {
    e.preventDefault();
    if (checkoutSubmitting) return;
    const submitButton = this.querySelector('button[type="submit"]');
    const originalSubmitLabel = submitButton ? submitButton.innerHTML : '';
    checkoutSubmitting = true;
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Processing...';
    }

    const payload = {
      firstName: document.getElementById('firstName').value,
      lastName: document.getElementById('lastName').value,
      email: document.getElementById('email').value,
      phone: document.getElementById('phone').value,
      address: document.getElementById('address').value,
      city: document.getElementById('city').value,
      postalCode: document.getElementById('postalCode').value,
      notes: document.getElementById('notes').value,
      paymentMethod: document.querySelector('input[name="paymentMethod"]:checked')?.value || 'cod',
      discountCode
    };
    fetch('{{ path('app_shop_order_create') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(async (r) => {
      const data = await r.json().catch(() => ({}));
      if (!r.ok) {
        const message = data && data.message ? data.message : 'Could not create order';
        throw new Error(message);
      }
      return data;
    })
    .then((response) => {
      if (!response.success || !response.orderNumber) {
        alert(response && response.message ? response.message : 'Could not create order');
        return;
      }
      if (response.emailSent === false) {
        console.warn('Order confirmation email was not sent.', {
          transport: response.emailTransport || null,
          error: response.emailError || null
        });
      }
      window.location.href = '{{ path('app_shop_order_success', {orderNumber: '__ORDER__'}) }}'
        .replace('__ORDER__', response.orderNumber);
    })
    .catch((error) => alert(error && error.message ? error.message : 'Error creating order'))
    .finally(() => {
      checkoutSubmitting = false;
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.innerHTML = originalSubmitLabel;
      }
    });
  });
});
</script>
