      /* 2026 cart + checkout + payment refresh */
      :root {
          --purchase-ink: #0B2C3D;
          --purchase-accent: #1C7A5D;
          --purchase-accent-dark: #0C3F5A;
          --purchase-soft: #EAF7F1;
          --purchase-bg: #F3F8FC;
          --purchase-line: #D7E4F0;
      }

      .cart-section,
      .checkout-section {
          background:
              radial-gradient(circle at 6% 0%, rgba(28,122,93,0.14) 0%, transparent 25%),
              radial-gradient(circle at 92% 12%, rgba(12,63,90,0.12) 0%, transparent 28%),
              var(--purchase-bg);
      }

      .cart-header,
      .checkout-header,
      .payment-header {
          margin-bottom: 20px;
          padding: 22px 24px;
          border-radius: 20px;
          border: 1px solid #DBE7F2;
          background: linear-gradient(130deg, #FFFFFF 0%, #F2F8FF 55%, #ECFAF2 100%);
          box-shadow: 0 14px 34px rgba(15, 23, 42, 0.09);
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 14px;
          flex-wrap: wrap;
      }

      .checkout-step {
          margin: 0 0 7px;
          color: #1C7A5D;
          text-transform: uppercase;
          letter-spacing: 0.12em;
          font-size: 11px;
          font-weight: 800;
      }

      .cart-header h2,
      .checkout-header h2,
      .payment-header h2 {
          margin: 0;
          color: var(--purchase-ink);
          font-size: clamp(28px, 3vw, 36px);
          font-weight: 900;
          letter-spacing: -0.02em;
      }

      .cart-header p:last-child,
      .checkout-header p:last-child,
      .payment-header p:last-child {
          margin: 8px 0 0;
          color: #587085;
          font-size: 14px;
      }

      .cart-continue-link {
          border-radius: 999px;
          border: 1px solid #CCDAE8;
          background: #FFFFFF;
          color: #1E4663;
          font-size: 12px;
          font-weight: 800;
          letter-spacing: 0.04em;
          text-transform: uppercase;
          padding: 9px 14px;
          text-decoration: none;
          display: inline-flex;
          align-items: center;
          gap: 8px;
      }

      .cart-continue-link:hover {
          border-color: var(--purchase-accent);
          color: var(--purchase-accent);
          text-decoration: none;
      }

      .cart-layout,
      .checkout-layout {
          gap: 22px;
          align-items: start;
      }

      .cart-main,
      .cart-summary,
      .checkout-main,
      .order-summary {
          border-radius: 20px;
          border: 1px solid #DCE8F3;
          box-shadow: 0 18px 34px rgba(15, 23, 42, 0.08);
      }

      .cart-main {
          padding: 12px;
      }

      .cart-grid-head {
          display: grid;
          grid-template-columns: minmax(220px, 1fr) 120px 150px 120px 46px;
          gap: 12px;
          align-items: center;
          padding: 14px 16px;
          border-radius: 14px;
          background: #F3F8FE;
          border: 1px solid #DEE8F2;
          color: #4E6478;
          font-size: 12px;
          font-weight: 800;
          letter-spacing: 0.08em;
          text-transform: uppercase;
      }

      .cart-grid-head span:first-child {
          padding-left: 104px;
      }

      .cart-item {
          margin-top: 10px;
          border: 1px solid #E1EAF3;
          border-radius: 16px;
          padding: 16px;
          background: #FFFFFF;
          grid-template-columns: minmax(220px, 1fr) 120px 150px 120px 46px;
          gap: 12px;
          border-bottom: 1px solid #E1EAF3;
      }

      .item-product {
          min-width: 0;
          display: grid;
          grid-template-columns: 92px 1fr;
          gap: 12px;
          align-items: center;
      }

      .item-image {
          width: 92px;
          height: 92px;
          border-radius: 14px;
          border: 1px solid #DDE9F3;
      }

      .item-details h3 {
          margin-top: 0;
      }

      .item-price,
      .item-total {
          font-size: 20px;
          font-weight: 800;
          letter-spacing: -0.01em;
      }

      .item-total {
          color: #153B55;
      }

      .item-quantity {
          gap: 6px;
          border-radius: 999px;
          border: 1px solid #D8E5F2;
          background: #F8FBFF;
          padding: 5px;
          width: fit-content;
      }

      .qty-btn {
          width: 32px;
          height: 32px;
          border: 1px solid #D3E1EF;
          background: #FFFFFF;
          color: #163A52;
          font-size: 17px;
          line-height: 1;
      }

      .qty-btn:hover {
          border-color: var(--purchase-accent);
          color: var(--purchase-accent);
      }

      .qty-input {
          width: 46px;
          border: 0;
          background: transparent;
          font-size: 15px;
      }

      .qty-input:focus {
          outline: none;
      }

      .item-remove {
          width: 38px;
          height: 38px;
          border: 1px solid #F8CACA;
          background: #FFF1F1;
          color: #C23333;
      }

      .cart-summary {
          position: sticky;
          top: 18px;
          background: #FFFFFF;
      }

      .cart-summary h3,
      .order-summary h3 {
          margin: 0;
          color: var(--purchase-ink);
      }

      .summary-caption {
          margin: 8px 0 16px;
          color: #5E7488;
          font-size: 13px;
          line-height: 1.5;
      }

      .summary-row small {
          color: #6C8296;
          font-size: 11px;
      }

      .summary-row strong {
          color: #153B55;
          font-size: 14px;
      }

      .summary-divider {
          border-top: 1px solid #E4ECF4;
          margin: 6px 0;
      }

      .btn-checkout,
      .submit-order-btn {
          border-radius: 12px;
          border: 0;
          background: linear-gradient(135deg, var(--purchase-accent) 0%, var(--purchase-accent-dark) 100%);
          box-shadow: 0 14px 28px rgba(12, 63, 90, 0.22);
      }

      .btn-checkout:hover,
      .submit-order-btn:hover {
          color: #FFFFFF;
          text-decoration: none;
          transform: translateY(-1px);
      }

      .cart-empty-state {
          background: #FFFFFF;
          border: 1px dashed #BFD2E4;
          border-radius: 22px;
          text-align: center;
          padding: 44px 20px;
          box-shadow: 0 12px 28px rgba(15, 23, 42, 0.07);
      }

      .cart-empty-icon {
          width: 68px;
          height: 68px;
          margin: 0 auto 12px;
          border-radius: 20px;
          background: linear-gradient(135deg, #EAF7F1 0%, #E8F2FF 100%);
          color: #1C7A5D;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 30px;
      }

      .checkout-main {
          background: #FFFFFF;
      }

      .checkout-block {
          border: 1px solid #E1EAF3;
          border-radius: 16px;
          padding: 16px;
          margin-bottom: 16px;
          background: #FCFEFF;
      }

      .checkout-block h3 {
          margin: 0 0 12px;
          color: #133B56;
          font-size: 17px;
          font-weight: 800;
      }

      .checkout-block-head {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 10px;
          margin-bottom: 12px;
      }

      .checkout-block-head span {
          font-size: 12px;
          color: #1C7A5D;
          font-weight: 700;
          display: inline-flex;
          align-items: center;
          gap: 6px;
      }

      .checkout-form label {
          color: #1A455F;
      }

      .checkout-form input,
      .checkout-form textarea {
          border: 1px solid #D2DFEC;
          border-radius: 10px;
          padding: 11px 12px;
          color: #153D57;
          transition: border-color .2s ease, box-shadow .2s ease;
      }

      .checkout-form input:focus,
      .checkout-form textarea:focus {
          border-color: var(--purchase-accent);
          outline: none;
          box-shadow: 0 0 0 3px rgba(28,122,93,0.14);
      }

      .payment-method-option {
          display: block;
      }

      .payment-method-option input {
          position: absolute;
          opacity: 0;
          pointer-events: none;
      }

      .payment-method-card {
          border: 1px solid #D7E3EE;
          background: #FFFFFF;
          border-radius: 12px;
          padding: 14px 14px;
          transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
      }

      .payment-method-card i {
          width: 24px;
          text-align: center;
          color: #1A4D6B;
      }

      .payment-method-option input:checked + .payment-method-card {
          border-color: #1C7A5D;
          background: var(--purchase-soft);
          color: #133D57;
          box-shadow: 0 10px 22px rgba(28,122,93,0.16);
          transform: translateY(-1px);
      }

      .discount-block {
          background: linear-gradient(130deg, #F8FCFF 0%, #F1FBF5 100%);
      }

      .discount-code-section button {
          border-radius: 10px;
          min-width: 106px;
      }

      .discount-feedback {
          margin: 10px 0 0;
          font-size: 12px;
          font-weight: 700;
          color: #6A7F93;
      }

      .discount-feedback[data-tone="success"] {
          color: #187251;
      }

      .discount-feedback[data-tone="error"] {
          color: #C13434;
      }

      .checkout-submit-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          flex-wrap: wrap;
      }

      .checkout-submit-row .btn {
          border-radius: 12px;
      }

      .summary-items {
          display: grid;
          gap: 2px;
      }

      .summary-product {
          align-items: flex-start;
      }

      .summary-product span {
          max-width: 70%;
          line-height: 1.35;
      }

      .summary-trust {
          margin: 16px 0 0;
          padding: 0;
          list-style: none;
          display: grid;
          gap: 8px;
          color: #5A7084;
          font-size: 13px;
      }

      .summary-trust li {
          display: flex;
          align-items: center;
          gap: 8px;
      }

      .summary-trust i {
          color: var(--purchase-accent);
      }

      .payment-shell {
          display: grid;
          grid-template-columns: minmax(0, 1fr) 340px;
          gap: 20px;
      }

      .payment-main,
      .payment-side {
          background: #FFFFFF;
          border: 1px solid #DCE8F3;
          border-radius: 20px;
          box-shadow: 0 18px 34px rgba(15, 23, 42, 0.08);
      }

      .payment-main {
          padding: 22px;
      }

      .payment-side {
          padding: 20px;
          height: fit-content;
      }

      .payment-form .form-group {
          margin-bottom: 14px;
      }

      .payment-form .submit-order-btn {
          width: 100%;
      }

      .card-preview {
          border-radius: 16px;
          padding: 18px;
          background: linear-gradient(145deg, #0B2C3D 0%, #1C7A5D 100%);
          color: #FFFFFF;
          margin-bottom: 16px;
          box-shadow: 0 14px 30px rgba(11, 44, 61, 0.28);
      }

      .card-preview-chip {
          margin: 0 0 16px;
          font-size: 11px;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: rgba(255,255,255,.82);
      }

      .card-preview-number {
          font-size: 22px;
          font-weight: 800;
          letter-spacing: 0.06em;
          margin-bottom: 20px;
      }

      .card-preview-row {
          display: flex;
          justify-content: space-between;
          gap: 8px;
          font-size: 12px;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          color: rgba(255,255,255,.86);
      }

      .payment-benefits {
          list-style: none;
          margin: 0;
          padding: 0;
          display: grid;
          gap: 10px;
          color: #5A7084;
          font-size: 13px;
      }

      .payment-benefits li {
          display: flex;
          align-items: center;
          gap: 8px;
      }

      .payment-benefits i {
          color: var(--purchase-accent);
      }

      .paypal-badge {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          margin-bottom: 14px;
          border-radius: 999px;
          background: #EAF2FF;
          border: 1px solid #C8D9F0;
          color: #174A75;
          font-size: 12px;
          font-weight: 800;
          padding: 7px 12px;
      }

      @media (max-width: 1100px) {
          .cart-item {
              grid-template-columns: minmax(200px, 1fr) 100px 130px 100px 42px;
          }

          .cart-grid-head {
              grid-template-columns: minmax(200px, 1fr) 100px 130px 100px 42px;
          }

          .cart-grid-head span:first-child {
              padding-left: 0;
          }
      }

      @media (max-width: 900px) {
          .cart-grid-head {
              display: none;
          }

          .cart-item {
              grid-template-columns: 1fr;
              gap: 10px;
          }

          .item-product,
          .item-price,
          .item-quantity,
          .item-total {
              width: 100%;
          }

          .item-remove {
              justify-self: end;
          }

          .checkout-submit-row .submit-order-btn,
          .checkout-submit-row .btn {
              width: 100%;
          }

          .payment-shell {
              grid-template-columns: 1fr;
          }
      }
  </style>
{% endblock %}

{% block footer %}{% endblock %}

{% block body %}
{% set pageMode = mode|default('supplements') %}
{% if pageMode == 'shop' %}
<section class="shop-section" id="products">
  <div class="container">
    <div class="shop-premium-header">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;">
        <div>
          <h1>Fuel Your Next Level</h1>
          <p>Science-backed supplements curated for consistent progress, recovery, and performance.</p>
          <a href="#productsGrid" class="hero-shop-cta"><i class="fa fa-bolt"></i> Explore Supplements</a>
        </div>
        <div class="shop-flow-actions">
          {% if app.user %}
            <a href="{{ path('app_shop_progress') }}" class="shop-flow-btn">
              <i class="fa fa-line-chart"></i> My Progress
            </a>
            <a href="{{ path('app_shop_leaderboard') }}" class="shop-flow-btn">
              <i class="fa fa-trophy"></i> Ranking
            </a>
          {% endif %}
          <button type="button" class="shop-flow-btn" id="openInlineCartBtn">
            <i class="fa fa-shopping-cart"></i> Cart
          </button>
          <button type="button" class="shop-flow-btn" id="openInlineCheckoutBtn">
            <i class="fa fa-credit-card"></i> Checkout
          </button>
        </div>
      </div>
      <div class="shop-kpis">
        <div class="shop-kpi">
          <span class="label"><i class="fa fa-capsules"></i> Available Products</span>
          <span class="value">{{ supplements|length }}</span>
        </div>
        <div class="shop-kpi">
          <span class="label"><i class="fa fa-truck"></i> Free Shipping</span>
          <span class="value">From 100 DT</span>
        </div>
        <div class="shop-kpi">
          <span class="label"><i class="fa fa-lock"></i> Secure Checkout</span>
          <span class="value">Secure & Fast</span>
        </div>
      </div>
    </div>

    <div class="flow-panels">
      <section class="flow-panel" id="inlineCartPanel">
        <div class="flow-panel-head">
          <h3><i class="fa fa-shopping-cart"></i> Your Cart</h3>
          <button type="button" class="flow-close" data-close-panel="inlineCartPanel"><i class="fa fa-times"></i></button>
        </div>
        <div class="inline-cart-body">
          <div id="inlineCartRows"></div>
          <div class="inline-summary">
            <div class="inline-summary-row"><span>Subtotal</span><strong id="inlineSubtotal">0 DT</strong></div>
            <div class="inline-summary-row"><span>Shipping</span><strong id="inlineShipping">7 DT</strong></div>
            <div class="inline-summary-total"><span>Total</span><span id="inlineTotal">0 DT</span></div>
            <div style="display:flex;justify-content:flex-end;">
              <button type="button" class="btn btn-primary" id="goInlineCheckoutBtn">Proceed to Checkout</button>
            </div>
          </div>
        </div>
      </section>

      <section class="flow-panel" id="inlineCheckoutPanel">
        <div class="flow-panel-head">
          <h3><i class="fa fa-lock"></i> Secure Checkout</h3>
          <button type="button" class="flow-close" data-close-panel="inlineCheckoutPanel"><i class="fa fa-times"></i></button>
        </div>
        <div class="inline-checkout-body">
          <div class="inline-checkout-grid">
            <form id="inlineCheckoutForm" class="inline-checkout-form">
              <div class="form-row">
                <div class="form-group"><input id="coFirstName" type="text" placeholder="First name" required></div>
                <div class="form-group"><input id="coLastName" type="text" placeholder="Last name" required></div>
              </div>
              <div class="form-group"><input id="coEmail" type="email" placeholder="Email" required></div>
              <div class="form-group"><input id="coPhone" type="text" placeholder="Phone" required></div>
              <div class="form-group"><input id="coAddress" type="text" placeholder="Address" required></div>
              <div class="form-row">
                <div class="form-group"><input id="coCity" type="text" placeholder="City" required></div>
                <div class="form-group"><input id="coPostalCode" type="text" placeholder="Postal code" required></div>
              </div>
              <div class="form-group"><textarea id="coNotes" rows="3" placeholder="Notes (optional)"></textarea></div>
              <div class="form-group">
                <label style="font-size:13px;font-weight:700;color:#21384d;margin-bottom:6px;display:block;">Payment method</label>
                <div class="payment-methods-selection">
                  {% for payment in paymentMethods %}
                    <label class="payment-method-option">
                      <input type="radio" name="coPaymentMethod" value="{{ payment.id }}" {% if loop.first %}checked{% endif %}>
                      <div class="payment-method-card"><i class="{{ payment.icon }}"></i> <span>{{ payment.name }}</span></div>
                    </label>
                  {% endfor %}
                </div>
              </div>
              <div class="form-group">
                <input id="coDiscountCode" type="text" placeholder="Discount code">
              </div>
              <button type="submit" class="btn btn-primary" style="width:100%;padding:12px;border-radius:10px;">Confirm Order</button>
            </form>

            <aside class="inline-checkout-summary">
              <h4 style="margin:0 0 8px;color:#0B2C3D;">Order Summary</h4>
              <div id="inlineCheckoutSummaryItems"></div>
              <div class="inline-summary" style="margin-top:8px;">
                <div class="inline-summary-row"><span>Subtotal</span><strong id="coSubtotal">0 DT</strong></div>
                <div class="inline-summary-row"><span>Shipping</span><strong id="coShipping">7 DT</strong></div>
                <div class="inline-summary-row"><span>Discount</span><strong id="coDiscount">0 DT</strong></div>
                <div class="inline-summary-total"><span>Total</span><span id="coTotal">0 DT</span></div>
              </div>
              <p id="coStatus" style="margin:10px 0 0;color:#1B5E4B;font-weight:700;"></p>
            </aside>
          </div>
        </div>
      </section>
    </div>
    <button type="button" class="floating-cart" id="floatingCartBtn" aria-label="Open cart">
      <i class="fa fa-shopping-bag"></i> Cart <span class="count" id="floatingCartCount">0</span>
    </button>

    <div class="shop-layout">
      <aside class="shop-sidebar">
        <div class="filter-search">
          <input type="search" id="searchInput" placeholder="Search supplement name...">
        </div>
        <div class="filter-group" data-filter="categories">
          <h3><button type="button" class="filter-toggle" data-target="categories"><span><i class="fa fa-filter"></i> Categories</span><i class="fa fa-chevron-down"></i></button></h3>
          <div class="filter-content filter-options" id="filter-categories">
            {% for category in categories %}
              <label><input type="checkbox" name="category" value="{{ category }}" class="filter-checkbox"> {{ category }}</label>
            {% endfor %}
          </div>
        </div>
        <div class="filter-group" data-filter="brands">
          <h3><button type="button" class="filter-toggle" data-target="brands"><span><i class="fa fa-tag"></i> Brands</span><i class="fa fa-chevron-down"></i></button></h3>
          <div class="filter-content filter-options" id="filter-brands">
            {% for brand in brands %}
              <label><input type="checkbox" name="brand" value="{{ brand }}" class="filter-checkbox"> {{ brand }}</label>
            {% endfor %}
          </div>
        </div>
        <div class="filter-group" data-filter="price">
          <h3><button type="button" class="filter-toggle" data-target="price"><span><i class="fa fa-dollar-sign"></i> Price Range</span><i class="fa fa-chevron-down"></i></button></h3>
          <div class="filter-content" id="filter-price">
            <input type="range" min="0" max="500" value="500" class="price-slider" id="priceSlider">
            <div class="price-values">
              <span>0 DT</span>
              <span id="maxPrice">500 DT</span>
            </div>
          </div>
        </div>
        <div class="filter-actions">
          <button type="button" class="filter-clear" id="clearFiltersBtn">Clear filters</button>
        </div>
      </aside>

      <div class="shop-main">
        <div class="shop-toolbar">
          <div class="results-count">
            Showing <strong id="showing-count">{{ supplements|length }}</strong> of <strong>{{ supplements|length }}</strong> products
          </div>
          <div class="shop-sort">
            <select id="sortSelect">
              <option value="name-asc">Sort by Name (A-Z)</option>
              <option value="name-desc">Sort by Name (Z-A)</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="newest">Newest First</option>
            </select>
          </div>
        </div>

        <div class="products-grid" id="productsGrid">
          {% for supplement in supplements %}
            {% set summary = ratingSummary[supplement.id] ?? {'avg': 0, 'count': 0} %}
            <div class="product-card"
                 data-category="{{ supplement.category }}"
                 data-brand="{{ supplement.brand }}"
                 data-price="{{ supplement.price }}"
                 data-name="{{ supplement.name }}"
                 data-created="{{ supplement.createdAt|date('Y-m-d') }}"
                 data-stock="{{ supplement.stock }}"
                 data-image="{{ supplement.image ? asset('uploads/supplements/' ~ supplement.image) : asset('images/image_1.jpg') }}"
                 data-description="{{ (supplement.description ?: 'Premium supplement picked for performance, recovery, and clean nutrition support.')|e('html_attr') }}">
              {% if supplement.stock < 10 and supplement.stock > 0 %}
                <span class="badge badge-limited">LIMITED</span>
              {% elseif supplement.stock == 0 %}
                <span class="badge badge-sold">SOLD OUT</span>
              {% elseif supplement.createdAt and supplement.createdAt > date('-30 days') %}
                <span class="badge badge-new">NEW</span>
              {% elseif loop.index <= 3 %}
                <span class="badge badge-new">BEST SELLER</span>
              {% endif %}
              <div class="product-image">
                {% if supplement.image %}
                  <img src="{{ asset('uploads/supplements/' ~ supplement.image) }}" alt="{{ supplement.name }}">
                {% else %}
                  <img src="{{ asset('images/image_1.jpg') }}" alt="{{ supplement.name }}">
                {% endif %}
              </div>
              <div class="product-info">
                <div class="product-brand">{{ supplement.brand }}</div>
                <h3 class="product-name">
                  <a class="product-link" href="{{ path('app_shop_product_show', {id: supplement.id}) }}">{{ supplement.name }}</a>
                </h3>
                <div class="product-category">{{ supplement.category }}</div>
                <div class="product-rating">
                  {% set rounded = summary.avg|default(0)|round(0, 'common') %}
                  {% for i in 1..5 %}
                    <i class="fa {% if i <= rounded %}fa-star{% else %}fa-star-o{% endif %}"></i>
                  {% endfor %}
                  <span>({{ summary.count|default(0) }})</span>
                </div>
                <div class="product-price">{{ supplement.price }} DT</div>
                <div class="product-trust">
                  <span><i class="fa fa-shield"></i> Trusted formula</span>
                  <span><i class="fa fa-bolt"></i> Fast checkout</span>
                </div>
                {% if supplement.stock > 10 %}
                  <div class="stock-chip in"><i class="fa fa-check-circle"></i> In stock</div>
                {% elseif supplement.stock > 0 %}
                  <div class="stock-chip low"><i class="fa fa-exclamation-circle"></i> Low stock</div>
                {% else %}
                  <div class="stock-chip out"><i class="fa fa-times-circle"></i> Out of stock</div>
                {% endif %}
                <button type="button" class="quick-view-btn js-quick-view"><i class="fa fa-search-plus"></i> Quick View</button>
                <a class="view-details-btn" href="{{ path('app_shop_product_show', {id: supplement.id}) }}">
                  <i class="fa fa-eye"></i> View Details
                </a>
                {% if supplement.stock > 0 %}
                  <button class="add-to-cart-btn" data-id="{{ supplement.id }}" data-name="{{ supplement.name }}">
                    <i class="fa fa-shopping-cart"></i> Add to Cart
                  </button>
                {% else %}
                  <button class="add-to-cart-btn" disabled><i class="fa fa-times"></i> Out of Stock</button>
                {% endif %}
              </div>
            </div>
          {% else %}
            <p class="no-products">No products found.</p>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="quick-modal" id="quickViewModal" aria-hidden="true">
      <div class="quick-modal-card">
        <div class="quick-modal-grid">
          <div class="quick-modal-media"><img id="quickViewImage" src="" alt="Supplement"></div>
          <div class="quick-modal-body">
            <button type="button" class="quick-modal-close" id="quickViewClose"><i class="fa fa-times"></i></button>
            <p style="margin:0;color:#1B5E4B;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;" id="quickViewBrand"></p>
            <h3 style="margin:6px 0 10px;color:#0B2C3D;font-size:30px;font-weight:900;" id="quickViewName"></h3>
            <p style="margin:0 0 8px;color:#5f7082;" id="quickViewMeta"></p>
            <div style="font-size:32px;font-weight:900;color:#1B5E4B;margin-bottom:12px;" id="quickViewPrice"></div>
            <p style="margin:0 0 16px;color:#445a6e;line-height:1.7;" id="quickViewDesc"></p>
            <button type="button" class="add-to-cart-btn" id="quickViewAdd"><i class="fa fa-shopping-cart"></i> Add to Cart</button>
          </div>
        </div>
      </div>
    </div>

    <section class="ai-suggestion-shell" id="aiSuggestionAssistant">
      <div class="ai-suggestion-top">
        <div>
          <p class="ai-suggestion-eyebrow">Fitopia AI Assistant</p>
          <h2 class="ai-suggestion-title">Tell AI your goal, get supplement picks</h2>
          <p class="ai-suggestion-copy">
            Enter your objective and the assistant will suggest supplements using your cart context and catalog signals.
          </p>
        </div>
        <div class="ai-suggestion-controls">
          <span class="ai-suggestion-chip"><i class="fa fa-magic"></i> AI + Smart fallback</span>
          <button type="button" class="ai-refresh-btn" id="aiRefreshBtn"><i class="fa fa-refresh"></i> Refresh Mix</button>
        </div>
      </div>

      <form id="aiSuggestForm" class="ai-suggestion-form">
        <input
          type="text"
          id="aiGoalInput"
          maxlength="240"
          placeholder="Example: I want better recovery and less fatigue after training"
        >
        <button type="submit" class="btn btn-primary"><i class="fa fa-paper-plane"></i> Get Suggestions</button>
      </form>

      <div class="ai-goal-list">
        <button type="button" class="ai-goal-btn js-ai-goal" data-goal="Build lean muscle and support daily recovery">Lean Muscle</button>
        <button type="button" class="ai-goal-btn js-ai-goal" data-goal="Improve endurance for long workouts and cardio sessions">Endurance</button>
        <button type="button" class="ai-goal-btn js-ai-goal" data-goal="Support fat loss while keeping workout energy high">Fat Loss</button>
        <button type="button" class="ai-goal-btn js-ai-goal" data-goal="Find budget friendly daily health supplements">Budget Daily Stack</button>
      </div>

      <p class="ai-suggestion-status" id="aiSuggestStatus" data-tone="muted">Describe your goal and click "Get Suggestions".</p>
      <div class="ai-suggestion-grid" id="aiSuggestGrid">
        <div class="ai-suggestion-empty">AI suggestions will appear here.</div>
      </div>
    </section>
  </div>
</section>
{% if newForm is defined and editForm is defined %}
<div class="admin-divider">Admin Inventory Console</div>
<section class="container">
  <div class="studio-shell">
    <div class="studio-top">
      <div>
        <p style="margin:0; font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:#1B5E4B; font-weight:700;">Supplement Studio</p>
        <h2 style="margin:6px 0 4px; color:#0B2C3D; font-size:30px; font-weight:800;">Manage Your Inventory</h2>
        <p style="margin:0; color:#5f7082;">Professional catalog control: create, update, remove, and review your full supplement range.</p>
      </div>
      <a href="{{ path('app_supplement_new') }}" class="btn btn-primary" style="padding:12px 18px; border-radius:12px;">
        <i class="fa fa-plus"></i> Add Supplement
      </a>
    </div>

    <div class="studio-grid">
      {% for supplement in supplements %}
        <article class="studio-card">
          <div class="studio-card-head">
            <div class="studio-thumb">
              {% if supplement.image %}
                <img src="{{ asset('uploads/supplements/' ~ supplement.image) }}" alt="{{ supplement.name }}">
              {% else %}
                <i class="fa fa-capsules" style="color:#fff; font-size:30px;"></i>
              {% endif %}
            </div>
            <div style="min-width:0;">
              <h3 style="margin:0 0 3px; font-size:20px; color:#0B2C3D; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ supplement.name }}</h3>
              <p style="margin:0 0 8px; font-size:12px; color:#1B5E4B; font-weight:700; letter-spacing:0.08em; text-transform:uppercase;">{{ supplement.brand }}</p>
              <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <span style="background:#eef4f8; color:#29485d; border-radius:999px; padding:4px 10px; font-size:12px;">{{ supplement.category }}</span>
                <span style="background:#eaf8f1; color:#1B5E4B; border-radius:999px; padding:4px 10px; font-size:12px;">Stock: {{ supplement.stock }}</span>
              </div>
            </div>
          </div>
          <div class="studio-card-body">
            <div style="font-size:28px; font-weight:900; color:#1B5E4B; margin-bottom:10px;">{{ supplement.price }} DT</div>
            <div class="studio-actions">
              <a href="{{ path('app_shop_product_show', {'id': supplement.id}) }}" class="btn btn-secondary" style="border-radius:10px; text-align:center;">
                <i class="fa fa-eye"></i> View
              </a>
              <a href="{{ path('app_supplement_edit', {'id': supplement.id}) }}" class="btn btn-secondary" style="border-radius:10px; text-align:center;">
                <i class="fa fa-edit"></i> Update
              </a>
              <a href="{{ path('app_supplement_show', {'id': supplement.id}) }}" class="btn btn-secondary" style="border-radius:10px; text-align:center; grid-column: span 2;">
                <i class="fa fa-list"></i> View Full Details
              </a>
              <form method="post" action="{{ path('app_supplement_delete', {'id': supplement.id}) }}" style="grid-column: span 2;" onsubmit="return confirm('Delete {{ supplement.name|e('js') }}?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ supplement.id) }}">
                <button type="submit" class="btn btn-danger" style="width:100%; border-radius:10px;">
                  <i class="fa fa-trash"></i> Delete
                </button>
              </form>
            </div>
          </div>
        </article>
      {% else %}
        <div style="grid-column:1/-1; background:#fff; border:1px dashed #c9d8e6; border-radius:14px; padding:22px; text-align:center; color:#567;">
          No supplements available yet.
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const supplementCatalog = {
    {% for supplement in supplements %}
    '{{ supplement.id }}': {
      name: '{{ supplement.name|e('js') }}',
      brand: '{{ supplement.brand|e('js') }}',
      category: '{{ supplement.category|e('js') }}',
      price: {{ supplement.price + 0 }},
      image: '{{ supplement.image ? asset('uploads/supplements/' ~ supplement.image) : asset('images/image_1.jpg') }}'
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  };

  const products = Array.from(document.querySelectorAll('#productsGrid .product-card'));
  const showingCount = document.getElementById('showing-count');
  const priceSlider = document.getElementById('priceSlider');
  const maxPrice = document.getElementById('maxPrice');
  const productsGrid = document.getElementById('productsGrid');
  const searchInput = document.getElementById('searchInput');
  const inlineCartPanel = document.getElementById('inlineCartPanel');
  const inlineCheckoutPanel = document.getElementById('inlineCheckoutPanel');
  const inlineCartRows = document.getElementById('inlineCartRows');
  const inlineCheckoutItems = document.getElementById('inlineCheckoutSummaryItems');
  const floatingCartBtn = document.getElementById('floatingCartBtn');
  const floatingCartCount = document.getElementById('floatingCartCount');
  const quickModal = document.getElementById('quickViewModal');
  const quickClose = document.getElementById('quickViewClose');
  const quickAdd = document.getElementById('quickViewAdd');
  const aiSuggestForm = document.getElementById('aiSuggestForm');
  const aiGoalInput = document.getElementById('aiGoalInput');
  const aiSuggestGrid = document.getElementById('aiSuggestGrid');
  const aiSuggestStatus = document.getElementById('aiSuggestStatus');
  const aiRefreshBtn = document.getElementById('aiRefreshBtn');
  const productDetailUrlTemplate = '{{ path('app_shop_product_show', {'id': '__SUPPLEMENT_ID__'}) }}';
  let quickViewSelectedId = null;
  let currentCart = [];
  let aiShownIds = [];
  let aiLastQueryKey = '__default__';
  let inlineCheckoutSubmitting = false;

  const fmt = (v) => Number(v).toFixed(2) + ' DT';
  const shippingFor = (subtotal) => subtotal >= 100 ? 0 : 7;

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function setAiStatus(message, tone = 'muted') {
    if (!aiSuggestStatus) return;
    aiSuggestStatus.textContent = message;
    aiSuggestStatus.setAttribute('data-tone', tone);
  }

  function renderAiSuggestions(suggestions) {
    if (!aiSuggestGrid) return;
    if (!Array.isArray(suggestions) || suggestions.length === 0) {
      aiSuggestGrid.innerHTML = '<div class="ai-suggestion-empty">No suggestions available for this prompt. Try a more specific goal.</div>';
      return;
    }

    aiSuggestGrid.innerHTML = suggestions.map((suggestion) => {
      const id = Number(suggestion.id || 0);
      const safeId = id > 0 ? id : 0;
      const source = String(suggestion.source || 'heuristic').toLowerCase();
      const sourceClass = source === 'ai' ? 'ai' : 'heuristic';
      const sourceLabel = source === 'ai' ? 'AI Match' : 'Smart Match';
      const reason = escapeHtml(suggestion.reason || 'Good fit for your supplement profile.');
      const name = escapeHtml(suggestion.name || 'Supplement');
      const brand = escapeHtml(suggestion.brand || 'Brand');
      const category = escapeHtml(suggestion.category || 'Category');
      const image = escapeHtml(suggestion.image || '{{ asset('images/image_1.jpg') }}');
      const stock = Number(suggestion.stock || 0);
      const score = Number(suggestion.score || 0);
      const productUrl = productDetailUrlTemplate.replace('__SUPPLEMENT_ID__', String(safeId));

      return `
        <article class="ai-suggestion-card">
          <div class="ai-suggestion-media"><img src="${image}" alt="${name}"></div>
          <div class="ai-suggestion-body">
            <div class="ai-suggestion-meta">
              <span class="ai-source-badge ${sourceClass}">${sourceLabel}</span>
              <span class="ai-score">${Math.round(score)}% match</span>
            </div>
            <h3 class="ai-suggestion-name">${name}</h3>
            <p class="ai-suggestion-note">${reason}</p>
            <div class="ai-suggestion-foot">
              <span>${brand} | ${category}</span>
              <strong>${fmt(suggestion.price || 0)}</strong>
            </div>
            <div class="ai-suggestion-actions">
              <a href="${escapeHtml(productUrl)}" class="btn btn-secondary">View</a>
              <button type="button" class="btn btn-primary js-ai-add" data-id="${safeId}" ${stock > 0 ? '' : 'disabled'}>
                ${stock > 0 ? 'Add to Cart' : 'Out of Stock'}
              </button>
            </div>
          </div>
        </article>
      `;
    }).join('');
  }

  function requestAiSuggestions(query = '', focusProductId = null, allowReset = true) {
    if (!aiSuggestGrid) return Promise.resolve();

    const normalizedQuery = String(query || '').trim();
    const queryKey = normalizedQuery !== '' ? normalizedQuery.toLowerCase() : '__default__';
    if (queryKey !== aiLastQueryKey) {
      aiShownIds = [];
      aiLastQueryKey = queryKey;
    }

    setAiStatus('Analyzing your goal and current cart context...', 'loading');
    aiSuggestGrid.innerHTML = '<div class="ai-suggestion-empty">Generating recommendations...</div>';

    return fetch('{{ path('app_shop_ai_suggestions') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        query: normalizedQuery,
        focusProductId: focusProductId ? Number(focusProductId) : null,
        limit: 6,
        excludeIds: aiShownIds
      })
    })
      .then((response) => response.json())
      .then((payload) => {
        const suggestions = Array.isArray(payload.suggestions) ? payload.suggestions : [];
        const returnedIds = suggestions
          .map((item) => Number(item.id || 0))
          .filter((id) => id > 0);

        if (returnedIds.length > 0) {
          aiShownIds = Array.from(new Set([...aiShownIds, ...returnedIds])).slice(-80);
        }

        renderAiSuggestions(suggestions);
        if (suggestions.length === 0) {
          if (allowReset && aiShownIds.length > 0) {
            aiShownIds = [];
            return requestAiSuggestions(normalizedQuery, focusProductId, false);
          }
          setAiStatus('No close results found. Try adding details like budget, goal, or timing.', 'warning');
          return;
        }

        const hasAi = suggestions.some((item) => String(item.source || '').toLowerCase() === 'ai');
        const sourceLabel = hasAi ? 'AI model recommendations' : 'smart fallback recommendations';
        setAiStatus(`Showing ${suggestions.length} ${sourceLabel}.`, 'success');
      })
      .catch(() => {
        renderAiSuggestions([]);
        setAiStatus('Suggestion service is temporarily unavailable. Please retry.', 'error');
      });
  }

  function openPanel(panel) {
    [inlineCartPanel, inlineCheckoutPanel].forEach((el) => el && el.classList.remove('is-open'));
    if (panel) {
      panel.classList.add('is-open');
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function getCartRowsSubtotal() {
    let subtotal = 0;
    currentCart.forEach((item) => {
      const p = supplementCatalog[String(item.id)];
      if (!p) return;
      subtotal += Number(p.price) * Number(item.quantity);
    });
    return subtotal;
  }

  function updateFloatingCartCount() {
    if (!floatingCartCount) return;
    const count = currentCart.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
    floatingCartCount.textContent = String(count);
  }

  function renderInlineCart() {
    if (!inlineCartRows) return;
    if (currentCart.length === 0) {
      inlineCartRows.innerHTML = '<div style="padding:14px;color:#607284;">Your cart is empty. Add a supplement to continue.</div>';
      document.getElementById('inlineSubtotal').textContent = fmt(0);
      document.getElementById('inlineShipping').textContent = '7.00 DT';
      document.getElementById('inlineTotal').textContent = fmt(7);
      return;
    }

    inlineCartRows.innerHTML = currentCart.map((item) => {
      const p = supplementCatalog[String(item.id)];
      if (!p) return '';
      const lineTotal = Number(p.price) * Number(item.quantity);
      return `
        <div class="inline-cart-row" data-id="${item.id}">
          <div class="inline-cart-thumb"><img src="${p.image}" alt="${p.name}"></div>
          <div><strong>${p.name}</strong><div style="font-size:12px;color:#667a8e;">${p.brand} | ${p.category}</div></div>
          <div><strong>${fmt(p.price)}</strong></div>
          <div class="inline-qty">
            <button type="button" data-act="dec">-</button>
            <span>${item.quantity}</span>
            <button type="button" data-act="inc">+</button>
          </div>
          <div><strong>${fmt(lineTotal)}</strong></div>
          <button type="button" data-act="remove" style="border:0;background:#fee2e2;color:#dc2626;border-radius:8px;width:32px;height:32px;"><i class="fa fa-trash"></i></button>
        </div>
      `;
    }).join('');

    const subtotal = getCartRowsSubtotal();
    const shipping = shippingFor(subtotal);
    document.getElementById('inlineSubtotal').textContent = fmt(subtotal);
    document.getElementById('inlineShipping').textContent = fmt(shipping);
    document.getElementById('inlineTotal').textContent = fmt(subtotal + shipping);
  }

  function renderInlineCheckoutSummary() {
    if (!inlineCheckoutItems) return;
    if (currentCart.length === 0) {
      inlineCheckoutItems.innerHTML = '<div style="color:#6d8093;">No items in cart.</div>';
      document.getElementById('coSubtotal').textContent = fmt(0);
      document.getElementById('coShipping').textContent = fmt(7);
      document.getElementById('coDiscount').textContent = fmt(0);
      document.getElementById('coTotal').textContent = fmt(7);
      return;
    }

    inlineCheckoutItems.innerHTML = currentCart.map((item) => {
      const p = supplementCatalog[String(item.id)];
      if (!p) return '';
      return `<div class="inline-summary-row"><span>${p.name} x${item.quantity}</span><strong>${fmt(Number(p.price) * Number(item.quantity))}</strong></div>`;
    }).join('');

    const subtotal = getCartRowsSubtotal();
    const shipping = shippingFor(subtotal);
    const code = (document.getElementById('coDiscountCode')?.value || '').trim().toLowerCase();
    const discount = code === 'ali123' ? subtotal * 0.10 : 0;
    document.getElementById('coSubtotal').textContent = fmt(subtotal);
    document.getElementById('coShipping').textContent = fmt(shipping);
    document.getElementById('coDiscount').textContent = '-' + fmt(discount);
    document.getElementById('coTotal').textContent = fmt(subtotal + shipping - discount);
  }

  function fetchCartAndRender() {
    return fetch('{{ path('app_shop_cart_get') }}')
      .then((r) => r.json())
      .then((data) => {
        currentCart = Array.isArray(data.cart) ? data.cart : [];
        renderInlineCart();
        renderInlineCheckoutSummary();
        updateFloatingCartCount();
        if (typeof updateCartCount === 'function') updateCartCount();
      });
  }

  function filterProducts() {
    const selectedCategories = Array.from(document.querySelectorAll('input[name="category"]:checked')).map((el) => el.value);
    const selectedBrands = Array.from(document.querySelectorAll('input[name="brand"]:checked')).map((el) => el.value);
    const ceiling = parseFloat(priceSlider ? priceSlider.value : '500');
    const searchTerm = (searchInput ? searchInput.value : '').trim().toLowerCase();
    let visible = 0;

    products.forEach((product) => {
      const matchCategory = selectedCategories.length === 0 || selectedCategories.includes(product.dataset.category);
      const matchBrand = selectedBrands.length === 0 || selectedBrands.includes(product.dataset.brand);
      const matchPrice = parseFloat(product.dataset.price || '0') <= ceiling;
      const matchSearch = searchTerm === '' || (product.dataset.name || '').toLowerCase().includes(searchTerm);
      const show = matchCategory && matchBrand && matchPrice && matchSearch;
      product.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (showingCount) showingCount.textContent = String(visible);
  }

  document.querySelectorAll('.filter-checkbox').forEach((el) => el.addEventListener('change', filterProducts));
  if (priceSlider) {
    priceSlider.addEventListener('input', function () {
      if (maxPrice) maxPrice.textContent = this.value + ' DT';
      filterProducts();
    });
  }
  if (searchInput) {
    searchInput.addEventListener('input', filterProducts);
  }

  document.getElementById('clearFiltersBtn')?.addEventListener('click', function () {
    document.querySelectorAll('.filter-checkbox').forEach((el) => { el.checked = false; });
    if (priceSlider) {
      priceSlider.value = '500';
      if (maxPrice) maxPrice.textContent = '500 DT';
    }
    if (searchInput) searchInput.value = '';
    filterProducts();
  });

  document.getElementById('sortSelect')?.addEventListener('change', function () {
    const value = this.value;
    const sorted = [...products].sort((a, b) => {
      if (value === 'name-asc') return a.dataset.name.localeCompare(b.dataset.name);
      if (value === 'name-desc') return b.dataset.name.localeCompare(a.dataset.name);
      if (value === 'price-asc') return parseFloat(a.dataset.price || '0') - parseFloat(b.dataset.price || '0');
      if (value === 'price-desc') return parseFloat(b.dataset.price || '0') - parseFloat(a.dataset.price || '0');
      if (value === 'newest') return new Date(b.dataset.created) - new Date(a.dataset.created);
      return 0;
    });
    sorted.forEach((el) => productsGrid?.appendChild(el));
  });

  document.querySelectorAll('.filter-toggle').forEach((btn) => {
    btn.addEventListener('click', function () {
      const group = this.closest('.filter-group');
      if (!group) return;
      group.classList.toggle('collapsed');
    });
  });

  function addProductToCart(supplementId, buttonEl, openCartAfter = true) {
    if (!supplementId) return Promise.resolve();
    if (buttonEl) {
      buttonEl.disabled = true;
      buttonEl.classList.add('adding');
    }
    return fetch('{{ path('app_shop_cart_add') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ supplementId: supplementId, quantity: 1 })
    })
      .then((r) => r.json())
      .then((data) => {
        if (data && data.success) {
          return fetchCartAndRender().then(() => {
            if (openCartAfter) openPanel(inlineCartPanel);
          });
        }
      })
      .catch(() => alert('Error adding product to cart'))
      .finally(() => {
        if (buttonEl) {
          buttonEl.disabled = false;
          setTimeout(() => buttonEl.classList.remove('adding'), 220);
        }
      });
  }

  document.querySelectorAll('.add-to-cart-btn[data-id]').forEach((btn) => {
    btn.addEventListener('click', function () {
      addProductToCart(this.dataset.id, this, true);
    });
  });

  document.querySelectorAll('.js-quick-view').forEach((btn) => {
    btn.addEventListener('click', function () {
      const card = this.closest('.product-card');
      if (!card || !quickModal) return;
      quickViewSelectedId = card.querySelector('.add-to-cart-btn[data-id]')?.dataset.id || null;
      document.getElementById('quickViewBrand').textContent = card.dataset.brand || '';
      document.getElementById('quickViewName').textContent = card.dataset.name || '';
      document.getElementById('quickViewMeta').textContent = `${card.dataset.category || ''} | Stock ${card.dataset.stock || '0'}`;
      document.getElementById('quickViewPrice').textContent = `${Number(card.dataset.price || 0).toFixed(2)} DT`;
      document.getElementById('quickViewDesc').textContent = card.dataset.description || '';
      document.getElementById('quickViewImage').src = card.dataset.image || '{{ asset('images/image_1.jpg') }}';
      quickAdd.disabled = Number(card.dataset.stock || 0) <= 0;
      quickModal.classList.add('open');
      quickModal.setAttribute('aria-hidden', 'false');
    });
  });

  quickClose?.addEventListener('click', () => {
    quickModal?.classList.remove('open');
    quickModal?.setAttribute('aria-hidden', 'true');
  });
  quickModal?.addEventListener('click', (e) => {
    if (e.target === quickModal) {
      quickModal.classList.remove('open');
      quickModal.setAttribute('aria-hidden', 'true');
    }
  });
  quickAdd?.addEventListener('click', function () {
    addProductToCart(quickViewSelectedId, this, true).then(() => {
      quickModal?.classList.remove('open');
      quickModal?.setAttribute('aria-hidden', 'true');
    });
  });

  aiSuggestForm?.addEventListener('submit', function (event) {
    event.preventDefault();
    const query = (aiGoalInput?.value || '').trim();
    requestAiSuggestions(query, quickViewSelectedId);
  });

  aiRefreshBtn?.addEventListener('click', function () {
    const query = (aiGoalInput?.value || '').trim();
    requestAiSuggestions(query, quickViewSelectedId);
  });

  document.querySelectorAll('.js-ai-goal').forEach((button) => {
    button.addEventListener('click', function () {
      const goal = this.getAttribute('data-goal') || '';
      if (aiGoalInput) {
        aiGoalInput.value = goal;
      }
      requestAiSuggestions(goal, quickViewSelectedId);
    });
  });

  aiSuggestGrid?.addEventListener('click', function (event) {
    const addButton = event.target.closest('.js-ai-add');
    if (!addButton) return;
    addProductToCart(addButton.dataset.id, addButton, true);
  });

  document.getElementById('openInlineCartBtn')?.addEventListener('click', function () {
    fetchCartAndRender().then(() => openPanel(inlineCartPanel));
  });
  floatingCartBtn?.addEventListener('click', function () {
    fetchCartAndRender().then(() => openPanel(inlineCartPanel));
  });

  document.getElementById('openInlineCheckoutBtn')?.addEventListener('click', function () {
    fetchCartAndRender().then(() => openPanel(inlineCheckoutPanel));
  });

  document.getElementById('goInlineCheckoutBtn')?.addEventListener('click', function () {
    fetchCartAndRender().then(() => openPanel(inlineCheckoutPanel));
  });

  document.querySelectorAll('[data-close-panel]').forEach((btn) => {
    btn.addEventListener('click', function () {
      const id = this.getAttribute('data-close-panel');
      document.getElementById(id)?.classList.remove('is-open');
    });
  });

  document.getElementById('coDiscountCode')?.addEventListener('input', renderInlineCheckoutSummary);

  inlineCartRows?.addEventListener('click', function (event) {
    const btn = event.target.closest('button[data-act]');
    if (!btn) return;
    const row = event.target.closest('.inline-cart-row');
    if (!row) return;
    const id = parseInt(row.getAttribute('data-id'), 10);
    const item = currentCart.find((x) => Number(x.id) === id);
    if (!item) return;
    const act = btn.getAttribute('data-act');

    if (act === 'remove') {
      fetch('{{ path('app_shop_cart_remove') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ supplementId: id })
      }).then(fetchCartAndRender);
      return;
    }

    const nextQty = act === 'inc' ? Number(item.quantity) + 1 : Math.max(1, Number(item.quantity) - 1);
    fetch('{{ path('app_shop_cart_update') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ supplementId: id, quantity: nextQty })
    }).then(fetchCartAndRender);
  });

  document.getElementById('inlineCheckoutForm')?.addEventListener('submit', function (e) {
    e.preventDefault();
    if (inlineCheckoutSubmitting) return;

    const submitButton = this.querySelector('button[type="submit"]');
    const originalSubmitLabel = submitButton ? submitButton.innerHTML : '';
    const subtotal = getCartRowsSubtotal();
    if (subtotal <= 0) {
      alert('Your cart is empty.');
      openPanel(inlineCartPanel);
      return;
    }
    inlineCheckoutSubmitting = true;
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Processing...';
    }

    const discountCode = (document.getElementById('coDiscountCode')?.value || '').trim();
    const payload = {
      firstName: document.getElementById('coFirstName').value,
      lastName: document.getElementById('coLastName').value,
      email: document.getElementById('coEmail').value,
      phone: document.getElementById('coPhone').value,
      address: document.getElementById('coAddress').value,
      city: document.getElementById('coCity').value,
      postalCode: document.getElementById('coPostalCode').value,
      notes: document.getElementById('coNotes').value,
      paymentMethod: document.querySelector('input[name="coPaymentMethod"]:checked')?.value || 'cod',
      discountCode: discountCode
    };

    fetch('{{ path('app_shop_order_create') }}', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(async (r) => {
        const data = await r.json().catch(() => ({}));
        if (!r.ok) {
          const message = data && data.message ? data.message : 'Could not complete order.';
          throw new Error(message);
        }
        return data;
      })
      .then((res) => {
        if (!res || !res.success || !res.orderNumber) {
          alert((res && res.message) ? res.message : 'Could not complete order.');
          return;
        }
        if (res.emailSent === false) {
          console.warn('Order confirmation email was not sent.', {
            transport: res.emailTransport || null,
            error: res.emailError || null
          });
        }
        window.location.href = '{{ path('app_shop_order_success', {orderNumber: '__ORDER__'}) }}'
          .replace('__ORDER__', res.orderNumber);
      })
      .catch((error) => alert(error && error.message ? error.message : 'Error while creating order'))
      .finally(() => {
        inlineCheckoutSubmitting = false;
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.innerHTML = originalSubmitLabel;
        }
      });
  });

  fetchCartAndRender()
    .then(() => requestAiSuggestions(''))
    .catch(() => requestAiSuggestions(''));
});
</script>
{% elseif pageMode == 'cart' %}
<section class="cart-section">
  <div class="container">
    {% if cartItems is empty %}
      <div class="cart-empty-state">
        <div class="cart-empty-icon"><i class="fa fa-shopping-basket"></i></div>
        <h2>Your cart is empty</h2>
        <p style="margin:8px 0 18px;color:#5D7488;">Add supplements to unlock personalized checkout and faster payment flow.</p>
        <a href="{{ path('app_shop_index') }}" class="btn btn-primary">Continue Shopping</a>
      </div>
    {% else %}
      <div class="cart-header">
        <div>
          <p class="checkout-step">Checkout Step 1</p>
          <h2>Review your cart</h2>
          <p>Adjust quantity and verify totals before secure checkout.</p>
        </div>
        <a href="{{ path('app_shop_index') }}" class="cart-continue-link">
          <i class="fa fa-arrow-left"></i> Continue Shopping
        </a>
      </div>
      <div class="cart-layout">
        <div class="cart-main">
