<script>
document.addEventListener('DOMContentLoaded', function () {
  const addToCartButton = document.getElementById('productDetailAddToCart');
  const detailStatus = document.getElementById('productDetailStatus');
  if (addToCartButton) {
    addToCartButton.addEventListener('click', function () {
      const supplementId = this.dataset.id;
      const originalLabel = this.innerHTML;
      this.disabled = true;
      this.classList.add('adding');
      this.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Adding...';
      if (detailStatus) {
        detailStatus.textContent = 'Adding product to cart...';
        detailStatus.classList.remove('is-error');
      }

      fetch('{{ path('app_shop_cart_add') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ supplementId, quantity: 1 })
      })
        .then((response) => response.json().then((data) => ({ ok: response.ok, data })))
        .then(({ ok, data }) => {
          if (!ok || !data.success) {
            throw new Error(data.message || 'Unable to add this product to cart.');
          }

          if (typeof updateCartCount === 'function') {
            updateCartCount();
          }

          if (detailStatus) {
            detailStatus.textContent = data.message || 'Product added to cart.';
            detailStatus.classList.remove('is-error');
          }
        })
        .catch((error) => {
          if (detailStatus) {
            detailStatus.textContent = error && error.message ? error.message : 'Unable to add this product to cart.';
            detailStatus.classList.add('is-error');
          }
        })
        .finally(() => {
          this.disabled = false;
          this.classList.remove('adding');
          this.innerHTML = originalLabel;
        });
    });
  }

  const ratingInput = document.getElementById('ratingInput');
  const ratingValue = document.getElementById('review-rating');
  const ratingHelper = document.getElementById('ratingHelper');
  if (!ratingInput || !ratingValue) return;
  let selected = 0;
  const stars = Array.from(ratingInput.querySelectorAll('.rating-star'));

  const renderStars = function (activeValue) {
    stars.forEach((starButton) => {
      const starValue = parseInt(starButton.dataset.value || '0', 10);
      const active = starValue <= activeValue;
      starButton.classList.toggle('is-active', active);
      starButton.innerHTML = active ? '<i class="fa fa-star"></i>' : '<i class="fa fa-star-o"></i>';
    });
  };

  ratingInput.addEventListener('mouseover', function (e) {
    const hoveredStar = e.target.closest('.rating-star');
    if (!hoveredStar) return;
    renderStars(parseInt(hoveredStar.dataset.value || '0', 10));
  });

  ratingInput.addEventListener('mouseout', function () {
    renderStars(selected);
  });

  ratingInput.addEventListener('click', function (e) {
    const clickedStar = e.target.closest('.rating-star');
    if (!clickedStar) return;
    selected = parseInt(clickedStar.dataset.value || '0', 10);
    ratingValue.value = selected;
    renderStars(selected);
    if (ratingHelper) {
      ratingHelper.textContent = 'Selected rating: ' + selected + '/5';
    }
  });
});
</script>
