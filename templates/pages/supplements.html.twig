          color: #0aaf73;
          font-size: 1rem;
          font-weight: 800;
      }

      .favorites-panel-action,
      .favorites-reco-action {
          border: 0;
          border-radius: 18px;
          padding: 12px 24px;
          background: #f4f6fa;
          color: #334a62;
          font-size: 0.98rem;
          font-weight: 800;
          cursor: pointer;
          box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.03);
      }

      .favorites-panel-action:hover,
      .favorites-reco-action:hover {
          background: #edf1f6;
      }

      .favorites-panel-count-badge {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-width: 40px;
          height: 40px;
          margin-left: 12px;
          border-radius: 999px;
          background: #16c68a;
          color: #fff;
          font-size: 1rem;
          font-weight: 900;
      }

      .favorite-showcase-grid {
          display: flex;
          flex-wrap: wrap;
          gap: 18px;
      }

      .favorite-showcase-card {
          width: 224px;
          min-height: 172px;
          border-radius: 18px;
          background: #f9fbff;
          border: 1px solid #eef3f9;
          box-shadow: inset 0 0 0 1px rgba(255,255,255,0.4);
          padding: 16px;
          display: flex;
          flex-direction: column;
          gap: 12px;
          position: relative;
      }

      .favorite-showcase-head {
          padding-right: 28px;
      }

      .favorite-showcase-name {
          display: block;
          color: #071b39;
          font-size: 1.05rem;
          font-weight: 900;
          line-height: 1.2;
          text-decoration: none;
      }

      .favorite-showcase-name:hover {
          color: #071b39;
          text-decoration: none;
      }

      .favorite-showcase-price {
          display: block;
          margin-top: 6px;
          color: #0aa96f;
          font-size: 0.98rem;
          font-weight: 900;
      }

      .favorite-showcase-body {
          display: flex;
          align-items: flex-end;
          justify-content: space-between;
          gap: 12px;
          margin-top: auto;
      }

      .favorite-showcase-thumb {
          width: 58px;
          height: 58px;
          border-radius: 14px;
          background: #ffffff;
          display: grid;
          place-items: center;
          overflow: hidden;
          box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06);
      }

      .favorite-showcase-thumb img {
          width: 100%;
          height: 100%;
          object-fit: contain;
      }

      .favorite-remove-btn {
          border: 0;
          background: transparent;
          color: #ff4e4e;
          font-size: 1.25rem;
          line-height: 1;
          cursor: pointer;
          padding: 4px;
      }

      .favorite-remove-btn:hover {
          color: #e12727;
      }

      .favorite-showcase-empty {
          display: none;
          margin-top: 4px;
          border-radius: 20px;
          padding: 22px 24px;
          background: #f7fafc;
          color: #61798b;
          font-weight: 700;
      }

      .favorites-panel.is-collapsed .favorite-showcase-grid,
      .favorites-panel.is-collapsed .favorite-showcase-empty {
          display: none !important;
      }

      .favorites-reco-shell {
          background: #ffffff;
          border-radius: 34px;
          box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
          padding: 30px 32px 34px;
      }

      .favorites-reco-grid {
          display: grid;
          grid-auto-flow: column;
          grid-auto-columns: minmax(340px, 1fr);
          gap: 24px;
          overflow-x: auto;
          padding-bottom: 6px;
          scrollbar-width: thin;
      }

      .favorites-reco-grid::-webkit-scrollbar {
          height: 8px;
      }

      .favorites-reco-grid::-webkit-scrollbar-thumb {
          background: rgba(17, 24, 39, 0.18);
          border-radius: 999px;
      }

      .favorite-reco-card {
          min-height: 238px;
          border-radius: 28px;
          background: #151d2d;
          color: #fff;
          padding: 26px 24px 22px;
          box-shadow: 0 22px 38px rgba(12, 19, 30, 0.18);
          display: flex;
          flex-direction: column;
          gap: 18px;
      }

      .favorite-reco-note {
          color: #18ca8b;
          font-size: 0.95rem;
          font-weight: 800;
      }

      .favorite-reco-name {
          margin: 0;
          color: #ffffff;
          font-size: 1.18rem;
          font-weight: 900;
          line-height: 1.2;
      }

      .favorite-reco-price {
          color: #ffffff;
          font-size: 1.02rem;
          font-weight: 800;
      }

      .favorite-reco-actions {
          margin-top: auto;
          display: flex;
          gap: 14px;
          align-items: center;
      }

      .favorite-reco-view {
          width: 54px;
          height: 38px;
          border: 0;
          border-radius: 12px;
          background: #2a3446;
          color: #fff;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
      }

      .favorite-reco-view:hover {
          background: #334158;
      }

      .favorite-reco-cart {
          flex: 1;
          min-height: 38px;
          border: 0;
          border-radius: 14px;
          background: #18c68b;
          color: #fff;
          font-weight: 900;
          cursor: pointer;
      }

      .favorite-reco-cart:hover {
          background: #12b77d;
      }

      .favorite-reco-cart[disabled] {
          background: #617189;
          cursor: not-allowed;
      }

      @media (max-width: 991px) {
          .favorites-panel,
          .favorites-reco-shell {
              padding: 24px 20px 26px;
              border-radius: 26px;
          }

          .favorites-panel-top,
          .favorites-reco-top {
              flex-direction: column;
              align-items: stretch;
          }

          .favorite-showcase-card {
              width: 100%;
          }

          .favorites-reco-grid {
              grid-auto-columns: minmax(280px, 86vw);
          }
      }

      #supplements-storefront .shop-toolbar {
          background: transparent;
          box-shadow: none;
          border: 0;
          padding: 0 6px;
          margin-bottom: 20px;
      }

      #supplements-storefront .results-count {
          color: #4c6276;
          font-size: 15px;
      }

      #supplements-storefront .shop-sort select {
          min-height: 48px;
          border-radius: 14px;
          background: #fff;
      }

      #supplements-storefront .products-grid {
          margin-top: 0;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 30px;
      }

      #supplements-storefront .product-card {
          border-radius: 30px;
          border: 1px solid #dff1eb;
          box-shadow: 0 18px 36px rgba(13, 106, 87, 0.09);
          overflow: hidden;
      }

      #supplements-storefront .product-card:hover {
          transform: translateY(-6px);
      }

      #supplements-storefront .product-image {
          position: relative;
          height: 280px;
          background: #ffffff;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 18px;
          border-bottom: 0;
      }

      #supplements-storefront .product-image::after {
          display: none;
      }

      #supplements-storefront .product-image img {
          object-fit: contain;
          max-width: 100%;
          max-height: 100%;
      }

      .product-fav {
          position: absolute;
          top: 18px;
          right: 18px;
          width: 34px;
          height: 34px;
          border-radius: 999px;
          background: #f5f7fa;
          color: #cfd7e1;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-size: 17px;
          border: 0;
          z-index: 2;
          cursor: pointer;
          transition: all .2s ease;
      }

      .product-fav:hover,
      .product-fav.is-active,
      .favorite-btn:hover,
      .favorite-btn.is-active {
          color: #ef476f;
          background: #fff0f4;
          box-shadow: 0 10px 20px rgba(239, 71, 111, 0.18);
      }

      .favorite-btn {
          min-height: 50px;
          border-radius: 15px;
          border: 0;
          margin: 0;
          background: #f2f4f6;
          color: #12253c;
          padding: 0;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-size: 18px;
          transition: all .2s ease;
      }

      #supplements-storefront .product-info {
          padding: 18px 24px 24px;
      }

      #supplements-storefront .product-brand {
          color: #0ac48d;
          font-size: 12px;
          letter-spacing: 0.04em;
          margin-bottom: 8px;
      }

      #supplements-storefront .product-name {
          font-size: 20px;
          min-height: auto;
          margin-bottom: 10px;
      }

      #supplements-storefront .product-category {
          display: none;
      }

      #supplements-storefront .product-description-mini {
          color: #70849a;
          font-size: 14px;
          line-height: 1.5;
          min-height: 42px;
          margin-bottom: 14px;
      }

      #supplements-storefront .product-price {
          color: #071a3a;
          font-size: 30px;
          margin-bottom: 16px;
      }

      #supplements-storefront .product-trust,
      #supplements-storefront .stock-chip,
      #supplements-storefront .view-details-btn {
          display: none;
      }

      .product-actions-inline {
          display: grid;
          grid-template-columns: 52px minmax(0, 1fr);
          gap: 12px;
          align-items: stretch;
      }

      #supplements-storefront .favorite-btn,
      #supplements-storefront .quick-view-btn {
          width: 52px;
          min-width: 52px;
          height: 50px;
          min-height: 50px;
          border-radius: 15px;
          border: 0;
          margin: 0;
          background: #f2f4f6;
          color: #12253c;
          padding: 0;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-size: 16px;
      }

      #supplements-storefront .add-to-cart-btn {
          height: 50px;
          min-height: 50px;
          border-radius: 15px;
          background: #151d2c;
          box-shadow: none;
          color: #ffffff;
          font-size: 16px;
          font-weight: 800;
          letter-spacing: 0;
      }

      #supplements-storefront .add-to-cart-btn:hover:not(:disabled) {
          background: #0d6a57;
          transform: none;
      }

      @media (max-width: 1400px) {
          .store-reco-grid,
          #supplements-storefront .products-grid {
              grid-template-columns: repeat(2, minmax(0, 1fr));
          }
      }

      @media (max-width: 1100px) {
          .store-topbar {
              flex-direction: column;
              align-items: flex-start;
          }

          .store-hero-shell {
              grid-template-columns: 1fr;
              gap: 22px;
          }

          #supplements-storefront .shop-layout {
              grid-template-columns: 1fr;
          }
      }

      @media (max-width: 760px) {
          .store-reco-grid,
          #supplements-storefront .products-grid,
          .store-hero-stats {
              grid-template-columns: 1fr;
          }

          .store-hero-media {
              min-height: 460px;
          }

          .store-hero-overlay {
              width: 100%;
          }
      }
  </style>
{% endblock %}

{% block footer %}{% endblock %}

{% block body %}
{% set pageMode = mode|default('supplements') %}
{% set favoritesOnly = pageMode == 'favorites' %}
{% if pageMode == 'shop' or pageMode == 'favorites' %}
{% set recommendationSupplements = [] %}
{% for wantedId in [11, 10, 4, 7, 3] %}
  {% for item in supplements %}
    {% if item.id == wantedId %}
      {% set recommendationSupplements = recommendationSupplements|merge([item]) %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% if recommendationSupplements is empty %}
  {% set recommendationSupplements = supplements|slice(0, 5) %}
{% endif %}
{% set heroSupplements = [] %}
{% for wantedId in [2, 6, 3, 4, 5] %}
  {% set foundHero = supplements|filter(item => item.id == wantedId)|first %}
  {% if foundHero %}
    {% set heroSupplements = heroSupplements|merge([foundHero]) %}
  {% endif %}
{% endfor %}
{% if heroSupplements|length < 5 %}
  {% set heroSupplements = heroSupplements|merge(supplements|filter(item => heroSupplements|filter(existing => existing.id == item.id) is empty))|slice(0, 5) %}
{% endif %}
{% set heroMain = heroSupplements|first %}
<section class="shop-section" id="products" data-shop-mode="{{ pageMode }}">
  <div class="container">
    <div class="store-shell" id="supplements-storefront">
      <div class="store-topbar">
        <div class="store-topbar-brand">Fitopia Store</div>
        <div class="store-topbar-nav">
          <a href="{{ path('explore_forums_blogs') }}">Accueil Forum</a>
          {% if app.user %}
            <a href="{{ path('app_shop_progress') }}">Mes Objectifs</a>
          {% endif %}
          <a href="{{ path('app_shop_leaderboard') }}">Classement</a>
          <a href="{{ path('app_shop_favorites') }}">Mes Favoris</a>
          <a href="{{ path('app_shop_cart') }}">Mes Commandes</a>
        </div>
        <div class="store-topbar-actions">
          <button type="button" class="store-chip-btn" id="openInlineCartBtn">Panier <i class="fa fa-shopping-basket"></i></button>
          <button type="button" class="store-chip-btn primary" id="openInlineCheckoutBtn">Payer <i class="fa fa-money"></i></button>
          <a href="{{ path('app_shop_cart') }}" class="store-chip-btn" style="text-decoration:none;">Notifications</a>
        </div>
      </div>

      {% if favoritesOnly %}
      <div class="favorites-page-shell">
        <section class="favorites-panel" id="favoritesPanel">
          <div class="favorites-panel-top">
            <div>
              <h2>Mes Coups De Coeur</h2>
              <p><span id="favoriteSavedCount">{{ supplements|length }}</span> produit(s) sauvegard&eacute;(s)</p>
            </div>
            <button type="button" class="favorites-panel-action" id="favoritesHideBtn">Masquer</button>
          </div>

          <div class="favorite-showcase-grid" id="favoriteShowcaseGrid">
            {% for supplement in supplements %}
              <article class="favorite-showcase-card product-card"
                       data-supplement-id="{{ supplement.id }}"
                       data-category="{{ supplement.category }}"
                       data-brand="{{ supplement.brand }}"
                       data-price="{{ supplement.price }}"
                       data-name="{{ supplement.name }}"
                       data-created="{{ supplement.createdAt|date('Y-m-d') }}"
                       data-stock="{{ supplement.stock }}"
                       data-detail-url="{{ path('app_shop_product_show', {id: supplement.id}) }}"
                       data-image="{{ supplement.image ? asset('uploads/supplements/' ~ supplement.image) : asset('images/image_1.jpg') }}"
                       data-description="{{ (supplement.description ?: 'Premium supplement picked for performance, recovery, and clean nutrition support.')|e('html_attr') }}">
                <div class="favorite-showcase-head">
                  <a class="favorite-showcase-name" href="{{ path('app_shop_product_show', {id: supplement.id}) }}">{{ supplement.name }}</a>
                  <span class="favorite-showcase-price">{{ supplement.price }} DT</span>
                </div>
                <div class="favorite-showcase-body">
                  <div class="favorite-showcase-thumb">
                    {% if supplement.image %}
                      <img src="{{ asset('uploads/supplements/' ~ supplement.image) }}" alt="{{ supplement.name }}">
                    {% else %}
                      <img src="{{ asset('images/image_1.jpg') }}" alt="{{ supplement.name }}">
                    {% endif %}
                  </div>
                  <button type="button"
                          class="favorite-remove-btn js-supplement-favorite"
                          data-id="{{ supplement.id }}"
                          data-favorite-style="remove"
                          aria-label="Retirer {{ supplement.name }} des favoris">
                    <i class="fa fa-times"></i>
                  </button>
                </div>
              </article>
            {% endfor %}
          </div>
          <div class="favorite-showcase-empty" id="favoriteShowcaseEmpty">
            Aucun favori enregistr&eacute; pour le moment. Cliquez sur le c&oelig;ur d&apos;un produit pour le retrouver ici.
          </div>
        </section>

        <section class="favorites-reco-shell">
          <div class="favorites-reco-top">
            <div>
              <h2>Recommandations <span class="favorites-panel-count-badge">{{ recommendationSupplements|length }}</span></h2>
              <p>{{ recommendationSupplements|length }} suggestion(s) ready for you.</p>
            </div>
            <button type="button" class="favorites-reco-action" id="storeRecoRefreshBtn">Actualiser</button>
          </div>

          <div class="favorites-reco-grid store-reco-grid">
            {% for supplement in recommendationSupplements %}
              <article class="favorite-reco-card product-card"
                       data-category="{{ supplement.category }}"
                       data-brand="{{ supplement.brand }}"
                       data-price="{{ supplement.price }}"
                       data-name="{{ supplement.name }}"
                       data-created="{{ supplement.createdAt|date('Y-m-d') }}"
                       data-stock="{{ supplement.stock }}"
                       data-detail-url="{{ path('app_shop_product_show', {id: supplement.id}) }}"
                       data-image="{{ supplement.image ? asset('uploads/supplements/' ~ supplement.image) : asset('images/image_1.jpg') }}"
                       data-description="{{ (supplement.description ?: 'Premium supplement picked for performance, recovery, and clean nutrition support.')|e('html_attr') }}">
                <div class="favorite-reco-note">You bought this product before.</div>
                <h3 class="favorite-reco-name">{{ supplement.name }}</h3>
                <div class="favorite-reco-price">{{ supplement.price }} DT</div>
                <div class="favorite-reco-actions">
                  <button type="button" class="favorite-reco-view js-quick-view" aria-label="Voir {{ supplement.name }}"><i class="fa fa-eye"></i></button>
                  {% if supplement.stock > 0 %}
                    <button type="button" class="favorite-reco-cart add-to-cart-btn" data-id="{{ supplement.id }}" data-name="{{ supplement.name }}">Vite !</button>
                  {% else %}
                    <button type="button" class="favorite-reco-cart" disabled>Indisponible</button>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        </section>
      </div>
      {% else %}
      <div class="store-hero-shell">
        <div class="store-hero-media">
          <div class="store-hero-stage">
            <div class="hero-back-jar hero-back-jar-left"></div>
            <div class="hero-back-jar hero-back-jar-right"></div>
            <div class="hero-shelf"></div>
            {% if heroSupplements|length > 0 %}
              <img class="hero-pack hero-pack-main" src="{{ heroMain.image ? asset('uploads/supplements/' ~ heroMain.image) : asset('images/image_1.jpg') }}" alt="{{ heroMain.name }}">
            {% endif %}
            {% if heroSupplements|length > 1 %}
              <img class="hero-pack hero-pack-left" src="{{ asset('uploads/supplements/' ~ heroSupplements[1].image) }}" alt="{{ heroSupplements[1].name }}">
            {% endif %}
            {% if heroSupplements|length > 2 %}
              <img class="hero-pack hero-pack-right" src="{{ asset('uploads/supplements/' ~ heroSupplements[2].image) }}" alt="{{ heroSupplements[2].name }}">
            {% endif %}
            {% if heroSupplements|length > 3 %}
              <img class="hero-pack hero-pack-mini" src="{{ asset('uploads/supplements/' ~ heroSupplements[3].image) }}" alt="{{ heroSupplements[3].name }}">
            {% endif %}
            {% if heroSupplements|length > 4 %}
              <img class="hero-pack hero-pack-shaker" src="{{ asset('uploads/supplements/' ~ heroSupplements[4].image) }}" alt="{{ heroSupplements[4].name }}">
            {% endif %}
            <div class="hero-scoop"></div>
          </div>
          <div class="store-hero-overlay">
            <span class="store-hero-pill">PREMIUM NUTRITION</span>
            <h3>Boostez vos performances avec nos suppl&eacute;ments exclusifs.</h3>
          </div>
        </div>

        <div class="store-hero-copy">
          {% if favoritesOnly %}
            <p class="eyebrow">Fitopia Favorites</p>
            <h1>Retrouvez vos suppl&eacute;ments favoris</h1>
            <p>Les produits ci-dessous correspondent aux c&oelig;urs enregistr&eacute;s depuis votre navigateur sur la boutique.</p>
            <a href="#productsGrid" class="store-hero-cta">Voir mes favoris</a>
          {% else %}
            <p class="eyebrow">Fitopia Supplements</p>
            <h1>D&eacute;couvrez notre s&eacute;lection exclusive</h1>
            <p>Optimisez vos r&eacute;sultats avec des produits de haute qualit&eacute;, approuv&eacute;s par des experts pour vos entra&icirc;nements.</p>
            <a href="#productsGrid" class="store-hero-cta">Acheter maintenant</a>
          {% endif %}
          <div class="store-hero-stats">
            <div class="store-hero-stat">
              <strong>{% if favoritesOnly %}<span id="favorite-count-hero">{{ supplements|length }}</span>{% else %}100+{% endif %}</strong>
              <span>{% if favoritesOnly %}favori(s) sauvegard&eacute;(s){% else %}produits certifi&eacute;s{% endif %}</span>
            </div>
            <div class="store-hero-stat">
              <strong>{% if favoritesOnly %}Local{% else %}24h{% endif %}</strong>
              <span>{% if favoritesOnly %}stockage navigateur{% else %}livraison rapide{% endif %}</span>
            </div>
          </div>
        </div>
      </div>

      <section class="store-reco-shell">
        <div class="store-reco-top">
          <div>
            <h2>RECOMMANDATIONS <span class="count">{{ recommendationSupplements|length }}</span></h2>
            <p>{{ recommendationSupplements|length }} suggestion(s) pr&ecirc;tes pour vous.</p>
          </div>
          <button type="button" class="store-refresh-btn" id="storeRecoRefreshBtn">Actualiser</button>
        </div>
        <div class="store-reco-grid">
          {% for supplement in recommendationSupplements %}
            <div class="product-card reco-card"
                 data-category="{{ supplement.category }}"
                 data-brand="{{ supplement.brand }}"
                 data-price="{{ supplement.price }}"
                 data-name="{{ supplement.name }}"
                 data-created="{{ supplement.createdAt|date('Y-m-d') }}"
                 data-stock="{{ supplement.stock }}"
                 data-detail-url="{{ path('app_shop_product_show', {id: supplement.id}) }}"
                 data-image="{{ supplement.image ? asset('uploads/supplements/' ~ supplement.image) : asset('images/image_1.jpg') }}"
                 data-description="{{ (supplement.description ?: 'Premium supplement picked for performance, recovery, and clean nutrition support.')|e('html_attr') }}">
              <div class="reco-body">
                <div class="reco-note">Produit populaire dans les commandes r&eacute;centes.</div>
                <div class="reco-name">{{ supplement.name }}</div>
                <div class="reco-price">{{ supplement.price }} DT</div>
                <div class="reco-actions">
                  <button type="button" class="favorite-btn js-supplement-favorite" data-id="{{ supplement.id }}" aria-label="Ajouter {{ supplement.name }} aux favoris"><i class="fa fa-heart-o"></i></button>
                  <button type="button" class="quick-view-btn js-quick-view"><i class="fa fa-eye"></i></button>
                  {% if supplement.stock > 0 %}
                    <button class="add-to-cart-btn" data-id="{{ supplement.id }}" data-name="{{ supplement.name }}">Vite !</button>
                  {% else %}
                    <button class="add-to-cart-btn" disabled>Indisponible</button>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <div class="flow-backdrop" id="flowBackdrop"></div>
      <div class="flow-panels">
      <section class="flow-panel" id="inlineCartPanel">
        <div class="flow-panel-head">
          <div class="flow-panel-head-copy">
            <h3>Votre panier</h3>
            <div class="flow-panel-meta"><span id="inlineCartCountLabel">0</span> article(s)</div>
          </div>
          <button type="button" class="flow-close" data-close-panel="inlineCartPanel"><i class="fa fa-ellipsis-h"></i></button>
        </div>
        <div class="inline-cart-body">
          <div id="inlineCartRows"></div>
