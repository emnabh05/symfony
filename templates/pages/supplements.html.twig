        <div class="card-preview">
          <p class="card-preview-chip">Secure Card</p>
          <div class="card-preview-number" id="cardPreviewNumber">**** **** **** ****</div>
          <div class="card-preview-row">
            <span id="cardPreviewName">CARD HOLDER</span>
            <span id="cardPreviewExpiry">MM/YY</span>
          </div>
        </div>
        <ul class="payment-benefits">
          <li><i class="fa fa-shield"></i> 256-bit encrypted payment session</li>
          <li><i class="fa fa-refresh"></i> Instant payment confirmation</li>
          <li><i class="fa fa-envelope"></i> Receipt sent to your email</li>
        </ul>
      </aside>
    </div>
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const params = new URLSearchParams(window.location.search);
  const order = params.get('order');
  const paymentForm = document.getElementById('paymentForm');
  const cardNumberInput = document.getElementById('cardNumber');
  const cardNameInput = document.getElementById('cardName');
  const expiryInput = document.getElementById('expiryDate');
  const cvvInput = document.getElementById('cvv');
  const previewNumber = document.getElementById('cardPreviewNumber');
  const previewName = document.getElementById('cardPreviewName');
  const previewExpiry = document.getElementById('cardPreviewExpiry');

  function groupCardNumber(value) {
    const digits = String(value || '').replace(/\D/g, '').slice(0, 16);
    return digits.replace(/(\d{4})(?=\d)/g, '$1 ').trim();
  }

  function formatExpiry(value) {
    const digits = String(value || '').replace(/\D/g, '').slice(0, 4);
    if (digits.length < 3) return digits;
    return digits.slice(0, 2) + '/' + digits.slice(2);
  }

  function maskCardPreview(value) {
    const digits = String(value || '').replace(/\D/g, '');
    if (digits.length === 0) return '**** **** **** ****';
    const padded = (digits + '################').slice(0, 16);
    const visible = padded.replace(/#/g, '*');
    return visible.replace(/(.{4})(?=.)/g, '$1 ').trim();
  }

  function updateCardPreview() {
    if (previewNumber) previewNumber.textContent = maskCardPreview(cardNumberInput?.value || '');
    if (previewName) {
      const v = (cardNameInput?.value || '').trim();
      previewName.textContent = v === '' ? 'CARD HOLDER' : v.toUpperCase();
    }
    if (previewExpiry) {
      const exp = (expiryInput?.value || '').trim();
      previewExpiry.textContent = exp === '' ? 'MM/YY' : exp;
    }
  }

  cardNumberInput?.addEventListener('input', function () {
    this.value = groupCardNumber(this.value);
    updateCardPreview();
  });

  cardNameInput?.addEventListener('input', updateCardPreview);

  expiryInput?.addEventListener('input', function () {
    this.value = formatExpiry(this.value);
    updateCardPreview();
  });

  cvvInput?.addEventListener('input', function () {
    this.value = String(this.value || '').replace(/\D/g, '').slice(0, 4);
  });

  updateCardPreview();

  paymentForm?.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!order) {
      alert('Missing order number');
      return;
    }
    const submitButton = this.querySelector('button[type="submit"]');
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Processing payment...';
    }
    setTimeout(() => {
      window.location.href = '{{ path('app_shop_order_success', {orderNumber: '__ORDER__'}) }}'
        .replace('__ORDER__', order);
    }, 1000);
  });
});
</script>
