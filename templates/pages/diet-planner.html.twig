{% extends 'base.html.twig' %}

{% block title %}Diet & Eating Planner | Fitopia{% endblock %}

{% block stylesheets %}
<style>
  :root {
    --diet-bg: #f4f7fd;
    --diet-card: #ffffff;
    --diet-border: #dfe7f3;
    --diet-text: #0f2541;
    --diet-muted: #6f84a0;
    --diet-green: #12c48b;
    --diet-green-dark: #0f4a5a;
    --diet-green-soft: #ecfbf4;
    --diet-shadow: 0 18px 40px rgba(15, 37, 65, 0.08);
    --diet-page-gutter: clamp(18px, 2.8vw, 52px);
  }

  .diet-page {
    background: var(--diet-bg);
    padding: 2rem 0 3rem;
  }

  .diet-wrap {
    width: calc(100% - (var(--diet-page-gutter) * 2));
    max-width: none;
    margin: 0 auto;
    padding: 0;
  }

  .diet-card {
    background: var(--diet-card);
    border: 1px solid var(--diet-border);
    border-radius: 28px;
    box-shadow: var(--diet-shadow);
  }

  .diet-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(360px, 0.88fr);
    gap: 2rem;
    background: #eef8f1;
    border: 1px solid #d9ece0;
    border-radius: 32px;
    padding: 2.1rem;
    box-shadow: 0 22px 40px rgba(14, 39, 64, 0.08);
  }

  .diet-hero-media {
    position: relative;
    min-height: 470px;
    border-radius: 28px;
    overflow: hidden;
  }

  .diet-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .diet-hero-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.6rem;
    color: #fff;
    background: linear-gradient(to top, rgba(14, 31, 41, 0.78), rgba(14, 31, 41, 0.08));
  }

  .diet-hero-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: #fff;
    color: #0f2541;
    font-weight: 800;
    font-size: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .diet-hero-copy {
    display: grid;
    align-content: center;
    gap: 1rem;
  }

  .diet-kicker {
    color: #00b978;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 900;
    font-size: 0.82rem;
  }

  .diet-title {
    margin: 0;
    font-size: clamp(2.2rem, 3vw, 3.1rem);
    line-height: 1.05;
    color: #08263a;
    font-weight: 900;
  }

  .diet-lead {
    margin: 0;
    color: #50677e;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .diet-hero-actions,
  .diet-dashboard-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .diet-btn,
  .diet-btn-outline,
  .diet-btn-soft {
    border-radius: 999px;
    padding: 0.82rem 1.35rem;
    font-weight: 800;
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    text-decoration: none;
    cursor: pointer;
  }

  .diet-btn {
    background: var(--diet-green);
    color: #fff;
    box-shadow: 0 14px 28px rgba(18, 196, 139, 0.25);
  }

  .diet-btn-outline {
    background: #fff;
    color: var(--diet-green);
    border-color: var(--diet-green);
  }

  .diet-btn-soft {
    background: #eff4f8;
    color: #0f2541;
    border-color: #eff4f8;
  }

  .diet-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .diet-hero-stat {
    background: #fff;
    border: 1px solid #e4efe8;
    border-radius: 18px;
    padding: 1rem 1.1rem;
  }

  .diet-hero-stat strong {
    display: block;
    color: #08263a;
    font-weight: 900;
    font-size: 1.85rem;
  }

  .diet-hero-stat span {
    color: #60778b;
    font-size: 0.92rem;
  }

  .diet-stack {
    display: grid;
    gap: 1.4rem;
    margin-top: 1.6rem;
  }

  .diet-dashboard {
    padding: 2rem;
  }

  .diet-dashboard-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .diet-section-title {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .diet-icon-box {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    background: #edf8f1;
    color: #0f2541;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
  }

  .diet-section-title h2,
  .diet-panel-title h3 {
    margin: 0;
    color: #0f2541;
    font-weight: 900;
  }

  .diet-section-title p,
  .diet-panel-header p {
    margin: 0.2rem 0 0;
    color: var(--diet-muted);
  }

  .diet-metric-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .diet-metric-card,
  .diet-target-card {
    background: #f3f6fb;
    border-radius: 20px;
    padding: 1.2rem 1rem;
    text-align: center;
  }

  .diet-metric-card small,
  .diet-target-card small {
    display: block;
    color: var(--diet-muted);
    font-size: 0.92rem;
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .diet-metric-card strong,
  .diet-target-card strong {
    display: block;
    color: #0f2541;
    font-size: 1.1rem;
    font-weight: 900;
  }

  .diet-target-card {
    background: var(--diet-green-soft);
    border: 1px solid #28d29b;
  }

  .diet-target-card strong {
    color: #00795d;
    font-size: 1.3rem;
  }

  .diet-progress-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 1.8rem;
    align-items: end;
    margin-top: 1.6rem;
  }

  .diet-progress-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 900;
    color: #0f2541;
    margin-bottom: 0.8rem;
  }

  .diet-progress-title .diet-progress-text {
    color: #00b978;
    font-weight: 900;
  }

  .diet-progress-track {
    width: 100%;
    height: 24px;
    background: #eef3f8;
    border-radius: 999px;
    overflow: hidden;
  }

  .diet-progress-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, #0f4a5a, #12c48b);
    border-radius: 999px;
  }

  .diet-quick-add {
    border-left: 1px solid #e6edf5;
    padding-left: 1.6rem;
  }

  .diet-quick-add label {
    display: block;
    margin-bottom: 0.7rem;
    color: #476078;
    font-weight: 800;
  }

  .diet-input {
    width: 100%;
    border: 1px solid #cdd9e7;
    border-radius: 16px;
    background: #fff;
    padding: 0.95rem 1rem;
    color: #163149;
  }

  .diet-inline-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px;
    gap: 0.75rem;
    align-items: center;
  }

  .diet-suggestion {
    margin-top: 1.5rem;
    border-radius: 20px;
    background: #eefaf2;
    color: #00795d;
    padding: 1rem 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1rem;
  }

  .diet-suggestion strong {
    color: #0f2541;
  }

  .diet-panel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .diet-panel {
    padding: 1.8rem;
  }

  .diet-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .diet-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #edf3f8;
    color: #00b978;
    padding: 0.45rem 0.9rem;
    font-weight: 800;
    font-size: 0.9rem;
  }

  .diet-macro-bar {
    border-radius: 18px;
    background: #f3f6fb;
    padding: 0.9rem 1rem;
    color: #0f2541;
    font-weight: 800;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .diet-achievement-list,
  .diet-journal-list,
  .diet-regime-list,
  .diet-catalog-list {
    display: grid;
    gap: 0.9rem;
  }

  .diet-achievement-item,
  .diet-journal-item,
  .diet-regime-item,
  .diet-catalog-item {
    background: #f7faff;
    border: 1px solid #e8eef7;
    border-radius: 18px;
    padding: 1rem 1.1rem;
  }

  .diet-achievement-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .diet-achievement-item strong,
  .diet-journal-item strong,
  .diet-regime-item strong,
  .diet-catalog-item strong {
    color: #0f2541;
    font-weight: 900;
  }

  .diet-achievement-item p,
  .diet-journal-item p,
  .diet-regime-item p,
  .diet-catalog-item p {
    margin: 0.25rem 0 0;
    color: var(--diet-muted);
  }

  .diet-lock {
    color: #a5b3c3;
  }

  .diet-unlock {
    color: #0fb67d;
  }

  .diet-journal-top,
  .diet-regime-top,
  .diet-catalog-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .diet-journal-meta,
  .diet-regime-meta,
  .diet-catalog-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.6rem;
  }

  .diet-mini-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    background: #fff;
    border: 1px solid #dbe6f2;
    color: #3e566e;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .diet-actions-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
  }

  .diet-small-btn {
    border-radius: 12px;
    border: 1px solid #d6e1ed;
    background: #fff;
    color: #0f2541;
    padding: 0.5rem 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }

  .diet-small-btn-danger {
    border-color: #f0c2c2;
    color: #bc3e3e;
    background: #fff5f5;
  }

  .diet-hidden-edit {
    display: none;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px dashed #d8e3ef;
  }

  .diet-manage-card {
    display: none;
  }

  .diet-form-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .diet-form-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .diet-form-group {
    display: grid;
    gap: 0.45rem;
  }

  .diet-form-group label {
    color: #445d74;
    font-weight: 800;
    font-size: 0.92rem;
  }

  .diet-textarea {
    min-height: 100px;
    resize: vertical;
  }

  .diet-empty {
    border-radius: 18px;
    background: #f5f8fc;
    color: var(--diet-muted);
    padding: 1.2rem;
    font-weight: 700;
  }

  .food-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(9, 25, 40, 0.58);
    z-index: 1300;
    padding: 1rem;
    overflow-y: auto;
  }

  .food-modal.show {
    display: flex;
  }

  .food-modal-card {
    width: min(960px, 95vw);
    background: #fff;
    border-radius: 28px;
    box-shadow: 0 24px 60px rgba(15, 37, 65, 0.24);
    padding: 1.5rem;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }

  .food-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .food-modal-head h4 {
    margin: 0;
    color: #0f2541;
    font-size: 1.35rem;
    font-weight: 900;
  }

  .food-modal-head p {
    margin: 0.35rem 0 0;
    color: var(--diet-muted);
  }

  .food-close {
    border: none;
    background: #f1f5f9;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    cursor: pointer;
    color: #5f748b;
    font-weight: 900;
  }

  .food-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .diet-error-summary,
  .diet-status-box {
    display: none;
    padding: 0.75rem 0.9rem;
    border-radius: 14px;
    margin-bottom: 1rem;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .diet-error-summary {
    background: #fff2f2;
    color: #b54141;
    border: 1px solid #efc0c0;
  }

  .diet-status-box {
    background: #eefaf2;
    color: #0a7d5c;
    border: 1px solid #b6ecd3;
  }

  .diet-field-error {
    color: #c34747;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .diet-field-valid {
    color: #089164;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .diet-input.is-invalid,
  .form-control.is-invalid {
    border-color: #e06a6a;
    box-shadow: 0 0 0 0.12rem rgba(224, 106, 106, 0.12);
  }

  .diet-input.is-valid,
  .form-control.is-valid {
    border-color: #18bf87;
    box-shadow: 0 0 0 0.12rem rgba(24, 191, 135, 0.12);
  }

  @media (max-width: 1100px) {
    .diet-hero,
    .diet-progress-row,
    .diet-panel-grid {
      grid-template-columns: 1fr;
    }

    .diet-quick-add {
      border-left: none;
      padding-left: 0;
    }

    .diet-metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .diet-form-grid,
    .diet-form-grid-4 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .diet-wrap {
      width: calc(100% - 18px);
    }

    .diet-hero,
    .diet-dashboard,
    .diet-panel,
    .diet-manage-card,
    .food-modal-card {
      padding: 1.1rem;
    }

    .diet-hero-stats,
    .diet-metric-grid {
      grid-template-columns: 1fr;
    }

    .diet-inline-form {
      grid-template-columns: 1fr;
    }

  }
</style>
{% endblock %}

{% block body %}
<section class="diet-page">
  <div class="diet-wrap">
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert {% if label == 'success' %}alert-success{% elseif label == 'error' %}alert-danger{% elseif label == 'warning' %}alert-warning{% else %}alert-info{% endif %}" style="border-radius:18px;margin-bottom:1rem;">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    <div class="diet-hero">
      <div class="diet-hero-media">
        <img src="{{ asset('images/diet-hero-reference.png') }}" alt="Diet and eating planner">
        <div class="diet-hero-overlay">
          <span class="diet-hero-badge">HEALTH &amp; NUTRITION</span>
          <div style="font-size: 1.95rem; font-weight: 900; line-height: 1.15;">Prenez le contr&ocirc;le de votre alimentation.</div>
        </div>
      </div>
      <div class="diet-hero-copy">
        <div class="diet-kicker">Fitopia Performance Platform</div>
        <h1 class="diet-title">Diet &amp; Eating Planner</h1>
        <p class="diet-lead">
          Cette page est personnalis&eacute;e pour vous. Planifiez vos repas, suivez vos macros et atteignez vos objectifs avec pr&eacute;cision.
        </p>
        <div class="diet-hero-actions">
          <button type="button" class="diet-btn" id="dp-open-create-regime-hero">Cr&eacute;er mon r&eacute;gime</button>
          <button type="button" class="diet-btn-outline" id="dp-open-daily-plan-hero">Planning 7j</button>
        </div>
        <div class="diet-hero-stats">
          <div class="diet-hero-stat">
            <strong>98%</strong>
            <span>Pr&eacute;cision calories</span>
          </div>
          <div class="diet-hero-stat">
            <strong>12 sem.</strong>
            <span>Planification</span>
          </div>
          <div class="diet-hero-stat">
            <strong>5000+</strong>
            <span>repas analyses</span>
          </div>
        </div>
      </div>
    </div>

    <div class="diet-stack">
      <div class="diet-card diet-dashboard">
        <div class="diet-dashboard-top">
          <div class="diet-section-title">
            <span class="diet-icon-box"><i class="fa fa-heart"></i></span>
            <div>
              <h2>My Regime</h2>
              <p>Consultez votre profil nutritionnel et suivez votre progression du jour.</p>
            </div>
          </div>
          <div class="diet-dashboard-actions">
            <button
              type="button"
              class="diet-btn"
              id="dp-open-scan-dialog"
              data-url="{{ path('diet_scan_analyze') }}"
              data-token="{{ csrf_token('diet_scan_analyze') }}"
            >
              <i class="fa fa-camera"></i>
              Scanner repas
            </button>
            <button type="button" class="diet-btn-soft" id="dp-open-add-meal-hero">+ Ajouter repas</button>
            <button type="button" class="diet-btn-soft" id="dp-open-daily-plan-dialog">Planning 7j</button>
            <button type="button" class="diet-btn-outline" id="dp-open-shopping-dialog" data-url="{{ path('diet_shopping_list') }}">Courses</button>
            <a href="{{ path('diet_pdf_export') }}" class="diet-btn-outline">
              <i class="fa fa-file-text"></i>
              PDF
            </a>
          </div>
        </div>

        <div class="diet-metric-grid">
          <div class="diet-metric-card">
            <small><i class="fa fa-arrows-v"></i> Taille</small>
            <strong>{{ regime and regime.taille ? regime.taille|number_format(1, '.', '') ~ ' cm' : '--' }}</strong>
          </div>
          <div class="diet-metric-card">
            <small><i class="fa fa-balance-scale"></i> Poids</small>
            <strong>{{ regime and regime.poids ? regime.poids|number_format(1, '.', '') ~ ' kg' : '--' }}</strong>
          </div>
          <div class="diet-metric-card">
            <small><i class="fa fa-calendar"></i> Age</small>
            <strong>{{ regime and regime.age ? regime.age ~ ' ans' : '--' }}</strong>
          </div>
          <div class="diet-metric-card">
            <small><i class="fa fa-heartbeat"></i> IMC</small>
            <strong>{{ regime and regime.bmi ? regime.bmi|number_format(0, '.', '') : '--' }}</strong>
          </div>
          <div class="diet-metric-card">
            <small><i class="fa fa-leaf"></i> Sant&eacute;</small>
            <strong>{{ regime and regime.typeSante ? regime.typeSante|replace({'_': ' '})|title : 'N/A' }}</strong>
          </div>
          <div class="diet-target-card">
            <small><i class="fa fa-fire"></i> Calories Cibles</small>
            <strong>{{ regime and regime.caloriesCibles ? regime.caloriesCibles ~ ' kcal/j' : '0 kcal/j' }}</strong>
          </div>
        </div>

        <div class="diet-progress-row">
          <div>
            <div class="diet-progress-title">
              <span><i class="fa fa-fire"></i> Calories du jour</span>
              <span class="diet-progress-text">
                {{ totals.calories }} / {{ regime and regime.caloriesCibles ? regime.caloriesCibles : 0 }} kcal
                {% if regime and regime.caloriesCibles %}
                  ({{ remainingCalories }} restantes)
                {% endif %}
              </span>
            </div>
            <div class="diet-progress-track">
              <div class="diet-progress-fill" style="width: {{ calorieProgress }}%;"></div>
            </div>
          </div>
          <div class="diet-quick-add">
            <label for="dp-barcode-input">Ajout Rapide</label>
            <form id="dp-barcode-form" class="diet-inline-form" data-url="{{ path('diet_barcode_lookup') }}">
              <input class="diet-input" id="dp-barcode-input" type="text" placeholder="Saisir code-barres..." inputmode="numeric">
              <button type="submit" class="diet-btn">Ajouter</button>
            </form>
            <div id="dp-barcode-status" style="margin-top:0.6rem;color:#5c7288;font-weight:700;"></div>
          </div>
        </div>

        <div class="diet-suggestion">
          <i class="fa fa-lightbulb-o"></i>
          <div><strong>Suggestions:</strong> {{ suggestionLine }}</div>
        </div>
      </div>

      <div class="diet-panel-grid">
        <div class="diet-card diet-panel">
          <div class="diet-panel-header">
            <div class="diet-panel-title">
              <h3><i class="fa fa-trophy"></i> Mes r&eacute;ussites</h3>
            </div>
          </div>
          <div class="diet-macro-bar">
            <span><i class="fa fa-fire"></i> {{ totals.calories }} kcal</span>
            <span><i class="fa fa-bolt"></i> P {{ totals.proteines }} g</span>
            <span><i class="fa fa-leaf"></i> C {{ totals.glucides }} g</span>
            <span><i class="fa fa-tint"></i> F {{ totals.lipides }} g</span>
          </div>
          <div class="diet-achievement-list">
            {% for achievement in achievements %}
              <div class="diet-achievement-item">
                <div>
                  <strong>{{ achievement.label }}</strong>
                  <p>{{ achievement.description }}</p>
                </div>
                <div class="diet-actions-row">
                  {% if achievement.kind == 'hydration' %}
                    <button
                      type="button"
                      class="diet-btn"
                      id="dp-hydration-add"
                      data-url="{{ path('diet_hydration_add') }}"
                      data-token="{{ csrf_token('diet_hydration_add') }}"
                      style="padding:0.7rem 1rem;"
                    >
                      +
                    </button>
                  {% endif %}
                  <i class="fa {% if achievement.unlocked %}fa-check-circle diet-unlock{% else %}fa-lock diet-lock{% endif %}"></i>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="diet-card diet-panel">
          <div class="diet-panel-header">
            <div class="diet-panel-title">
              <h3><i class="fa fa-cutlery"></i> Mon Journal Alimentaire</h3>
              <p>{% if repas is empty %}Aucun repas aujourd'hui.{% else %}{{ repas|length }} repas enregistr&eacute;s aujourd'hui.{% endif %}</p>
            </div>
            <button type="button" class="diet-chip" id="dp-open-checklist-dialog">Checklist</button>
          </div>
          {% if repas is not empty %}
            <div class="diet-journal-list">
              {% for r in repas %}
                <div class="diet-journal-item">
                  <div class="diet-journal-top">
                    <div>
                      <strong>{{ r.nomRepas }}</strong>
                      <p>{{ r.typeRepas }}{% if r.dateRepas %} · {{ r.dateRepas|date('H:i') }}{% endif %}</p>
                    </div>
                    <div class="diet-actions-row">
                      <span class="diet-chip">{{ r.calories ?: 0 }} kcal</span>
                      <button type="button" class="diet-small-btn" data-meal-edit-open="{{ r.id }}">Modifier</button>
                      <form method="post" action="{{ path('diet_meal_delete', {'id': r.id}) }}" style="margin:0;" onsubmit="return confirm('Supprimer ce repas ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('meal_delete_' ~ r.id) }}">
                        <button type="submit" class="diet-small-btn diet-small-btn-danger">Supprimer</button>
                      </form>
                    </div>
                  </div>
                  <div class="diet-journal-meta">
                    <span class="diet-mini-pill">P {{ r.proteines ?: 0 }} g</span>
                    <span class="diet-mini-pill">C {{ r.glucides ?: 0 }} g</span>
                    <span class="diet-mini-pill">F {{ r.lipides ?: 0 }} g</span>
                  </div>
                  <div class="diet-hidden-edit" id="meal-edit-{{ r.id }}">
                    <form method="post" action="{{ path('diet_meal_update', {'id': r.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('meal_update_' ~ r.id) }}">
                      <div class="diet-form-grid">
                        <div class="diet-form-group">
                          <label>Type de repas</label>
                          <input class="diet-input" name="type_repas" value="{{ r.typeRepas }}">
                        </div>
                        <div class="diet-form-group">
                          <label>Nom du repas</label>
                          <input class="diet-input" name="nom_repas" value="{{ r.nomRepas }}">
                        </div>
                        <div class="diet-form-group">
                          <label>Calories</label>
                          <input class="diet-input" type="number" name="calories" value="{{ r.calories }}">
                        </div>
                      </div>
                      <div class="diet-form-grid-4" style="margin-top:0.9rem;">
                        <div class="diet-form-group">
                          <label>Proteines</label>
                          <input class="diet-input" type="number" name="proteines" value="{{ r.proteines }}">
                        </div>
                        <div class="diet-form-group">
                          <label>Glucides</label>
                          <input class="diet-input" type="number" name="glucides" value="{{ r.glucides }}">
                        </div>
                        <div class="diet-form-group">
                          <label>Lipides</label>
                          <input class="diet-input" type="number" name="lipides" value="{{ r.lipides }}">
                        </div>
                        <div class="diet-form-group">
                          <label>Commentaire</label>
                          <input class="diet-input" name="commentaire" value="{{ r.commentaire }}">
                        </div>
                      </div>
                      <div class="food-modal-actions">
                        <button type="submit" class="diet-btn">Enregistrer</button>
                      </div>
                    </form>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="diet-empty">Aucun repas disponible.</div>
          {% endif %}
        </div>
      </div>

      <div class="diet-card diet-manage-card">
        <div class="diet-panel-header">
          <div class="diet-panel-title">
            <h3>Mes Regimes</h3>
            <p>Retrouvez ici vos profils nutritionnels, vos calories cibles et vos recommandations de repas dans un affichage proche du planner principal.</p>
          </div>
          <div class="diet-dashboard-actions">
            <button type="button" class="diet-btn-soft" id="dp-open-add-meal-manage">+ Ajouter repas</button>
            <button type="button" class="diet-btn-soft" id="dp-open-daily-plan-manage">Planning 7j</button>
            <button type="button" class="diet-btn" id="dp-open-create-regime-dialog">+ Ajouter un regime</button>
          </div>
        </div>
        {% if regimes is not empty %}
          <div class="diet-regime-list">
            {% for r in regimes %}
              <div class="diet-regime-item">
                <div class="diet-regime-top">
                  <div>
                    <strong>Regime #{{ r.id }}</strong>
                    <p>{{ r.typeSante ? r.typeSante|replace({'_': ' '})|title : 'N/A' }} &middot; {{ r.caloriesCibles ?: 0 }} kcal/j</p>
                    <div class="diet-regime-meta">
                      <span class="diet-mini-pill">Taille {{ r.taille ? r.taille|number_format(1, '.', '') : '--' }} cm</span>
                      <span class="diet-mini-pill">Poids {{ r.poids ? r.poids|number_format(1, '.', '') : '--' }} kg</span>
                      <span class="diet-mini-pill">IMC {{ r.bmi ?: '--' }}</span>
                    </div>
                  </div>
                  <div class="diet-actions-row">
                    <a href="{{ path('diet_planner', {'regime_id': r.id}) }}" class="diet-small-btn">Voir</a>
                    <button type="button" class="diet-small-btn" data-regime-edit-open="{{ r.id }}">Modifier</button>
                    <form method="post" action="{{ path('diet_regime_delete', {'id': r.id}) }}" style="margin:0;" onsubmit="return confirm('Supprimer ce regime ?');">
                      <input type="hidden" name="_token" value="{{ csrf_token('regime_delete_' ~ r.id) }}">
                      <button type="submit" class="diet-small-btn diet-small-btn-danger">Supprimer</button>
                    </form>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="diet-empty">Aucun regime enregistre pour le moment.</div>
        {% endif %}
      </div>
    </div>
  </div>

</section>

<div class="food-modal" id="dp-create-regime-modal">
  <div class="food-modal-card">
    <div class="food-modal-head">
      <div>
        <h4>Ajouter un regime</h4>
        <p>Le calcul suit le meme metier que le projet Java: IMC, type sante, calories cibles et repas adequats.</p>
      </div>
      <button type="button" class="food-close" id="dp-create-regime-close">X</button>
    </div>
    <div class="diet-error-summary" data-regime-error-summary></div>
    {{ form_start(regimeCreateForm, {'attr': {'class': 'js-regime-form', 'novalidate': 'novalidate'}}) }}
      <div class="diet-form-grid">
        <div class="diet-form-group">
          <label>Taille (cm)</label>
          {{ form_widget(regimeCreateForm.taille, {'attr': {'class': 'diet-input js-regime-taille', 'inputmode': 'decimal'}}) }}
        </div>
        <div class="diet-form-group">
          <label>Poids (kg)</label>
          {{ form_widget(regimeCreateForm.poids, {'attr': {'class': 'diet-input js-regime-poids', 'inputmode': 'decimal'}}) }}
        </div>
        <div class="diet-form-group">
          <label>Age</label>
          {{ form_widget(regimeCreateForm.age, {'attr': {'class': 'diet-input js-regime-age', 'inputmode': 'numeric'}}) }}
        </div>
      </div>
      <div class="diet-form-grid" style="margin-top:0.9rem;">
        <div class="diet-form-group">
          <label>IMC (auto)</label>
          {{ form_widget(regimeCreateForm.bmi, {'attr': {'class': 'diet-input js-regime-bmi', 'readonly': 'readonly'}}) }}
        </div>
        <div class="diet-form-group">
          <label>Type sant&eacute; (auto)</label>
          {{ form_widget(regimeCreateForm.typeSante, {'attr': {'class': 'diet-input js-regime-type-sante'}}) }}
        </div>
        <div class="diet-form-group">
          <label>Calories cibles (auto)</label>
          {{ form_widget(regimeCreateForm.caloriesCibles, {'attr': {'class': 'diet-input js-regime-calories'}}) }}
        </div>
      </div>
      <div class="diet-form-group" style="margin-top:0.9rem;">
        <label>Repas ad&eacute;quats (auto)</label>
        {{ form_widget(regimeCreateForm.repasAdequats, {'attr': {'class': 'diet-input diet-textarea js-regime-repas'}}) }}
      </div>
      <div class="food-modal-actions">
        <button type="button" class="diet-btn-soft" id="dp-create-regime-cancel">Annuler</button>
        <button type="submit" class="diet-btn">Cr&eacute;er le r&eacute;gime</button>
      </div>
    {{ form_end(regimeCreateForm) }}
  </div>
</div>

<div class="food-modal" id="dp-add-meal-modal">
  <div class="food-modal-card">
    <div class="food-modal-head">
      <div>
        <h4>Ajouter repas</h4>
        <p>Ajoutez un repas depuis votre catalogue existant pour ce regime.</p>
      </div>
      <button type="button" class="food-close" id="dp-add-meal-close">X</button>
    </div>

    <form method="post" action="{{ path('diet_meal_add') }}" id="dp-manual-meal-form" style="display:none;">
      <input type="hidden" name="_token" value="{{ csrf_token('meal_add') }}">
      {% if regime %}
        <input type="hidden" name="regime_id" value="{{ regime.id }}">
      {% endif %}
      <input type="hidden" name="type_repas" id="dp-manual-type" value="Extra meal">
      <input type="hidden" name="nom_repas" id="dp-manual-name">
      <input type="hidden" name="calories" id="dp-manual-calories">
      <input type="hidden" name="proteines" id="dp-manual-protein">
      <input type="hidden" name="glucides" id="dp-manual-carbs">
      <input type="hidden" name="lipides" id="dp-manual-fat">
      <input type="hidden" name="commentaire" id="dp-manual-comment">
    </form>

    <div style="margin-top:1.4rem;">
      <h4 style="margin:0 0 0.8rem;color:#0f2541;">Catalogue repas</h4>
      {% if catalogMeals is not empty %}
        <div class="diet-catalog-list">
          {% for m in catalogMeals|slice(0, 12) %}
            <div class="diet-catalog-item">
              <div class="diet-catalog-top">
                <div>
                  <strong>{{ m.nomRepas }}</strong>
                  <p>{{ m.typeRepas ?: 'Repas' }}</p>
                  <div class="diet-catalog-meta">
                    <span class="diet-mini-pill">{{ m.calories ?: 0 }} kcal</span>
                    <span class="diet-mini-pill">P {{ m.proteines ?: 0 }} g</span>
                    <span class="diet-mini-pill">C {{ m.glucides ?: 0 }} g</span>
                    <span class="diet-mini-pill">F {{ m.lipides ?: 0 }} g</span>
                  </div>
                </div>
                <form method="post" action="{{ path('diet_meal_add') }}" style="margin:0;">
                  <input type="hidden" name="_token" value="{{ csrf_token('meal_add') }}">
                  <input type="hidden" name="source_repas_id" value="{{ m.id }}">
                  {% if regime %}
                    <input type="hidden" name="regime_id" value="{{ regime.id }}">
                  {% endif %}
                  <button type="submit" class="diet-btn-soft">Ajouter ce repas</button>
                </form>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="diet-empty">Aucun repas enregistre dans le catalogue.</div>
      {% endif %}
    </div>
  </div>
</div>

<div class="food-modal" id="dp-scan-meal-modal">
  <div class="food-modal-card">
    <div class="food-modal-head">
      <div>
        <h4>Scanner repas</h4>
        <p>Chargez une photo du repas pour pre-remplir les champs avant ajout.</p>
      </div>
      <button type="button" class="food-close" id="dp-scan-close">X</button>
    </div>

    <form method="post" action="{{ path('diet_meal_add') }}" id="dp-scan-meal-form">
      <input type="hidden" name="_token" value="{{ csrf_token('meal_add') }}">
      {% if regime %}
        <input type="hidden" name="regime_id" value="{{ regime.id }}">
      {% endif %}
      <div class="diet-form-group">
        <label>Photo du repas</label>
        <input class="diet-input" type="file" id="dp-scan-image-input" accept="image/*" required>
      </div>
      <div style="margin-top:0.8rem;">
        <button type="button" class="diet-btn-soft" id="dp-scan-analyze-btn">Analyser la photo</button>
      </div>
      <div class="diet-status-box" id="dp-scan-status-box"></div>
      <div class="diet-form-grid" style="margin-top:0.9rem;">
        <div class="diet-form-group">
          <label>Type de repas</label>
          <select class="diet-input" name="type_repas" id="dp-scan-type" required>
            <option value="Petit-dejeuner">Petit-d&eacute;jeuner</option>
            <option value="Dejeuner" selected>D&eacute;jeuner</option>
            <option value="Diner">D&icirc;ner</option>
            <option value="Collation">Collation</option>
          </select>
        </div>
        <div class="diet-form-group">
          <label>Nom du repas</label>
          <input class="diet-input" type="text" name="nom_repas" id="dp-scan-name" required>
        </div>
        <div class="diet-form-group">
          <label>Calories</label>
          <input class="diet-input" type="number" name="calories" id="dp-scan-calories" min="0" required>
        </div>
      </div>
      <div class="diet-form-grid-4" style="margin-top:0.9rem;">
        <div class="diet-form-group">
          <label>Proteines</label>
          <input class="diet-input" type="number" name="proteines" id="dp-scan-protein" min="0">
        </div>
        <div class="diet-form-group">
          <label>Glucides</label>
          <input class="diet-input" type="number" name="glucides" id="dp-scan-carbs" min="0">
        </div>
        <div class="diet-form-group">
          <label>Lipides</label>
          <input class="diet-input" type="number" name="lipides" id="dp-scan-fat" min="0">
        </div>
        <div class="diet-form-group">
          <label>Commentaire</label>
          <input class="diet-input" type="text" name="commentaire" id="dp-scan-comment">
        </div>
      </div>
      <div class="food-modal-actions">
        <button type="button" class="diet-btn-soft" id="dp-scan-cancel">Annuler</button>
        <button type="submit" class="diet-btn">Ajouter ce repas</button>
      </div>
    </form>
  </div>
</div>

<div class="food-modal" id="dp-shopping-modal">
  <div class="food-modal-card">
    <div class="food-modal-head">
      <div>
        <h4>Liste de courses intelligente</h4>
        <p>G&eacute;n&eacute;r&eacute;e &agrave; partir de vos repas du jour et de leurs commentaires.</p>
      </div>
      <button type="button" class="food-close" id="dp-shopping-close">X</button>
    </div>
    <div id="dp-shopping-body">
      {% if shoppingPreview.items is not empty %}
        <div class="diet-catalog-list">
          {% for item in shoppingPreview.items %}
            <div class="diet-catalog-item">
              <strong>{{ item.name }}</strong>
              <p>Quantite estimee: x{{ item.count }}</p>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="diet-empty">Aucun ingr&eacute;dient d&eacute;tect&eacute; pour le moment. Ajoutez des d&eacute;tails dans les commentaires de repas.</div>
      {% endif %}
    </div>
  </div>
</div>

<div class="food-modal" id="dp-checklist-modal">
  <div class="food-modal-card">
    <div class="food-modal-head">
      <div>
        <h4>Checklist du jour</h4>
        <p>Le suivi est calcul&eacute; automatiquement &agrave; partir des repas du jour et de l'hydratation.</p>
      </div>
      <button type="button" class="food-close" id="dp-checklist-close">X</button>
    </div>
    <div class="diet-achievement-list">
      <div class="diet-achievement-item">
        <div><strong>Petit-d&eacute;jeuner</strong><p>Repas du matin enregistr&eacute;.</p></div>
        <i class="fa {% if checklist.breakfast %}fa-check-circle diet-unlock{% else %}fa-lock diet-lock{% endif %}"></i>
      </div>
      <div class="diet-achievement-item">
        <div><strong>D&eacute;jeuner</strong><p>Repas du midi enregistr&eacute;.</p></div>
        <i class="fa {% if checklist.lunch %}fa-check-circle diet-unlock{% else %}fa-lock diet-lock{% endif %}"></i>
      </div>
      <div class="diet-achievement-item">
        <div><strong>D&icirc;ner</strong><p>Repas du soir enregistr&eacute;.</p></div>
        <i class="fa {% if checklist.dinner %}fa-check-circle diet-unlock{% else %}fa-lock diet-lock{% endif %}"></i>
      </div>
      <div class="diet-achievement-item">
        <div><strong>Collation</strong><p>Snack ou collation d&eacute;tect&eacute;.</p></div>
        <i class="fa {% if checklist.snack %}fa-check-circle diet-unlock{% else %}fa-lock diet-lock{% endif %}"></i>
      </div>
      <div class="diet-achievement-item">
        <div><strong>Hydratation</strong><p>Objectif : 1 L par jour ({{ hydrationCount }}/{{ hydrationGoal }} verres)</p></div>
        <i class="fa {% if checklist.hydration %}fa-check-circle diet-unlock{% else %}fa-lock diet-lock{% endif %}"></i>
      </div>
    </div>
  </div>
</div>

<div class="food-modal" id="dp-daily-plan-modal">
  <div class="food-modal-card">
    <div class="food-modal-head">
      <div>
        <h4>Planning 7j</h4>
        <p>R&eacute;sum&eacute; hebdomadaire de votre r&eacute;gime et de votre journal alimentaire.</p>
      </div>
      <button type="button" class="food-close" id="dp-daily-plan-close">X</button>
    </div>
    {% if regime %}
      <div class="diet-regime-list">
        {% for day in dailyPlan %}
          <div class="diet-regime-item">
            <div class="diet-regime-top">
              <div>
                <strong>{{ day.date|date('D d/m') }}</strong>
                <p>{{ day.totals.calories }} kcal · P {{ day.totals.proteines }} g · C {{ day.totals.glucides }} g · F {{ day.totals.lipides }} g</p>
              </div>
              <div class="diet-actions-row">
                <span class="diet-mini-pill">{% if day.badges.calories_ok %}Calories OK{% else %}Calories a ajuster{% endif %}</span>
                <span class="diet-mini-pill">{% if day.badges.hydration_ok %}Hydratation OK{% else %}Hydratation faible{% endif %}</span>
              </div>
            </div>
            {% if day.meals is not empty %}
              <div class="diet-journal-meta">
                {% for m in day.meals %}
                  <span class="diet-mini-pill">{{ m.dateRepas|date('H:i') }} · {{ m.nomRepas }}</span>
                {% endfor %}
              </div>
            {% else %}
              <p style="margin-top:0.7rem;">Aucun repas enregistr&eacute; ce jour-l&agrave;.</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="diet-empty">Aucun r&eacute;gime actif. Cr&eacute;ez d'abord votre profil nutritionnel.</div>
    {% endif %}
  </div>
</div>

{% for r in regimes %}
  <div class="food-modal" id="dp-edit-regime-modal-{{ r.id }}">
    <div class="food-modal-card">
      <div class="food-modal-head">
        <div>
          <h4>Modifier le r&eacute;gime #{{ r.id }}</h4>
          <p>Ajustez vos informations comme dans l'onboarding Java.</p>
        </div>
        <button type="button" class="food-close" data-regime-edit-close="{{ r.id }}">X</button>
      </div>
      <div class="diet-error-summary" data-regime-error-summary></div>
      {{ form_start(regimeEditForms[r.id], {'attr': {'class': 'js-regime-form', 'novalidate': 'novalidate'}}) }}
        <div class="diet-form-grid">
          <div class="diet-form-group">
            <label>Taille (cm)</label>
            {{ form_widget(regimeEditForms[r.id].taille, {'attr': {'class': 'diet-input js-regime-taille'}}) }}
          </div>
          <div class="diet-form-group">
            <label>Poids (kg)</label>
            {{ form_widget(regimeEditForms[r.id].poids, {'attr': {'class': 'diet-input js-regime-poids'}}) }}
          </div>
          <div class="diet-form-group">
            <label>Age</label>
            {{ form_widget(regimeEditForms[r.id].age, {'attr': {'class': 'diet-input js-regime-age'}}) }}
          </div>
        </div>
        <div class="diet-form-grid" style="margin-top:0.9rem;">
          <div class="diet-form-group">
            <label>IMC (auto)</label>
            {{ form_widget(regimeEditForms[r.id].bmi, {'attr': {'class': 'diet-input js-regime-bmi', 'readonly': 'readonly'}}) }}
          </div>
          <div class="diet-form-group">
            <label>Type sant&eacute; (auto)</label>
            {{ form_widget(regimeEditForms[r.id].typeSante, {'attr': {'class': 'diet-input js-regime-type-sante'}}) }}
          </div>
          <div class="diet-form-group">
            <label>Calories cibles (auto)</label>
            {{ form_widget(regimeEditForms[r.id].caloriesCibles, {'attr': {'class': 'diet-input js-regime-calories'}}) }}
          </div>
        </div>
        <div class="diet-form-group" style="margin-top:0.9rem;">
          <label>Repas ad&eacute;quats (auto)</label>
          {{ form_widget(regimeEditForms[r.id].repasAdequats, {'attr': {'class': 'diet-input diet-textarea js-regime-repas'}}) }}
        </div>
        <div class="food-modal-actions">
          <button type="button" class="diet-btn-soft" data-regime-edit-close="{{ r.id }}">Annuler</button>
          <button type="submit" class="diet-btn">Enregistrer</button>
        </div>
      {{ form_end(regimeEditForms[r.id]) }}
    </div>
  </div>
{% endfor %}
{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    function computeDietProfile(taille, poids, age) {
      if (!(taille > 0) || !(poids > 0) || !(age > 0)) {
        return { bmi: '', typeSante: '', calories: '', repas: '' };
      }

      const bmi = Math.round((poids / Math.pow(taille / 100, 2)) * 100) / 100;
      let typeSante = '';
      if (bmi < 18.5) typeSante = 'sous_poids';
      else if (bmi < 25) typeSante = 'normal';
      else if (bmi < 30) typeSante = 'surpoids';
      else typeSante = 'obesite';

      let calories = Math.round(poids * 30);
      if (typeSante === 'sous_poids') calories += 250;
      else if (typeSante === 'obesite') calories -= 350;
      else if (typeSante === 'surpoids') calories -= 200;
      if (age > 45) calories -= 80;
      calories = Math.max(1200, calories);

      const suggestions = {
        sous_poids: 'Augmentez les calories, proteines et glucides. Repas riches: avocat, noix, viandes, oeufs, riz complet.',
        normal: 'Equilibrez proteines, glucides et lipides. Privilegiez legumes, viandes maigres et cereales completes.',
        surpoids: 'Reduisez les calories, evitez les sucres raffines. Legumes verts, proteines maigres et glucides complexes.',
        obesite: 'Regime hypocalorique controle. Legumes, viandes blanches, limitation des feculents et des graisses.',
        diabetique: 'Repas a index glycemique modere, legumes, fibres et portions controlees.',
        cardiaque: 'Limitez le sel et les graisses saturees. Favorisez poisson, huile d olive et legumes.',
        autre: 'Choisissez des repas simples, frais et faciles a digerer selon votre tolerance.'
      };

      let repas = suggestions[typeSante] || '';
      if (repas && age >= 45) repas += ' Hydratation et fibres renforcees.';

      return { bmi, typeSante, calories, repas };
    }

    function clearValidation(form) {
      form.querySelectorAll('.diet-field-error, .diet-field-valid').forEach((node) => node.remove());
      form.querySelectorAll('.is-invalid, .is-valid').forEach((node) => {
        node.classList.remove('is-invalid', 'is-valid');
      });
      const summary = form.parentElement.querySelector('[data-regime-error-summary]');
      if (summary) {
        summary.style.display = 'none';
        summary.textContent = '';
      }
    }

    function appendValidation(input, message, valid) {
      if (!input) return;
      input.classList.add(valid ? 'is-valid' : 'is-invalid');
      input.classList.remove(valid ? 'is-invalid' : 'is-valid');
      const el = document.createElement('div');
      el.className = valid ? 'diet-field-valid' : 'diet-field-error';
      el.textContent = message;
      input.parentElement.appendChild(el);
    }

    function validateRegimeForm(form) {
      clearValidation(form);
      const fields = [
        { selector: '.js-regime-taille', label: 'La taille', min: 100, max: 250, integer: false },
        { selector: '.js-regime-poids', label: 'Le poids', min: 25, max: 300, integer: false },
        { selector: '.js-regime-age', label: "L'age", min: 10, max: 100, integer: true }
      ];

      const errors = [];
      fields.forEach((field) => {
        const input = form.querySelector(field.selector);
        if (!input) return;
        const raw = String(input.value || '').replace(',', '.').trim();
        if (!raw) {
          errors.push(field.label + ' est obligatoire.');
          appendValidation(input, field.label + ' est obligatoire.', false);
          return;
        }

        const value = field.integer ? parseInt(raw, 10) : parseFloat(raw);
        if (Number.isNaN(value) || value < field.min || value > field.max) {
          errors.push(field.label + ' doit etre entre ' + field.min + ' et ' + field.max + '.');
          appendValidation(input, field.label + ' doit etre entre ' + field.min + ' et ' + field.max + '.', false);
          return;
        }

        appendValidation(input, field.label + ' est valide.', true);
      });

      const summary = form.parentElement.querySelector('[data-regime-error-summary]');
      if (errors.length > 0) {
        if (summary) {
          summary.textContent = errors[0];
          summary.style.display = 'block';
        }
        return false;
      }

      return true;
    }

    function refreshRegimeForm(form) {
      const taille = parseFloat(String(form.querySelector('.js-regime-taille')?.value || '').replace(',', '.')) || 0;
      const poids = parseFloat(String(form.querySelector('.js-regime-poids')?.value || '').replace(',', '.')) || 0;
      const age = parseInt(form.querySelector('.js-regime-age')?.value || '0', 10) || 0;
      const profile = computeDietProfile(taille, poids, age);

      const bmiEl = form.querySelector('.js-regime-bmi');
      const typeEl = form.querySelector('.js-regime-type-sante');
      const calEl = form.querySelector('.js-regime-calories');
      const repasEl = form.querySelector('.js-regime-repas');

      if (bmiEl) bmiEl.value = profile.bmi !== '' ? profile.bmi : '';
      if (typeEl) typeEl.value = profile.typeSante;
      if (calEl) calEl.value = profile.calories;
      if (repasEl) repasEl.value = profile.repas;
    }

    document.querySelectorAll('.js-regime-form').forEach((form) => {
      ['.js-regime-taille', '.js-regime-poids', '.js-regime-age'].forEach((selector) => {
        const input = form.querySelector(selector);
        if (!input) return;
        input.addEventListener('input', () => {
          refreshRegimeForm(form);
          validateRegimeForm(form);
        });
        input.addEventListener('blur', () => validateRegimeForm(form));
      });

      form.addEventListener('submit', (event) => {
        refreshRegimeForm(form);
        if (!validateRegimeForm(form)) {
          event.preventDefault();
          event.stopPropagation();
        }
      });

      refreshRegimeForm(form);
    });

    function bindModal(triggerIds, modalId, closeIds) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      const openers = triggerIds.map((id) => document.getElementById(id)).filter(Boolean);
      const closers = closeIds.map((id) => document.getElementById(id)).filter(Boolean);
      const open = () => modal.classList.add('show');
      const close = () => modal.classList.remove('show');

      openers.forEach((btn) => btn.addEventListener('click', open));
      closers.forEach((btn) => btn.addEventListener('click', close));
      modal.addEventListener('click', (event) => {
        if (event.target === modal) close();
      });

      return { open, close, modal };
    }

    const createRegimeModal = bindModal(
      ['dp-open-create-regime-dialog', 'dp-open-create-regime-hero'],
      'dp-create-regime-modal',
      ['dp-create-regime-close', 'dp-create-regime-cancel']
    );
    const addMealModal = bindModal(
      ['dp-open-add-meal-hero', 'dp-open-add-meal-manage'],
      'dp-add-meal-modal',
      ['dp-add-meal-close']
    );
    const dailyPlanModal = bindModal(
      ['dp-open-daily-plan-dialog', 'dp-open-daily-plan-manage', 'dp-open-daily-plan-hero'],
      'dp-daily-plan-modal',
      ['dp-daily-plan-close']
    );
    bindModal(['dp-open-shopping-dialog'], 'dp-shopping-modal', ['dp-shopping-close']);
    bindModal(['dp-open-checklist-dialog'], 'dp-checklist-modal', ['dp-checklist-close']);

    const scanDialog = document.getElementById('dp-scan-meal-modal');
    const scanOpen = document.getElementById('dp-open-scan-dialog');
    const scanClose = document.getElementById('dp-scan-close');
    const scanCancel = document.getElementById('dp-scan-cancel');
    const openScan = () => scanDialog?.classList.add('show');
    const closeScan = () => scanDialog?.classList.remove('show');
    scanOpen?.addEventListener('click', openScan);
    scanClose?.addEventListener('click', closeScan);
    scanCancel?.addEventListener('click', closeScan);
    scanDialog?.addEventListener('click', (event) => {
      if (event.target === scanDialog) closeScan();
    });

    const openIntent = new URLSearchParams(window.location.search).get('open');

    if (openIntent === 'create-regime' && createRegimeModal) {
      createRegimeModal.open();
    } else if (openIntent === 'daily-plan' && dailyPlanModal) {
      dailyPlanModal.open();
    } else if ({{ showCreateRegimeOnboarding ? 'true' : 'false' }} && createRegimeModal) {
      createRegimeModal.open();
    }

    document.querySelectorAll('[data-regime-edit-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-regime-edit-open');
        document.getElementById('dp-edit-regime-modal-' + id)?.classList.add('show');
      });
    });

    document.querySelectorAll('[data-regime-edit-close]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-regime-edit-close');
        document.getElementById('dp-edit-regime-modal-' + id)?.classList.remove('show');
      });
    });

    document.querySelectorAll('[id^="dp-edit-regime-modal-"]').forEach((modal) => {
      modal.addEventListener('click', (event) => {
        if (event.target === modal) modal.classList.remove('show');
      });
    });

    document.querySelectorAll('[data-meal-edit-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-meal-edit-open');
        const row = document.getElementById('meal-edit-' + id);
        if (!row) return;
        row.style.display = row.style.display === 'block' ? 'none' : 'block';
      });
    });

    const shoppingOpen = document.getElementById('dp-open-shopping-dialog');
    const shoppingBody = document.getElementById('dp-shopping-body');
    shoppingOpen?.addEventListener('click', async () => {
      const url = shoppingOpen.dataset.url || '';
      if (!url || !shoppingBody) return;
      shoppingBody.innerHTML = '<div class="diet-empty">Generation de votre liste de courses...</div>';
      try {
        const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await response.json();
        if (!response.ok || !Array.isArray(data.items) || data.items.length === 0) {
          shoppingBody.innerHTML = '<div class="diet-empty">Aucun ingr&eacute;dient d&eacute;tect&eacute; pour le moment.</div>';
          return;
        }
        shoppingBody.innerHTML = data.items.map((item) => (
          '<div class="diet-catalog-item"><strong>' + item.name + '</strong><p>Quantite estimee: x' + item.count + '</p></div>'
        )).join('');
      } catch (_) {
        shoppingBody.innerHTML = '<div class="diet-empty">Impossible de generer la liste de courses pour le moment.</div>';
      }
    });

    const hydrationBtn = document.getElementById('dp-hydration-add');
    hydrationBtn?.addEventListener('click', async () => {
      const url = hydrationBtn.dataset.url || '';
      const token = hydrationBtn.dataset.token || '';
      if (!url || !token) return;

      try {
        const response = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: new URLSearchParams({ _token: token })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.ok) return;
        window.location.reload();
      } catch (_) {
      }
    });

    const barcodeForm = document.getElementById('dp-barcode-form');
    const barcodeInput = document.getElementById('dp-barcode-input');
    const barcodeStatus = document.getElementById('dp-barcode-status');
    barcodeForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const barcode = String(barcodeInput?.value || '').trim();
      const url = barcodeForm.dataset.url || '';
      if (!barcode || !url) return;

      barcodeStatus.textContent = 'Recherche du produit...';
      try {
        const response = await fetch(url + '?barcode=' + encodeURIComponent(barcode), {
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.ok) {
          barcodeStatus.textContent = data.message || 'Produit introuvable.';
          return;
        }

        const setValue = (id, value) => {
          const input = document.getElementById(id);
          if (input) input.value = value ?? '';
        };

        setValue('dp-manual-type', 'Extra meal');
        setValue('dp-manual-name', data.food || '');
        setValue('dp-manual-calories', Math.round(data.calories || 0));
        setValue('dp-manual-protein', Math.round(data.protein || 0));
        setValue('dp-manual-carbs', Math.round(data.carbs || 0));
        setValue('dp-manual-fat', Math.round(data.fat || 0));
        setValue('dp-manual-comment', data.comment || '');
        barcodeStatus.textContent = 'Produit trouve. Ajout au regime en cours...';
        document.getElementById('dp-manual-meal-form')?.submit();
      } catch (_) {
        barcodeStatus.textContent = 'OpenFoodFacts est temporairement indisponible.';
      }
    });

    const scanAnalyzeBtn = document.getElementById('dp-scan-analyze-btn');
    const scanStatusBox = document.getElementById('dp-scan-status-box');
    const scanImageInput = document.getElementById('dp-scan-image-input');
    scanAnalyzeBtn?.addEventListener('click', async () => {
      const file = scanImageInput?.files && scanImageInput.files[0] ? scanImageInput.files[0] : null;
      const url = scanOpen?.dataset.url || '';
      const token = scanOpen?.dataset.token || '';
      if (!file || !url || !token || !scanStatusBox) return;

      const setStatus = (message, ok) => {
        scanStatusBox.textContent = message;
        scanStatusBox.style.display = 'block';
        scanStatusBox.style.background = ok ? '#eefaf2' : '#fff2f2';
        scanStatusBox.style.color = ok ? '#0a7d5c' : '#b54141';
        scanStatusBox.style.border = ok ? '1px solid #b6ecd3' : '1px solid #efc0c0';
      };

      const payload = new FormData();
      payload.append('image', file);
      payload.append('_token', token);
      setStatus('Analyse en cours...', true);
      scanAnalyzeBtn.disabled = true;

      try {
        const response = await fetch(url, {
          method: 'POST',
          body: payload,
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || data.error) {
          setStatus(data.error || 'Analyse indisponible.', false);
          return;
        }

        const setValue = (id, value) => {
          const input = document.getElementById(id);
          if (input) input.value = value ?? '';
        };

        setValue('dp-scan-name', data.food || '');
        setValue('dp-scan-calories', Math.round(data.calories || 0));
        setValue('dp-scan-protein', Math.round(data.protein || 0));
        setValue('dp-scan-carbs', Math.round(data.carbs || 0));
        setValue('dp-scan-fat', Math.round(data.fat || 0));
        setValue('dp-scan-comment', 'Source: analyse photo automatique.');
        setStatus('Analyse terminee. Verifiez les champs puis ajoutez le repas.', true);
      } catch (_) {
        setStatus('Erreur pendant l analyse de la photo.', false);
      } finally {
        scanAnalyzeBtn.disabled = false;
      }
    });
  });
</script>
{% endblock %}

{% block footer %}{% endblock %}
