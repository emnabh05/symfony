      {{ form_end(regimeCreateForm) }}
    </div>
  </div>
</div>

{# Dialogue modal pour ajouter un repas à partir des repas existants #}
<div class="food-modal" id="dp-add-meal-modal">
  <div class="food-modal-card">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <h4>Ajouter un repas existant</h4>
      <button type="button" id="dp-add-meal-close" class="btn btn-link text-muted" style="text-decoration:none;">✕</button>
    </div>
    <p class="text-muted">Sélectionnez un repas déjà enregistré pour l'ajouter à la journée en cours. La jauge indique l’impact sur vos calories cibles.</p>
    <div class="modal-help">
      Choisissez un repas dans la liste, puis cliquez sur "Ajouter ce repas". Vous pouvez comparer l'impact calorique avant validation.
    </div>
    <div class="section-help" style="margin:0.65rem 0 0.75rem;">
      Choisissez un repas depuis la liste ci-dessous pour un ajout rapide a la journee.
    </div>
    <div class="mt-2">
      {% if catalogMeals is not empty %}
        <div class="row" style="row-gap: 0.75rem;">
          {% for m in catalogMeals %}
            {% set pct = (regime and regime.caloriesCibles) ? ((m.calories ?? 0) / regime.caloriesCibles * 100) : 0 %}
            <div class="col-md-6">
              <div class="diet-card" style="border-radius:12px; padding:0.8rem 0.9rem; border:1px solid #dce7f2;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:0.45rem;">
                  <strong style="line-height:1.25;">{{ m.nomRepas }}</strong>
                  <span class="pill" style="margin-right:0; white-space:nowrap;">{{ m.typeRepas ?: 'Repas' }}</span>
                </div>
                <div class="muted" style="font-size:0.85rem;margin-top:0.35rem;">
                  <i class="fa fa-fire"></i> {{ m.calories ?? 0 }} kcal
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:0.35rem;margin-top:0.35rem;">
                  <span class="pill" style="background:#eef2ff;color:#1e3a8a;">P {{ m.proteines ?? 0 }} g</span>
                  <span class="pill" style="background:#ecfeff;color:#155e75;">C {{ m.glucides ?? 0 }} g</span>
                  <span class="pill" style="background:#fff7ed;color:#9a3412;">F {{ m.lipides ?? 0 }} g</span>
                </div>
                {% if regime and regime.caloriesCibles %}
                  <div style="margin-top:0.6rem;">
                    <div class="form-label-icon" style="font-size:0.8rem;"><i class="fa fa-line-chart"></i> Impact sur la journée</div>
                    <div class="progress-bar">
                      <span style="width:{{ pct > 120 ? 120 : pct }}%; background: {{ pct > 100 ? '#d64545' : 'var(--dp-accent)' }};"></span>
                    </div>
                    <small class="text-muted">{{ (m.calories ?? 0) }} / {{ regime.caloriesCibles }} kcal</small>
                  </div>
                {% endif %}
                <form method="post" action="{{ path('diet_meal_add') }}" style="margin-top:0.65rem;">
                  <input type="hidden" name="_token" value="{{ csrf_token('meal_add') }}">
                  <input type="hidden" name="source_repas_id" value="{{ m.id }}">
                  {% if regime %}
                    <input type="hidden" name="regime_id" value="{{ regime.id }}">
                  {% endif %}
                  <button type="submit" class="btn-fit btn-sm btn-full">Ajouter ce repas</button>
                </form>
              </div>
            </div>
          {% endfor %}
    </div>
      {% else %}
        <p class="muted">Aucun repas n'est encore enregistré. Créez d'abord des repas dans la section repas.</p>
      {% endif %}
    </div>
  </div>
</div>

{# Dialogue modal pour scanner un repas par photo (IA) #}
<div class="food-modal" id="dp-scan-meal-modal">
  <div class="food-modal-card">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <h4>Scanner un repas (IA)</h4>
      <button type="button" id="dp-scan-close" class="btn btn-link text-muted" style="text-decoration:none;">✕</button>
    </div>
    <p class="text-muted" style="margin-bottom:0.5rem;">
      Prenez une photo de votre repas: l'IA detecte l'aliment et estime calories/macros automatiquement.
    </p>
    <div class="modal-help">
      Conseil: prenez une photo nette, bien eclairee, avec le plat centré.
    </div>

    <form method="post" action="{{ path('diet_meal_add') }}" class="meal-form" id="dp-scan-meal-form">
      <input type="hidden" name="_token" value="{{ csrf_token('meal_add') }}">
      {% if regime %}
        <input type="hidden" name="regime_id" value="{{ regime.id }}">
      {% endif %}

      <div class="form-group" style="margin-bottom:0.55rem;">
        <label class="label-mini">Photo du repas</label>
        <input type="file" class="form-control" id="dp-scan-image-input" accept="image/*" required>
      </div>
      <div class="form-group" style="margin-bottom:0.65rem;">
        <button type="button" class="btn-soft btn-sm" id="dp-scan-analyze-btn">Analyser la photo</button>
      </div>
      <div id="dp-scan-status" class="label-mini" style="min-height:1.2rem;margin-bottom:0.6rem;"></div>

      <div class="form-row">
        <div class="form-group col-md-4">
          <label class="label-mini">Type de repas</label>
          <select name="type_repas" id="dp-scan-type" class="form-control" required>
            <option value="Petit-dejeuner">Petit-dejeuner</option>
            <option value="Dejeuner" selected>Dejeuner</option>
            <option value="Diner">Diner</option>
            <option value="Collation">Collation</option>
          </select>
        </div>
        <div class="form-group col-md-8">
          <label class="label-mini">Nom du repas</label>
          <input type="text" id="dp-scan-name" name="nom_repas" class="form-control" required>
        </div>
      </div>

      <div class="input-group-mini">
        <div>
          <label class="label-mini">Calories</label>
          <input type="number" id="dp-scan-calories" name="calories" class="form-control" min="0" required>
        </div>
        <div>
          <label class="label-mini">Proteines</label>
          <input type="number" id="dp-scan-protein" name="proteines" class="form-control" min="0" step="1">
        </div>
        <div>
          <label class="label-mini">Glucides</label>
          <input type="number" id="dp-scan-carbs" name="glucides" class="form-control" min="0" step="1">
        </div>
        <div>
          <label class="label-mini">Lipides</label>
          <input type="number" id="dp-scan-fat" name="lipides" class="form-control" min="0" step="1">
        </div>
      </div>

      <div class="form-group" style="margin-top:0.6rem;">
        <label class="label-mini">Commentaire</label>
        <textarea name="commentaire" id="dp-scan-comment" class="form-control" rows="2" placeholder="Optionnel"></textarea>
      </div>

      <div class="food-modal-actions">
        <button type="button" class="btn btn-outline-secondary" id="dp-scan-cancel">Annuler</button>
        <button type="submit" class="btn-fit">Ajouter ce repas</button>
      </div>
    </form>
  </div>
</div>

{# Dialogue modal pour la liste de courses intelligente #}
<div class="food-modal" id="dp-shopping-modal">
  <div class="food-modal-card">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <h4>Liste de courses intelligente</h4>
      <button type="button" id="dp-shopping-close" class="btn btn-link text-muted" style="text-decoration:none;">✕</button>
    </div>
    <p class="text-muted" style="margin-bottom:0.5rem;">
      Générée automatiquement à partir de vos repas du jour (ingrédients listés dans les commentaires de vos repas).
    </p>
    <div class="modal-help">
      Cochez les ingrédients déjà disponibles pour préparer vos achats plus facilement.
    </div>
    <div id="dp-shopping-body" class="mt-2">
      <p class="muted">Cliquez sur le bouton dans la section des repas pour générer votre liste de courses.</p>
    </div>
  </div>
</div>

{# Dialogue modal pour la checklist du jour #}
<div class="food-modal" id="dp-checklist-modal">
  <div class="food-modal-card">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <h4>Checklist du jour</h4>
      <button type="button" id="dp-checklist-close" class="btn btn-link text-muted" style="text-decoration:none;">✕</button>
    </div>
    <p class="text-muted" style="margin-bottom:0.5rem;">
      Coche les éléments complétés pour ta journée (basé automatiquement sur tes repas du jour).
    </p>
    <div class="modal-help">
      Cette checklist est informative: les cases se cochent selon les repas enregistrés, sans action manuelle nécessaire.
    </div>
    <div class="mt-2">
      <ul class="list-unstyled" style="margin-bottom:0;">
        <li style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem;">
          <input type="checkbox" {% if checklist.breakfast %}checked{% endif %} disabled>
          <span>Petit‑déjeuner</span>
        </li>
        <li style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem;">
          <input type="checkbox" {% if checklist.lunch %}checked{% endif %} disabled>
          <span>Déjeuner</span>
        </li>
        <li style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem;">
          <input type="checkbox" {% if checklist.dinner %}checked{% endif %} disabled>
          <span>Dîner</span>
        </li>
        <li style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem;">
          <input type="checkbox" {% if checklist.snack %}checked{% endif %} disabled>
          <span>Collation / snack</span>
        </li>
        <li style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.35rem;">
          <input type="checkbox" {% if checklist.hydration %}checked{% endif %} disabled>
          <span>Hydratation suffisante (≥ 3 prises dans la journée)</span>
        </li>
      </ul>
      <p class="label-mini" style="margin-top:0.5rem;">
        Les cases sont cochées automatiquement selon tes repas enregistrés aujourd'hui.
      </p>
    </div>
  </div>
</div>

{# Dialogue modal pour le daily plan de repas (calendrier sur 7 jours du régime actif) #}
<div class="food-modal" id="dp-daily-plan-modal">
  <div class="food-modal-card">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <h4>Daily plan de repas</h4>
      <button type="button" id="dp-daily-plan-close" class="btn btn-link text-muted" style="text-decoration:none;">✕</button>
    </div>
    {% if regime %}
      <p class="text-muted" style="margin-bottom:0.5rem;">
        Calendrier des 7 derniers jours pour votre régime
        <strong>{{ regime.typeSante ?? 'N/A' }}</strong> ({{ regime.caloriesCibles ?? '—' }} kcal/j).
      </p>
      <div class="modal-help">
        Comparez rapidement vos journées pour voir la régularité des repas et votre adhérence à l'objectif calorique.
      </div>
      <div class="row" style="row-gap:0.75rem;max-height:320px;overflow-y:auto;">
        {% for day in dailyPlan %}
          <div class="col-md-6">
            <div class="diet-card" style="border-radius:12px;padding:0.6rem 0.8rem;">
              <div class="sub-title" style="margin-bottom:0.25rem;">
                {{ day.date|date('D d/m') }}
              </div>
              <div class="summary-grid" style="margin-bottom:0.35rem;">
                <div class="summary-item"><i class="fa fa-fire"></i>{{ day.totals.calories }} kcal</div>
                <div class="summary-item"><i class="fa fa-bolt"></i>P {{ day.totals.proteines }} g</div>
                <div class="summary-item"><i class="fa fa-leaf"></i>C {{ day.totals.glucides }} g</div>
                <div class="summary-item"><i class="fa fa-tint"></i>F {{ day.totals.lipides }} g</div>
              </div>

              {# Badges journaliers avec le même design que précédemment #}
              <div class="row" style="row-gap:0.4rem;margin-bottom:0.4rem;">
                {% set badges = {
                  'perfect_week': {
                    'label': 'Semaine parfaite',
                    'description': 'Calories dans la cible sur cette journée.',
                    'unlocked': day.badges.calories_ok
                  },
                  'hydration_7_days': {
                    'label': 'Hydratation OK',
                    'description': 'Au moins 3 repas / collations enregistrés aujourd\'hui.',
                    'unlocked': day.badges.hydration_ok
                  },
                  'calories_10_days': {
                    'label': 'Calories respectées',
                    'description': 'Journée avec calories proches de l\'objectif.',
                    'unlocked': day.badges.calories_ok
                  }
                } %}
                {% for key, badge in badges %}
                  <div class="col-12">
                    <div class="diet-card" style="border-radius:10px;padding:0.35rem 0.6rem;border-style:dashed;{% if badge.unlocked %}background:#ecfdf5;border-color:#22c55e;{% else %}background:#f9fafb;border-color:#e5e7eb;opacity:0.85;{% endif %}">
                      <div style="display:flex;align-items:center;gap:0.5rem;">
                        {% if badge.unlocked %}
                          <i class="fa fa-check-circle" style="color:#16a34a;"></i>
                        {% else %}
                          <i class="fa fa-lock" style="color:#9ca3af;"></i>
                        {% endif %}
                        <div>
                          <div class="label-mini" style="font-weight:700;color:#111827;">{{ badge.label }}</div>
                          <div class="label-mini">{{ badge.description }}</div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
              {% if day.meals is not empty %}
                <ul class="list-unstyled" style="margin-bottom:0;">
                  {% for m in day.meals %}
                    <li style="font-size:0.85rem;margin-bottom:0.15rem;">
                      <strong>{{ m.dateRepas|date('H:i') }}</strong> ·
                      {{ m.typeRepas }} – {{ m.nomRepas }}
                      {% if m.calories is not null %}
                        ({{ m.calories }} kcal)
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <p class="muted" style="font-size:0.8rem;margin-bottom:0;">Aucun repas enregistré ce jour-là.</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="muted">Aucun régime actif. Sélectionnez d'abord un régime pour voir le calendrier des repas.</p>
    {% endif %}
  </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Auto-calcul IMC, type santé, calories et repas adéquats
    function calcRegime(form) {
      const taille = parseFloat(form.querySelector('.js-regime-taille')?.value) || 0;
      const poids = parseFloat(form.querySelector('.js-regime-poids')?.value) || 0;
      const age = parseInt(form.querySelector('.js-regime-age')?.value, 10) || 0;
      const gender = (form.dataset.userGender || 'male').toLowerCase();
      const bmiEl = form.querySelector('.js-regime-bmi');
      const typeEl = form.querySelector('.js-regime-type-sante');
      const calEl = form.querySelector('.js-regime-calories');
      const repasEl = form.querySelector('.js-regime-repas');

      let bmi = null;
      let typeSante = '';
      let calories = null;
      let repasAdequats = '';

      if (taille > 0 && poids > 0) {
        bmi = Math.round(poids / Math.pow(taille / 100, 2) * 100) / 100;
        if (bmi < 18.5) typeSante = 'sous_poids';
        else if (bmi < 25) typeSante = 'normal';
        else if (bmi < 30) typeSante = 'surpoids';
        else typeSante = 'obesite';

        if (age > 0 && age <= 100) {
          const bmr = gender === 'female' || gender === 'f'
            ? 10 * poids + 6.25 * taille - 5 * age - 161
            : 10 * poids + 6.25 * taille - 5 * age + 5;
          calories = Math.round(bmr * 1.2);
          if (typeSante === 'surpoids' || typeSante === 'obesite') calories = Math.round(calories * 0.9);
          else if (typeSante === 'sous_poids') calories = Math.round(calories * 1.1);
        }

        const suggestions = {
          sous_poids: 'Augmentez les calories, protéines et glucides. Repas riches: avocat, noix, viandes, œufs, riz complet.',
          normal: 'Équilibrez protéines, glucides et lipides. Privilégiez légumes, viandes maigres, céréales complètes.',
          surpoids: 'Réduisez les calories, évitez sucres raffinés. Légumes verts, protéines maigres, glucides complexes.',
          obesite: 'Régime hypocalorique contrôlé. Légumes, viandes blanches, limitation des féculents et graisses.'
        };
        repasAdequats = suggestions[typeSante] || '';
      }

      if (bmiEl) bmiEl.value = bmi !== null ? bmi : '';
      if (typeEl) typeEl.value = typeSante;
      if (calEl) calEl.value = calories !== null ? calories : '';
      if (repasEl) repasEl.value = repasAdequats;
    }

    function normalizeNumber(value) {
      return (value || '').toString().trim().replace(',', '.');
    }

    function clearRegimeErrors(form) {
      form.querySelectorAll('.regime-field-error').forEach((el) => el.remove());
      form.querySelectorAll('.regime-field-valid').forEach((el) => el.remove());
      form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
      form.querySelectorAll('.is-valid').forEach((el) => el.classList.remove('is-valid'));
      const summary = form.querySelector('[data-regime-error-summary]');
      if (summary) {
        summary.style.display = 'none';
        summary.textContent = '';
      }
    }

    function setRegimeFieldError(input, message) {
      if (!input) return;
      input.classList.remove('is-valid');
      input.classList.add('is-invalid');
      const err = document.createElement('div');
      err.className = 'regime-field-error';
      err.textContent = message;
      const group = input.closest('.form-group') || input.parentElement;
      if (group) group.appendChild(err);
    }

    function setRegimeFieldValid(input, message) {
      if (!input) return;
      input.classList.remove('is-invalid');
      input.classList.add('is-valid');
      const ok = document.createElement('div');
      ok.className = 'regime-field-valid';
      ok.textContent = message;
      const group = input.closest('.form-group') || input.parentElement;
      if (group) group.appendChild(ok);
    }

    function validateRegimeForm(form) {
      clearRegimeErrors(form);
      const errors = [];

      const fields = [
        { selector: '.js-regime-taille', label: 'La taille', min: 100, max: 250 },
        { selector: '.js-regime-poids', label: 'Le poids', min: 25, max: 300 },
        { selector: '.js-regime-age', label: "L'age", min: 10, max: 100, integer: true }
      ];

      fields.forEach((field) => {
        const input = form.querySelector(field.selector);
        if (!input) return;

        const raw = normalizeNumber(input.value);
        if (!raw) {
          const msg = field.label + ' est obligatoire.';
          errors.push(msg);
          setRegimeFieldError(input, msg);
          return;
        }

        const value = field.integer ? parseInt(raw, 10) : parseFloat(raw);
        if (Number.isNaN(value)) {
          const msg = field.label + ' doit être un nombre valide.';
          errors.push(msg);
          setRegimeFieldError(input, msg);
          return;
        }

        if (field.integer && !/^\d+$/.test(raw)) {
          const msg = field.label + ' doit être un nombre entier.';
          errors.push(msg);
          setRegimeFieldError(input, msg);
          return;
        }

        if (value < field.min || value > field.max) {
          const msg = field.label + ' doit être entre ' + field.min + ' et ' + field.max + '.';
          errors.push(msg);
          setRegimeFieldError(input, msg);
          return;
        }

        setRegimeFieldValid(input, field.label + ' est valide.');
      });

      if (errors.length > 0) {
        const summary = form.querySelector('[data-regime-error-summary]');
        if (summary) {
          summary.textContent = errors[0];
          summary.style.display = 'block';
        }
        return false;
      }

      return true;
    }

    document.querySelectorAll('.js-regime-form').forEach(form => {
      ['taille', 'poids', 'age'].forEach(f => {
        const el = form.querySelector('.js-regime-' + (f === 'taille' ? 'taille' : f === 'poids' ? 'poids' : 'age'));
        if (!el) return;
        el.addEventListener('input', () => {
          calcRegime(form);
          validateRegimeForm(form);
        });
        el.addEventListener('blur', () => {
          validateRegimeForm(form);
        });
      });

      form.addEventListener('submit', (e) => {
        calcRegime(form);
        if (!validateRegimeForm(form)) {
          e.preventDefault();
          e.stopPropagation();
        }
      });

      calcRegime(form);
    });

    // Bouton "Ajouter un repas" dans le bloc régime -> ouvre le dialogue de sélection de repas existants
    const regimeAddMealBtn = document.getElementById('regime-add-meal-btn');
    const bottomScanBtn = document.getElementById('dp-open-add-meal-bottom');
    const addMealDialog = document.getElementById('dp-add-meal-modal');
    const addMealClose = document.getElementById('dp-add-meal-close');
    if (addMealDialog) {
      const closeAddMeal = () => addMealDialog.classList.remove('show');
      if (regimeAddMealBtn) {
        regimeAddMealBtn.addEventListener('click', () => {
          addMealDialog.classList.add('show');
        });
      }
      if (addMealClose) {
        addMealClose.addEventListener('click', closeAddMeal);
      }
      addMealDialog.addEventListener('click', (e) => {
        if (e.target === addMealDialog) closeAddMeal();
      });
    }

    // Dialogue scan IA de repas
    const scanOpen = document.getElementById('dp-open-scan-dialog');
    const scanDialog = document.getElementById('dp-scan-meal-modal');
    const scanClose = document.getElementById('dp-scan-close');
    const scanCancel = document.getElementById('dp-scan-cancel');
    const scanAnalyze = document.getElementById('dp-scan-analyze-btn');
    const scanInput = document.getElementById('dp-scan-image-input');
    const scanStatus = document.getElementById('dp-scan-status');
    const scanName = document.getElementById('dp-scan-name');
    const scanCalories = document.getElementById('dp-scan-calories');
    const scanProtein = document.getElementById('dp-scan-protein');
    const scanCarbs = document.getElementById('dp-scan-carbs');
    const scanFat = document.getElementById('dp-scan-fat');
    const scanComment = document.getElementById('dp-scan-comment');

    if (scanDialog) {
      const closeScan = () => scanDialog.classList.remove('show');
      if (scanOpen) {
        scanOpen.addEventListener('click', () => scanDialog.classList.add('show'));
      }
      if (bottomScanBtn) {
        bottomScanBtn.addEventListener('click', () => scanDialog.classList.add('show'));
      }
      if (scanClose) scanClose.addEventListener('click', closeScan);
      if (scanCancel) scanCancel.addEventListener('click', closeScan);
      scanDialog.addEventListener('click', (e) => {
        if (e.target === scanDialog) closeScan();
      });
    }

    if (scanAnalyze && scanOpen && scanInput) {
      const setStatus = (text, isError = false) => {
        if (!scanStatus) return;
        scanStatus.textContent = text;
        scanStatus.style.color = isError ? '#b91c1c' : '#475569';
      };

      scanAnalyze.addEventListener('click', async () => {
        const file = scanInput.files && scanInput.files[0] ? scanInput.files[0] : null;
        if (!file) {
          setStatus('Selectionnez une image avant analyse.', true);
          return;
        }

        const apiUrl = scanOpen.dataset.url || '';
        const csrf = scanOpen.dataset.token || '';
        if (!apiUrl || !csrf) {
          setStatus('Configuration API manquante.', true);
          return;
        }

        const fd = new FormData();
        fd.append('image', file);
        fd.append('_token', csrf);

        scanAnalyze.disabled = true;
        setStatus('Analyse IA en cours...');
        try {
          const resp = await fetch(apiUrl, {
            method: 'POST',
            body: fd,
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'application/json'
            }
          });

          const raw = await resp.text();
          let data = null;
          try {
            data = JSON.parse(raw);
          } catch (_) {
            const clean = String(raw || '')
              .replace(/<[^>]*>/g, ' ')
              .replace(/\s+/g, ' ')
              .trim();
            throw new Error(clean || ('Reponse serveur non-JSON (HTTP ' + resp.status + ')'));
          }

          if (!resp.ok || data.error) {
            throw new Error(data.error || ('HTTP ' + resp.status));
          }

          if (scanName) scanName.value = data.food || '';
          if (scanCalories) scanCalories.value = Math.round(data.calories || 0);
          if (scanProtein) scanProtein.value = Math.round(data.protein || 0);
          if (scanCarbs) scanCarbs.value = Math.round(data.carbs || 0);
          if (scanFat) scanFat.value = Math.round(data.fat || 0);
          if (scanComment) {
            const confidence = data.confidence !== undefined ? ('Confiance IA: ' + data.confidence + '%. ') : '';
            scanComment.value = confidence + 'Source: photo analysee automatiquement.';
          }

          setStatus('Analyse terminee. Verifiez les valeurs puis cliquez sur "Ajouter ce repas".');
        } catch (err) {
          setStatus('Erreur analyse IA: ' + (err.message || 'inconnue'), true);
        } finally {
          scanAnalyze.disabled = false;
        }
      });
    }

    // Jauge dynamique de calories pendant la saisie du repas
    const gauge = document.getElementById('regime-calorie-gauge');
    if (gauge) {
      const target = parseInt(gauge.dataset.target || '0', 10) || 0;
      const base = parseInt(gauge.dataset.current || '0', 10) || 0;
      const fill = document.getElementById('regime-calorie-fill');
      const text = document.getElementById('regime-calorie-text');
      const caloriesInput = document.querySelector('.meal-form input[name="calories"]');
      const submitBtn = document.querySelector('.meal-form button.btn-fit');

      const updateGauge = (extra) => {
        const add = Number.isFinite(extra) ? extra : 0;
        const used = base + (add > 0 ? add : 0);
        let pct = target > 0 ? (used / target * 100) : 0;
        if (pct < 0) pct = 0;
        if (pct > 120) pct = 120;
        if (fill) {
          fill.style.width = Math.min(pct, 100) + '%';
          fill.style.backgroundColor = target && used > target ? '#d64545' : 'var(--dp-accent)';
        }
        if (text) {
          if (target > 0) {
            const remaining = target - used;
            text.textContent = remaining >= 0
              ? `${used} / ${target} kcal (${remaining} restantes)`
              : `${used} / ${target} kcal (dépassement de ${Math.abs(remaining)} kcal)`;
          } else {
            text.textContent = `${used} kcal`;
          }
        }
        if (submitBtn) {
          submitBtn.disabled = !!(target && used > target);
        }
      };

      updateGauge(0);

      if (caloriesInput) {
        caloriesInput.addEventListener('input', (e) => {
          const v = parseInt(e.target.value || '0', 10);
          updateGauge(Number.isNaN(v) ? 0 : v);
        });
      }
    }

    // Liaison avec la sélection de repas existant
    // Ouverture / fermeture du dialogue "Ajouter un régime"
    const createDialog = document.getElementById('dp-create-regime-modal');
    const createOpen = document.getElementById('dp-open-create-regime-dialog');
    const createClose = document.getElementById('dp-create-regime-close');
    const createCancel = document.getElementById('dp-create-regime-cancel');
    if (createDialog && createOpen) {
      const closeDialog = () => createDialog.classList.remove('show');
      createOpen.addEventListener('click', () => createDialog.classList.add('show'));
      if (createClose) createClose.addEventListener('click', closeDialog);
      if (createCancel) createCancel.addEventListener('click', closeDialog);
      createDialog.addEventListener('click', (e) => {
        if (e.target === createDialog) closeDialog();
      });
    }

    // Dialogue "Liste de courses intelligente"
    const shoppingDialog = document.getElementById('dp-shopping-modal');
    const shoppingOpen = document.getElementById('dp-open-shopping-dialog');
    const shoppingClose = document.getElementById('dp-shopping-close');
    const shoppingBody = document.getElementById('dp-shopping-body');
    if (shoppingDialog && shoppingOpen && shoppingBody) {
      const closeShopping = () => shoppingDialog.classList.remove('show');
      const renderShopping = (data) => {
        if (!data || !Array.isArray(data.items) || data.items.length === 0) {
          shoppingBody.innerHTML = '<p class="muted">Aucun ingrédient détecté à partir de vos repas. Ajoutez des détails dans les commentaires de vos repas (liste d\'aliments) pour générer une liste de courses.</p>';
          return;
        }
        let html = '';
        html += '<div class="muted" style="font-size:0.85rem;margin-bottom:0.5rem;">Basée sur vos repas du jour.</div>';
        html += '<ul class="list-unstyled" style="max-height:260px;overflow-y:auto;margin-bottom:0.75rem;">';
        data.items.forEach((item) => {
          const count = item.count || 1;
          const safeName = (item.name || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          html += '<li style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem;">';
          html += '<input type="checkbox" checked style="margin:0;">';
          html += '<span style="flex:1;">' + safeName + (count > 1 ? ' <span class="label-mini">(x' + count + ')</span>' : '') + '</span>';
          html += '</li>';
        });
        html += '</ul>';
        if (data.totals) {
          html += '<div class="summary-grid">';
          html += '<div class="summary-item"><i class="fa fa-fire"></i>' + (data.totals.calories ?? 0) + ' kcal</div>';
          html += '<div class="summary-item"><i class="fa fa-bolt"></i>P ' + (data.totals.proteines ?? 0) + ' g</div>';
          html += '<div class="summary-item"><i class="fa fa-leaf"></i>C ' + (data.totals.glucides ?? 0) + ' g</div>';
          html += '<div class="summary-item"><i class="fa fa-tint"></i>F ' + (data.totals.lipides ?? 0) + ' g</div>';
          html += '</div>';
        }
        shoppingBody.innerHTML = html;
      };

      shoppingOpen.addEventListener('click', () => {
        shoppingDialog.classList.add('show');
        shoppingBody.innerHTML = '<p class="muted">Génération de votre liste de courses…</p>';
        const url = shoppingOpen.dataset.url || '';
        if (!url) {
          shoppingBody.innerHTML = '<p class="text-danger">URL de l\'API manquante.</p>';
          return;
        }
        fetch(url, {
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then((res) => {
            if (!res.ok) {
              throw new Error('HTTP ' + res.status);
            }
            return res.json();
          })
          .then((data) => renderShopping(data))
          .catch(() => {
            shoppingBody.innerHTML = '<p class="text-danger">Impossible de générer la liste de courses pour le moment.</p>';
          });
      });
      if (shoppingClose) shoppingClose.addEventListener('click', closeShopping);
      shoppingDialog.addEventListener('click', (e) => {
        if (e.target === shoppingDialog) closeShopping();
      });
    }

    // Dialogue "Checklist du jour"
    const checklistDialog = document.getElementById('dp-checklist-modal');
    const checklistOpen = document.getElementById('dp-open-checklist-dialog');
    const checklistClose = document.getElementById('dp-checklist-close');
    if (checklistDialog && checklistOpen) {
      const closeChecklist = () => checklistDialog.classList.remove('show');
      checklistOpen.addEventListener('click', () => {
        checklistDialog.classList.add('show');
      });
      if (checklistClose) checklistClose.addEventListener('click', closeChecklist);
      checklistDialog.addEventListener('click', (e) => {
        if (e.target === checklistDialog) closeChecklist();
      });
    }

    // Dialogue "Daily plan de repas"
    const dailyDialog = document.getElementById('dp-daily-plan-modal');
    const dailyOpen = document.getElementById('dp-open-daily-plan-dialog');
    const dailyClose = document.getElementById('dp-daily-plan-close');
    if (dailyDialog && dailyOpen) {
      const closeDaily = () => dailyDialog.classList.remove('show');
      dailyOpen.addEventListener('click', () => {
        dailyDialog.classList.add('show');
      });
      if (dailyClose) dailyClose.addEventListener('click', closeDaily);
      dailyDialog.addEventListener('click', (e) => {
        if (e.target === dailyDialog) closeDaily();
      });
    }

    // Dialogues de modification de régime
    document.querySelectorAll('[data-regime-edit-open]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-regime-edit-open');
        const modal = document.getElementById('dp-edit-regime-modal-' + id);
        if (!modal) return;
        modal.classList.add('show');
      });
    });

    document.querySelectorAll('[data-regime-edit-close]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-regime-edit-close');
        const modal = document.getElementById('dp-edit-regime-modal-' + id);
        if (!modal) return;
        modal.classList.remove('show');
      });
    });

    document.querySelectorAll('[id^="dp-edit-regime-modal-"]').forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.remove('show');
        }
      });
    });

    // Tri / filtre / recherche dynamiques pour les régimes
    const regimeList = document.getElementById('regime-list');
    const sortSelect = document.getElementById('regime-sort');
    const filterSelect = document.getElementById('regime-filter');
    const searchInput = document.getElementById('regime-search');

    if (regimeList && sortSelect && filterSelect && searchInput) {
      let sortOrder = sortSelect.value;
      let filterType = '';
      let searchText = '';
      const regimeEmptyState = document.getElementById('regime-empty-state');

      const getItems = () => Array.from(regimeList.querySelectorAll('.regime-item'));
      const normalize = (value) => String(value || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();

      function applyRegimeFilters() {
        let items = getItems();
        items.forEach(item => {
          const type = normalize(item.dataset.type || '');
          const searchData = normalize(item.dataset.search || '');
          const cal = parseInt(item.dataset.calories || '0', 10) || 0;

          let visible = true;
          if (filterType) {
            visible = visible && type === filterType;
          }
          if (searchText) {
            visible = visible && searchData.includes(searchText);
          }

          item.style.display = visible ? '' : 'none';
        });

        // Tri après filtrage (on ne réordonne que les visibles)
        let visibleItems = getItems().filter(i => i.style.display !== 'none');
        visibleItems.sort((a, b) => {
          const ca = parseInt(a.dataset.calories || '0', 10) || 0;
          const cb = parseInt(b.dataset.calories || '0', 10) || 0;
          return sortOrder === 'calories-asc' ? ca - cb : cb - ca;
        });
        visibleItems.forEach(item => regimeList.appendChild(item));

        if (regimeEmptyState) {
          regimeEmptyState.style.display = visibleItems.length === 0 ? 'block' : 'none';
        }
      }

      sortSelect.addEventListener('change', (e) => {
        sortOrder = e.target.value;
        applyRegimeFilters();
      });
      filterSelect.addEventListener('change', (e) => {
        filterType = normalize(e.target.value || '');
        applyRegimeFilters();
      });
      searchInput.addEventListener('input', (e) => {
        searchText = normalize(e.target.value || '');
        applyRegimeFilters();
      });

      applyRegimeFilters();
    }

    // Chat IA régime : ouverture / fermeture
    const chatOpenBtn = document.getElementById('ai-chat-open');
    const chatModal = document.getElementById('ai-chat-modal');
    const chatCloseBtn = document.getElementById('ai-chat-close');
    const chatBody = document.getElementById('ai-chat-body');
    const chatInput = document.getElementById('ai-chat-input');
    const chatSend = document.getElementById('ai-chat-send');
    const chatChips = document.querySelectorAll('.ai-chat-chip');

    function openChat() {
      if (!chatModal) return;
      chatModal.classList.add('show');
      if (chatInput) {
        setTimeout(() => chatInput.focus(), 150);
      }
    }

    function closeChat() {
      if (!chatModal) return;
      chatModal.classList.remove('show');
    }

    if (chatOpenBtn && chatModal) {
      chatOpenBtn.addEventListener('click', openChat);
      if (chatCloseBtn) chatCloseBtn.addEventListener('click', closeChat);
      chatModal.addEventListener('click', (e) => {
        if (e.target === chatModal) closeChat();
      });
    }

    function escapeHtml(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function appendMessage(text, isUser = false, asHtml = false) {
      if (!chatBody) return null;
      const div = document.createElement('div');
      div.className = 'ai-chat-msg ' + (isUser ? 'ai-chat-msg-user' : 'ai-chat-msg-bot');
      if (asHtml) {
        div.innerHTML = text;
      } else {
        div.textContent = text;
      }
      chatBody.appendChild(div);
      chatBody.scrollTop = chatBody.scrollHeight;
      return div;
    }

    function setChatBusy(busy) {
      if (chatSend) chatSend.disabled = busy;
      if (chatInput) chatInput.disabled = busy;
      chatChips.forEach(chip => {
        chip.style.pointerEvents = busy ? 'none' : 'auto';
        chip.style.opacity = busy ? '0.6' : '1';
      });
    }

    async function requestBotReply(message) {
      const apiUrl = chatModal ? (chatModal.dataset.url || '') : '';
      const csrf = chatModal ? (chatModal.dataset.token || '') : '';
      if (!apiUrl || !csrf) {
        throw new Error('Configuration API manquante.');
      }

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 25000);

      const resp = await fetch(apiUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        signal: controller.signal,
        body: JSON.stringify({
          message: message,
          _token: csrf
        })
      });
      clearTimeout(timeoutId);

      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || data.error) {
        throw new Error(data.error || ('HTTP ' + resp.status));
      }

      const reply = (data.reply || '').trim();
      if (!reply) {
        throw new Error('R�ponse vide.');
      }

      return reply;
    }

    async function handleUserMessage(text) {
      const msg = (text || '').trim();
      if (!msg) return;

      appendMessage(msg, true);
      const typing = appendMessage('...');
      setChatBusy(true);

      try {
        const reply = await requestBotReply(msg);
        if (typing && typing.parentNode) {
          typing.parentNode.removeChild(typing);
        }
        appendMessage(escapeHtml(reply).replace(/\n/g, '<br>'), false, true);
      } catch (err) {
        if (typing && typing.parentNode) {
          typing.parentNode.removeChild(typing);
        }
        appendMessage('Erreur API: ' + (err.message || 'inconnue'));
      } finally {
        setChatBusy(false);
        if (chatInput) chatInput.focus();
      }
    }

    if (chatSend && chatInput) {
      chatSend.addEventListener('click', async () => {
        await handleUserMessage(chatInput.value);
        chatInput.value = '';
      });
      chatInput.addEventListener('keydown', async (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          await handleUserMessage(chatInput.value);
          chatInput.value = '';
        }
      });
    }

    chatChips.forEach(chip => {
      chip.addEventListener('click', async () => {
        const msg = chip.getAttribute('data-msg') || chip.textContent;
        await handleUserMessage(msg);
      });
    });
  });
</script>
{% endblock %}

