{% extends 'base.html.twig' %}

{% block title %}Diet & Eating Planner | Fitopia{% endblock %}

{% block stylesheets %}
<style>
  :root {
    --dp-bg: #f3f6fb;
    --dp-card: #ffffff;
    --dp-border: #e2e8f0;
    --dp-text: #1f2937;
    --dp-muted: #6b7280;
    --dp-accent: #0c3f44;
    --dp-accent-2: #0b5d66;
    --dp-soft: #eef6f5;
    --dp-danger: #d64545;
    --dp-danger-soft: #fff1f1;
  }
  .diet-page { background: var(--dp-bg); padding: 2.5rem 0 3.5rem; }
  .diet-wrap { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
  .diet-hero { font-weight: 800; font-size: 2.4rem; color: var(--dp-text); }
  .diet-sub { color: var(--dp-muted); margin-top: 0.35rem; }
  .diet-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 1.6rem; margin-top: 1.6rem; }
  .diet-col { display: grid; gap: 1.3rem; }
  .diet-card {
    background: var(--dp-card);
    border-radius: 14px;
    border: 1px solid var(--dp-border);
    box-shadow: 0 10px 20px rgba(15, 23, 42, 0.06);
    overflow: hidden;
  }
  .diet-card .icon-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
  }
  .icon-pill {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: #e8f3f0;
    color: var(--dp-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }
  .regime-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 1.2rem;
    align-items: start;
  }
  .regime-stats {
    display: grid;
    gap: 0.45rem;
  }
  .regime-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--dp-text);
  }
  .regime-row i {
    color: var(--dp-accent);
    width: 18px;
  }
  .mini-image {
    border: 1px dashed #d1dae6;
    border-radius: 14px;
    background: #f8fafc;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    font-weight: 600;
    text-align: center;
    padding: 0.75rem;
  }
  .card-header {
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--dp-border);
    font-weight: 700;
    color: var(--dp-text);
  }
  .card-body { padding: 1rem 1.1rem 1.2rem; }
  .sub-title { font-weight: 700; margin-bottom: 0.35rem; color: var(--dp-text); }
  .muted { color: var(--dp-muted); }
  .pill {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--dp-soft);
    color: var(--dp-accent);
    font-weight: 700;
    font-size: 0.78rem;
    margin-right: 0.4rem;
  }
  .btn-fit {
    background: var(--dp-accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-weight: 700;
  }
  .btn-soft {
    background: #f0f4f8;
    color: var(--dp-accent);
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-weight: 700;
  }
  .btn-danger {
    background: var(--dp-danger-soft);
    color: var(--dp-danger);
    border: 1px solid #f5c2c2;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-weight: 700;
  }
  .form-control {
    border-radius: 8px;
    border: 1px solid #d9e2ef;
  }
  .input-group-mini {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
  }
  .form-label-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    color: var(--dp-text);
  }
  .form-label-icon i {
    color: var(--dp-accent);
  }
  .meal-form .form-control {
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06);
  }
  .label-mini { font-size: 0.75rem; color: var(--dp-muted); }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.9rem;
  }
  .summary-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--dp-muted);
  }
  .summary-item i {
    color: var(--dp-accent);
  }
  .summary-item { font-size: 0.85rem; color: var(--dp-muted); }
  .progress-bar { height: 8px; background: #e5e7eb; border-radius: 999px; overflow: hidden; }
  .progress-bar span { display: block; height: 100%; background: var(--dp-accent); }
  .table-sm th, .table-sm td { padding: 0.45rem; }
  .actions-btns .btn {
    border-radius: 10px;
    padding: 0.35rem 0.6rem;
  }
  .ai-card {
    border: 1px dashed #d1dae6;
    border-radius: 12px;
    background: #f7fafc;
    padding: 1rem;
    text-align: center;
  }
  .food-modal {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1300;
    overflow-y: auto;
    padding: 1rem;
  }
  .food-modal.show {
    display: flex;
    animation: fadeIn 0.25s ease;
  }
  .food-modal-card {
    background: #fff;
    border-radius: 18px;
    padding: 1.6rem;
    width: min(520px, 92vw);
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.25);
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }
  .food-modal-card h4 {
    font-weight: 800;
    margin-bottom: 0.4rem;
    color: var(--dp-accent);
  }
  .food-modal-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    margin-top: 1rem;
  }
  .food-modal-actions .btn {
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    font-weight: 700;
  }
  .chat-launch-btn {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 1200;
    background: #0b3a3d;
    color: #fff;
    border-radius: 999px;
    padding: 0.65rem 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.35);
    border: none;
    font-weight: 700;
  }
  .chat-launch-btn i { font-size: 1rem; }
  .food-scan-launch-btn {
    position: fixed;
    right: 24px;
    bottom: 78px;
    z-index: 1200;
    background: #0c3f44;
    color: #fff;
    border-radius: 999px;
    padding: 0.6rem 1.05rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.28);
    border: none;
    font-weight: 700;
  }
  .food-scan-launch-btn i { font-size: 1rem; }
  .ai-chat-modal {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1200;
  }
  .ai-chat-modal.show { display: flex; }
  .ai-chat-card {
    background: #fff;
    border-radius: 18px;
    padding: 1.25rem 1.4rem;
    width: min(520px, 100vw - 2rem);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.25);
  }
  .ai-chat-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:0.75rem;
  }
  .ai-chat-header-title {
    display:flex;
    align-items:center;
    gap:0.5rem;
    font-weight:800;
    color:#0b3a3d;
  }
  .ai-chat-avatar {
    width:32px;
    height:32px;
    border-radius:999px;
    background:#e0f2fe;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    color:#0369a1;
  }
  .ai-chat-body {
    flex:1;
    border-radius: 12px;
    border:1px solid #e2e8f0;
    padding:0.75rem;
    overflow-y:auto;
    background:#f8fafc;
    margin-bottom:0.75rem;
  }
  .ai-chat-msg {
    max-width:85%;
    padding:0.45rem 0.7rem;
    border-radius:12px;
    margin-bottom:0.4rem;
    font-size:0.9rem;
    line-height:1.3;
  }
  .ai-chat-msg-bot {
    background:#e0f2fe;
    color:#0b3a3d;
    align-self:flex-start;
  }
  .ai-chat-msg-user {
    background:#0b3a3d;
    color:#fff;
    align-self:flex-end;
  }
  .ai-chat-suggestions {
    display:flex;
    flex-wrap:wrap;
    gap:0.35rem;
    margin-bottom:0.6rem;
  }
  .ai-chat-chip {
    border-radius:999px;
    border:1px solid #e2e8f0;
    padding:0.25rem 0.6rem;
    font-size:0.8rem;
    background:#fff;
    cursor:pointer;
  }
  .ai-chat-input-row {
    display:flex;
    gap:0.4rem;
    align-items:center;
  }
  .ai-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #eef2ff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #4338ca;
    margin-bottom: 0.5rem;
  }
  .btn-full { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; }
  .diet-intro {
    background: linear-gradient(135deg, #f4fbf9 0%, #eef4ff 100%);
    border: 1px solid #dbe7f4;
    border-radius: 14px;
    padding: 0.9rem 1rem;
    margin-top: 0.9rem;
    display: grid;
    gap: 0.55rem;
  }
  .diet-intro-title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 800;
    color: var(--dp-accent);
  }
  .diet-intro-text {
    margin: 0;
    color: #334155;
    font-size: 0.9rem;
  }
  .quick-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .step-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #d7e2ef;
    color: #0f172a;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .section-help {
    margin-bottom: 0.7rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    border: 1px dashed #d5e2ee;
    background: #f8fbff;
    color: #475569;
    font-size: 0.86rem;
    line-height: 1.35;
  }
  .help-text {
    color: #64748b;
    margin-bottom: 0.7rem;
    font-size: 0.88rem;
  }
  .table-guidance {
    margin-bottom: 0.65rem;
    color: #64748b;
    font-size: 0.83rem;
  }
  .table-sm thead th {
    background: #f8fafc;
    color: #334155;
    border-top: 0;
    border-bottom: 1px solid #e2e8f0;
    font-weight: 700;
  }
  .table-sm tbody tr:hover {
    background: #fbfdff;
  }
  .modal-help {
    margin: 0.2rem 0 0.75rem;
    padding: 0.55rem 0.7rem;
    border-left: 4px solid var(--dp-accent);
    background: #f8fbfd;
    border-radius: 8px;
    color: #475569;
    font-size: 0.86rem;
  }
  .regime-error-summary {
    display: none;
    margin-bottom: 0.75rem;
    border: 1px solid #fecaca;
    background: #fff1f2;
    color: #991b1b;
    border-radius: 10px;
    padding: 0.55rem 0.7rem;
    font-size: 0.86rem;
  }
  .regime-field-error {
    color: #b91c1c;
    font-size: 0.78rem;
    margin-top: 0.3rem;
  }
  .regime-field-valid {
    color: #15803d;
    font-size: 0.78rem;
    margin-top: 0.3rem;
  }
  .form-control.is-invalid {
    border-color: #ef4444;
    box-shadow: 0 0 0 0.08rem rgba(239, 68, 68, 0.12);
  }
  .form-control.is-valid {
    border-color: #22c55e;
    box-shadow: 0 0 0 0.08rem rgba(34, 197, 94, 0.12);
  }
  @media (max-width: 991px) {
    .diet-grid { grid-template-columns: 1fr; }
    .quick-steps { flex-direction: column; }
    .food-scan-launch-btn { bottom: 76px; right: 14px; padding: 0.55rem 0.9rem; }
    .chat-launch-btn { right: 14px; bottom: 16px; }
  }
</style>
{% endblock %}

{% block body %}
<section class="diet-page">
  <div class="diet-wrap">
    <h1 class="diet-hero">Diet &amp; Eating Planner</h1>
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div
          class="alert {% if label == 'success' %}alert-success{% elseif label == 'error' %}alert-danger{% elseif label == 'warning' %}alert-warning{% else %}alert-info{% endif %}"
          style="margin-top:0.85rem;border-radius:10px;"
        >
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}
    {% if app.user %}
      <p class="diet-sub">Welcome {{ app.user.firstName }} {{ app.user.lastName }}. This page is personalized for you.</p>
    {% endif %}
    <div class="diet-intro">
      <div class="diet-intro-title"><i class="fa fa-map-signs"></i> Comment utiliser cette page</div>
      <p class="diet-intro-text">Cette interface vous guide pas a pas pour definir votre regime, suivre vos repas du jour et verifier votre progression nutritionnelle.</p>
      <div class="quick-steps">
        <span class="step-chip"><i class="fa fa-plus-circle"></i> 1. Ajoutez ou selectionnez un regime</span>
        <span class="step-chip"><i class="fa fa-cutlery"></i> 2. Ajoutez vos repas du jour</span>
        <span class="step-chip"><i class="fa fa-line-chart"></i> 3. Suivez vos calories et macros</span>
        <span class="step-chip"><i class="fa fa-check-square-o"></i> 4. Utilisez checklist et liste de courses</span>
      </div>
    </div>

    <div class="diet-grid">
      <div class="diet-col">
        <div class="diet-card">
          <div class="card-header">
            <span class="icon-title"><span class="icon-pill"><i class="fa fa-heartbeat"></i></span> My Diet &amp; Daily Tracking</span>
          </div>
          <div class="card-body">
            <div class="sub-title">My Regime <span class="muted" style="font-weight:500;">(Gérez vos régimes alimentaires)</span></div>
            <p class="help-text">Consultez ici votre profil nutritionnel actif. Le système calcule automatiquement IMC, type de santé et calories cibles selon vos données.</p>
            <div class="regime-grid">
              <div class="regime-stats">
                {% if regime %}
                  <div class="regime-row"><i class="fa fa-arrows-v"></i><strong>Taille:</strong> {{ regime.taille ? regime.taille ~ ' cm' : '—' }}</div>
                  <div class="regime-row"><i class="fa fa-balance-scale"></i><strong>Poids:</strong> {{ regime.poids ? regime.poids ~ ' kg' : '—' }}</div>
                  <div class="regime-row"><i class="fa fa-birthday-cake"></i><strong>Âge:</strong> {{ regime.age ?? '—' }}</div>
                  <div class="regime-row"><i class="fa fa-heartbeat"></i><strong>IMC:</strong> {{ regime.bmi ?? '—' }}</div>
                  <div class="regime-row"><i class="fa fa-leaf"></i><strong>Type santé:</strong> {{ regime.typeSante ?? '—' }}</div>
                  <div class="regime-row"><i class="fa fa-fire"></i><strong>Calories cibles:</strong> {{ regime.caloriesCibles ?? '—' }} kcal/j</div>
                  <div class="regime-row">
                    <i class="fa fa-cutlery"></i>
                    <strong>Repas adéquats:</strong>
                    {% if regime.repasAdequats %}
                      <span class="muted">{{ regime.repasAdequats }}</span>
                    {% else %}
                      <span class="muted">—</span>
                    {% endif %}
                  </div>
                  {% if regime and regime.caloriesCibles %}
                    {% set used = totals.calories %}
                    {% set target = regime.caloriesCibles %}
                    {% set pct = target > 0 ? (used / target * 100) : 0 %}
                    <div style="margin-top:0.75rem;">
                      <div class="form-label-icon"><i class="fa fa-fire"></i> Suivi des calories du jour</div>
                      <div class="progress-bar" id="regime-calorie-gauge" data-current="{{ used }}" data-target="{{ target }}">
                        <span id="regime-calorie-fill" style="width:{{ pct }}%"></span>
                      </div>
                      <small class="text-muted" id="regime-calorie-text">{{ used }} / {{ target }} kcal</small>
                      <button type="button" class="btn-soft btn-sm mt-1" id="regime-add-meal-btn">+ Ajouter un repas</button>
                    </div>
                  {% endif %}
                {% else %}
                  <div class="muted">Aucun régime actif. Créez-en un ci-dessous.</div>
                {% endif %}
              </div>
              <div class="mini-image" style="padding:0; overflow:hidden;">
                <img src="{{ asset('images/nutrition_plan.jpeg') }}" alt="Nutrition plan" style="width:100%;height:100%;object-fit:cover;border-radius:14px;">
              </div>
            </div>

            {# Formulaire de création de régime déplacé dans le dialogue modal en bas de page #}
            {% if regimes is not empty %}
            {% endif %}
          </div>
        </div>

        <div class="diet-card">
          <div class="card-header">
            <span class="icon-title"><span class="icon-pill"><i class="fa fa-line-chart"></i></span> Today's Summary</span>
          </div>
          <div class="card-body">
            <div class="section-help">
              Cette section montre votre progression du jour. Les pourcentages indiquent votre avancement par rapport à vos objectifs.
            </div>
            <div class="summary-grid">
              <div class="summary-item"><i class="fa fa-fire"></i> Calories</div>
              <div class="summary-item"><i class="fa fa-bolt"></i> Proteins</div>
              <div class="summary-item"><i class="fa fa-leaf"></i> Carbs</div>
              <div class="summary-item"><i class="fa fa-tint"></i> Fats</div>
            </div>
            <div class="summary-grid mt-2">
              {% set calPct = regime and regime.caloriesCibles ? (totals.calories / regime.caloriesCibles * 100) : 0 %}
              {% set proPct = regime and regime.caloriesCibles ? (totals.proteines / 50 * 100) : 0 %}
              {% set carbPct = regime and regime.caloriesCibles ? (totals.glucides / 200 * 100) : 0 %}
              {% set fatPct = regime and regime.caloriesCibles ? (totals.lipides / 65 * 100) : 0 %}
              <div>
                <div class="progress-bar"><span style="width:{{ calPct }}%"></span></div>
                <small class="text-muted">{{ calPct|round(0, 'floor') }}%</small>
              </div>
              <div>
                <div class="progress-bar"><span style="width:{{ proPct }}%"></span></div>
                <small class="text-muted">{{ proPct|round(0, 'floor') }}%</small>
              </div>
              <div>
                <div class="progress-bar"><span style="width:{{ carbPct }}%"></span></div>
                <small class="text-muted">{{ carbPct|round(0, 'floor') }}%</small>
              </div>
              <div>
                <div class="progress-bar"><span style="width:{{ fatPct }}%"></span></div>
                <small class="text-muted">{{ fatPct|round(0, 'floor') }}%</small>
              </div>
            </div>
          </div>
        </div>

        <div class="diet-card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span class="icon-title"><span class="icon-pill"><i class="fa fa-list-alt"></i></span> Today's Meals List</span>
            <div style="display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap;">
              <button
                type="button"
                class="btn-soft btn-sm"
                id="dp-open-checklist-dialog"
              >
                Checklist du jour
              </button>
              <button
                type="button"
                class="btn-soft btn-sm"
                id="dp-open-shopping-dialog"
                data-url="{{ path('diet_shopping_list') }}"
              >
                Liste de courses intelligente
              </button>
              <button
                type="button"
                class="btn-soft btn-sm"
                id="dp-open-scan-dialog"
                data-url="{{ path('diet_food_recognition') }}"
                data-token="{{ csrf_token('food_recognition') }}"
              >
                Scanner photo IA
              </button>
            </div>
          </div>
          <div class="card-body">
            <div class="section-help">
              Ajoutez vos repas depuis "Ajouter un repas", puis utilisez les actions pour modifier ou supprimer une ligne. Le total nutritionnel est mis à jour automatiquement.
            </div>
            {% if repas is not empty %}
              <div class="table-guidance">Lecture rapide: <strong>P</strong> = protéines, <strong>C</strong> = glucides, <strong>F</strong> = lipides.</div>
              <div class="table-responsive">
                <table class="table table-sm">
                  <thead>
                    <tr>
                      <th>Type</th>
                      <th>Meal</th>
                      <th>Calories</th>
                      <th>Macros</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for r in repas %}
                      <tr>
                        <td>{{ r.typeRepas }}</td>
                        <td>{{ r.nomRepas }}</td>
                        <td>{{ r.calories ?: '—' }}</td>
                        <td>P {{ r.proteines ?: 0 }} / C {{ r.glucides ?: 0 }} / F {{ r.lipides ?: 0 }}</td>
                        <td class="actions-btns">
                          <button class="btn btn-outline-primary btn-sm" type="button" onclick="document.getElementById('meal-edit-{{ r.id }}').style.display='table-row';">
                            <i class="fa fa-pencil"></i>
                          </button>
                          <form method="post" action="{{ path('diet_meal_delete', {'id': r.id}) }}" style="display:inline;" onsubmit="return confirm('Delete this meal?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('meal_delete_' ~ r.id) }}">
                            <button class="btn btn-outline-danger btn-sm" type="submit">
                              <i class="fa fa-trash"></i>
                            </button>
                          </form>
                        </td>
                      </tr>
                      <tr id="meal-edit-{{ r.id }}" style="display:none;">
                        <td colspan="5">
                          <form method="post" action="{{ path('diet_meal_update', {'id': r.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('meal_update_' ~ r.id) }}">
                            <div class="form-row">
                              <div class="form-group col-md-3">
                                <input class="form-control" name="type_repas" value="{{ r.typeRepas }}">
                              </div>
                              <div class="form-group col-md-3">
                                <input class="form-control" name="nom_repas" value="{{ r.nomRepas }}">
                              </div>
                              <div class="form-group col-md-2">
                                <input class="form-control" name="calories" value="{{ r.calories }}">
                              </div>
                              <div class="form-group col-md-2">
                                <input class="form-control" name="proteines" value="{{ r.proteines }}">
                              </div>
                              <div class="form-group col-md-2">
                                <input class="form-control" name="glucides" value="{{ r.glucides }}">
                              </div>
                              <div class="form-group col-md-2">
                                <input class="form-control" name="lipides" value="{{ r.lipides }}">
                              </div>
                            </div>
                            <button class="btn-fit">Save</button>
                          </form>
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% else %}
              <p class="muted">No meals logged yet.</p>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="diet-col">
        {# Badges du jour pour le régime actif #}
        <div class="diet-card" style="margin-bottom:1rem;">
          <div class="card-header">
            <span class="icon-title">
              <span class="icon-pill"><i class="fa fa-trophy"></i></span> Badges du jour
            </span>
          </div>
          <div class="card-body">
            {% if regime and todayBadges %}
              <div class="summary-grid" style="margin-bottom:0.5rem;">
                <div class="summary-item"><i class="fa fa-fire"></i>{{ todayBadges.totals.calories }} kcal</div>
                <div class="summary-item"><i class="fa fa-bolt"></i>P {{ todayBadges.totals.proteines }} g</div>
                <div class="summary-item"><i class="fa fa-leaf"></i>C {{ todayBadges.totals.glucides }} g</div>
                <div class="summary-item"><i class="fa fa-tint"></i>F {{ todayBadges.totals.lipides }} g</div>
              </div>
              <div class="row" style="row-gap:0.5rem;">
                {% set badges = {
                  'perfect_week': {
                    'label': 'Semaine parfaite',
                    'description': 'Calories dans la cible aujourd\'hui.',
                    'unlocked': todayBadges.calories_ok
                  },
                  'hydration_7_days': {
                    'label': 'Hydratation OK',
                    'description': 'Au moins 3 repas / collations enregistrés aujourd\'hui.',
                    'unlocked': todayBadges.hydration_ok
                  },
                  'calories_10_days': {
                    'label': 'Calories respectées',
                    'description': 'Journée avec calories proches de l\'objectif.',
                    'unlocked': todayBadges.calories_ok
                  }
                } %}
                {% for key, badge in badges %}
                  <div class="col-12">
                    <div class="diet-card" style="border-radius:10px;padding:0.4rem 0.7rem;border-style:dashed;{% if badge.unlocked %}background:#ecfdf5;border-color:#22c55e;{% else %}background:#f9fafb;border-color:#e5e7eb;opacity:0.85;{% endif %}">
                      <div style="display:flex;align-items:center;gap:0.5rem;">
                        {% if badge.unlocked %}
                          <i class="fa fa-check-circle" style="color:#16a34a;"></i>
                        {% else %}
                          <i class="fa fa-lock" style="color:#9ca3af;"></i>
                        {% endif %}
                        <div>
                          <div class="label-mini" style="font-weight:700;color:#111827;">{{ badge.label }}</div>
                          <div class="label-mini">{{ badge.description }}</div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <p class="muted">Sélectionnez ou créez un régime et ajoutez des repas pour débloquer vos badges du jour.</p>
            {% endif %}
          </div>
        </div>

        {# Liste de tous les régimes sous forme de cards #}
        <div class="diet-card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span class="icon-title">
              <span class="icon-pill"><i class="fa fa-list-alt"></i></span> Mes régimes
            </span>
            <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
              <div class="explore-toolbar" style="margin:0;gap:0.4rem;">
                <select id="regime-sort" title="Tri par calories" style="min-width:140px;">
                  <option value="calories-desc">Calories ↓</option>
                  <option value="calories-asc">Calories ↑</option>
                </select>
                <select id="regime-filter" title="Filtrer par type" style="min-width:140px;">
                  <option value="">Tous les types</option>
                  <option value="sous_poids">Sous-poids</option>
                  <option value="normal">Normal</option>
                  <option value="surpoids">Surpoids</option>
                  <option value="obesite">Obésité</option>
                </select>
                <input type="text" id="regime-search" placeholder="Rechercher régime, type, calories..." style="min-width:220px;">
              </div>
              <button type="button" class="btn-soft btn-sm" id="dp-open-daily-plan-dialog">
                Daily plan de repas
              </button>
              <button type="button" class="btn-soft btn-sm" id="dp-open-create-regime-dialog">
                + Ajouter un régime
              </button>
            </div>
          </div>
          <div class="card-body">
            <div class="section-help">
              Gérez tous vos régimes ici: tri, filtre, recherche, édition et suppression. Utilisez "Voir" pour activer un régime.
            </div>
            {% if regimes is not empty %}
              <div class="row" id="regime-list" style="row-gap: 0.75rem;">
                {% for r in regimes %}
                  <div class="col-12 regime-item" data-calories="{{ r.caloriesCibles ?? 0 }}" data-type="{{ r.typeSante ?? '' }}" data-search="{{ ('regime ' ~ r.id ~ ' ' ~ (r.typeSante ?? '') ~ ' ' ~ (r.caloriesCibles ?? 0) ~ ' kcal')|lower }}">
                    <div class="diet-card">
                      <div class="card-body" style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;">
                        <div>
                          <div class="icon-title" style="margin-bottom:0.15rem;">
                            <span class="icon-pill"><i class="fa fa-heartbeat"></i></span>
                            Régime #{{ r.id }}
                          </div>
                          <div class="muted" style="font-size:0.85rem;">
                            {{ r.typeSante ?? '—' }} · {{ r.caloriesCibles ?? '—' }} kcal/j
                          </div>
                        </div>
                        <div style="display:flex;gap:0.35rem;justify-content:flex-end;align-items:center;flex-wrap:nowrap;">
                          <a href="{{ path('diet_planner', {'regime_id': r.id}) }}" class="btn-soft btn-sm" style="text-decoration:none;white-space:nowrap;">Voir</a>
                          <button
                            type="button"
                            class="btn-soft btn-sm"
                            data-regime-edit-open="{{ r.id }}"
                            style="white-space:nowrap;"
                          >
                            Modifier
                          </button>
                          <form method="post" action="{{ path('diet_regime_delete', {'id': r.id}) }}" style="display:inline-block;margin:0;" onsubmit="return confirm('Supprimer ce régime ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('regime_delete_' ~ r.id) }}">
                            <button class="btn-danger btn-sm" type="submit" style="white-space:nowrap;">Supprimer</button>
                          </form>
                        </div>
                      </div>
                    </div>

                    {# Dialogue modal de modification pour ce régime #}
                    <div class="food-modal" id="dp-edit-regime-modal-{{ r.id }}">
                      <div class="food-modal-card">
                        <div style="display:flex;align-items:center;justify-content:space-between;">
                          <h4>Modifier le régime #{{ r.id }}</h4>
                          <button
                            type="button"
                            class="btn btn-link text-muted"
                            data-regime-edit-close="{{ r.id }}"
                            style="text-decoration:none;"
                          >
                            ✕
                          </button>
                        </div>
                        <p class="text-muted">Ajustez vos informations pour mettre à jour ce régime.</p>
                        <div class="mt-2">
                          {{ form_start(regimeEditForms[r.id], {'attr': {'class': 'js-regime-form', 'data-user-gender': app.user and app.user.gender ? app.user.gender : 'male', 'novalidate': 'novalidate'}}) }}
                            <div class="regime-error-summary" data-regime-error-summary></div>
                            <div class="form-row">
                              <div class="form-group col-md-4">
                                <label class="form-label-icon">Taille (cm)</label>
                                {{ form_widget(regimeEditForms[r.id].taille, {'attr': {'class': 'form-control js-regime-taille', 'placeholder': 'Taille', 'required': 'required', 'min': '100', 'max': '250', 'step': '0.1', 'inputmode': 'decimal'}}) }}
                              </div>
                              <div class="form-group col-md-4">
                                <label class="form-label-icon">Poids (kg)</label>
                                {{ form_widget(regimeEditForms[r.id].poids, {'attr': {'class': 'form-control js-regime-poids', 'placeholder': 'Poids', 'required': 'required', 'min': '25', 'max': '300', 'step': '0.1', 'inputmode': 'decimal'}}) }}
                              </div>
                              <div class="form-group col-md-4">
                                <label class="form-label-icon">Âge</label>
                                {{ form_widget(regimeEditForms[r.id].age, {'attr': {'class': 'form-control js-regime-age', 'placeholder': 'Âge', 'required': 'required', 'min': '10', 'max': '100', 'step': '1', 'inputmode': 'numeric'}}) }}
                              </div>
                            </div>
                            <div class="form-row">
                              <div class="form-group col-md-4">
                                <label class="form-label-icon">IMC (auto)</label>
                                {{ form_widget(regimeEditForms[r.id].bmi, {'attr': {'class': 'form-control js-regime-bmi', 'placeholder': 'IMC', 'readonly': 'readonly'}}) }}
                              </div>
                              <div class="form-group col-md-4">
                                <label class="form-label-icon">Type santé (auto)</label>
                                {{ form_widget(regimeEditForms[r.id].typeSante, {'attr': {'class': 'form-control js-regime-type-sante', 'placeholder': 'Type santé'}}) }}
                              </div>
                              <div class="form-group col-md-4">
                                <label class="form-label-icon">Calories cibles (auto)</label>
                                {{ form_widget(regimeEditForms[r.id].caloriesCibles, {'attr': {'class': 'form-control js-regime-calories', 'placeholder': 'Calories'}}) }}
                              </div>
                            </div>
                            <div class="form-group">
                              <label class="form-label-icon">Repas adéquats (auto)</label>
                              {{ form_widget(regimeEditForms[r.id].repasAdequats, {'attr': {'class': 'form-control js-regime-repas', 'placeholder': 'Repas adéquats'}}) }}
                            </div>
                            <div class="food-modal-actions">
                              <button type="button" class="btn btn-outline-secondary" data-regime-edit-close="{{ r.id }}">Annuler</button>
                              <button type="submit" class="btn btn-primary">Enregistrer</button>
                            </div>
                          {{ form_end(regimeEditForms[r.id]) }}
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
              <p class="muted" id="regime-empty-state" style="display:none;margin-top:0.4rem;">Aucun régime ne correspond à votre recherche.</p>
            {% else %}
              <p class="muted">Aucun régime enregistré pour le moment.</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
  </section>

  <button type="button" class="food-scan-launch-btn" id="dp-open-add-meal-bottom">
    <i class="fa fa-camera"></i>
    Scanner un repas
  </button>

  {# Bouton flottant pour ouvrir le chat IA #}
  <button type="button" class="chat-launch-btn" id="ai-chat-open">
    <i class="fa fa-comments"></i>
    Chat r&eacute;gime IA
  </button>

  {# Modal de chat IA conseiller nutrition #}
  <div class="ai-chat-modal" id="ai-chat-modal" data-url="{{ path('diet_ai_chat') }}" data-token="{{ csrf_token('diet_ai_chat') }}">
