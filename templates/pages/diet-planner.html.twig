        <button type="button" class="btn-fit btn-sm" id="ai-chat-send">Envoyer</button>
      </div>
    </div>
  </div>
</section>
{# Dialogue modal pour créer un régime #}
<div class="food-modal" id="dp-create-regime-modal">
  <div class="food-modal-card">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <h4>Ajouter un régime</h4>
      <button type="button" id="dp-create-regime-close" class="btn btn-link text-muted" style="text-decoration:none;">✕</button>
    </div>
    <p class="text-muted">Renseignez vos informations pour générer un nouveau régime personnalisé.</p>
    <div class="modal-help">
      Les champs IMC, type de santé, calories cibles et repas adéquats se mettent à jour automatiquement pendant la saisie.
    </div>
    <div class="mt-2">
      {{ form_start(regimeCreateForm, {'attr': {'class': 'js-regime-form', 'data-user-gender': app.user and app.user.gender ? app.user.gender : 'male', 'novalidate': 'novalidate'}}) }}
        <div class="regime-error-summary" data-regime-error-summary></div>
        <div class="form-row">
          <div class="form-group col-md-4">
            <label class="form-label-icon">Taille (cm)</label>
            {{ form_widget(regimeCreateForm.taille, {'attr': {'class': 'form-control js-regime-taille', 'required': 'required', 'min': '100', 'max': '250', 'step': '0.1', 'inputmode': 'decimal'}}) }}
          </div>
          <div class="form-group col-md-4">
            <label class="form-label-icon">Poids (kg)</label>
            {{ form_widget(regimeCreateForm.poids, {'attr': {'class': 'form-control js-regime-poids', 'required': 'required', 'min': '25', 'max': '300', 'step': '0.1', 'inputmode': 'decimal'}}) }}
          </div>
          <div class="form-group col-md-4">
            <label class="form-label-icon">Âge</label>
            {{ form_widget(regimeCreateForm.age, {'attr': {'class': 'form-control js-regime-age', 'required': 'required', 'min': '10', 'max': '100', 'step': '1', 'inputmode': 'numeric'}}) }}
          </div>
        </div>
        <div class="form-row">
          <div class="form-group col-md-4">
            <label class="form-label-icon">IMC (auto)</label>
            {{ form_widget(regimeCreateForm.bmi, {'attr': {'class': 'form-control js-regime-bmi', 'readonly': 'readonly'}}) }}
          </div>
          <div class="form-group col-md-4">
            <label class="form-label-icon">Type santé (auto)</label>
            {{ form_widget(regimeCreateForm.typeSante, {'attr': {'class': 'form-control js-regime-type-sante'}}) }}
          </div>
          <div class="form-group col-md-4">
            <label class="form-label-icon">Calories cibles (auto)</label>
            {{ form_widget(regimeCreateForm.caloriesCibles, {'attr': {'class': 'form-control js-regime-calories'}}) }}
          </div>
        </div>
        <div class="form-group">
