{% extends 'base.html.twig' %}

{% block title %}Contact Us | Fitopia{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  :root {
    --f-green: #15996a;
    --f-blue: #16384c;
    --f-dark: #13231d;
    --f-muted: #5f756d;
    --f-border: #e3eee7;
  }

  .contact-page {
    background-color: #ffffff;
    padding-bottom: 80px;
  }

  .hero-mini {
    height: 300px;
    background: linear-gradient(135deg, #f7fbf8, #e3eee7);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    border-bottom: 1px solid var(--f-border);
  }

  .hero-mini h1 {
    font-size: 48px;
    color: var(--f-dark);
    margin: 0;
  }

  .hero-mini p {
    color: var(--f-muted);
    font-size: 18px;
  }

  .contact-shell {
    max-width: 1100px;
    margin: -60px auto 0;
    display: flex;
    gap: 30px;
    position: relative;
    z-index: 10;
  }

  .contact-info-panel {
    flex: 1;
    background: white;
    padding: 40px;
    border-radius: 24px;
    border: 1px solid var(--f-border);
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  .contact-form-panel {
    flex: 2;
    background: white;
    padding: 40px;
    border-radius: 24px;
    border: 1px solid var(--f-border);
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 30px;
  }

  .info-icon {
    width: 44px;
    height: 44px;
    background: #f4faf6;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--f-green);
    font-size: 20px;
    flex-shrink: 0;
  }

  .info-content h3 {
    margin: 0 0 5px;
    font-size: 18px;
    color: var(--f-dark);
  }

  .info-content p {
    margin: 0;
    color: var(--f-muted);
    font-size: 15px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: var(--f-dark);
    margin-bottom: 8px;
  }

  .form-control-java {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #dcebe2;
    border-radius: 12px;
    font-size: 15px;
    background: #fdfdfd;
    transition: border-color 0.2s;
  }

  .form-control-java:focus {
    outline: none;
    border-color: var(--f-green);
    background: #ffffff;
  }

  .btn-submit {
    background: var(--f-blue);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 14px 28px;
    font-weight: 800;
    font-size: 15px;
    cursor: pointer;
    width: 100%;
    transition: background 0.2s;
  }

  .btn-submit:hover {
    background: #0d2a3a;
  }

  @media (max-width: 991px) {
    .contact-shell {
      flex-direction: column;
      margin-top: 20px;
      padding: 0 20px;
    }
  }
</style>
{% endblock %}

{% block body %}
<div class="contact-page">
  <div class="hero-mini">
    <h1>Contact Fitopia</h1>
    <p>We're here to help you on your wellness journey.</p>
  </div>

  <div class="contact-shell">
    <div class="contact-info-panel">
      <div class="info-item">
        <div class="info-icon">📍</div>
        <div class="info-content">
          <h3>Location</h3>
          <p>123 Wellness Street, Esprit City, Tunisia</p>
        </div>
      </div>
      <div class="info-item">
        <div class="info-icon">📞</div>
        <div class="info-content">
          <h3>Phone</h3>
          <p>+216 58 938 889</p>
        </div>
      </div>
      <div class="info-item">
        <div class="info-icon">📧</div>
        <div class="info-content">
          <h3>Email</h3>
          <p>customerservice@fitopia.com</p>
        </div>
      </div>
      <div class="info-item" style="margin-bottom: 0;">
        <div class="info-icon">🌐</div>
        <div class="info-content">
          <h3>Working Hours</h3>
          <p>Mon - Fri: 8:00 - 20:00<br>Sat - Sun: 9:00 - 18:00</p>
        </div>
      </div>
    </div>

    <div class="contact-form-panel">
      <h2 style="font-size: 28px; color: var(--f-dark); margin-top: 0;">Send us a message</h2>
      <p style="color: var(--f-muted); margin-bottom: 30px;">Have a question about our programs? Our team is ready to assist.</p>
      
      <form action="#" method="POST">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <div class="form-group">
            <label>First Name</label>
            <input type="text" class="form-control-java" placeholder="Enter your first name">
          </div>
          <div class="form-group">
            <label>Last Name</label>
            <input type="text" class="form-control-java" placeholder="Enter your last name">
          </div>
        </div>
        
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" class="form-control-java" placeholder="name@example.com">
        </div>
        
        <div class="form-group">
          <label>Subject</label>
          <select class="form-control-java">
            <option>General Inquiry</option>
            <option>Fitness Programs</option>
            <option>Nutrition Plans</option>
            <option>Events & Workshops</option>
            <option>Technical Support</option>
          </select>
        </div>
        
        <div class="form-group">
          <label>Message</label>
          <textarea class="form-control-java" rows="5" placeholder="How can we help you?"></textarea>
        </div>
        
        <button type="submit" class="btn-submit">Send Message</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}
