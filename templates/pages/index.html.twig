{% extends 'base.html.twig' %}

{% block title %}Home | Fitopia{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  :root {
    --f-green: #15996a;
    --f-blue: #16384c;
    --f-dark: #13231d;
    --f-muted: #5f756d;
    --f-border: #e3eee7;
  }

  .home-page {
    background-color: #ffffff;
  }

  /* Hero Section */
  .hero-slider-shell {
    position: relative;
    height: 600px;
    background: linear-gradient(to bottom right, #f8fcfa, #edf5f0);
    border-radius: 28px;
    border: 1px solid var(--f-border);
    margin: 20px 30px;
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.08);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(247,251,248,0.92), rgba(247,251,248,0.44), rgba(255,255,255,0.12));
  }

  .hero-copy-box {
    position: relative;
    z-index: 2;
    max-width: 540px;
    padding: 50px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }

  .hero-kicker {
    color: var(--f-green);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hero-title {
    color: var(--f-dark);
    font-size: 50px;
    font-weight: 400;
    line-height: 1.1;
  }

  .hero-subtitle {
    color: var(--f-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .hero-facts {
    display: flex;
    gap: 12px;
    margin-top: 10px;
  }

  .hero-fact-pill {
    background: #f4faf6;
    border-radius: 999px;
    border: 1px solid #dcebe2;
    color: #48655c;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 14px;
  }

  /* Featured Services */
  .featured-services-shell {
    padding: 60px 30px;
    background: linear-gradient(to bottom, #f7fcf9, #eef8f2);
    border-radius: 24px;
    border: 1px solid #e0ede5;
    margin: 0 30px;
    text-align: center;
  }

  .services-grid {
    display: flex;
    gap: 22px;
    margin-top: 30px;
    justify-content: center;
  }

  .service-card {
    flex: 1;
    max-width: 388px;
    background: #ffffff;
    border-radius: 26px;
    border: 1px solid #e5efe9;
    padding-bottom: 20px;
    text-align: left;
    overflow: hidden;
    box-shadow: 0 18px 36px rgba(15, 23, 42, 0.08);
  }

  .service-img {
    height: 250px;
    background-size: cover;
    background-position: center;
  }

  .service-tag {
    color: #109567;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    padding: 15px 20px 5px;
  }

  .service-title {
    color: #172554;
    font-size: 22px;
    font-weight: 800;
    padding: 0 20px;
  }

  .service-copy {
    color: #5b6777;
    font-size: 15px;
    line-height: 1.6;
    padding: 10px 20px;
  }

  /* Consult Grid */
  .consult-grid {
    padding: 60px 30px;
    display: flex;
    gap: 22px;
  }

  .consult-card {
    flex: 1;
    background: linear-gradient(to bottom, #ffffff, #f9fcfa);
    border-radius: 26px;
    border: 1px solid #ddebe2;
    padding: 32px;
    box-shadow: 0 18px 36px rgba(15, 23, 42, 0.06);
  }

  .consult-card-light {
    flex: 2;
    background: linear-gradient(to bottom, #ffffff, #f4fbf7);
    border-color: #d7e8de;
    box-shadow: 0 22px 44px rgba(21, 154, 114, 0.1);
  }

  /* Pricing */
  .price-section {
    padding: 60px 30px;
    background-color: #f8fafc;
    text-align: center;
  }

  .price-grid {
    display: flex;
    gap: 18px;
    margin-top: 30px;
  }

  .price-card {
    flex: 1;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e6edf5;
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    box-shadow: 0 18px 36px rgba(15, 23, 42, 0.08);
  }

  .price-amount {
    color: #17a589;
    font-size: 42px;
    font-weight: 800;
  }

  .btn-java-primary {
    background: var(--f-blue);
    color: #ffffff !important;
    border: none;
    border-radius: 4px;
    padding: 12px 24px;
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
    text-decoration: none;
  }

  .btn-java-primary:hover,
  .btn-java-primary:focus,
  .btn-java-primary:active,
  .btn-java-primary:visited {
    color: #ffffff !important;
    text-decoration: none;
  }

  .btn-java-light {
    background: white;
    color: var(--f-blue);
    border: 1px solid #e9edf3;
    border-radius: 4px;
    padding: 12px 24px;
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
    text-decoration: none;
  }

  @media (max-width: 991px) {
    .services-grid, .consult-grid, .price-grid { flex-direction: column; }
    .hero-slider-shell { height: auto; margin: 10px; }
    .hero-copy-box { padding: 30px; }
  }
</style>
{% endblock %}

