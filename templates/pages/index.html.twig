{% block body %} <!-- HERO -->
<style>
  :root {
    --hero-primary: #0f766e;
    --hero-primary-dark: #115e59;
    --hero-text: #f8fafc;
    --hero-muted: rgba(248, 250, 252, 0.82);
    --hero-surface: rgba(255, 255, 255, 0.08);
    --hero-border: rgba(255, 255, 255, 0.18);
  }

  .main-hero {
    position: relative;
    min-height: 88vh;
    display: grid;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(55% 55% at 12% 12%, rgba(15, 118, 110, 0.45), transparent 70%),
      radial-gradient(50% 50% at 86% 18%, rgba(14, 165, 233, 0.28), transparent 72%),
      linear-gradient(135deg, #022c2c 0%, #063b3b 48%, #0b4f52 100%);
  }

  .main-hero::before {
    content: '';
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(circle at 25% 35%, rgba(255, 255, 255, 0.08), transparent 40%),
      radial-gradient(circle at 78% 65%, rgba(255, 255, 255, 0.07), transparent 45%);
    animation: heroFloat 12s ease-in-out infinite alternate;
    will-change: transform;
    pointer-events: none;
    z-index: 0;
  }

  .main-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(circle at center, #000 35%, transparent 85%);
    opacity: 0.28;
  }

  .main-hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-shell {
    max-width: 760px;
    padding: clamp(26px, 4vw, 44px);
    border: 1px solid var(--hero-border);
    border-radius: 24px;
    backdrop-filter: blur(8px);
    background: linear-gradient(165deg, rgba(2, 6, 23, 0.42), rgba(2, 6, 23, 0.2));
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    margin-bottom: 16px;
    border-radius: 999px;
    border: 1px solid var(--hero-border);
    background: var(--hero-surface);
    color: #d7fbf5;
    font-size: 13px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .hero-headline {
    margin: 0;
    color: var(--hero-text);
    font-size: clamp(34px, 6vw, 62px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 800;
  }

  .hero-subheadline {
    margin: 18px 0 0;
    color: var(--hero-muted);
    font-size: clamp(17px, 2.5vw, 21px);
    line-height: 1.55;
    max-width: 58ch;
  }

  .hero-ctas {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 11px 22px;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 220ms ease, opacity 220ms ease, box-shadow 220ms ease, background-color 220ms ease, color 220ms ease;
    will-change: transform;
  }

  .hero-btn-primary {
    background: var(--hero-primary);
    color: #ffffff;
    box-shadow: 0 16px 30px rgba(15, 118, 110, 0.34);
  }

  .hero-btn-primary:hover,
  .hero-btn-primary:focus-visible {
    transform: translateY(-2px) scale(1.01);
    background: var(--hero-primary-dark);
    color: #ffffff;
    box-shadow: 0 20px 34px rgba(15, 118, 110, 0.38);
  }

  .hero-btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.65);
    color: #0f172a;
    background: #ffffff;
  }

  .hero-btn-secondary:hover,
  .hero-btn-secondary:focus-visible {
    transform: translateY(-2px);
    color: #0f172a;
    background: #f8fafc;
  }

  @keyframes heroFloat {
    0% { transform: translate3d(-1.5%, -1.5%, 0) scale(1.02); }
    100% { transform: translate3d(1.5%, 1.5%, 0) scale(1.04); }
  }

  @media (max-width: 991.98px) {
    .main-hero {
      min-height: 78vh;
      padding: 96px 0 72px;
    }

    .hero-shell {
      border-radius: 18px;
      padding: 22px;
    }
  }

  @media (max-width: 575.98px) {
    .main-hero {
      min-height: 72vh;
      padding: 84px 0 60px;
    }

    .hero-ctas {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-hero::before {
      animation: none;
    }    .hero-btn,
    .hero-btn:hover,
    .hero-btn:focus-visible {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

