{% extends 'base.html.twig' %}

{% block title %}Fitopia Reels{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .reels-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #eef8f6 0%, #f6fbfa 100%);
  }

  .reels-topbar {
    background: #ffffff;
    border-bottom: 1px solid #e6eef5;
    box-shadow: 0 10px 26px rgba(14, 30, 37, 0.05);
  }

  .reels-topbar-inner {
    width: min(100%, calc(100% - 36px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding: 18px 0 14px;
  }

  .reels-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
  }

  .reels-nav-link {
    width: 104px;
    padding: 12px 0 16px;
    border-bottom: 4px solid transparent;
    color: #5e6471;
    text-align: center;
    font-size: 26px;
    text-decoration: none;
  }

  .reels-nav-link.is-active {
    color: #1f2937;
    border-bottom-color: #2f7cff;
  }

  .reels-topbar-spacer {
    min-height: 1px;
  }

  .reels-title-band {
    width: min(100%, calc(100% - 36px));
    margin: 0 auto;
    padding: 18px 0 22px;
    text-align: center;
  }

  .reels-title-band h1 {
    margin: 0;
    color: #20242b;
    font-size: 28px;
    font-weight: 900;
  }

  .reels-stage-shell {
    width: min(100%, calc(100% - 28px));
    margin: 0 auto;
    padding-bottom: 26px;
  }

  .reels-stage {
    position: relative;
    min-height: calc(100vh - 180px);
    border-radius: 24px;
    overflow: hidden;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 22px 44px rgba(15, 23, 42, 0.16);
  }

  .reels-video-wrap {
    position: relative;
    width: min(100%, 430px);
    height: min(100%, 760px);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111111;
  }

  .reels-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000000;
  }

  .reels-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 0%, rgba(0, 0, 0, 0.18) 65%, rgba(0, 0, 0, 0.5) 100%);
    pointer-events: none;
  }

  .reels-actions {
    position: absolute;
    right: 22px;
    bottom: 140px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    z-index: 3;
  }

  .reels-action-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    font-size: 18px;
    backdrop-filter: blur(8px);
  }

  .reels-caption {
    position: absolute;
    left: 22px;
    right: 96px;
    bottom: 24px;
    z-index: 3;
    color: #ffffff;
  }

  .reels-meta {
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 700;
    opacity: 0.92;
  }

  .reels-caption h2 {
    margin: 0 0 6px;
    font-size: 24px;
    font-weight: 900;
    line-height: 1.15;
  }

  .reels-caption p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    opacity: 0.92;
  }

  .reels-scoreboard {
    display: flex;
    gap: 14px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .reels-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 13px;
    font-weight: 800;
  }

  .reels-side-hint {
    position: absolute;
    left: 22px;
    top: 18px;
    z-index: 3;
    padding: 9px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .reels-switchers {
    position: absolute;
    left: 24px;
    top: 50%;
    right: 24px;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .reels-switchers button {
    pointer-events: auto;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 20px;
    backdrop-filter: blur(8px);
  }

  @media (max-width: 900px) {
    .reels-topbar-inner {
      grid-template-columns: 1fr;
    }

    .reels-nav {
      gap: 8px;
      justify-content: space-between;
    }

    .reels-nav-link {
      width: auto;
      flex: 1 1 0;
      font-size: 22px;
    }

    .reels-stage {
      min-height: calc(100vh - 210px);
    }

    .reels-video-wrap {
      width: 100%;
      height: calc(100vh - 230px);
    }
  }
</style>
{% endblock %}

{% block body %}
<section class="reels-page">
  <header class="reels-topbar">
    <div class="reels-topbar-inner">
      <div class="reels-topbar-spacer"></div>
      <nav class="reels-nav" aria-label="Fitopia navigation">
        <a href="{{ path('home') }}" class="reels-nav-link"><i class="fa fa-home"></i></a>
        <a href="{{ path('fitopia_reels') }}" class="reels-nav-link is-active"><i class="fa fa-film"></i></a>
        <a href="{{ path('app_shop_index') }}" class="reels-nav-link"><i class="fa fa-shopping-bag"></i></a>
        <a href="{{ path('explore_forums_blogs') }}" class="reels-nav-link"><i class="fa fa-users"></i></a>
        <a href="{{ path('fitopia_games') }}" class="reels-nav-link"><i class="fa fa-gamepad"></i></a>
      </nav>
      <div class="reels-topbar-spacer"></div>
    </div>
  </header>

  <div class="reels-title-band">
    <h1>Fitopia Reels</h1>
  </div>

  <div class="reels-stage-shell">
    <div class="reels-stage">
      <div class="reels-video-wrap">
        <video id="fitopia-reels-video" class="reels-video" autoplay muted playsinline loop></video>
        <div class="reels-overlay"></div>
        <div class="reels-side-hint">Swipe or use arrows</div>

        <div class="reels-switchers">
          <button type="button" id="reels-prev-btn" aria-label="Previous reel"><i class="fa fa-angle-left"></i></button>
          <button type="button" id="reels-next-btn" aria-label="Next reel"><i class="fa fa-angle-right"></i></button>
        </div>

        <div class="reels-actions">
          <button type="button" class="reels-action-btn" id="reels-like-btn"><i class="fa fa-heart"></i></button>
          <button type="button" class="reels-action-btn" id="reels-comment-btn"><i class="fa fa-comment"></i></button>
          <button type="button" class="reels-action-btn" id="reels-share-btn"><i class="fa fa-share"></i></button>
        </div>

        <div class="reels-caption">
          <div class="reels-meta" id="reels-author-line"></div>
          <h2 id="reels-title"></h2>
          <p id="reels-caption-text"></p>
          <div class="reels-scoreboard">
            <span class="reels-pill"><i class="fa fa-heart"></i> <span id="reels-like-count">0</span></span>
            <span class="reels-pill"><i class="fa fa-comment"></i> <span id="reels-comment-count">0</span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block footer %}{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('fitopia-reels-video');
    const titleEl = document.getElementById('reels-title');
    const authorLineEl = document.getElementById('reels-author-line');
    const captionEl = document.getElementById('reels-caption-text');
    const likeCountEl = document.getElementById('reels-like-count');
    const commentCountEl = document.getElementById('reels-comment-count');
    const prevBtn = document.getElementById('reels-prev-btn');
    const nextBtn = document.getElementById('reels-next-btn');
    const likeBtn = document.getElementById('reels-like-btn');

    const reels = [
      {% for reel in reels %}
      {
        title: {{ reel.title|json_encode|raw }},
        author: {{ reel.author|json_encode|raw }},
        caption: {{ reel.caption|json_encode|raw }},
        video: {{ asset(reel.video)|json_encode|raw }},
        likes: {{ reel.likes|json_encode|raw }},
        comments: {{ reel.comments|json_encode|raw }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ];

    if (!video || !titleEl || !authorLineEl || !captionEl || !likeCountEl || !commentCountEl || !prevBtn || !nextBtn || !likeBtn || reels.length === 0) {
      return;
    }

    let currentIndex = 0;
    const likedMap = new Map();

    function renderReel(index) {
      const reel = reels[index];
      if (!reel) {
        return;
      }

      video.src = reel.video;
      video.play().catch(() => {});
      titleEl.textContent = reel.title;
      authorLineEl.textContent = reel.author;
      captionEl.textContent = reel.caption;
      const likedBonus = likedMap.get(index) ? 1 : 0;
      likeCountEl.textContent = String(reel.likes + likedBonus);
      commentCountEl.textContent = String(reel.comments);
      likeBtn.style.color = likedMap.get(index) ? '#ff6b81' : '#ffffff';
    }

    function goTo(index) {
      currentIndex = (index + reels.length) % reels.length;
      renderReel(currentIndex);
    }

    prevBtn.addEventListener('click', () => goTo(currentIndex - 1));
    nextBtn.addEventListener('click', () => goTo(currentIndex + 1));

    likeBtn.addEventListener('click', () => {
      likedMap.set(currentIndex, !likedMap.get(currentIndex));
      renderReel(currentIndex);
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
        goTo(currentIndex - 1);
      }
      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
        goTo(currentIndex + 1);
      }
    });

    let wheelLock = false;
    window.addEventListener('wheel', (event) => {
      if (wheelLock) {
        return;
      }
      wheelLock = true;
      window.setTimeout(() => {
        wheelLock = false;
      }, 420);
      if (event.deltaY > 0) {
        goTo(currentIndex + 1);
      } else if (event.deltaY < 0) {
        goTo(currentIndex - 1);
      }
    }, { passive: true });

    renderReel(0);
  });
</script>
{% endblock %}
