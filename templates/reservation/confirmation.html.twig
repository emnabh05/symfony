{% extends 'base.html.twig' %}

{% block title %}Reservation confirmee | Fitopia{% endblock %}

{% block body %}
<section class="container py-5">
  <div class="card shadow-sm border-0" style="max-width: 760px; margin: 0 auto; border-radius: 16px;">
    <div class="card-body p-4 p-md-5">
      <h2 class="h4 mb-3"><i class="fa fa-check-circle"></i> Reservation confirmee</h2>
      <p class="text-muted">Votre reservation a ete enregistree avec succes.</p>

      <div class="mb-4">
        <div><strong>Client:</strong> {{ reservation.nomParticipant }}</div>
        <div><strong>Email:</strong> {{ reservation.emailParticipant }}</div>
        <div><strong>Evenement:</strong> {{ event ? event.titre : 'N/A' }}</div>
        <div><strong>Date:</strong> {{ event ? event.dateEvent|date('Y-m-d') : 'N/A' }}</div>
        <div><strong>Lieu:</strong> {{ event ? event.lieu : 'N/A' }}</div>
        <div><strong>Statut:</strong> {{ reservation.statut }}</div>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-success" href="{{ path('app_reservation_qr_generate', {id: reservation.id}) }}">
          <i class="fa fa-qrcode"></i> Generer mon QR Code
        </a>
        <a class="btn btn-outline-secondary" href="{{ path('events', {event: event ? event.id : null}) }}">
          Retour aux evenements
        </a>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block footer %}{% endblock %}
