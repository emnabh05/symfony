{% extends 'base.html.twig' %}

{% block title %}Reservation evenement | Fitopia{% endblock %}

{% block body %}
<section class="container py-5">
  {% set price = event.prixEvent|default('0') + 0 %}
  {% set imageSrc = (event.imageEvent and event.imageEvent starts with 'event-') ? asset('uploads/events/' ~ event.imageEvent) : 'https://images.unsplash.com/photo-1476480862126-209bfaa8edc8?auto=format&fit=crop&w=1400&q=80' %}

  <div class="row g-4">
    <div class="col-12 col-lg-7">
      <div class="card border-0 shadow-sm h-100">
        <img src="{{ imageSrc }}" alt="{{ event.titre }}" class="card-img-top" style="aspect-ratio:16/8;object-fit:cover;">
        <div class="card-body">
          <h1 class="h4 mb-3">{{ event.titre }}</h1>
          <div class="row g-2 mb-3">
            <div class="col-12 col-md-6"><strong>Date :</strong> {{ event.dateEvent|date('Y-m-d') }}</div>
            <div class="col-12 col-md-6"><strong>Lieu :</strong> {{ event.lieu }}</div>
            <div class="col-12 col-md-6"><strong>Prix :</strong> {% if price > 0 %}{{ event.prixEvent }} DT{% else %}Gratuit{% endif %}</div>
            <div class="col-12 col-md-6"><strong>Capacite restante :</strong> {{ event.capacite }}</div>
          </div>
          <p class="text-muted mb-0">{{ event.description|length > 220 ? event.description|slice(0, 220) ~ '...' : event.description }}</p>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h2 class="h5 mb-3">Confirmer votre reservation</h2>

          {% if isFull %}
            <div class="alert alert-warning mb-2">Cet evenement est complet.</div>
            <a class="btn btn-primary w-100" href="{{ path('app_waitlist_join_form', {id: event.id}) }}">Rejoindre la liste d attente</a>
          {% else %}
            {{ form_start(form, {action: path('app_event_reservation_create', {id: event.id})}) }}
              {{ form_widget(form) }}
              <button type="submit" class="btn btn-primary w-100">Confirmer ma reservation</button>
            {{ form_end(form) }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
