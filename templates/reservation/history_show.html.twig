{% extends 'base.html.twig' %}

{% block title %}Detail reservation | Fitopia{% endblock %}

{% block body %}
<section class="container py-5">
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0">Detail de ma reservation</h1>
    <a class="btn btn-outline-secondary" href="{{ path('app_reservation_history_index') }}">Retour a l historique</a>
  </div>

  <div class="row g-3">
    <div class="col-12 col-lg-6 d-flex">
      <article class="card border-0 shadow-sm w-100">
        <div class="card-header bg-white"><strong>Bloc A - Infos evenement</strong></div>
        <div class="card-body">
          {% set imageSrc = event and event.imageEvent ? (event.imageEvent starts with('http') ? event.imageEvent : asset('uploads/events/' ~ event.imageEvent)) : asset('images/bg_1.jpg') %}
          <img
            src="{{ imageSrc }}"
            alt="Image evenement"
            class="img-fluid rounded mb-3"
            style="max-height: 220px; width: 100%; object-fit: cover;"
          >
          <p class="mb-1"><strong>Titre:</strong> {{ event ? event.titre : 'N/A' }}</p>
          <p class="mb-1"><strong>Description:</strong> {{ event ? event.description : 'N/A' }}</p>
          <p class="mb-1"><strong>Date:</strong> {{ event and event.dateEvent ? event.dateEvent|date('Y-m-d') : 'N/A' }}</p>
          <p class="mb-1"><strong>Lieu:</strong> {{ event ? event.lieu : 'N/A' }}</p>
          <p class="mb-0"><strong>Prix:</strong> {{ event and event.prixEvent is not null ? event.prixEvent|number_format(2, '.', ' ') ~ ' DT' : 'Gratuit' }}</p>
        </div>
      </article>
    </div>

    <div class="col-12 col-lg-6 d-flex">
      <article class="card border-0 shadow-sm w-100">
        <div class="card-header bg-white"><strong>Bloc B - Infos reservation</strong></div>
        <div class="card-body">
          <p class="mb-1"><strong>Nom:</strong> {{ reservation.nomParticipant }}</p>
          <p class="mb-1"><strong>Email:</strong> {{ reservation.emailParticipant }}</p>
          <p class="mb-1"><strong>Date reservation:</strong> {{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d H:i') : 'N/A' }}</p>
          <p class="mb-0"><strong>Statut:</strong> <span class="badge bg-primary text-white">{{ reservation.statut }}</span></p>
        </div>
      </article>
    </div>

    <div class="col-12">
      <article class="card border-0 shadow-sm">
        <div class="card-header bg-white"><strong>Bloc C - QR Code</strong></div>
        <div class="card-body">
          {% if reservation.qrToken %}
            <div class="row g-3 align-items-center">
              <div class="col-12 col-md-4 text-center">
                <img
                  src="{{ qrImageUrl }}"
                  alt="QR Code reservation"
                  class="img-fluid rounded border"
                  style="max-width: 240px;"
                >
              </div>
              <div class="col-12 col-md-8">
                <p class="mb-2">Votre QR est genere et pret pour la validation.</p>
                <div class="d-flex flex-wrap gap-2">
                  <a class="btn btn-success" href="{{ path('app_reservation_qr_validate', {token: reservation.qrToken}) }}" target="_blank" rel="noopener">
                    Ouvrir la page de validation
                  </a>
                  {% if validationUrl %}
                    <a class="btn btn-outline-secondary" href="{{ validationUrl }}" target="_blank" rel="noopener">Lien absolu de validation</a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% else %}
            <span class="badge bg-warning text-dark">QR non genere</span>
            <div class="mt-3">
              {% if canGenerateQr %}
                <a class="btn btn-primary" href="{{ path('app_reservation_qr_generate', {id: reservation.id}) }}">Generer mon QR code</a>
              {% else %}
                <p class="text-muted mb-0">Connectez-vous avec le compte proprietaire pour generer le QR.</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </article>
    </div>
  </div>
</section>
{% endblock %}

{% block footer %}{% endblock %}
