{% extends 'base.html.twig' %}

{% block title %}Reservation confirmee | Fitopia{% endblock %}

{% block body %}
<section class="container py-5">
  <div class="card border-0 shadow-sm" style="max-width: 760px; margin: 0 auto;">
    <div class="card-body p-4 p-md-5">
      <div class="text-success fs-2 mb-2"><i class="fa fa-check-circle"></i></div>
      <h1 class="h4 mb-2">Reservation confirmee</h1>
      <p class="text-muted mb-4">Votre reservation a ete enregistree avec succes.</p>

      <div class="row g-2 mb-3">
        <div class="col-12 col-md-6"><strong>Participant :</strong> {{ reservation.nomParticipant }}</div>
        <div class="col-12 col-md-6"><strong>Email :</strong> {{ reservation.emailParticipant }}</div>
        <div class="col-12 col-md-6"><strong>Evenement :</strong> {{ event ? event.titre : 'N/A' }}</div>
        <div class="col-12 col-md-6"><strong>Date :</strong> {{ event ? event.dateEvent|date('Y-m-d') : 'N/A' }}</div>
        <div class="col-12 col-md-6"><strong>Lieu :</strong> {{ event ? event.lieu : 'N/A' }}</div>
        <div class="col-12 col-md-6"><strong>Statut :</strong> {{ reservation.statut }}</div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-success" href="{{ path('app_reservation_qr_generate', {id: reservation.id}) }}">
          <i class="fa fa-qrcode"></i> Generer mon QR code
        </a>
        <a class="btn btn-outline-primary" href="{{ path('app_event_show', {id: event.id}) }}">
          <i class="fa fa-info-circle"></i> Voir les details
        </a>
        <a class="btn btn-outline-secondary" href="{{ path('events') }}">
          Retour aux events
        </a>
      </div>
    </div>
  </div>
</section>
{% endblock %}
