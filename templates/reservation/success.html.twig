{% extends 'base.html.twig' %}

{% block title %}Reservation evenement | Fitopia{% endblock %}

{% block body %}
<section class="container py-5">
  {% set statusKey = reservation.statut|default('')|lower %}
  {% set isPaid = statusKey in ['payee', 'paid', 'paye'] %}
  <div class="card border-0 shadow-sm" style="max-width: 760px; margin: 0 auto;">
    <div class="card-body p-4 p-md-5">
      <div class="text-success fs-2 mb-2"><i class="fa fa-check-circle"></i></div>
      <h1 class="h4 mb-2">{{ isPaid ? 'Paiement confirme' : 'Reservation confirmee' }}</h1>
      <p class="text-muted mb-4">
        {% if isPaid %}
          Votre paiement a ete valide et votre place est maintenant reservee.
        {% else %}
          Votre reservation a ete enregistree avec succes.
        {% endif %}
      </p>

      <div class="row g-2 mb-3">
        <div class="col-12 col-md-6"><strong>Participant :</strong> {{ reservation.nomParticipant }}</div>
        <div class="col-12 col-md-6"><strong>Email :</strong> {{ reservation.emailParticipant }}</div>
        <div class="col-12 col-md-6"><strong>Telephone :</strong> {{ reservation.telephoneParticipant ?: '-' }}</div>
        <div class="col-12 col-md-6"><strong>Evenement :</strong> {{ event ? event.titre : 'N/A' }}</div>
        <div class="col-12 col-md-6"><strong>Date :</strong> {{ event ? event.dateEvent|date('Y-m-d') : 'N/A' }}</div>
        <div class="col-12 col-md-6"><strong>Lieu :</strong> {{ event ? event.lieu : 'N/A' }}</div>
        <div class="col-12 col-md-6"><strong>Montant :</strong> {{ reservation.montant|number_format(2, '.', ' ') }} DT</div>
        <div class="col-12 col-md-6"><strong>Statut :</strong> {{ reservation.statut }}</div>
        <div class="col-12 col-md-6"><strong>Transaction :</strong> {{ reservation.transactionId ?: '-' }}</div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        {% if statusKey in ['confirmee', 'utilisee', 'payee', 'paid', 'paye'] %}
          <a class="btn btn-success" href="{{ path('app_reservation_qr_generate', {id: reservation.id}) }}">
            <i class="fa fa-qrcode"></i> Generer mon QR code
          </a>
        {% endif %}
        <a class="btn btn-outline-dark" href="{{ path('app_reservation_history_show', {id: reservation.id}) }}">
          <i class="fa fa-receipt"></i> Voir le detail
        </a>
        <a class="btn btn-outline-primary" href="{{ path('app_event_show', {id: event.id}) }}">
          <i class="fa fa-info-circle"></i> Voir les details
        </a>
        <a class="btn btn-outline-secondary" href="{{ path('events') }}">
          Retour aux events
        </a>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block footer %}{% endblock %}
