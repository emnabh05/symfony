{% extends 'admin/layout.html.twig' %}

{% block title %}Admin Profile | Fitopia{% endblock %}

{% block stylesheets %}
<style>
  .profile-card {
    min-height: 70vh;
    width: 100%;
  }
  .profile-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 1.75rem;
    border-radius: 14px;
    background: linear-gradient(160deg, #0b5f61 0%, #176f69 50%, #2f8a7d 100%);
    color: #fff;
    margin-bottom: 1.5rem;
  }
  .profile-hero .title {
    font-size: 1.6rem;
    font-weight: 800;
  }
  .profile-hero .subtitle {
    opacity: 0.9;
    font-size: 0.98rem;
  }
  .profile-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.6);
    background: #fff;
  }
  .profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .profile-grid .full {
    grid-column: 1 / -1;
  }
  .icon-input {
    position: relative;
  }
  .icon-input i {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #0f7a5f;
    font-size: 1.05rem;
  }
  .icon-input input,
  .icon-input textarea {
    padding-left: 44px;
    min-height: 48px;
    font-size: 1rem;
  }
  .icon-input textarea {
    min-height: 110px;
    padding-top: 0.9rem;
  }
  .form-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 1.5rem;
    border: 1px solid #eef2f6;
  }
  .form-card h5 {
    margin-top: 0;
    margin-bottom: 1rem;
    font-weight: 700;
    color: #0f172a;
  }
  .form-control {
    border-radius: 12px;
    border-color: #dbe4ef;
  }
  .save-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }
  @media (max-width: 991px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
{% endblock %}

{% block body %}
  <div class="page-title" style="font-size:2rem;">Admin Profile</div>
  <div class="card profile-card">
    <div class="profile-hero">
      <div>
        <div class="title">Fitopia Admin Profile</div>
        <div class="subtitle">Update the same core account fields used in the Java project</div>
      </div>
      <img class="profile-avatar" src="{{ path('app_profile_avatar_view') }}?v={{ app.user and app.user.avatar ? app.user.avatar|url_encode : 'none' }}" alt="Admin avatar">
    </div>

    {% for message in app.flashes('success') %}
      <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {{ form_start(profileForm) }}
    <div class="form-card">
      <h5>Account Information</h5>
      <div class="profile-grid">
        <div>
          {{ form_label(profileForm.firstName, 'First name') }}
          <div class="icon-input">
            <i class="fa fa-user-circle"></i>
            {{ form_widget(profileForm.firstName, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(profileForm.firstName) }}
        </div>

        <div>
          {{ form_label(profileForm.lastName, 'Last name') }}
          <div class="icon-input">
            <i class="fa fa-user-circle-o"></i>
            {{ form_widget(profileForm.lastName, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(profileForm.lastName) }}
        </div>

        <div class="full">
          {{ form_label(profileForm.username, 'Username') }}
          <div class="icon-input">
            <i class="fa fa-id-card-o"></i>
            {{ form_widget(profileForm.username, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(profileForm.username) }}
        </div>

        <div class="full">
          {{ form_label(profileForm.email, 'Email') }}
          <div class="icon-input">
            <i class="fa fa-envelope-open"></i>
            {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(profileForm.email) }}
        </div>

        <div>
          {{ form_label(profileForm.phone, 'Phone') }}
          <div class="icon-input">
            <i class="fa fa-mobile"></i>
            {{ form_widget(profileForm.phone, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(profileForm.phone) }}
        </div>

        <div>
          {{ form_label(profileForm.birthDate, 'Birth date') }}
          <div class="icon-input">
            <i class="fa fa-calendar-check-o"></i>
            {{ form_widget(profileForm.birthDate, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(profileForm.birthDate) }}
        </div>

        <div class="full">
          {{ form_label(profileForm.bio, 'Bio') }}
          <div class="icon-input">
            <i class="fa fa-info-circle"></i>
            {{ form_widget(profileForm.bio, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(profileForm.bio) }}
        </div>
      </div>
    </div>

    {{ form_row(profileForm._token) }}
    <div class="save-row">
      <button class="btn btn-dark" style="background:#0b3a3d;border:none;border-radius:10px;padding:0.7rem 1.2rem;color:#fff;font-weight:600;font-size:1rem;">Save Changes</button>
    </div>
    {{ form_end(profileForm, {'render_rest': false}) }}
  </div>
{% endblock %}
