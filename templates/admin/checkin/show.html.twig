{% extends 'admin/layout.html.twig' %}

{% block title %}Resultat Check-in{% endblock %}

{% block stylesheets %}
  <style>
    .checkin-wrap { max-width: 900px; }
    .checkin-card {
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 1.2rem;
      background: #fff;
    }
    .info-grid {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 0.55rem 1rem;
    }
    .info-label { font-weight: 700; color: #334155; }
    .info-value { color: #0f172a; word-break: break-word; }
    .status-badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 0.2rem 0.65rem;
      font-size: 0.78rem;
      font-weight: 700;
      border: 1px solid transparent;
    }
    .status-confirmed { background: #dbeafe; color: #1d4ed8; border-color: #93c5fd; }
    .status-used { background: #dcfce7; color: #166534; border-color: #86efac; }
    .status-cancelled { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
  </style>
{% endblock %}

{% block body %}
  <div class="checkin-wrap">
    <h1 class="page-title">Resultat check-in</h1>

    {% for message in app.flashes('success') %}
      <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('info') %}
      <div class="alert alert-info">{{ message }}</div>
    {% endfor %}

    <div class="checkin-card">
      <a class="btn btn-sm btn-outline-secondary mb-3" href="{{ path('admin_checkin_index') }}">
        <i class="fa fa-arrow-left"></i> Retour check-in
      </a>

      {% if not reservation %}
        <div class="alert alert-danger mb-3">QR invalide.</div>
        <a class="btn btn-primary" href="{{ path('admin_checkin_index') }}">Retour a la liste</a>
      {% else %}
        {% set status = reservation.statut %}
        {% set isCancelled = status == constant('App\\Entity\\Reservation::STATUS_CANCELLED') %}
        {% set isUsed = reservation.usedAt or status == constant('App\\Entity\\Reservation::STATUS_USED') %}
        {% set isConfirmed = status == constant('App\\Entity\\Reservation::STATUS_CONFIRMED') %}

        <div class="info-grid">
          <div class="info-label">Token</div>
          <div class="info-value">{{ reservation.qrToken ?? 'N/A' }}</div>

          <div class="info-label">Participant</div>
          <div class="info-value">{{ reservation.nomParticipant }}</div>

          <div class="info-label">Email</div>
          <div class="info-value">{{ reservation.emailParticipant }}</div>

          <div class="info-label">Evenement</div>
          <div class="info-value">{{ reservation.event ? reservation.event.titre : 'N/A' }}</div>

          <div class="info-label">Date evenement</div>
          <div class="info-value">{{ reservation.event ? reservation.event.dateEvent|date('Y-m-d') : 'N/A' }}</div>

          <div class="info-label">Lieu</div>
          <div class="info-value">{{ reservation.event ? reservation.event.lieu : 'N/A' }}</div>

          <div class="info-label">Statut</div>
          <div class="info-value">
            {% if isCancelled %}
              <span class="status-badge status-cancelled">Annulee</span>
            {% elseif isUsed %}
              <span class="status-badge status-used">Utilisee</span>
            {% else %}
              <span class="status-badge status-confirmed">{{ status }}</span>
            {% endif %}
          </div>
        </div>

        {% if isCancelled %}
          <div class="alert alert-danger mt-3 mb-0">Reservation annulee.</div>
        {% elseif isUsed %}
          <div class="alert alert-info mt-3 mb-0">
            Deja validee{% if reservation.usedAt %} le {{ reservation.usedAt|date('Y-m-d H:i') }}{% endif %}.
          </div>
        {% elseif isConfirmed %}
          <form class="mt-3" method="post" action="{{ path('admin_checkin_validate', {token: reservation.qrToken}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_checkin_validate_' ~ reservation.qrToken) }}">
            <button type="submit" class="btn btn-success">
              &#9989; Valider l'entree
            </button>
          </form>
        {% else %}
          <div class="alert alert-danger mt-3 mb-0">QR invalide.</div>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock %}
