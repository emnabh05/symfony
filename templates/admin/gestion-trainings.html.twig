{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des entrainements | Fitopia{% endblock %}

{% block stylesheets %}
<style>
  .agenda-hero { background: linear-gradient(135deg, #0b3a3d 0%, #0d5b50 55%, #0f7a5f 100%); color:#fff; border-radius:16px; padding:2rem 2.5rem; box-shadow:0 18px 50px rgba(14,30,37,.18); position:relative; overflow:hidden; }
  .agenda-hero::after { content:""; position:absolute; right:-60px; top:-60px; width:180px; height:180px; background:rgba(255,255,255,.08); border-radius:50%; }
  .agenda-hero h2 { margin:0 0 .4rem; font-weight:800; }
  .agenda-hero p { margin:0; opacity:.9; }
  .hero-stats { margin-top:1rem; display:flex; gap:.65rem; flex-wrap:wrap; }
  .hero-chip { background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.22); border-radius:999px; padding:.32rem .75rem; font-size:.8rem; font-weight:700; display:inline-flex; align-items:center; gap:.4rem; }
  .option-grid { margin-top:2rem; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; }
  .option-card { background:#fff; border-radius:14px; padding:1.5rem; box-shadow:0 12px 30px rgba(14,30,37,.08); border:1px solid #eef2f6; transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease; cursor:pointer; position:relative; overflow:hidden; }
  .option-card::before { content:""; position:absolute; inset:0; background:linear-gradient(135deg, rgba(15,122,95,.05), rgba(11,58,61,0)); opacity:0; transition:opacity .25s ease; }
  .option-card.selected { border-color:#0f7a5f; box-shadow:0 0 0 3px rgba(15,122,95,.15); }
  .option-card:hover { transform:translateY(-4px); border-color:#d2e5e1; box-shadow:0 18px 40px rgba(14,30,37,.14); }
  .option-card:hover::before { opacity:1; }
  .option-card>* { position:relative; z-index:1; }
  .option-icon { width:42px; height:42px; border-radius:10px; background:#e6f0ee; color:#0b3a3d; display:inline-flex; align-items:center; justify-content:center; font-size:1.2rem; margin-bottom:.75rem; }
  .panel { margin-top:2rem; background:#fff; border-radius:16px; padding:1.75rem; border:1px solid #eef2f6; box-shadow:0 12px 30px rgba(14,30,37,.08); display:none; transform:translateY(12px); opacity:0; transition:all .25s ease; }
  .panel.active { display:block; transform:translateY(0); opacity:1; }
  .panel h3 { margin-top:0; font-weight:800; display:inline-flex; align-items:center; gap:.55rem; color:#0b3a3d; }
  .panel h3 i { width:34px; height:34px; border-radius:10px; background:#e9f7f2; color:#0f7a5f; display:inline-flex; align-items:center; justify-content:center; font-size:.95rem; }
  .muted { color:#6b7280; }
  .form-wrap { background:#fff; border-radius:14px; border:1px solid #e6eef6; padding:1.25rem; margin-bottom:1rem; box-shadow:0 10px 26px rgba(14,30,37,.07); transition:transform .22s ease, box-shadow .22s ease; }
  .form-wrap:hover { transform:translateY(-2px); box-shadow:0 16px 30px rgba(14,30,37,.11); }
  .form-row { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; }
  .form-row.three { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .form-control,.btn { border-radius:10px; }
  .form-control { border:1px solid #d6e0ea; transition:border-color .2s ease, box-shadow .2s ease; }
  .form-control:focus { border-color:#0f7a5f; box-shadow:0 0 0 3px rgba(15,122,95,.12); }
  label { font-weight:700; color:#3a4b5c; font-size:.86rem; margin-bottom:.2rem; }
  .btn-primary { background:#0b3a3d; border-color:#0b3a3d; font-weight:700; box-shadow:0 6px 16px rgba(11,58,61,.22); }
  .btn-primary:hover { background:#0f7a5f; border-color:#0f7a5f; }
  .btn-outline-primary,.btn-outline-danger { font-weight:700; border-width:1.5px; }
  .list-item { border:1px solid #e6eef6; border-radius:12px; padding:.9rem 1rem; margin-bottom:.75rem; background:linear-gradient(180deg,#ffffff 0%,#fcfdff 100%); transition:transform .2s ease, box-shadow .2s ease; animation:itemIn .28s ease both; }
  .list-item:hover { transform:translateX(2px); box-shadow:0 10px 22px rgba(14,30,37,.08); }
  .list-head { display:flex; justify-content:space-between; align-items:center; gap:.6rem; flex-wrap:wrap; }
  .badge-soft { display:inline-block; border-radius:999px; background:#e9f7f2; color:#0f7a5f; font-size:.72rem; padding:.2rem .55rem; font-weight:700; }
  .success-toast { background:#e6fffa; color:#0b3a3d; border:1px solid #b7f3ea; border-radius:12px; padding:.85rem 1rem; margin-bottom:1rem; }
  .error-toast { background:#fff1f1; color:#a11b1b; border:1px solid #f7c9c9; border-radius:12px; padding:.85rem 1rem; margin-bottom:1rem; }
  .table-wrap { overflow-x:auto; }
  .table-toolbar { display:flex; justify-content:flex-end; align-items:center; gap:.55rem; margin:.6rem 0 .8rem; flex-wrap:wrap; }
  .toolbar-search,.toolbar-sort { border:1px solid #d6e0ea; border-radius:10px; padding:.42rem .62rem; font-size:.85rem; background:#fff; }
  .toolbar-search { min-width:230px; }
  .toolbar-sort { min-width:190px; }
  .toolbar-export { border:1px solid #c8d7ee; background:#f0f5ff; color:#1f3f68; border-radius:10px; font-weight:700; font-size:.84rem; padding:.42rem .78rem; }
  table { width:100%; border-collapse:collapse; border-radius:12px; overflow:hidden; border:1px solid #e6eef6; background:#fff; }
  th,td { border-bottom:1px solid #eef2f6; padding:.62rem .55rem; text-align:left; font-size:.9rem; }
  th { background:#f4f8fb; color:#1e3042; font-weight:800; }
  tbody tr { transition:background-color .2s ease; }
  tbody tr:hover { background:#f8fcfb; }
  @keyframes itemIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
  @media (max-width:991px) {
    .option-grid { grid-template-columns:1fr; }
    .form-row,.form-row.three { grid-template-columns:1fr; }
    .hero-stats { display:grid; grid-template-columns:1fr; gap:.45rem; }
    .table-toolbar { justify-content:stretch; }
    .toolbar-search,.toolbar-sort,.toolbar-export { width:100%; min-width:0; }
  }
</style>
{% endblock %}

{% block body %}
  <div class="agenda-hero">
    <h2>Training Plans & Programs Management</h2>
    <p>Admin can manage all training plans and programs created for all users from one page.</p>
    <div class="hero-stats">
      <span class="hero-chip"><i class="fa fa-map"></i> {{ plans|length }} training plans</span>
      <span class="hero-chip"><i class="fa fa-list"></i> {{ programs|length }} programs</span>
      <span class="hero-chip"><i class="fa fa-users"></i> {{ users|length }} users</span>
    </div>
  </div>

  {% if not tablesReady %}
    <div class="error-toast">Training tables are missing. Run fitness migrations first.</div>
  {% endif %}

  {% for message in app.flashes('success') %}
    <div class="success-toast">{{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('error') %}
    <div class="error-toast">{{ message }}</div>
  {% endfor %}

  <div class="option-grid">
    <div class="option-card" data-action="create">
      <div class="option-icon"><i class="fa fa-plus"></i></div>
      <h4>Create records</h4>
      <p class="muted">Add training plans and programs for users.</p>
    </div>
    <div class="option-card" data-action="update">
      <div class="option-icon"><i class="fa fa-refresh"></i></div>
      <h4>Update existing records</h4>
      <p class="muted">Edit plans and programs with full details.</p>
    </div>
    <div class="option-card" data-action="delete">
      <div class="option-icon"><i class="fa fa-trash"></i></div>
      <h4>Delete records</h4>
      <p class="muted">Delete plans and programs safely.</p>
    </div>
    <div class="option-card" data-action="explore">
      <div class="option-icon"><i class="fa fa-globe"></i></div>
      <h4>Explore all data</h4>
      <p class="muted">Search, sort and export all plans and programs.</p>
    </div>
  </div>

  <div id="panel-create" class="panel">
    <h3><i class="fa fa-plus-circle"></i> Create training records</h3>
    <p class="muted">Create training plans and programs.</p>

    <div class="form-wrap">
      <h5 style="font-weight:800;"><i class="fa fa-map"></i> Add Training Plan</h5>
      <form method="post" action="{{ path('admin_trainings_plan_add') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_plan_add') }}">
        <div class="form-row three">
          <div>
            <label>User</label>
            <select class="form-control" name="user_id">
              <option value="">No owner</option>
              {% for u in users %}
                <option value="{{ u.id }}">{{ u.email }}</option>
              {% endfor %}
            </select>
          </div>
          <div><label>Title</label><input class="form-control" name="title" required></div>
          <div><label>Category</label><input class="form-control" name="category" required></div>
        </div>
        <div class="form-row three">
          <div><label>Level</label><input class="form-control" name="level" required></div>
          <div><label>Duration Weeks</label><input class="form-control" name="duration_weeks" type="number" min="1" value="4" required></div>
          <div><label>Sessions / Week</label><input class="form-control" name="sessions_per_week" type="number" min="1" value="3" required></div>
        </div>
        <div class="form-row three">
          <div><label>Session Duration (min)</label><input class="form-control" name="session_duration" type="number" min="1" value="45" required></div>
          <div><label>Image URL</label><input class="form-control" name="image_url"></div>
          <div><label>Video URL</label><input class="form-control" name="video_url"></div>
        </div>
        <div class="form-row three">
          <div>
            <label>Visibility</label>
            <select class="form-control" name="is_public">
              <option value="1">Public</option>
              <option value="0">Private</option>
            </select>
          </div>
          <div style="grid-column: span 2;">
            <label>Link Programs</label>
            <select class="form-control" name="program_ids[]" multiple>
              {% for p in programs %}
                <option value="{{ p.id }}">{{ p.name }} - {{ p.muscleGroup }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <div class="form-row"><div style="grid-column:1/-1;"><label>Description</label><textarea class="form-control" name="description" rows="2"></textarea></div></div>
        <button class="btn btn-primary mt-2" type="submit"><i class="fa fa-check"></i> Create Training Plan</button>
      </form>
    </div>

    <div class="form-wrap">
      <h5 style="font-weight:800;"><i class="fa fa-list"></i> Add Program</h5>
      <form method="post" action="{{ path('admin_trainings_program_add') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_program_add') }}">
        <div class="form-row three">
          <div>
            <label>User</label>
            <select class="form-control" name="user_id">
              <option value="">No owner</option>
              {% for u in users %}
                <option value="{{ u.id }}">{{ u.email }}</option>
              {% endfor %}
            </select>
          </div>
          <div><label>Name</label><input class="form-control" name="name" required></div>
          <div>
            <label>Muscle Group</label>
            <select class="form-control" name="muscle_group" required>
              <option value="">-- Select --</option>
              <option value="Poitrine">Poitrine</option>
              <option value="Dos">Dos</option>
              <option value="Jambes">Jambes</option>
              <option value="Fessier">Fessier</option>
              <option value="Épaules">Épaules</option>
              <option value="Biceps">Biceps</option>
              <option value="Triceps">Triceps</option>
              <option value="Avant-bras">Avant-bras</option>
              <option value="Abdos">Abdos</option>
            </select>
          </div>
        </div>
        <div class="form-row three">
          <div><label>Difficulty</label><input class="form-control" name="difficulty" required></div>
          <div><label>Sets</label><input class="form-control" name="sets" type="number" min="0"></div>
          <div><label>Repetitions</label><input class="form-control" name="repetitions" type="number" min="0"></div>
        </div>
        <div class="form-row three">
          <div><label>Duration (min)</label><input class="form-control" name="duration" type="number" min="0"></div>
          <div><label>Image URL</label><input class="form-control" name="image_url"></div>
          <div><label>Video URL</label><input class="form-control" name="video_url"></div>
        </div>
        <div class="form-row">
          <div><label>Link Training Plans</label>
            <select class="form-control" name="plan_ids[]" multiple>
              {% for pl in plans %}
                <option value="{{ pl.id }}">{{ pl.title }} - {{ pl.level }}</option>
              {% endfor %}
            </select>
          </div>
          <div><label>Description</label><textarea class="form-control" name="description" rows="2"></textarea></div>
        </div>
        <button class="btn btn-primary mt-2" type="submit"><i class="fa fa-check"></i> Create Program</button>
      </form>
    </div>

    <div class="form-wrap">
      <h5 style="font-weight:800;"><i class="fa fa-line-chart"></i> Add Trend</h5>
      <form method="post" action="{{ path('admin_trainings_trend_add') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_trend_add') }}">
        <div class="form-row three">
          <div><label>Title</label><input class="form-control" name="title" required></div>
          <div>
            <label>Category</label>
            <select class="form-control" name="category" required>
              <option value="Endurance">Endurance</option>
              <option value="Salles &amp; cours fitness">Salles &amp; cours fitness</option>
              <option value="Tech &amp; digital">Tech &amp; digital</option>
              <option value="Bien-être">Bien-être</option>
            </select>
          </div>
          <div>
            <label>Active</label>
            <select class="form-control" name="is_active">
              <option value="1">Active</option>
              <option value="0">Inactive</option>
            </select>
          </div>
        </div>
        <div class="form-row three">
          <div style="grid-column: span 2;"><label>Image URL</label><input class="form-control" name="image_url"></div>
          <div><label>Description</label><textarea class="form-control" name="description" rows="2"></textarea></div>
        </div>
        <button class="btn btn-primary mt-2" type="submit"><i class="fa fa-check"></i> Create Trend</button>
      </form>
    </div>
  </div>

  <div id="panel-update" class="panel">
    <h3><i class="fa fa-refresh"></i> Update records</h3>
    <p class="muted">Edit training plans and programs.</p>

    <h5 style="font-weight:800;"><i class="fa fa-map"></i> Training Plans</h5>
    {% for pl in plans %}
      <div class="list-item">
        <div class="list-head">
          <div><strong>#{{ pl.id }}</strong> - {{ pl.title }} <span class="badge-soft">{{ pl.level }}</span> <span class="badge-soft">{{ pl.user ? pl.user.email : 'No owner' }}</span></div>
          <button class="btn btn-outline-primary btn-sm js-toggle" data-target="plan-form-{{ pl.id }}"><i class="fa fa-pencil"></i> Edit</button>
        </div>
        <form id="plan-form-{{ pl.id }}" method="post" action="{{ path('admin_trainings_plan_update', {'id': pl.id}) }}" style="display:none;margin-top:0.8rem;">
          <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_plan_update_' ~ pl.id) }}">
          <div class="form-row three">
            <div><label>User</label>
              <select class="form-control" name="user_id">
                <option value="">No owner</option>
                {% for u in users %}
                  <option value="{{ u.id }}" {{ pl.user and pl.user.id == u.id ? 'selected' : '' }}>{{ u.email }}</option>
                {% endfor %}
              </select>
            </div>
            <div><label>Title</label><input class="form-control" name="title" value="{{ pl.title }}" required></div>
            <div><label>Category</label><input class="form-control" name="category" value="{{ pl.category }}" required></div>
          </div>
          <div class="form-row three">
            <div><label>Level</label><input class="form-control" name="level" value="{{ pl.level }}" required></div>
            <div><label>Duration Weeks</label><input class="form-control" name="duration_weeks" type="number" min="1" value="{{ pl.durationWeeks }}" required></div>
            <div><label>Sessions / Week</label><input class="form-control" name="sessions_per_week" type="number" min="1" value="{{ pl.sessionsPerWeek }}" required></div>
          </div>
          <div class="form-row three">
            <div><label>Session Duration</label><input class="form-control" name="session_duration" type="number" min="1" value="{{ pl.sessionDuration }}" required></div>
            <div><label>Image URL</label><input class="form-control" name="image_url" value="{{ pl.imageUrl }}"></div>
            <div><label>Video URL</label><input class="form-control" name="video_url" value="{{ pl.videoUrl }}"></div>
          </div>
          <div class="form-row three">
            <div>
              <label>Visibility</label>
              <select class="form-control" name="is_public">
                <option value="1" {{ pl.isPublic ? 'selected' : '' }}>Public</option>
                <option value="0" {{ not pl.isPublic ? 'selected' : '' }}>Private</option>
              </select>
            </div>
            <div style="grid-column: span 2;">
              <label>Link Programs</label>
              <select class="form-control" name="program_ids[]" multiple>
                {% for p in programs %}
                  <option value="{{ p.id }}" {{ p in pl.exercises ? 'selected' : '' }}>{{ p.name }} - {{ p.muscleGroup }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-row"><div style="grid-column:1/-1;"><label>Description</label><textarea class="form-control" name="description" rows="2">{{ pl.description }}</textarea></div></div>
          <button class="btn btn-primary btn-sm mt-2" type="submit"><i class="fa fa-save"></i> Save Plan</button>
        </form>
      </div>
    {% else %}
      <p class="muted">No plans found.</p>
    {% endfor %}

    <h5 style="font-weight:800;margin-top:1rem;"><i class="fa fa-list"></i> Programs</h5>
    {% for p in programs %}
      <div class="list-item">
        <div class="list-head">
          <div><strong>#{{ p.id }}</strong> - {{ p.name }} <span class="badge-soft">{{ p.difficulty }}</span> <span class="badge-soft">{{ p.user ? p.user.email : 'No owner' }}</span></div>
          <button class="btn btn-outline-primary btn-sm js-toggle" data-target="program-form-{{ p.id }}"><i class="fa fa-pencil"></i> Edit</button>
        </div>
        <form id="program-form-{{ p.id }}" method="post" action="{{ path('admin_trainings_program_update', {'id': p.id}) }}" style="display:none;margin-top:0.8rem;">
          <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_program_update_' ~ p.id) }}">
          <div class="form-row three">
            <div>
              <label>User</label>
              <select class="form-control" name="user_id">
                <option value="">No owner</option>
                {% for u in users %}
                  <option value="{{ u.id }}" {{ p.user and p.user.id == u.id ? 'selected' : '' }}>{{ u.email }}</option>
                {% endfor %}
              </select>
            </div>
            <div><label>Name</label><input class="form-control" name="name" value="{{ p.name }}" required></div>
            <div>
              <label>Muscle Group</label>
              <select class="form-control" name="muscle_group" required>
                <option value="">-- Select --</option>
                <option value="Poitrine" {{ p.muscleGroup == 'Poitrine' ? 'selected' : '' }}>Poitrine</option>
                <option value="Dos" {{ p.muscleGroup == 'Dos' ? 'selected' : '' }}>Dos</option>
                <option value="Jambes" {{ p.muscleGroup == 'Jambes' ? 'selected' : '' }}>Jambes</option>
                <option value="Fessier" {{ p.muscleGroup == 'Fessier' ? 'selected' : '' }}>Fessier</option>
                <option value="Épaules" {{ p.muscleGroup == 'Épaules' ? 'selected' : '' }}>Épaules</option>
                <option value="Biceps" {{ p.muscleGroup == 'Biceps' ? 'selected' : '' }}>Biceps</option>
                <option value="Triceps" {{ p.muscleGroup == 'Triceps' ? 'selected' : '' }}>Triceps</option>
                <option value="Avant-bras" {{ p.muscleGroup == 'Avant-bras' ? 'selected' : '' }}>Avant-bras</option>
                <option value="Abdos" {{ p.muscleGroup == 'Abdos' ? 'selected' : '' }}>Abdos</option>
              </select>
            </div>
          </div>
          <div class="form-row three">
            <div><label>Difficulty</label><input class="form-control" name="difficulty" value="{{ p.difficulty }}" required></div>
            <div><label>Sets</label><input class="form-control" name="sets" type="number" min="0" value="{{ p.sets }}"></div>
            <div><label>Repetitions</label><input class="form-control" name="repetitions" type="number" min="0" value="{{ p.repetitions }}"></div>
          </div>
          <div class="form-row three">
            <div><label>Duration</label><input class="form-control" name="duration" type="number" min="0" value="{{ p.duration }}"></div>
            <div><label>Image URL</label><input class="form-control" name="image_url" value="{{ p.imageUrl }}"></div>
            <div><label>Video URL</label><input class="form-control" name="video_url" value="{{ p.videoUrl }}"></div>
          </div>
          <div class="form-row">
            <div><label>Link Plans</label>
              <select class="form-control" name="plan_ids[]" multiple>
                {% for pl in plans %}
                  <option value="{{ pl.id }}" {{ pl in p.programs ? 'selected' : '' }}>{{ pl.title }} - {{ pl.level }}</option>
                {% endfor %}
              </select>
            </div>
            <div><label>Description</label><textarea class="form-control" name="description" rows="2">{{ p.description }}</textarea></div>
          </div>
          <button class="btn btn-primary btn-sm mt-2" type="submit"><i class="fa fa-save"></i> Save Program</button>
        </form>
      </div>
    {% else %}
      <p class="muted">No programs found.</p>
    {% endfor %}

    <h5 style="font-weight:800;margin-top:1rem;"><i class="fa fa-line-chart"></i> Trends</h5>
    {% for t in trends %}
      <div class="list-item">
        <div class="list-head">
          <div><strong>#{{ t.id }}</strong> - {{ t.title }} <span class="badge-soft">{{ t.category }}</span> <span class="badge-soft">{{ t.isActive ? 'Active' : 'Inactive' }}</span></div>
          <button class="btn btn-outline-primary btn-sm js-toggle" data-target="trend-form-{{ t.id }}"><i class="fa fa-pencil"></i> Edit</button>
        </div>
        <form id="trend-form-{{ t.id }}" method="post" action="{{ path('admin_trainings_trend_update', {'id': t.id}) }}" style="display:none;margin-top:0.8rem;">
          <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_trend_update_' ~ t.id) }}">
          <div class="form-row three">
            <div><label>Title</label><input class="form-control" name="title" value="{{ t.title }}" required></div>
            <div>
              <label>Category</label>
              <select class="form-control" name="category" required>
                {% set categories = ['Endurance', 'Salles & cours fitness', 'Tech & digital', 'Bien-être'] %}
                {% for cat in categories %}
                  <option value="{{ cat }}" {{ t.category == cat ? 'selected' : '' }}>{{ cat }}</option>
                {% endfor %}
              </select>
            </div>
            <div>
              <label>Active</label>
              <select class="form-control" name="is_active">
                <option value="1" {{ t.isActive ? 'selected' : '' }}>Active</option>
                <option value="0" {{ not t.isActive ? 'selected' : '' }}>Inactive</option>
              </select>
            </div>
          </div>
          <div class="form-row three">
            <div style="grid-column: span 2;"><label>Image URL</label><input class="form-control" name="image_url" value="{{ t.imageUrl }}"></div>
            <div><label>Description</label><textarea class="form-control" name="description" rows="2">{{ t.description }}</textarea></div>
          </div>
          <button class="btn btn-primary btn-sm mt-2" type="submit"><i class="fa fa-save"></i> Save Trend</button>
        </form>
      </div>
    {% else %}
      <p class="muted">No trends found.</p>
    {% endfor %}
  </div>

  <div id="panel-delete" class="panel">
    <h3><i class="fa fa-trash"></i> Delete records</h3>
    <p class="muted">Remove plans and programs.</p>

    <h5 style="font-weight:800;"><i class="fa fa-map"></i> Delete Training Plans</h5>
    {% for pl in plans %}
      <div class="list-item">
        <div class="list-head">
          <div><strong>#{{ pl.id }}</strong> - {{ pl.title }} - {{ pl.user ? pl.user.email : 'No owner' }}</div>
          <form method="post" action="{{ path('admin_trainings_plan_delete', {'id': pl.id}) }}" onsubmit="return confirm('Delete this training plan?');">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_plan_delete_' ~ pl.id) }}">
            <button class="btn btn-outline-danger btn-sm" type="submit"><i class="fa fa-trash"></i> Delete</button>
          </form>
        </div>
      </div>
    {% else %}
      <p class="muted">No plans found.</p>
    {% endfor %}

    <h5 style="font-weight:800;margin-top:1rem;"><i class="fa fa-list"></i> Delete Programs</h5>
    {% for p in programs %}
      <div class="list-item">
        <div class="list-head">
          <div><strong>#{{ p.id }}</strong> - {{ p.name }} - {{ p.user ? p.user.email : 'No owner' }}</div>
          <form method="post" action="{{ path('admin_trainings_program_delete', {'id': p.id}) }}" onsubmit="return confirm('Delete this program?');">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_program_delete_' ~ p.id) }}">
            <button class="btn btn-outline-danger btn-sm" type="submit"><i class="fa fa-trash"></i> Delete</button>
          </form>
        </div>
      </div>
    {% else %}
      <p class="muted">No programs found.</p>
    {% endfor %}

    <h5 style="font-weight:800;margin-top:1rem;"><i class="fa fa-line-chart"></i> Delete Trends</h5>
    {% for t in trends %}
      <div class="list-item">
        <div class="list-head">
          <div><strong>#{{ t.id }}</strong> - {{ t.title }} - {{ t.category }}</div>
          <form method="post" action="{{ path('admin_trainings_trend_delete', {'id': t.id}) }}" onsubmit="return confirm('Delete this trend?');">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_trend_delete_' ~ t.id) }}">
            <button class="btn btn-outline-danger btn-sm" type="submit"><i class="fa fa-trash"></i> Delete</button>
          </form>
        </div>
      </div>
    {% else %}
      <p class="muted">No trends found.</p>
    {% endfor %}
  </div>

  <div id="panel-explore" class="panel">
    <h3><i class="fa fa-globe"></i> Explore all data</h3>
    <p class="muted">Search, sort and export all plans and programs.</p>

    <h5 style="font-weight:800;"><i class="fa fa-table"></i> All Training Plans</h5>
    <div class="table-toolbar">
      <select id="plans-sort" class="toolbar-sort">
        <option value="0:number:desc">Sort ID (desc)</option>
        <option value="0:number:asc">Sort ID (asc)</option>
        <option value="2:text:asc">Sort Title (A-Z)</option>
        <option value="2:text:desc">Sort Title (Z-A)</option>
        <option value="6:number:desc">Sort Duration (high)</option>
        <option value="6:number:asc">Sort Duration (low)</option>
      </select>
      <button type="button" id="plans-export" class="toolbar-export"><i class="fa fa-file-pdf-o"></i> Export PDF</button>
      <input id="plans-search" class="toolbar-search" type="search" placeholder="Search training plans...">
    </div>
    <div class="table-wrap">
      <table id="plans-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>User</th>
            <th>Title</th>
            <th>Category</th>
            <th>Level</th>
            <th>Programs</th>
            <th>Duration</th>
            <th>Updated</th>
          </tr>
        </thead>
        <tbody>
          {% for pl in plans %}
            <tr>
              <td>#{{ pl.id }}</td>
              <td>{{ pl.user ? pl.user.email : '-' }}</td>
              <td>{{ pl.title }}</td>
              <td>{{ pl.category }}</td>
              <td>{{ pl.level }}</td>
              <td>{{ pl.exercises|length }}</td>
              <td>{{ pl.sessionDuration }} min</td>
              <td>{{ pl.updatedAt ? pl.updatedAt|date('Y-m-d H:i') : '-' }}</td>
            </tr>
          {% else %}
            <tr><td colspan="8" class="muted">No plans found.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <h5 style="font-weight:800;margin-top:1rem;"><i class="fa fa-table"></i> All Programs</h5>
    <div class="table-toolbar">
      <select id="programs-sort" class="toolbar-sort">
        <option value="0:number:desc">Sort ID (desc)</option>
        <option value="0:number:asc">Sort ID (asc)</option>
        <option value="2:text:asc">Sort Name (A-Z)</option>
        <option value="2:text:desc">Sort Name (Z-A)</option>
        <option value="7:number:desc">Sort Duration (high)</option>
        <option value="7:number:asc">Sort Duration (low)</option>
      </select>
      <button type="button" id="programs-export" class="toolbar-export"><i class="fa fa-file-pdf-o"></i> Export PDF</button>
      <input id="programs-search" class="toolbar-search" type="search" placeholder="Search programs...">
    </div>
    <div class="table-wrap">
      <table id="programs-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>User</th>
            <th>Name</th>
            <th>Muscle Group</th>
            <th>Difficulty</th>
            <th>Plans</th>
            <th>Sets/Reps</th>
            <th>Duration</th>
            <th>Updated</th>
          </tr>
        </thead>
        <tbody>
          {% for p in programs %}
            <tr>
              <td>#{{ p.id }}</td>
              <td>{{ p.user ? p.user.email : '-' }}</td>
              <td>{{ p.name }}</td>
              <td>{{ p.muscleGroup }}</td>
              <td>{{ p.difficulty }}</td>
              <td>{{ p.programs|length }}</td>
              <td>{{ p.sets ?: 0 }}/{{ p.repetitions ?: 0 }}</td>
              <td>{{ p.duration ?: 0 }} min</td>
              <td>{{ p.updatedAt ? p.updatedAt|date('Y-m-d H:i') : '-' }}</td>
            </tr>
          {% else %}
            <tr><td colspan="9" class="muted">No programs found.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <h5 style="font-weight:800;margin-top:1rem;"><i class="fa fa-table"></i> All Trends</h5>
    <div class="table-toolbar">
      <select id="trends-sort" class="toolbar-sort">
        <option value="0:number:desc">Sort ID (desc)</option>
        <option value="0:number:asc">Sort ID (asc)</option>
        <option value="1:text:asc">Sort Title (A-Z)</option>
        <option value="1:text:desc">Sort Title (Z-A)</option>
        <option value="2:text:asc">Sort Category (A-Z)</option>
        <option value="2:text:desc">Sort Category (Z-A)</option>
      </select>
      <button type="button" id="trends-export" class="toolbar-export"><i class="fa fa-file-pdf-o"></i> Export PDF</button>
      <input id="trends-search" class="toolbar-search" type="search" placeholder="Search trends...">
    </div>
    <div class="table-wrap">
      <table id="trends-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Category</th>
            <th>Active</th>
            <th>Image</th>
            <th>Updated</th>
          </tr>
        </thead>
        <tbody>
          {% for t in trends %}
            <tr>
              <td>#{{ t.id }}</td>
              <td>{{ t.title }}</td>
              <td>{{ t.category }}</td>
              <td>{{ t.isActive ? 'Yes' : 'No' }}</td>
              <td>
                {% if t.imageUrl %}
                  <img src="{{ t.imageUrl }}" alt="{{ t.title }}" style="width:52px;height:34px;object-fit:cover;border-radius:6px;">
                {% else %}
                  -
                {% endif %}
              </td>
              <td>{{ t.updatedAt ? t.updatedAt|date('Y-m-d H:i') : '-' }}</td>
            </tr>
          {% else %}
            <tr><td colspan="6" class="muted">No trends found.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.option-card');
    const panels = {
      create: document.getElementById('panel-create'),
      update: document.getElementById('panel-update'),
      delete: document.getElementById('panel-delete'),
      explore: document.getElementById('panel-explore')
    };

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        cards.forEach((c) => c.classList.remove('selected'));
        card.classList.add('selected');
        Object.values(panels).forEach((p) => p && p.classList.remove('active'));
        const key = card.getAttribute('data-action');
        if (panels[key]) panels[key].classList.add('active');
      });
    });
    const defaultCard = document.querySelector('.option-card[data-action="explore"]');
    if (defaultCard) defaultCard.click();

    document.querySelectorAll('.js-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.getAttribute('data-target'));
        if (!target) return;
        target.style.display = target.style.display === 'none' || target.style.display === '' ? 'block' : 'none';
      });
    });

    function loadJsPdf() {
      if (window.jspdf && window.jspdf.jsPDF) return Promise.resolve(window.jspdf.jsPDF);
      return new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-jspdf="1"]');
        if (existing) {
          existing.addEventListener('load', () => resolve(window.jspdf?.jsPDF));
          existing.addEventListener('error', reject);
          return;
        }
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js';
        s.async = true;
        s.setAttribute('data-jspdf', '1');
        s.onload = () => resolve(window.jspdf?.jsPDF);
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    function parseValue(raw, type) {
      if (type === 'number') {
        const m = String(raw).match(/-?\d+(\.\d+)?/);
        return m ? parseFloat(m[0]) : 0;
      }
      if (type === 'date') {
        return new Date(String(raw).replace(' ', 'T')).getTime() || 0;
      }
      return String(raw).toLowerCase();
    }

    function setupTableTools(cfg) {
      const table = document.getElementById(cfg.tableId);
      if (!table) return;
      const tbody = table.querySelector('tbody');
      const searchInput = document.getElementById(cfg.searchId);
      const sortSelect = document.getElementById(cfg.sortId);
      const exportBtn = document.getElementById(cfg.exportId);
      const baseRows = Array.from(tbody.querySelectorAll('tr'));

      function apply() {
        const q = (searchInput?.value || '').trim().toLowerCase();
        const [col, type, dir] = (sortSelect?.value || '0:number:desc').split(':');
        const visible = [...baseRows]
          .filter((row) => q === '' || row.textContent.toLowerCase().includes(q))
          .sort((a, b) => {
            const av = parseValue(a.cells[Number(col)]?.textContent || '', type);
            const bv = parseValue(b.cells[Number(col)]?.textContent || '', type);
            if (av === bv) return 0;
            return dir === 'asc' ? (av > bv ? 1 : -1) : (av < bv ? 1 : -1);
          });
        tbody.innerHTML = '';
        visible.forEach((row) => tbody.appendChild(row));
      }

      async function exportPdf() {
        const rows = Array.from(tbody.querySelectorAll('tr'));
        if (rows.length === 0) {
          alert('No rows to export.');
          return;
        }
        try {
          const JsPdfCtor = await loadJsPdf();
          const doc = new JsPdfCtor({ unit: 'pt', format: 'a4' });
          const margin = 40;
          let y = margin;
          const pageW = doc.internal.pageSize.getWidth();
          const pageH = doc.internal.pageSize.getHeight();
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(16);
          doc.text('Fitopia Admin - ' + cfg.title, margin, y);
          y += 16;
          doc.setFont('helvetica', 'normal');
          doc.setFontSize(10);
          doc.text('Generated on ' + new Date().toLocaleString(), margin, y);
          y += 14;
          rows.forEach((row) => {
            if (y > pageH - 40) {
              doc.addPage();
              y = margin;
            }
            const line = Array.from(row.cells).map((c) => c.textContent.trim()).join(' | ');
            const wrapped = doc.splitTextToSize(line, pageW - margin * 2);
            doc.text(wrapped, margin, y);
            y += Math.max(14, wrapped.length * 12);
          });
          doc.save(cfg.filename + '.pdf');
        } catch (e) {
          alert('Unable to export PDF right now.');
        }
      }

      searchInput?.addEventListener('input', apply);
      sortSelect?.addEventListener('change', apply);
      exportBtn?.addEventListener('click', exportPdf);
      apply();
    }

    setupTableTools({
      tableId: 'plans-table',
      searchId: 'plans-search',
      sortId: 'plans-sort',
      exportId: 'plans-export',
      title: 'Training Plans',
      filename: 'admin-training-plans'
    });
    setupTableTools({
      tableId: 'programs-table',
      searchId: 'programs-search',
      sortId: 'programs-sort',
      exportId: 'programs-export',
      title: 'Programs',
      filename: 'admin-programs'
    });
    setupTableTools({
      tableId: 'trends-table',
      searchId: 'trends-search',
      sortId: 'trends-sort',
      exportId: 'trends-export',
      title: 'Trends',
      filename: 'admin-trends'
    });
  });
</script>
{% endblock %}
