{% extends 'admin_base.html.twig' %}

{% block title %}Gestion des entrainements | Fitopia{% endblock %}

{% block stylesheets %}
<style>
  .training-hero { background: linear-gradient(135deg, #0b3a3d 0%, #0d5b50 55%, #0f7a5f 100%); color: #fff; border-radius: 18px; padding: 2rem 2.4rem; box-shadow: 0 18px 50px rgba(14, 30, 37, .18); position: relative; overflow: hidden; }
  .training-hero::after { content: ""; position: absolute; right: -50px; top: -50px; width: 170px; height: 170px; background: rgba(255, 255, 255, .08); border-radius: 50%; }
  .training-hero h2 { margin: 0 0 .45rem; font-weight: 800; }
  .training-hero p { margin: 0; opacity: .92; }
  .hero-chip-wrap { margin-top: 1rem; display: flex; gap: .65rem; flex-wrap: wrap; }
  .hero-chip { background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .22); border-radius: 999px; padding: .34rem .8rem; font-size: .82rem; font-weight: 700; }
  .training-panel { margin-top: 1.6rem; background: #fff; border-radius: 18px; padding: 1.5rem; border: 1px solid #e8eef4; box-shadow: 0 12px 30px rgba(14, 30, 37, .08); }
  .training-panel h3 { margin: 0 0 .35rem; font-weight: 800; color: #0b3a3d; }
  .training-panel p { margin: 0 0 1rem; color: #6b7280; }
  .form-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-bottom: .8rem; }
  .form-row.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .form-row.one { grid-template-columns: 1fr; }
  .form-control { border-radius: 10px; border: 1px solid #d6e0ea; }
  .form-control:focus { border-color: #0f7a5f; box-shadow: 0 0 0 3px rgba(15, 122, 95, .12); }
  label { font-weight: 700; color: #3a4b5c; font-size: .88rem; margin-bottom: .25rem; display: block; }
  .btn-primary { background: #0b3a3d; border-color: #0b3a3d; font-weight: 700; }
  .btn-primary:hover { background: #0f7a5f; border-color: #0f7a5f; }
  .btn-soft { display: inline-flex; align-items: center; gap: .4rem; padding: .48rem .78rem; border-radius: 10px; border: 1px solid #d5e1ea; background: #fff; color: #17324d; font-weight: 700; text-decoration: none; }
  .btn-soft:hover { background: #f5faf9; color: #0f7a5f; text-decoration: none; }
  .btn-danger-soft { display: inline-flex; align-items: center; gap: .4rem; padding: .48rem .78rem; border-radius: 10px; border: 1px solid #f2caca; background: #fff5f5; color: #b42318; font-weight: 700; }
  .btn-danger-soft:hover { background: #ffeaea; }
  .success-toast { background: #e6fffa; color: #0b3a3d; border: 1px solid #b7f3ea; border-radius: 12px; padding: .85rem 1rem; margin: 1rem 0; }
  .error-toast { background: #fff1f1; color: #a11b1b; border: 1px solid #f7c9c9; border-radius: 12px; padding: .85rem 1rem; margin: 1rem 0; }
  .group-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
  .group-card { border: 1px solid #e5edf5; border-radius: 14px; background: #fff; overflow: hidden; }
  .group-head { padding: .95rem 1rem; background: #f4f8fb; color: #17324d; font-weight: 800; display: flex; justify-content: space-between; gap: .75rem; }
  .exercise-item { padding: .85rem 1rem; border-top: 1px solid #eef2f6; }
  .exercise-row-head { display: flex; justify-content: space-between; align-items: center; gap: .75rem; }
  .exercise-title { font-weight: 800; color: #16324f; }
  .exercise-meta { margin-top: .2rem; color: #617181; font-size: .9rem; display: flex; gap: .65rem; flex-wrap: wrap; }
  .exercise-actions { display: flex; gap: .5rem; align-items: center; }
  .exercise-actions form { margin: 0; }
  .muted-empty { color: #6b7280; padding: 1rem; }
  @media (max-width: 991px) {
    .form-row, .form-row.two { grid-template-columns: 1fr; }
    .group-list { grid-template-columns: 1fr; }
    .exercise-row-head { align-items: flex-start; flex-direction: column; }
  }
</style>
{% endblock %}

{% block body %}
  {% set muscleGroups = ['Poitrine', 'Dos', 'Jambes', 'Fessier', 'Epaules', 'Biceps', 'Triceps', 'Avant-bras', 'Abdos'] %}

  <div class="training-hero">
    <h2>Ajout des exercices</h2>
    <p>Cette page back est maintenant dediee a l'ajout des exercices dans <code>fitness_exercise</code>.</p>
    <div class="hero-chip-wrap">
      <span class="hero-chip">{{ programs|length }} exercices</span>
      <span class="hero-chip">{{ users|length }} utilisateurs</span>
    </div>
  </div>

  {% for message in app.flashes('success') %}
    <div class="success-toast">{{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('error') %}
    <div class="error-toast">{{ message }}</div>
  {% endfor %}

  <div class="training-panel">
    <h3>{{ exerciseInEdit ? 'Modifier un exercice' : 'Ajouter un exercice' }}</h3>
    <p>Chaque exercice sera enregistre dans la base et rattache a son groupe musculaire.</p>

    <form method="post" action="{{ exerciseInEdit ? path('admin_trainings_program_update', {'id': exerciseInEdit.id}) : path('admin_trainings_program_add') }}" enctype="multipart/form-data">
      <input type="hidden" name="_token" value="{{ exerciseInEdit ? csrf_token('admin_trainings_program_update_' ~ exerciseInEdit.id) : csrf_token('admin_trainings_program_add') }}">

      <div class="form-row">
        <div>
          <label>Nom de l'exercice</label>
          <input class="form-control" name="name" value="{{ exerciseInEdit ? exerciseInEdit.name : '' }}" required>
        </div>
        <div>
          <label>Groupe musculaire</label>
          <select class="form-control" name="muscle_group" required>
            <option value="">-- Select --</option>
            {% for group in muscleGroups %}
              <option value="{{ group }}" {{ exerciseInEdit and (exerciseInEdit.muscleGroup == group or (group == 'Epaules' and exerciseInEdit.muscleGroup == 'Ã‰paules')) ? 'selected' : '' }}>{{ group }}</option>
            {% endfor %}
          </select>
        </div>
        <div>
          <label>Difficulte</label>
          <select class="form-control" name="difficulty" required>
            <option value="">-- Select --</option>
            <option value="Beginner" {{ exerciseInEdit and exerciseInEdit.difficulty == 'Beginner' ? 'selected' : '' }}>Beginner</option>
            <option value="Intermediate" {{ exerciseInEdit and exerciseInEdit.difficulty == 'Intermediate' ? 'selected' : '' }}>Intermediate</option>
            <option value="Advanced" {{ exerciseInEdit and exerciseInEdit.difficulty == 'Advanced' ? 'selected' : '' }}>Advanced</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div>
          <label>Sets</label>
          <input class="form-control" name="sets" type="number" min="0" value="{{ exerciseInEdit ? exerciseInEdit.sets : 0 }}">
        </div>
        <div>
          <label>Repetitions</label>
          <input class="form-control" name="repetitions" type="number" min="0" value="{{ exerciseInEdit ? exerciseInEdit.repetitions : 0 }}">
        </div>
        <div>
          <label>Lieu</label>
          <select class="form-control" name="place">
            <option value="both" {{ not exerciseInEdit or exerciseInEdit.place == 'both' ? 'selected' : '' }}>Les deux</option>
            <option value="gym" {{ exerciseInEdit and exerciseInEdit.place == 'gym' ? 'selected' : '' }}>Salle de sport</option>
            <option value="home" {{ exerciseInEdit and exerciseInEdit.place == 'home' ? 'selected' : '' }}>Maison</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div>
          <label>Duree (min)</label>
          <input class="form-control" name="duration" type="number" min="0" value="{{ exerciseInEdit ? exerciseInEdit.duration : 0 }}">
        </div>
        <div>
          <label>Image</label>
          <input class="form-control" name="image_file" type="file" accept="image/*">
        </div>
        <div>
          <label>Video</label>
          <input class="form-control" name="video_file" type="file" accept="video/mp4,video/webm,video/ogg,video/quicktime,video/x-msvideo">
        </div>
      </div>

      <div class="form-row one">
        <div>
          <label>Description</label>
          <textarea class="form-control" name="description" rows="3">{{ exerciseInEdit ? exerciseInEdit.description : '' }}</textarea>
        </div>
      </div>

      <div class="exercise-actions">
        <button class="btn btn-primary" type="submit"><i class="fa fa-check"></i> {{ exerciseInEdit ? 'Enregistrer les modifications' : 'Ajouter l\'exercice' }}</button>
        {% if exerciseInEdit %}
          <a class="btn-soft" href="{{ path('admin_trainings') }}"><i class="fa fa-times"></i> Annuler</a>
        {% endif %}
      </div>
    </form>
  </div>

  <div class="training-panel">
    <h3>Exercices existants</h3>
    <p>Affichage par groupe musculaire pour verifier rapidement ou chaque exercice apparait.</p>

    <div class="group-list">
      {% for group in muscleGroups %}
        {% set items = programs|filter(p => p.muscleGroup == group or (group == 'Epaules' and p.muscleGroup == 'Épaules')) %}
        <div class="group-card">
          <div class="group-head">
            <span>{{ group }}</span>
            <span>{{ items|length }}</span>
          </div>
          {% for ex in items %}
            <div class="exercise-item">
              <div class="exercise-row-head">
                <div class="exercise-title">{{ ex.name }}</div>
                <div class="exercise-actions">
                  <a class="btn-soft" href="{{ path('admin_trainings', {'edit': ex.id}) }}"><i class="fa fa-pencil"></i> Modifier</a>
                  <form method="post" action="{{ path('admin_trainings_program_delete', {'id': ex.id}) }}" onsubmit="return confirm('Supprimer cet exercice ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_trainings_program_delete_' ~ ex.id) }}">
                    <button class="btn-danger-soft" type="submit"><i class="fa fa-trash"></i> Supprimer</button>
                  </form>
                </div>
              </div>
              <div class="exercise-meta">
                <span>{{ ex.difficulty }}</span>
                <span>
                  {% if ex.place == 'gym' %}
                    Salle
                  {% elseif ex.place == 'home' %}
                    Maison
                  {% else %}
                    Salle / Maison
                  {% endif %}
                </span>
                {% if ex.sets %}<span>{{ ex.sets }} sets</span>{% endif %}
                {% if ex.repetitions %}<span>{{ ex.repetitions }} reps</span>{% endif %}
                {% if ex.duration %}<span>{{ ex.duration }} min</span>{% endif %}
              </div>
            </div>
          {% else %}
            <div class="muted-empty">Aucun exercice.</div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endblock %}
