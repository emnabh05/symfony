{% extends 'admin/layout.html.twig' %}

{% block title %}Add Payment | Fitopia Admin{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/admin-forms.css') }}">
{% endblock %}

{% block body %}
  <div class="admin-shell-inner">
    <div class="page-header">
      <a href="{{ path('admin_stocks') }}" class="back-btn">
        <i class="fa fa-arrow-left"></i>
      </a>
      <div>
        <h1 class="page-title">Add Payment</h1>
        <p class="page-subtitle">Create a payment record (order).</p>
      </div>
    </div>

    {% for message in app.flashes('success') %}
      <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="form-container">
      <form method="post" action="{{ path('admin_stocks_payment_add') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_stocks_payment_add') }}">

        <div class="form-row">
          <div class="form-group">
            <label>Order Reference</label>
            <input class="form-control" value="Auto-generated from the shared order ID" readonly>
          </div>
          <div class="form-group">
            <label>Status *</label>
            <select class="form-control" name="status" required>
              <option value="pending">Pending</option>
              <option value="processing">In Progress</option>
              <option value="on_way">On the Way</option>
              <option value="delivered">Delivered</option>
              <option value="canceled">Canceled</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>First Name *</label>
            <input class="form-control" name="first_name" required>
          </div>
          <div class="form-group">
            <label>Last Name *</label>
            <input class="form-control" name="last_name" required>
          </div>
        </div>

        <div class="form-row three">
          <div class="form-group">
            <label>Email *</label>
            <input class="form-control" name="email" type="email" required>
          </div>
          <div class="form-group">
            <label>Phone *</label>
            <input class="form-control" name="phone" required>
          </div>
          <div class="form-group">
            <label>Payment Method *</label>
            <input class="form-control" name="payment_method" required>
          </div>
        </div>

        <div class="form-row three">
          <div class="form-group">
            <label>Address *</label>
            <input class="form-control" name="address" required>
          </div>
          <div class="form-group">
            <label>City *</label>
            <input class="form-control" name="city" required>
          </div>
          <div class="form-group">
            <label>Postal Code *</label>
            <input class="form-control" name="postal_code" required>
          </div>
        </div>

        <div class="form-row three">
          <div class="form-group">
            <label>Subtotal *</label>
            <input class="form-control" name="subtotal" type="number" step="0.01" min="0" required>
          </div>
          <div class="form-group">
            <label>Shipping *</label>
            <input class="form-control" name="shipping" type="number" step="0.01" min="0" required>
          </div>
          <div class="form-group">
            <label>Discount</label>
            <input class="form-control" name="discount" type="number" step="0.01" min="0" value="0">
          </div>
        </div>

        <div class="form-row three">
          <div class="form-group">
            <label>Total *</label>
            <input class="form-control" name="total" type="number" step="0.01" min="0" required>
          </div>
          <div class="form-group">
            <label>Discount Code</label>
            <input class="form-control" name="discount_code">
          </div>
          <div class="form-group">
            <label>Notes</label>
            <input class="form-control" name="notes">
          </div>
        </div>

        <div class="form-actions">
          <a href="{{ path('admin_stocks') }}" class="btn btn-secondary">
            <i class="fa fa-times"></i> Cancel
          </a>
          <button type="submit" class="btn btn-primary">
            <i class="fa fa-save"></i> Save Payment
          </button>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
