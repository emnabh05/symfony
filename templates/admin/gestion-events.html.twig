{% extends 'admin_base.html.twig' %}

{% block title %}Gestion Evenements | Fitopia Admin{% endblock %}

{% block stylesheets %}
<style>
  .events-shell { padding: 22px; }
  .hero-events {
    background: linear-gradient(135deg, #0b3a3d 0%, #0d5b50 100%);
    color: #fff;
    border-radius: 24px;
    padding: 26px;
    box-shadow: 0 18px 38px rgba(11, 58, 61, 0.2);
    margin-bottom: 22px;
  }
  .hero-events h1 { margin: 0 0 8px; font-size: 1.85rem; font-weight: 800; }
  .hero-events p { margin: 0; opacity: 0.92; max-width: 780px; }
  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  .hero-link,
  .panel-tab {
    border: none;
    border-radius: 999px;
    padding: 10px 16px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
  }
  .hero-link {
    background: rgba(255,255,255,0.14);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.18);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 22px;
  }
  .stat-card {
    background: #fff;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
    border: 1px solid #edf1f5;
  }
  .stat-label {
    color: #627085;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 10px;
  }
  .stat-value {
    color: #12343b;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
  }
  .workspace-card {
    background: #fff;
    border-radius: 22px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
    border: 1px solid #e9eef5;
    overflow: hidden;
  }
  .workspace-header {
    padding: 22px 24px 14px;
    border-bottom: 1px solid #edf2f7;
  }
  .workspace-header h2 {
    margin: 0 0 12px;
    color: #17363d;
    font-size: 1.35rem;
    font-weight: 800;
  }
  .panel-tabs {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .panel-tab {
    background: #eef4f6;
    color: #33545a;
  }
  .panel-tab.active {
    background: #0f7a5f;
    color: #fff;
  }
  .panel-body { padding: 22px 24px 26px; }
  .panel-view { display: none; }
  .panel-view.active { display: block; }
  .toolbar,
  .toolbar-form {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 18px;
  }
  .toolbar-form .field,
  .toolbar .field {
    min-width: 170px;
    flex: 1 1 170px;
  }
  .toolbar-form .field-wide { flex: 2 1 260px; }
  .premium-input,
  .premium-select,
  .premium-textarea {
    width: 100%;
    border-radius: 14px;
    border: 1px solid #d7e1ea;
    padding: 11px 14px;
    background: #fff;
  }
  .premium-textarea { min-height: 130px; resize: vertical; }
  .premium-input:focus,
  .premium-select:focus,
  .premium-textarea:focus {
    outline: none;
    border-color: #0f7a5f;
    box-shadow: 0 0 0 4px rgba(15, 122, 95, 0.12);
  }
  .chip-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .chip {
    background: #f1f8f5;
    color: #18634f;
    border: 1px solid #cae8dc;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: 0.83rem;
    font-weight: 700;
  }
  .table-wrap { overflow-x: auto; }
  .premium-table {
    width: 100%;
    min-width: 860px;
    border-collapse: collapse;
  }
  .premium-table th,
  .premium-table td {
    padding: 14px 12px;
    border-bottom: 1px solid #edf2f7;
    text-align: left;
    vertical-align: top;
  }
  .premium-table th {
    color: #708092;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .row-title { font-weight: 800; color: #18363d; }
  .row-subtitle { color: #718096; font-size: 0.84rem; margin-top: 4px; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    padding: 5px 10px;
    font-size: 0.76rem;
    font-weight: 800;
    margin: 3px 6px 0 0;
  }
  .badge-open { background: #dcfce7; color: #166534; }
  .badge-full { background: #fee2e2; color: #991b1b; }
  .badge-premium { background: #fff7d6; color: #a16207; }
  .badge-confirmed { background: #dcfce7; color: #166534; }
  .badge-used { background: #dbeafe; color: #1d4ed8; }
  .badge-cancelled { background: #fee2e2; color: #991b1b; }
  .badge-vip { background: #e0f2fe; color: #075985; }
  .badge-standard { background: #f3f4f6; color: #4b5563; }
  .action-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .btn-main,
  .btn-secondary,
  .btn-danger,
  .btn-ghost {
    border: none;
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-main { background: #0f7a5f; color: #fff; }
  .btn-secondary { background: #ebf3ff; color: #1d4ed8; }
  .btn-danger { background: #fee2e2; color: #b91c1c; }
  .btn-ghost { background: #f3f4f6; color: #374151; }
  .form-card {
    background: #f9fbfc;
    border: 1px solid #e7edf4;
    border-radius: 18px;
    padding: 18px;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .form-grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .form-field label {
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
    color: #223e45;
  }
  .form-field.full { grid-column: 1 / -1; }
  .text-muted-small { color: #6b7280; font-size: 0.84rem; }
  @media (max-width: 900px) {
    .form-grid,
    .form-grid.three { grid-template-columns: 1fr; }
  }
</style>
{% endblock %}

{% block body %}
<div class="events-shell">
  <section class="hero-events">
    <h1>Gestion des evenements</h1>
    <p>Back-office unifie comme dans votre projet Java: pilotage des evenements, participants, fidelite client, waitlist et acces rapide au check-in.</p>
    <div class="hero-actions">
      <a class="hero-link" href="{{ path('admin_checkin_index') }}"><i class="fa fa-qrcode"></i> Check-in reservations</a>
      <a class="hero-link" href="{{ path('admin_waitlist') }}"><i class="fa fa-list"></i> Waitlist detaillee</a>
      <a class="hero-link" href="{{ path('admin_loyalty') }}"><i class="fa fa-diamond"></i> Fidelite detaillee</a>
    </div>
  </section>

  <div class="stats-grid">
    <article class="stat-card">
      <div class="stat-label">Evenements</div>
      <div class="stat-value">{{ totalEvents }}</div>
    </article>
    <article class="stat-card">
      <div class="stat-label">Participants</div>
      <div class="stat-value">{{ participantsList|length }}</div>
    </article>
    <article class="stat-card">
      <div class="stat-label">Clients VIP</div>
      <div class="stat-value">{{ totalVip }}</div>
    </article>
    <article class="stat-card">
      <div class="stat-label">Waitlist en attente</div>
      <div class="stat-value">{{ totalPendingWaitlist }}</div>
    </article>
    <article class="stat-card">
      <div class="stat-label">Events premium</div>
      <div class="stat-value">{{ events|filter(e => e.isPremium)|length }}</div>
    </article>
  </div>

  {% for message in app.flashes('success') %}
    <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('error') %}
    <div class="alert alert-danger"><i class="fa fa-times-circle"></i> {{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('info') %}
    <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ message }}</div>
  {% endfor %}

  <section class="workspace-card">
    <div class="workspace-header">
      <h2>Workspace admin events</h2>
      <div class="panel-tabs">
        <button type="button" class="panel-tab" data-panel="explore" onclick="switchPanel('explore')">Explorer</button>
        <button type="button" class="panel-tab" data-panel="participants" onclick="switchPanel('participants')">Participants</button>
        <button type="button" class="panel-tab" data-panel="loyalty" onclick="switchPanel('loyalty')">Fidelite</button>
        <button type="button" class="panel-tab" data-panel="waitlist" onclick="switchPanel('waitlist')">Waitlist</button>
        <button type="button" class="panel-tab" data-panel="create" onclick="switchPanel('create')">Nouveau</button>
      </div>
    </div>

    <div class="panel-body">
      <section id="panel-explore" class="panel-view">
        <div class="toolbar">
          <div class="field field-wide">
            <input type="text" id="eventSearch" class="premium-input" placeholder="Rechercher un evenement par titre, type ou lieu">
          </div>
          <div class="field">
            <select id="premiumFilter" class="premium-select">
              <option value="all">Tous les types</option>
              <option value="premium" {{ premiumFilter == 'premium' ? 'selected' : '' }}>Premium</option>
              <option value="standard" {{ premiumFilter == 'standard' ? 'selected' : '' }}>Standard</option>
            </select>
          </div>
        </div>

        <div class="table-wrap">
          <table class="premium-table" id="eventsTable">
            <thead>
              <tr>
                <th>ID</th>
                <th>Evenement</th>
                <th>Date</th>
                <th>Capacite</th>
                <th>Waitlist</th>
                <th>Statut</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for event in events %}
                {% set stats = eventStats[event.id]|default({'activeReservations': 0, 'remainingPlaces': event.capacite, 'isFull': false}) %}
                {% set eventWaitlistCounts = waitlistCountsByEvent[event.id]|default({}) %}
                {% set pendingForEvent = eventWaitlistCounts['EN_ATTENTE']|default(0) %}
                {% set invitedForEvent = eventWaitlistCounts['INVITE']|default(0) %}
                <tr class="event-row"
                    data-premium="{{ event.isPremium ? 'premium' : 'standard' }}"
                    data-event-id="{{ event.id }}"
                    data-event-json="{{ {
                      id: event.id,
                      titre: event.titre,
                      typeEvent: event.typeEvent,
                      lieu: event.lieu,
                      capacite: event.capacite,
                      prixEvent: event.prixEvent,
                      description: event.description,
                      isPremium: event.isPremium,
                      dateEvent: event.dateEvent|date('Y-m-d')
                    }|json_encode|e('html_attr') }}"
                    data-update-token="{{ csrf_token('admin_events_update_' ~ event.id) }}">
                  <td>#{{ event.id }}</td>
                  <td>
                    <div class="row-title">{{ event.titre }}</div>
                    <div class="row-subtitle">{{ event.typeEvent }} · {{ event.lieu }}</div>
                  </td>
                  <td>{{ event.dateEvent|date('d/m/Y') }}</td>
                  <td>
                    <div class="row-title">{{ stats.activeReservations }}/{{ event.capacite }}</div>
                    <div class="row-subtitle">{{ stats.remainingPlaces }} place(s) restante(s)</div>
                  </td>
                  <td>
                    <span class="badge badge-standard">En attente {{ pendingForEvent }}</span>
                    <span class="badge badge-standard">Invite {{ invitedForEvent }}</span>
                  </td>
                  <td>
                    {% if event.isPremium %}<span class="badge badge-premium"><i class="fa fa-star"></i> Premium</span>{% endif %}
                    {% if stats.isFull %}
                      <span class="badge badge-full">Complet</span>
                    {% else %}
                      <span class="badge badge-open">Ouvert</span>
                    {% endif %}
                  </td>
                  <td>
                    <div class="action-row">
                      <button type="button" class="btn-secondary" onclick="editEvent(this)"><i class="fa fa-pencil"></i> Modifier</button>
                      <button type="button" class="btn-ghost" onclick="openWaitlistPanel({{ event.id }})"><i class="fa fa-list"></i> Waitlist</button>
                      <form method="post" action="{{ path('admin_events_delete', {id: event.id}) }}" onsubmit="return confirm('Supprimer cet evenement ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_events_delete_' ~ event.id) }}">
                        <button class="btn-danger" type="submit"><i class="fa fa-trash"></i> Supprimer</button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="7" class="text-muted-small">Aucun evenement disponible.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section id="panel-participants" class="panel-view">
        <form method="get" action="{{ path('admin_events') }}" class="toolbar-form">
          <input type="hidden" name="panel" value="participants">
          <div class="field field-wide">
            <input class="premium-input" type="text" name="participant_search" value="{{ participantSearch }}" placeholder="Rechercher par nom participant">
          </div>
          <div class="field">
            <input class="premium-input" type="text" name="participant_email" value="{{ participantEmailFilter }}" placeholder="Filtrer par email">
          </div>
          <div class="field">
            <select class="premium-select" name="participant_event">
              <option value="0">Tous les evenements</option>
              {% for eventId, eventTitle in participantEventOptions %}
                <option value="{{ eventId }}" {{ participantEventFilter == eventId ? 'selected' : '' }}>{{ eventTitle }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="field">
            <select class="premium-select" name="participant_status">
              <option value="all" {{ participantStatusFilter == 'all' ? 'selected' : '' }}>Tous statuts</option>
              <option value="confirmee" {{ participantStatusFilter == 'confirmee' ? 'selected' : '' }}>Confirmee</option>
              <option value="en_attente_paiement" {{ participantStatusFilter == 'en_attente_paiement' ? 'selected' : '' }}>En attente paiement</option>
              <option value="payee" {{ participantStatusFilter == 'payee' ? 'selected' : '' }}>Payee</option>
              <option value="utilisee" {{ participantStatusFilter == 'utilisee' ? 'selected' : '' }}>Utilisee</option>
              <option value="annulee" {{ participantStatusFilter == 'annulee' ? 'selected' : '' }}>Annulee</option>
            </select>
          </div>
          <div class="field">
            <select class="premium-select" name="participant_sort">
              <option value="recent" {{ participantSort == 'recent' ? 'selected' : '' }}>Plus recents</option>
              <option value="oldest" {{ participantSort == 'oldest' ? 'selected' : '' }}>Plus anciens</option>
            </select>
          </div>
          <button class="btn-main" type="submit"><i class="fa fa-filter"></i> Filtrer</button>
        </form>

        <div class="chip-row">
          <span class="chip">Total {{ participantsList|length }}</span>
          <span class="chip">Confirmee {{ participantStatusStats['Confirmee']|default(0) }}</span>
          <span class="chip">En attente {{ participantStatusStats['EN_ATTENTE_PAIEMENT']|default(0) }}</span>
          <span class="chip">Payee {{ participantStatusStats['Payee']|default(0) }}</span>
          <span class="chip">Utilisee {{ participantStatusStats['Utilisee']|default(0) }}</span>
          <span class="chip">Annulee {{ participantStatusStats['Annulee']|default(0) }}</span>
        </div>

        <div class="table-wrap">
          <table class="premium-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Participant</th>
                <th>Telephone</th>
                <th>Evenement</th>
                <th>Date inscription</th>
                <th>Statut</th>
              </tr>
            </thead>
            <tbody>
              {% for participant in participantsList %}
                <tr>
                  <td>#{{ participant.id }}</td>
                  <td>
                    <div class="row-title">{{ participant.nom }}</div>
                    <div class="row-subtitle">{{ participant.email }}</div>
                  </td>
                  <td>{{ participant.phone|default('-') }}</td>
                  <td>{{ participant.eventTitle }}</td>
                  <td>{{ participant.dateInscription ? participant.dateInscription|date('Y-m-d H:i') : '-' }}</td>
                  <td>
                    {% if participant.statusSlug == 'utilisee' %}
                      <span class="badge badge-used">Utilisee</span>
                    {% elseif participant.statusSlug == 'annulee' %}
                      <span class="badge badge-cancelled">Annulee</span>
                    {% elseif participant.statusSlug == 'en_attente_paiement' %}
                      <span class="badge badge-premium">En attente paiement</span>
                    {% elseif participant.statusSlug == 'payee' %}
                      <span class="badge badge-open">Payee</span>
                    {% else %}
                      <span class="badge badge-confirmed">Confirmee</span>
                    {% endif %}
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="6" class="text-muted-small">Aucun participant trouve.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section id="panel-loyalty" class="panel-view">
        <form method="get" action="{{ path('admin_events') }}" class="toolbar-form">
          <input type="hidden" name="panel" value="loyalty">
          <div class="field field-wide">
            <input class="premium-input" type="text" name="loyalty_search" value="{{ loyaltySearch }}" placeholder="Rechercher par nom ou email">
          </div>
          <div class="field">
            <select class="premium-select" name="loyalty_sort">
              <option value="count_desc" {{ loyaltySort == 'count_desc' ? 'selected' : '' }}>Reservations decroissantes</option>
              <option value="count_asc" {{ loyaltySort == 'count_asc' ? 'selected' : '' }}>Reservations croissantes</option>
              <option value="total_desc" {{ loyaltySort == 'total_desc' ? 'selected' : '' }}>Depense decroissante</option>
              <option value="total_asc" {{ loyaltySort == 'total_asc' ? 'selected' : '' }}>Depense croissante</option>
              <option value="date_desc" {{ loyaltySort == 'date_desc' ? 'selected' : '' }}>Dernier achat recent</option>
            </select>
          </div>
          <button class="btn-main" type="submit"><i class="fa fa-search"></i> Rechercher</button>
        </form>

        <div class="chip-row">
          <span class="chip">Clients analyses {{ loyaltyClients|length }}</span>
          <span class="chip">VIP {{ totalVip }}</span>
          <span class="chip">Seuil VIP {{ vipThreshold }} reservations</span>
        </div>

        <div class="table-wrap">
          <table class="premium-table">
            <thead>
              <tr>
                <th>Client</th>
                <th>Reservations</th>
                <th>Total depense</th>
                <th>Dernier achat</th>
                <th>Tier</th>
                <th>Score</th>
                <th>Acces</th>
              </tr>
            </thead>
            <tbody>
              {% for client in loyaltyClients %}
                <tr>
                  <td>
                    <div class="row-title">{{ client.name ?: 'Client Fitopia' }}</div>
                    <div class="row-subtitle">{{ client.email }}</div>
                  </td>
                  <td>{{ client.confirmedCount }}</td>
                  <td>{{ client.totalAmount|number_format(2, '.', ' ') }} DT</td>
                  <td>{{ client.lastReservationDate ? client.lastReservationDate|date('Y-m-d H:i') : '-' }}</td>
                  <td>{{ client.tier }}</td>
                  <td>{{ client.score }}</td>
                  <td>
                    {% if client.vipAccess %}
                      <span class="badge badge-vip">VIP</span>
                    {% else %}
                      <span class="badge badge-standard">Standard</span>
                    {% endif %}
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="7" class="text-muted-small">Aucun profil fidelite trouve.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section id="panel-waitlist" class="panel-view">
        <form id="waitlistFilterForm" method="get" action="{{ path('admin_events') }}" class="toolbar-form">
          <input type="hidden" name="panel" value="waitlist">
          <div class="field field-wide">
            <select id="waitlistEventSelect" class="premium-select" name="waitlist_event" onchange="this.form.submit()">
              {% if events is empty %}
                <option value="0">Aucun evenement</option>
              {% else %}
                {% for event in events %}
                  <option value="{{ event.id }}" {{ selectedWaitlistEvent and event.id == selectedWaitlistEvent.id ? 'selected' : '' }}>
                    #{{ event.id }} - {{ event.titre }} ({{ event.dateEvent|date('Y-m-d') }})
                  </option>
                {% endfor %}
              {% endif %}
            </select>
          </div>
          <button class="btn-ghost" type="submit"><i class="fa fa-refresh"></i> Recharger</button>
        </form>

        {% if selectedWaitlistEvent %}
          <div class="chip-row">
            <span class="chip">Places restantes {{ remainingPlaces }}</span>
            <span class="chip">En attente {{ pendingCount }}</span>
            <span class="chip">Invites actives {{ inviteCount }}</span>
          </div>

          <div class="action-row" style="margin-bottom:16px;">
            <form method="post" action="{{ path('admin_events_waitlist_invite_next', {id: selectedWaitlistEvent.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('admin_events_waitlist_invite_' ~ selectedWaitlistEvent.id) }}">
              <input type="hidden" name="_redirect" value="events">
              <button class="btn-main" type="submit"><i class="fa fa-envelope"></i> Inviter le prochain</button>
            </form>
            <form method="post" action="{{ path('admin_events_waitlist_expire', {id: selectedWaitlistEvent.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('admin_events_waitlist_expire_' ~ selectedWaitlistEvent.id) }}">
              <input type="hidden" name="_redirect" value="events">
              <button class="btn-ghost" type="submit"><i class="fa fa-clock-o"></i> Nettoyer expires</button>
            </form>
          </div>

          <div class="table-wrap" style="margin-bottom:22px;">
            <table class="premium-table">
              <thead>
                <tr>
                  <th>Position</th>
                  <th>Participant</th>
                  <th>Statut</th>
                  <th>Created</th>
                  <th>Invite</th>
                  <th>Expiration</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                {% for entry in waitlistEntries %}
                  <tr>
                    <td>{{ entry.position }}</td>
                    <td>
                      <div class="row-title">{{ entry.nom }}</div>
                      <div class="row-subtitle">{{ entry.email }}</div>
                    </td>
                    <td>{{ entry.status }}</td>
                    <td>{{ entry.createdAt ? entry.createdAt|date('Y-m-d H:i') : '-' }}</td>
                    <td>{{ entry.invitedAt ? entry.invitedAt|date('Y-m-d H:i') : '-' }}</td>
                    <td>{{ entry.expiresAt ? entry.expiresAt|date('Y-m-d H:i') : '-' }}</td>
                    <td>
                      {% if entry.status in ['EN_ATTENTE', 'INVITE'] %}
                        <form method="post" action="{{ path('admin_events_waitlist_cancel', {id: entry.id}) }}">
                          <input type="hidden" name="_token" value="{{ csrf_token('admin_events_waitlist_cancel_' ~ entry.id) }}">
                          <input type="hidden" name="_redirect" value="events">
                          <button class="btn-danger" type="submit"><i class="fa fa-ban"></i> Annuler</button>
                        </form>
                      {% else %}
                        <span class="text-muted-small">Aucune action</span>
                      {% endif %}
                    </td>
                  </tr>
                {% else %}
                  <tr>
                    <td colspan="7" class="text-muted-small">Aucune entree waitlist pour cet evenement.</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <p class="text-muted-small">Aucun evenement disponible pour la waitlist.</p>
        {% endif %}

        <h3 style="margin:0 0 14px; color:#17363d; font-size:1.1rem; font-weight:800;">Dernieres promotions confirmees</h3>
        <div class="table-wrap">
          <table class="premium-table">
            <thead>
              <tr>
                <th>Participant</th>
                <th>Evenement</th>
                <th>Date</th>
                <th>Statut final</th>
              </tr>
            </thead>
            <tbody>
              {% for promotion in latestPromotions %}
                <tr>
                  <td>
                    <div class="row-title">{{ promotion.nom }}</div>
                    <div class="row-subtitle">{{ promotion.email }}</div>
                  </td>
                  <td>{{ promotion.event ? promotion.event.titre : 'N/A' }}</td>
                  <td>{{ promotion.invitedAt ? promotion.invitedAt|date('Y-m-d H:i') : (promotion.createdAt ? promotion.createdAt|date('Y-m-d H:i') : '-') }}</td>
                  <td>{{ promotion.status }}</td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="4" class="text-muted-small">Aucune promotion waitlist confirmee.</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section id="panel-create" class="panel-view">
        <div class="form-card">
          <form action="{{ path('admin_events_add') }}" method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_events_add') }}">
            <div class="form-grid">
              <div class="form-field">
                <label>Titre</label>
                <input class="premium-input" type="text" name="titre" required>
              </div>
              <div class="form-field">
                <label>Type</label>
                <input class="premium-input" type="text" name="type_event" required>
              </div>
              <div class="form-field">
                <label>Date</label>
                <input class="premium-input" type="date" name="date_event" required>
              </div>
              <div class="form-field">
                <label>Lieu</label>
                <input class="premium-input" type="text" name="lieu" required>
              </div>
            </div>
            <div class="form-grid three" style="margin-top:16px;">
              <div class="form-field">
                <label>Capacite</label>
                <input class="premium-input" type="number" name="capacite" min="1" required>
              </div>
              <div class="form-field">
                <label>Prix (DT)</label>
                <input class="premium-input" type="number" name="prix_event" step="0.01" value="0.00">
              </div>
              <div class="form-field">
                <label>Premium</label>
                <select class="premium-select" name="is_premium">
                  <option value="0">Standard</option>
                  <option value="1">Premium</option>
                </select>
              </div>
            </div>
            <div class="form-grid" style="margin-top:16px;">
              <div class="form-field full">
                <label>Description</label>
                <textarea class="premium-textarea" name="description" required></textarea>
              </div>
              <div class="form-field full">
                <label>Image</label>
                <input class="premium-input" type="file" name="image_file">
              </div>
            </div>
            <div class="action-row" style="margin-top:18px;">
              <button class="btn-main" type="submit"><i class="fa fa-plus-circle"></i> Creer l evenement</button>
            </div>
          </form>
        </div>
      </section>

      <section id="panel-update" class="panel-view">
        <div class="form-card">
          <form id="updateForm" method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" id="updateToken">
            <div class="form-grid">
              <div class="form-field">
                <label>Titre</label>
                <input class="premium-input" type="text" name="titre" id="editTitre" required>
              </div>
              <div class="form-field">
                <label>Type</label>
                <input class="premium-input" type="text" name="type_event" id="editType" required>
              </div>
              <div class="form-field">
                <label>Date</label>
                <input class="premium-input" type="date" name="date_event" id="editDate" required>
              </div>
              <div class="form-field">
                <label>Lieu</label>
                <input class="premium-input" type="text" name="lieu" id="editLieu" required>
              </div>
            </div>
            <div class="form-grid three" style="margin-top:16px;">
              <div class="form-field">
                <label>Capacite</label>
                <input class="premium-input" type="number" name="capacite" id="editCapacite" min="1" required>
              </div>
              <div class="form-field">
                <label>Prix (DT)</label>
                <input class="premium-input" type="number" name="prix_event" id="editPrix" step="0.01">
              </div>
              <div class="form-field">
                <label>Premium</label>
                <select class="premium-select" id="editPremiumSelect">
                  <option value="0">Standard</option>
                  <option value="1">Premium</option>
                </select>
                <input type="hidden" name="is_premium" id="editPremium" value="0">
              </div>
            </div>
            <div class="form-grid" style="margin-top:16px;">
              <div class="form-field full">
                <label>Description</label>
                <textarea class="premium-textarea" name="description" id="editDescription" required></textarea>
              </div>
              <div class="form-field full">
                <label>Image (optionnelle)</label>
                <input class="premium-input" type="file" name="image_file">
              </div>
            </div>
            <div class="action-row" style="margin-top:18px;">
              <button class="btn-main" type="submit"><i class="fa fa-save"></i> Sauvegarder</button>
              <button class="btn-ghost" type="button" onclick="switchPanel('explore')"><i class="fa fa-arrow-left"></i> Retour</button>
            </div>
          </form>
        </div>
      </section>
    </div>
  </section>
</div>
{% endblock %}

{% block javascripts %}
<script>
  function switchPanel(panelId) {
    document.querySelectorAll('.panel-view').forEach((panel) => {
      panel.classList.toggle('active', panel.id === 'panel-' + panelId);
    });
    document.querySelectorAll('.panel-tab').forEach((button) => {
      button.classList.toggle('active', button.dataset.panel === panelId);
    });
  }

  function editEvent(button) {
    const row = button.closest('tr');
    const event = JSON.parse(row.getAttribute('data-event-json'));
    document.getElementById('updateForm').action = '/admin/events/' + event.id + '/update';
    document.getElementById('updateToken').value = row.getAttribute('data-update-token');
    document.getElementById('editTitre').value = event.titre || '';
    document.getElementById('editType').value = event.typeEvent || '';
    document.getElementById('editDate').value = event.dateEvent || '';
    document.getElementById('editLieu').value = event.lieu || '';
    document.getElementById('editCapacite').value = event.capacite || '';
    document.getElementById('editPrix').value = event.prixEvent || 0;
    document.getElementById('editDescription').value = event.description || '';
    document.getElementById('editPremium').value = event.isPremium ? '1' : '0';
    document.getElementById('editPremiumSelect').value = event.isPremium ? '1' : '0';
    switchPanel('update');
  }

  function openWaitlistPanel(eventId) {
    switchPanel('waitlist');
    const select = document.getElementById('waitlistEventSelect');
    if (select) {
      select.value = String(eventId);
      select.form.submit();
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    switchPanel('{{ activePanel }}');

    const premiumSelect = document.getElementById('premiumFilter');
    const searchInput = document.getElementById('eventSearch');
    const rows = Array.from(document.querySelectorAll('#eventsTable .event-row'));
    const premiumQuery = '{{ premiumFilter }}';
    if (premiumSelect && premiumQuery) {
      premiumSelect.value = premiumQuery;
    }

    const applyEventFilters = () => {
      const searchValue = (searchInput ? searchInput.value : '').toLowerCase().trim();
      const premiumValue = premiumSelect ? premiumSelect.value : 'all';

      rows.forEach((row) => {
        const text = row.innerText.toLowerCase();
        const premium = row.getAttribute('data-premium');
        const matchesSearch = searchValue === '' || text.includes(searchValue);
        const matchesPremium = premiumValue === 'all' || premiumValue === premium;
        row.style.display = matchesSearch && matchesPremium ? '' : 'none';
      });
    };

    if (searchInput) {
      searchInput.addEventListener('input', applyEventFilters);
    }
    if (premiumSelect) {
      premiumSelect.addEventListener('change', applyEventFilters);
    }
    applyEventFilters();

    const premiumHidden = document.getElementById('editPremium');
    const premiumVisual = document.getElementById('editPremiumSelect');
    if (premiumHidden && premiumVisual) {
      premiumVisual.addEventListener('change', function () {
        premiumHidden.value = premiumVisual.value;
      });
    }
  });
</script>
{% endblock %}
