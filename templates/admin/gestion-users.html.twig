{% extends 'admin_base.html.twig' %}

{% block title %}Gestion utilisateur | Fitopia Admin{% endblock %}

{% block stylesheets %}
<style>
  .users-shell {
    width: 100%;
  }

  .users-overview-card {
    padding: 26px 28px 30px;
  }

  .users-overview-title {
    margin: 0 0 18px;
    font-size: 22px;
    font-weight: 900;
    color: #020817;
  }

  .users-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 18px;
  }

  .users-stat-card {
    min-height: 132px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #fbfdfd;
    border: 1px solid #dbe7e3;
    border-radius: 20px;
    padding: 20px 18px;
  }

  .users-stat-label {
    color: #50657a;
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .users-stat-value {
    color: #123748;
    font-size: 30px;
    line-height: 1;
    font-weight: 900;
    margin-bottom: 10px;
  }

  .users-stat-sub {
    color: #118265;
    font-size: 13px;
    font-weight: 800;
  }

  .users-actions-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.95fr);
    gap: 22px;
    align-items: stretch;
  }

  .users-action-card {
    min-height: 194px;
    border-radius: 24px;
    background: #ffffff;
    padding: 28px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    border: 1px solid #dce9e5;
    box-shadow: 0 8px 24px rgba(12, 63, 68, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
  }

  .users-action-card.primary {
    border-color: #62c7b0;
    box-shadow: 0 0 0 1px rgba(98, 199, 176, 0.16);
  }

  .users-action-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgba(12, 63, 68, 0.08);
  }

  .users-action-icon {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: #edf5f2;
    color: #0d5160;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 19px;
  }

  .users-action-card h3 {
    margin: 0;
    color: #020817;
    font-size: 17px;
    font-weight: 900;
  }

  .users-action-card p {
    margin: 0;
    color: #75859a;
    font-size: 15px;
    line-height: 1.6;
  }

  .users-table-card {
    padding: 6px 0 10px;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .users-table-title {
    margin: 0;
    color: #020817;
    font-size: 24px;
    font-weight: 900;
  }

  .users-table-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .users-table-meta {
    margin-top: 6px;
    color: #7b8794;
    font-size: 14px;
    font-weight: 600;
  }

  .users-search-form {
    width: min(100%, 370px);
    flex-shrink: 0;
  }

  .users-search-input {
    width: 100%;
    min-height: 66px;
    border: 1px solid #cfe0da;
    border-radius: 22px;
    padding: 0 24px;
    background: #ffffff;
    color: #123748;
    font-size: 16px;
    font-weight: 700;
    outline: none;
    box-shadow: 0 0 0 3px rgba(96, 211, 184, 0.12), 0 8px 24px rgba(12, 63, 68, 0.04);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .users-search-input:focus {
    border-color: #66d0b2;
    box-shadow: 0 0 0 4px rgba(102, 208, 178, 0.16), 0 10px 24px rgba(12, 63, 68, 0.06);
  }

  .users-search-input::placeholder {
    color: #8ea0ab;
    font-weight: 700;
  }

  .users-empty-state {
    padding: 30px 18px;
    text-align: center;
    color: #70808d;
    font-size: 15px;
    font-weight: 600;
  }

  .users-empty-state.is-hidden {
    display: none;
  }

  .users-table-wrap {
    overflow-x: auto;
  }

  .users-table {
    width: 100%;
    min-width: 1080px;
    border-collapse: separate;
    border-spacing: 0 16px;
  }

  .users-table thead th {
    padding: 0 28px 10px;
    color: #617b9b;
    font-size: 15px;
    font-weight: 800;
    text-align: left;
  }

  .users-row {
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(12, 63, 68, 0.03);
  }

  .users-row td {
    padding: 22px 28px;
    vertical-align: middle;
    border-top: 1px solid #d8e4f0;
    border-bottom: 1px solid #d8e4f0;
  }

  .users-row td:first-child {
    border-left: 1px solid #d8e4f0;
    border-radius: 22px 0 0 22px;
  }

  .users-row td:last-child {
    border-right: 1px solid #d8e4f0;
    border-radius: 0 22px 22px 0;
  }

  .users-user-cell {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .users-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1ca79d 0%, #18b5a5 100%);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 900;
    flex-shrink: 0;
  }

  .users-name {
    font-size: 17px;
    font-weight: 900;
    color: #081f4d;
    margin-bottom: 0;
  }

  .users-email {
    color: #536f96;
    font-size: 15px;
    font-weight: 500;
  }

  .users-role-badge,
  .users-status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 150px;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
  }

  .users-role-badge.admin {
    background: #e4eef8;
    color: #2a5a8f;
  }

  .users-role-badge.user {
    background: #edf1f5;
    color: #3e5d81;
  }

  .users-status-badge.active {
    background: linear-gradient(90deg, #d8f5e5 0%, #c9f0d7 100%);
    color: #088447;
  }

  .users-status-badge.archived {
    background: linear-gradient(90deg, #fde6e6 0%, #f8d2d2 100%);
    color: #c51f12;
  }

  .users-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .users-action-btn {
    min-width: 90px;
    height: 40px;
    padding: 0 16px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    background: #ffffff;
    border: 1px solid #d7e2ef;
    color: #234d7c;
  }

  @media (max-width: 1180px) {
    .users-stats-grid,
    .users-actions-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .users-table-header {
      flex-direction: column;
      align-items: stretch;
    }

    .users-search-form {
      width: 100%;
    }
  }
</style>
{% endblock %}

{% block body %}
<div class="users-shell">
    <div class="content-header">
        <div class="header-accent"></div>
        <h1>Gestion utilisateur</h1>
        <p>Administrez les comptes utilisateurs, leurs roles et leur statut dans l'ecosysteme Fitopia.</p>
    </div>

    <div class="card-section users-overview-card">
        <h2 class="users-overview-title">Dashboard Utilisateurs</h2>

        <div class="users-stats-grid">
            <div class="users-stat-card">
                <div class="users-stat-label">Total Utilisateurs</div>
                <div class="users-stat-value">{{ totalUsersCount }}</div>
                <div class="users-stat-sub">Utilisateurs actifs</div>
            </div>
            <div class="users-stat-card">
                <div class="users-stat-label">Administrateurs</div>
                <div class="users-stat-value">{{ adminUsersCount }}</div>
                <div class="users-stat-sub">Acces privilegies</div>
            </div>
            <div class="users-stat-card">
                <div class="users-stat-label">Comptes Archives</div>
                <div class="users-stat-value">{{ archivedUsersCount }}</div>
                <div class="users-stat-sub">&nbsp;</div>
            </div>
        </div>

        <div class="users-actions-grid">
            <div class="users-action-card primary" id="show-create-user-card">
                <div class="users-action-icon">+</div>
                <h3>Creer un utilisateur</h3>
                <p>Ajoutez manuellement un nouvel utilisateur au systeme.</p>
            </div>
            <div class="users-action-card" id="show-users-list-card">
                <div class="users-action-icon">SEE</div>
                <h3>Explorer les utilisateurs</h3>
                <p>Visualisez la liste complete des comptes synchronises.</p>
            </div>
        </div>
    </div>

    <div class="card-section" id="user-form-section" style="display: none;">
        <div class="section-title" id="user-form-title">Creer un utilisateur</div>
        <div class="form-container">
            <form action="{{ path('admin_users_add') }}" method="post" id="user-form">
                <input type="hidden" name="_token" id="form-csrf-token" value="{{ csrf_token('admin_users_add') }}">
                <input type="hidden" name="id" id="user-id">
                <input type="hidden" name="return_query" id="return-query" value="{{ usersSearchQuery|default('') }}">

                <div style="background: white; border: 1px solid #E6EAEE; border-radius: 18px; padding: 20px; margin-bottom: 24px;">
                    <h4 style="color: #153F46; font-size: 18px; font-weight: 800; margin-bottom: 18px;">Informations Personnelles</h4>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px;">
                        <div class="form-group required">
                            <label>Nom</label>
                            <input type="text" name="last_name" id="field-last-name" class="form-control" placeholder="Nom de famille" required>
                        </div>
                        <div class="form-group required">
                            <label>Prenom</label>
                            <input type="text" name="first_name" id="field-first-name" class="form-control" placeholder="Prenom" required>
                        </div>
                        <div class="form-group required">
                            <label>Email</label>
                            <input type="email" name="email" id="field-email" class="form-control" placeholder="example@fitopia.com" required>
                        </div>
                        <div class="form-group required">
                            <label>Nom d'utilisateur</label>
                            <input type="text" name="username" id="field-username" class="form-control" placeholder="Username" required>
                        </div>
                        <div class="form-group">
                            <label>Telephone</label>
                            <input type="text" name="phone" id="field-phone" class="form-control" placeholder="Numero de telephone">
                        </div>
                        <div class="form-group">
                            <label>Role</label>
                            <select name="role" id="field-role" class="form-control">
                                <option value="ROLE_USER">Utilisateur</option>
                                <option value="ROLE_ADMIN">Administrateur</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group" id="password-group">
                        <label>Mot de passe</label>
                        <input type="password" name="password" id="field-password" class="form-control" placeholder="Saisir pour changer ou creer">
                        <small style="color: #6B7280;">Laissez vide pour conserver l'ancien mot de passe en modification, ou utiliser le mot de passe par defaut en creation.</small>
                    </div>
                </div>

                <div style="display: flex; gap: 12px; justify-content: flex-end;">
                    <button type="button" class="btn-secondary" onclick="hideUserForm()">Annuler</button>
                    <button type="submit" class="btn-primary" style="width: 190px;">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card-section users-table-card" id="users-table-section" style="display: none;">
        <div class="users-table-header">
            <div>
                <h2 class="users-table-title">Liste des utilisateurs</h2>
                <div class="users-table-meta">
                    {% if usersSearchQuery %}
                        {{ managedUsers|length }} resultat{{ managedUsers|length > 1 ? 's' : '' }} pour "{{ usersSearchQuery }}"
                    {% else %}
                        {{ managedUsers|length }} utilisateur{{ managedUsers|length > 1 ? 's' : '' }} affiche{{ managedUsers|length > 1 ? 's' : '' }}
                    {% endif %}
                </div>
            </div>

            <div class="users-search-form">
                <input
                    type="search"
                    value="{{ usersSearchQuery|default('') }}"
                    class="users-search-input"
                    placeholder="Rechercher..."
                    aria-label="Rechercher un utilisateur"
                    oninput="filterUsersList()"
                >
            </div>
        </div>
        <div class="users-table-wrap">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in managedUsers %}
                        <tr
                            class="users-row"
                            data-user-json="{{ {id: user.id, email: user.email, username: user.username, first_name: user.firstName, last_name: user.lastName, phone: user.phone, role: 'ROLE_ADMIN' in user.roles ? 'ROLE_ADMIN' : 'ROLE_USER'}|json_encode|e('html_attr') }}"
                            data-update-token="{{ csrf_token('admin_users_update_' ~ user.id) }}"
                            data-search-text="{{ ((user.firstName|default('')) ~ ' ' ~ (user.lastName|default('')) ~ ' ' ~ (user.username|default('')) ~ ' ' ~ (user.email|default('')))|lower|e('html_attr') }}"
                        >
                            <td>
                                {% set initials = ((user.firstName|default('')|slice(0, 1)) ~ (user.lastName|default('')|slice(0, 1)))|upper %}
                                <div class="users-user-cell">
                                    <div class="users-avatar">{{ initials is empty ? 'U' : initials }}</div>
                                    <div class="users-name">{{ user.firstName }} {{ user.lastName }}</div>
                                </div>
                            </td>
                            <td class="users-email">{{ user.email }}</td>
                            <td>
                                <span class="users-role-badge {{ 'ROLE_ADMIN' in user.roles ? 'admin' : 'user' }}">
                                    {{ 'ROLE_ADMIN' in user.roles ? 'ADMIN' : 'PATIENT' }}
                                </span>
                            </td>
                            <td>
                                <span class="users-status-badge {{ user.isArchived ? 'archived' : 'active' }}">
                                    {{ user.isArchived ? 'ARCHIVE' : 'ACTIF' }}
                                </span>
                            </td>
                            <td>
                                <div class="users-actions">
                                    <button class="btn-secondary users-action-btn" onclick="editUser(this)">
                                        Modifier
                                    </button>
                                    <form action="{{ path('admin_users_delete', {id: user.id}) }}" method="post" onsubmit="return confirm('Supprimer cet utilisateur ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_users_delete_' ~ user.id) }}">
                                        <input type="hidden" name="return_query" value="{{ usersSearchQuery|default('') }}">
                                        <button type="submit" class="btn-secondary users-action-btn" style="color: #B42318; border-color: #FEE2E2;">
                                            Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="users-empty-state">
                                Aucun utilisateur ne correspond a cette recherche.
                            </td>
                        </tr>
                    {% endfor %}
                    {% if managedUsers is not empty %}
                        <tr id="users-empty-live-row" class="users-empty-state is-hidden">
                            <td colspan="5">Aucun utilisateur ne correspond a cette recherche.</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
const CREATE_TOKEN = "{{ csrf_token('admin_users_add') }}";
let usersSearchTimer = null;
let lastUsersPanel = 'none';

function normalizeSearchText(value) {
    return (value || '')
        .toString()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
}

function showPanel(type) {
    if (type === 'create') {
        document.getElementById('users-table-section').style.display = 'none';
        document.getElementById('user-form-title').innerText = 'Creer un utilisateur';
        document.getElementById('user-form').reset();
        document.getElementById('user-id').value = '';
        document.getElementById('form-csrf-token').value = CREATE_TOKEN;
        document.getElementById('user-form').action = '{{ path('admin_users_add') }}';
        document.getElementById('user-form-section').style.display = 'block';
        lastUsersPanel = 'form';
        document.getElementById('user-form-section').scrollIntoView({ behavior: 'smooth' });
    }
}

function scrollToTable() {
    document.getElementById('user-form-section').style.display = 'none';
    document.getElementById('users-table-section').style.display = 'block';
    lastUsersPanel = 'table';
    document.getElementById('users-table-section').scrollIntoView({ behavior: 'smooth' });
}

function hideUserForm() {
    document.getElementById('user-form-section').style.display = 'none';

    if (lastUsersPanel === 'table') {
        document.getElementById('users-table-section').style.display = 'block';
        document.getElementById('users-table-section').scrollIntoView({ behavior: 'smooth' });
    }
}

function editUser(btn) {
    const tr = btn.closest('tr');
    const data = JSON.parse(tr.getAttribute('data-user-json'));
    const token = tr.getAttribute('data-update-token');

    document.getElementById('users-table-section').style.display = 'none';
    document.getElementById('user-form-title').innerText = "Modifier l'utilisateur: " + data.email;
    document.getElementById('user-id').value = data.id;
    document.getElementById('form-csrf-token').value = token;
    document.getElementById('field-first-name').value = data.first_name || '';
    document.getElementById('field-last-name').value = data.last_name || '';
    document.getElementById('field-email').value = data.email;
    document.getElementById('field-username').value = data.username;
    document.getElementById('field-phone').value = data.phone || '';
    document.getElementById('field-role').value = data.role;

    document.getElementById('user-form').action = '/admin/users/' + data.id + '/update';
    document.getElementById('user-form-section').style.display = 'block';
    lastUsersPanel = 'table';
    document.getElementById('user-form-section').scrollIntoView({ behavior: 'smooth' });
}

function filterUsersList() {
    const searchInput = document.querySelector('.users-search-input');
    const searchMeta = document.querySelector('.users-table-meta');
    const userRows = Array.from(document.querySelectorAll('.users-row'));
    const emptyLiveRow = document.getElementById('users-empty-live-row');

    if (!searchInput) {
        return;
    }

    const rawQuery = searchInput.value.trim();
    const query = normalizeSearchText(rawQuery);
    let visibleCount = 0;

    userRows.forEach(function (row) {
        const haystack = normalizeSearchText(row.getAttribute('data-search-text') || '');
        const isVisible = query === '' || haystack.indexOf(query) !== -1;
        row.style.display = isVisible ? 'table-row' : 'none';
        if (isVisible) {
            visibleCount += 1;
        }
    });

    if (emptyLiveRow) {
        emptyLiveRow.classList.toggle('is-hidden', visibleCount > 0);
    }

    if (searchMeta) {
        if (query !== '') {
            searchMeta.textContent = visibleCount + ' resultat' + (visibleCount > 1 ? 's' : '') + ' pour "' + rawQuery + '"';
        } else {
            searchMeta.textContent = userRows.length + ' utilisateur' + (userRows.length > 1 ? 's' : '') + ' affiche' + (userRows.length > 1 ? 's' : '');
        }
    }
}

document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.querySelector('.users-search-input');
    const showCreateUserCard = document.getElementById('show-create-user-card');
    const showUsersListCard = document.getElementById('show-users-list-card');

    if (!searchInput) {
        return;
    }

    if (showCreateUserCard) {
        showCreateUserCard.addEventListener('click', function () {
            showPanel('create');
        });
    }

    if (showUsersListCard) {
        showUsersListCard.addEventListener('click', function () {
            scrollToTable();
        });
    }

    searchInput.addEventListener('input', function () {
        window.clearTimeout(usersSearchTimer);
        usersSearchTimer = window.setTimeout(filterUsersList, 60);
    });

    filterUsersList();
});
</script>
{% endblock %}
