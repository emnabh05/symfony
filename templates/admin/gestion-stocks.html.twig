{% extends 'admin_base.html.twig' %}

{% block title %}Gestion Supplements | Fitopia Admin{% endblock %}

{% block stylesheets %}
<style>
    .orders-hero {
        position: relative;
        overflow: hidden;
        border-radius: 32px;
        padding: 38px 44px;
        margin-bottom: 30px;
        background: linear-gradient(90deg, #145e6a 0%, #1a7a65 58%, #21906a 100%);
        color: #fff;
        box-shadow: 0 18px 40px rgba(17, 88, 80, 0.16);
    }

    .orders-hero::after {
        content: "";
        position: absolute;
        top: -36px;
        right: -58px;
        width: 210px;
        height: 210px;
        border-radius: 50%;
        background: rgba(120, 232, 178, 0.18);
    }

    .orders-hero h2 {
        position: relative;
        margin: 0 0 10px;
        font-size: 26px;
        font-weight: 800;
        color: #fff;
    }

    .orders-hero p {
        position: relative;
        margin: 0;
        font-size: 16px;
        color: rgba(255, 255, 255, 0.96);
    }

    .orders-table-card {
        background: #fff;
        border: 1px solid #edf1f4;
        border-radius: 30px;
        padding: 30px;
        box-shadow: 0 10px 32px rgba(15, 23, 42, 0.06);
    }

    .orders-table-card h3 {
        margin: 0 0 14px;
        color: #0f2247;
        font-size: 24px;
        font-weight: 800;
    }

    .orders-table-note {
        margin: 0 0 18px;
        color: #175e87;
        font-size: 15px;
        font-weight: 700;
    }

    .orders-grid-wrap {
        overflow-x: auto;
        border-radius: 18px;
        border: 1px solid #d8dfe6;
        background: linear-gradient(180deg, #ffffff 0%, #fbfcfd 100%);
    }

    .orders-grid {
        width: 100%;
        border-collapse: collapse;
        min-width: 920px;
        table-layout: fixed;
    }

    .orders-grid thead th {
        padding: 10px 12px;
        text-align: center;
        font-size: 14px;
        font-weight: 800;
        color: #20324d;
        border: 1px solid #cfd7df;
        background: linear-gradient(180deg, #f8f8f8 0%, #e7e7e7 100%);
    }

    .orders-grid tbody td {
        padding: 9px 12px;
        border: 1px solid #e2e8f0;
        color: #1f3556;
        font-size: 14px;
        vertical-align: middle;
        background: rgba(255, 255, 255, 0.95);
    }

    .orders-grid tbody tr:hover td {
        background: #f7fbfa;
    }

    .orders-status-form {
        margin: 0;
    }

    .orders-status-select {
        width: 100%;
        min-width: 160px;
        border: 1px solid #d8e1e8;
        border-radius: 10px;
        padding: 7px 10px;
        background: #fff;
        color: #183153;
        font-weight: 700;
    }

    .orders-empty {
        padding: 20px;
        text-align: center;
        color: #6b7280;
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .orders-hero,
        .orders-table-card {
            padding: 22px;
            border-radius: 22px;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="content-header">
    <div class="header-accent"></div>
    <h1>Gestion des supplements</h1>
    <p>Creez de nouveaux supplements et verifiez qu'ils sont bien synchronises avec le front.</p>
</div>

<div class="card-section" id="stocks-dashboard-section">
    <div class="section-title">Dashboard supplements</div>
    
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Stock Faible</div>
            <div class="stat-value">{{ stats.lowStockCount|default(0) }}</div>
            <div class="stat-sub">Articles a réapprovisionner</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Ventes totales</div>
            <div class="stat-value">{{ stats.itemsSold|default(0) }}</div>
            <div class="stat-sub">{{ stats.totalOrders|default(0) }} commandes</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Revenu Global</div>
            <div class="stat-value">{{ stats.totalRevenue|default(0)|number_format(2) }} DT</div>
            <div class="stat-sub">Depuis le lancement</div>
        </div>
    </div>

    <div class="actions-grid">
        <div class="action-card" onclick="showCreatePanel()">
            <div class="action-icon">+</div>
            <h3>Creer un supplement</h3>
            <p>Ajoutez un nouveau supplement pour votre stock.</p>
        </div>
        <div class="action-card" onclick="scrollToTable()">
            <div class="action-icon">SEE</div>
            <h3>Explorer les supplements</h3>
            <p>Les produits ci-dessous viennent de la meme base que la boutique front.</p>
        </div>
    </div>
</div>

<div class="card-section" id="supplements-orders-section">
    <div class="orders-hero">
        <h2>Orders Management</h2>
        <p>Change order status directly from the table: DELIVERED, ON_THE_WAY, CANCELED, ON_PROGRESS.</p>
    </div>

    <div class="orders-table-card">
        <h3>Orderd Table</h3>
        <p class="orders-table-note">Commandes trouvees: {{ payments|length }}. Tu peux changer le statut dans la colonne STATUS.</p>

        <div class="orders-grid-wrap">
            <table class="orders-grid">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Created At</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in payments %}
                        <tr>
                            <td>{{ order.firstName }} {{ order.lastName }}</td>
                            <td>{{ order.email }}</td>
                            <td>{{ order.phone ?: '-' }}</td>
                            <td>{{ order.city ?: '-' }}</td>
                            <td>{{ order.total }} DT</td>
                            <td>
                                <form class="orders-status-form" method="post" action="{{ path('admin_stocks_payment_update', {'id': order.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_stocks_payment_update_' ~ order.id) }}">
                                    <input type="hidden" name="first_name" value="{{ order.firstName }}">
                                    <input type="hidden" name="last_name" value="{{ order.lastName }}">
                                    <input type="hidden" name="email" value="{{ order.email }}">
                                    <input type="hidden" name="phone" value="{{ order.phone }}">
                                    <input type="hidden" name="address" value="{{ order.address }}">
                                    <input type="hidden" name="city" value="{{ order.city }}">
                                    <input type="hidden" name="postal_code" value="{{ order.postalCode }}">
                                    <input type="hidden" name="payment_method" value="{{ order.paymentMethod }}">
                                    <input type="hidden" name="subtotal" value="{{ order.subtotal }}">
                                    <input type="hidden" name="shipping" value="{{ order.shipping }}">
                                    <input type="hidden" name="discount" value="{{ order.discount }}">
                                    <input type="hidden" name="total" value="{{ order.total }}">
                                    <input type="hidden" name="discount_code" value="{{ order.discountCode }}">
                                    <input type="hidden" name="notes" value="{{ order.notes }}">
                                    <select class="orders-status-select" name="status" onchange="this.form.submit()">
                                        <option value="pending" {{ order.status == 'pending' ? 'selected' : '' }}>PLACED</option>
                                        <option value="processing" {{ order.status == 'processing' ? 'selected' : '' }}>ON_PROGRESS</option>
                                        <option value="on_way" {{ order.status == 'on_way' ? 'selected' : '' }}>ON_THE_WAY</option>
                                        <option value="delivered" {{ order.status == 'delivered' ? 'selected' : '' }}>DELIVERED</option>
                                        <option value="canceled" {{ order.status == 'canceled' ? 'selected' : '' }}>CANCELED</option>
                                    </select>
                                </form>
                            </td>
                            <td>{{ order.createdAt ? order.createdAt|date('Y-m-d H:i') : '-' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="orders-empty">No orders found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card-section" id="supplement-form-section" style="display: none;">
    <div class="section-title" id="supplement-form-title">Creer un supplement</div>
    <div class="form-container">
        <form action="{{ path('admin_stocks_supplement_add') }}" method="post" enctype="multipart/form-data" id="supplement-form">
            <input type="hidden" name="_token" id="form-csrf-token" value="{{ csrf_token('admin_stocks_supplement_add') }}">
            <input type="hidden" name="id" id="field-id">

            <div style="background: white; border: 1px solid #E6EAEE; border-radius: 18px; padding: 20px; margin-bottom: 24px;">
                <h4 style="color: #153F46; font-size: 18px; font-weight: 800; margin-bottom: 18px;">Informations principales</h4>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px;">
                    <div class="form-group required">
                        <label>Nom du supplement</label>
                        <input type="text" name="name" id="field-name" class="form-control" placeholder="Enter supplement name" required>
                    </div>
                    <div class="form-group required">
                        <label>Categorie</label>
                        <input type="text" name="category" id="field-category" class="form-control" placeholder="Select a category" required>
                    </div>
                    <div class="form-group">
                        <label style="color: #167E64;">Marque</label>
                        <input type="text" name="brand" id="field-brand" class="form-control" placeholder="Select a brand">
                    </div>
                    <div class="form-group">
                        <label style="color: #111827;">Prix (DT)</label>
                        <input type="number" step="0.01" name="price" id="field-price" class="form-control" placeholder="0.00">
                    </div>
                    <div class="form-group">
                        <label style="color: #111827;">Stock quantity</label>
                        <input type="number" name="stock" id="field-stock" class="form-control" placeholder="0">
                    </div>
                    <div class="form-group">
                        <label style="color: #111827;">Calories</label>
                        <input type="number" name="calories" id="field-calories" class="form-control" placeholder="Optional">
                    </div>
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" id="field-description" class="form-control" placeholder="Enter supplement description..."></textarea>
                </div>

                <div class="form-group">
                    <label>Product image</label>
                    <input type="file" name="image_file" id="field-image" class="form-control">
                </div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button type="button" class="btn-secondary" onclick="document.getElementById('supplement-form-section').style.display='none'">Annuler</button>
                <button type="submit" class="btn-primary" style="width: 190px;">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

<div class="card-section" id="supplements-list-section">
    <div class="section-title">Supplements synchronises</div>
    <p style="color: #6B7280; font-size: 14px; font-weight: 700; margin-bottom: 16px;">{{ supplements|length }} produits trouves</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
        {% for supplement in supplements %}
            <div class="supplement-card" 
                 style="background: white; border: 1px solid #E6EAEE; border-radius: 18px; padding: 15px; display: flex; gap: 15px; align-items: center;"
                 data-supplement-json="{{ {id: supplement.id, name: supplement.name, category: supplement.category, brand: supplement.brand, price: supplement.price, stock: supplement.stock, calories: supplement.calories, description: supplement.description}|json_encode|e('html_attr') }}"
                 data-update-token="{{ csrf_token('admin_stocks_supplement_update_' ~ supplement.id) }}">
                <div style="width: 80px; height: 80px; flex-shrink: 0; border-radius: 12px; overflow: hidden; background: #F3F4F6; display: flex; align-items: center; justify-content: center;">
                    {% if supplement.image %}
                        <img src="{{ asset('uploads/supplements/' ~ supplement.image) }}" style="width: 100%; height: 100%; object-fit: cover;">
                    {% else %}
                        <i class="fa fa-medkit" style="font-size: 24px; color: #9CA3AF;"></i>
                    {% endif %}
                </div>
                <div style="flex-grow: 1;">
                    <div style="font-weight: 800; font-size: 16px; color: #153F46;">{{ supplement.name }}</div>
                    <div style="color: #6B7280; font-size: 13px;">{{ supplement.brand }} • {{ supplement.category }}</div>
                    <div style="margin-top: 5px; display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-weight: 900; color: #118265;">{{ supplement.price|number_format(2) }} DT</span>
                        <span style="background: {{ supplement.stock > 10 ? '#ECFDF5' : '#FEF2F2' }}; color: {{ supplement.stock > 10 ? '#065F46' : '#991B1B' }}; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 800;">
                            Stock: {{ supplement.stock }}
                        </span>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <button class="btn-secondary" style="padding: 5px 10px; font-size: 12px;" onclick="editSupplement(this)">
                        <i class="fa fa-edit"></i>
                    </button>
                    <form action="{{ path('admin_stocks_supplement_delete', {id: supplement.id}) }}" method="post" onsubmit="return confirm('Supprimer ce supplement ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_stocks_supplement_delete_' ~ supplement.id) }}">
                        <button type="submit" class="btn-secondary" style="padding: 5px 10px; font-size: 12px; color: #B42318; border-color: #FEE2E2;">
                            <i class="fa fa-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
const CREATE_TOKEN = "{{ csrf_token('admin_stocks_supplement_add') }}";
const dashboardSection = document.getElementById('stocks-dashboard-section');
const ordersSection = document.getElementById('supplements-orders-section');
const formSection = document.getElementById('supplement-form-section');
const listSection = document.getElementById('supplements-list-section');

function applyStocksView() {
    const isOrdersView = window.location.hash === '#supplements-orders-section';

    if (ordersSection) {
        ordersSection.style.display = isOrdersView ? 'block' : 'none';
    }

    if (dashboardSection) {
        dashboardSection.style.display = isOrdersView ? 'none' : 'block';
    }

    if (listSection) {
        listSection.style.display = isOrdersView ? 'none' : 'block';
    }

    if (formSection && isOrdersView) {
        formSection.style.display = 'none';
    }
}

function showCreatePanel() {
    window.location.hash = '#supplements-list-section';
    applyStocksView();
    document.getElementById('supplement-form-title').innerText = 'Creer un supplement';
    document.getElementById('supplement-form').reset();
    document.getElementById('form-csrf-token').value = CREATE_TOKEN;
    document.getElementById('supplement-form').action = '{{ path('admin_stocks_supplement_add') }}';
    document.getElementById('supplement-form-section').style.display = 'block';
    document.getElementById('supplement-form-section').scrollIntoView({ behavior: 'smooth' });
}

function scrollToTable() {
    window.location.hash = '#supplements-list-section';
    applyStocksView();
    document.getElementById('supplements-list-section').scrollIntoView({ behavior: 'smooth' });
}

function editSupplement(btn) {
    window.location.hash = '#supplements-list-section';
    applyStocksView();
    const card = btn.closest('.supplement-card');
    const data = JSON.parse(card.getAttribute('data-supplement-json'));
    const token = card.getAttribute('data-update-token');

    document.getElementById('supplement-form-title').innerText = 'Modifier le supplement: ' + data.name;
    document.getElementById('field-id').value = data.id;
    document.getElementById('form-csrf-token').value = token;
    document.getElementById('field-name').value = data.name;
    document.getElementById('field-category').value = data.category;
    document.getElementById('field-brand').value = data.brand;
    document.getElementById('field-price').value = data.price;
    document.getElementById('field-stock').value = data.stock;
    document.getElementById('field-calories').value = data.calories || '';
    document.getElementById('field-description').value = data.description;
    
    document.getElementById('supplement-form').action = '/admin/stocks/supplement/' + data.id + '/update';
    document.getElementById('supplement-form-section').style.display = 'block';
    document.getElementById('supplement-form-section').scrollIntoView({ behavior: 'smooth' });
}

window.addEventListener('hashchange', applyStocksView);
applyStocksView();
</script>
{% endblock %}
