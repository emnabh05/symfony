<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #1f2937; }
    h2 { margin: 0 0 8px; color: #0b3a3d; }
    .meta { margin: 0 0 14px; color: #6b7280; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #d1d5db; padding: 6px 8px; text-align: left; }
    th { background: #eef6f4; }
  </style>
</head>
<body>
  <h2>Admin Users Report</h2>
  <p class="meta">Generated on {{ "now"|date("Y-m-d H:i") }}</p>
  <table>
    <thead>
      <tr><th>ID</th><th>Email</th><th>Username</th><th>Name</th><th>Phone</th><th>Roles</th></tr>
    </thead>
    <tbody>
      {% for user in users %}
        <tr>
          <td>#{{ user.id }}</td>
          <td>{{ user.email }}</td>
          <td>{{ user.username }}</td>
          <td>{{ user.firstName }} {{ user.lastName }}</td>
          <td>{{ user.phone }}</td>
          <td>{{ user.roles|join(', ') }}</td>
        </tr>
      {% else %}
        <tr><td colspan="6">No rows</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>

