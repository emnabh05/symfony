<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #1f2937; }
    h2 { margin: 0 0 8px; color: #0b3a3d; }
    .meta { margin: 0 0 14px; color: #6b7280; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #d1d5db; padding: 6px 8px; text-align: left; }
    th { background: #eef6f4; }
  </style>
</head>
<body>
  <h2>Admin Supplements Report</h2>
  <p class="meta">Generated on {{ "now"|date("Y-m-d H:i") }}</p>
  <table>
    <thead>
      <tr><th>ID</th><th>Name</th><th>Category</th><th>Brand</th><th>Price</th><th>Stock</th><th>Updated</th></tr>
    </thead>
    <tbody>
      {% for s in supplements %}
        <tr>
          <td>#{{ s.id }}</td>
          <td>{{ s.name }}</td>
          <td>{{ s.category }}</td>
          <td>{{ s.brand }}</td>
          <td>{{ s.price }} DT</td>
          <td>{{ s.stock }}</td>
          <td>{{ s.updatedAt ? s.updatedAt|date('Y-m-d H:i') : '-' }}</td>
        </tr>
      {% else %}
        <tr><td colspan="7">No rows</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>

