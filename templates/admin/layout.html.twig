<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}Fitopia Admin{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="{{ asset('css/admin_dashboard.css') }}?v=20260509-sidebar-structure-3">
    <style>
      body.admin-back-layout {
        padding-left: calc(var(--sidebar-width) + var(--layout-gap)) !important;
      }

      body.admin-back-layout .main-content {
        margin-left: 0 !important;
        width: auto !important;
        max-width: none !important;
        min-width: 0 !important;
        padding-left: 0 !important;
      }

      @media (max-width: 960px) {
        body.admin-back-layout {
          padding-left: 0 !important;
        }

        body.admin-back-layout .main-content {
          width: 100% !important;
          max-width: 100% !important;
        }
      }

      * { box-sizing: border-box; }

      .legacy-main-content {
        padding-top: 28px;
      }

      .admin-shell-inner {
        width: 100%;
        max-width: 1180px;
      }

      .page-title {
        margin: 0 0 18px;
        font-size: 2rem;
        font-weight: 900;
        color: #11243d;
        letter-spacing: -0.02em;
      }

      .page-subtitle {
        margin: 6px 0 0;
        color: #6f8094;
        font-size: 1rem;
      }

      .card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 22px 50px rgba(17, 36, 61, 0.08);
        padding: 2rem;
        border: 1px solid #eef3f6;
      }

      .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
      }

      .back-btn {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: #ffffff;
        border: 1px solid #dbe6eb;
        color: #0f4c45;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        box-shadow: 0 10px 24px rgba(15, 76, 69, 0.08);
      }

      .alert {
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 16px;
        font-weight: 700;
        border: 1px solid transparent;
      }

      .alert-success {
        background: #ecfdf5;
        color: #166534;
        border-color: #a7f3d0;
      }

      .alert-danger {
        background: #fef2f2;
        color: #991b1b;
        border-color: #fecaca;
      }

      .alert-info {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
      }

      .alert-warning {
        background: #fffbeb;
        color: #92400e;
        border-color: #fde68a;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 16px;
        border-radius: 12px;
        border: 1px solid transparent;
        text-decoration: none;
        font-weight: 800;
        font-size: 0.95rem;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-sm {
        padding: 8px 12px;
        font-size: 0.84rem;
        border-radius: 10px;
      }

      .btn-primary {
        background: #0f4c45;
        color: #fff;
        box-shadow: 0 12px 24px rgba(15, 76, 69, 0.16);
      }

      .btn-secondary {
        background: #eef4f3;
        color: #0f4c45;
        border-color: #d8e5e2;
      }

      .btn-success {
        background: #118265;
        color: #fff;
      }

      .btn-danger {
        background: #b42318;
        color: #fff;
      }

      .btn-dark {
        background: #0b3a3d;
        color: #fff;
      }

      .btn-outline-primary {
        background: #fff;
        color: #0f4c45;
        border-color: #9fc8c0;
      }

      .btn-outline-secondary {
        background: #fff;
        color: #5b6b7d;
        border-color: #d8e0e8;
      }

      .btn-outline-danger {
        background: #fff;
        color: #b42318;
        border-color: #f3b5b1;
      }

      .form-control {
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border-radius: 12px;
        border: 1px solid #d6e1e8;
        background: #fff;
        color: #153f46;
        font: inherit;
      }

      .form-control:focus {
        outline: none;
        border-color: #0f7a5f;
        box-shadow: 0 0 0 3px rgba(15, 122, 95, 0.12);
      }

      textarea.form-control {
        min-height: 110px;
        resize: vertical;
      }

      .form-label {
        display: inline-block;
        margin-bottom: 8px;
        font-weight: 700;
        color: #27465b;
      }

      .table-responsive {
        overflow-x: auto;
      }

      .table {
        width: 100%;
        border-collapse: collapse;
        min-width: 680px;
      }

      .table th,
      .table td {
        padding: 14px 12px;
        border-bottom: 1px solid #edf2f7;
        text-align: left;
      }

      .table th {
        font-size: 0.84rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #63758a;
      }

      .table td {
        color: #1f3447;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 800;
      }

      .badge-info {
        background: #e0f2fe;
        color: #075985;
      }

      .text-muted {
        color: #6b7280;
      }

      .d-flex {
        display: flex;
      }

      .gap-2 {
        gap: 0.5rem;
      }

      .flex-wrap {
        flex-wrap: wrap;
      }

      .mb-0 { margin-bottom: 0; }
      .mb-3 { margin-bottom: 1rem; }
      .mb-4 { margin-bottom: 1.5rem; }
      .mt-2 { margin-top: 0.5rem; }
      .mt-3 { margin-top: 1rem; }
      .ml-2 { margin-left: 0.5rem; }

      @media (max-width: 960px) {
        .legacy-main-content {
          padding-top: 22px;
        }

        .page-title {
          font-size: 1.7rem;
        }

        .page-header {
          align-items: flex-start;
        }
      }
    </style>
    {% block stylesheets %}{% endblock %}
  </head>
  <body class="admin-back-layout">
    {% set currentRoute = app.request.attributes.get('_route')|default('') %}
    {% set isStocksRoute = currentRoute starts with 'admin_stocks' %}
    {% set isStockProductsRoute = currentRoute == 'admin_stocks' or currentRoute starts with 'admin_stocks_supplement_' %}
    {% set isStockOrdersRoute = currentRoute starts with 'admin_stocks_payment_' %}
    <aside class="admin-sidebar">
      <div class="sidebar-logo">
        <div class="logo-box">
          <span class="logo-mark">F</span>
          <span class="logo-caption">FITOPIA</span>
        </div>
        <span class="sidebar-title">Fitopia Admin</span>
      </div>

      <div class="user-card">
        <div class="user-avatar">
          {{ app.user and app.user.email ? app.user.email|first|upper : 'A' }}
        </div>
        <div class="user-mail">
          {{ app.user and app.user.email ? app.user.email : 'admin@fitopia.com' }}
        </div>
      </div>

      <a href="{{ path('admin_tables') }}" class="nav-section-title {{ currentRoute == 'admin_tables' ? 'active' : '' }}">
        <span class="nav-link-icon"><i class="fa fa-table"></i></span>
        <span class="nav-section-label">Tables</span>
      </a>

      <nav class="nav-links">
        <a href="{{ path('admin_users') }}" class="nav-link-btn {{ currentRoute == 'admin_users' ? 'active' : '' }}">
          <span class="nav-link-main">
            <span class="nav-link-icon"><i class="fa fa-users"></i></span>
            <span class="nav-link-label">Gestion utilisateur</span>
          </span>
        </a>
        <a href="{{ path('admin_blog_forum') }}" class="nav-link-btn {{ currentRoute == 'admin_blog_forum' ? 'active' : '' }}">
          <span class="nav-link-main">
            <span class="nav-link-icon"><i class="fa fa-comment"></i></span>
            <span class="nav-link-label">Gestion forum et blog</span>
          </span>
        </a>
        <a href="{{ path('admin_events') }}" class="nav-link-btn {{ currentRoute == 'admin_events' ? 'active' : '' }}">
          <span class="nav-link-main">
            <span class="nav-link-icon"><i class="fa fa-calendar"></i></span>
            <span class="nav-link-label">Gestion des evenements</span>
          </span>
        </a>
        <a href="{{ path('admin_trainings') }}" class="nav-link-btn {{ currentRoute == 'admin_trainings' ? 'active' : '' }}">
          <span class="nav-link-main">
            <span class="nav-link-icon"><i class="fa fa-line-chart"></i></span>
            <span class="nav-link-label">Gestion des entrainements</span>
          </span>
        </a>
        <a href="{{ path('admin_nutrition') }}" class="nav-link-btn {{ currentRoute == 'admin_nutrition' ? 'active' : '' }}">
          <span class="nav-link-main">
            <span class="nav-link-icon"><i class="fa fa-pagelines"></i></span>
            <span class="nav-link-label">Gestion alimentation</span>
          </span>
        </a>

        <div class="nav-accordion {{ isStocksRoute ? 'is-open' : '' }}" data-sidebar-accordion>
          <button
            type="button"
            class="nav-link-btn nav-accordion-trigger {{ isStocksRoute ? 'active' : '' }}"
            data-sidebar-trigger
            aria-expanded="{{ isStocksRoute ? 'true' : 'false' }}"
          >
            <span class="nav-link-main">
              <span class="nav-link-icon"><i class="fa fa-shopping-cart"></i></span>
              <span>Gestion supplements</span>
            </span>
            <span class="nav-caret" aria-hidden="true"></span>
          </button>

          <div class="submenu {{ isStocksRoute ? 'is-open' : '' }}" data-sidebar-panel>
            <a
              href="{{ path('admin_stocks') }}#supplements-list-section"
              class="submenu-link {{ isStockProductsRoute ? 'active' : '' }}"
              data-submenu-link="products"
            >
              Produits
            </a>
            <a
              href="{{ path('admin_stocks') }}#supplements-orders-section"
              class="submenu-link {{ isStockOrdersRoute ? 'active' : '' }}"
              data-submenu-link="orders"
            >
              Commandes
            </a>
          </div>
        </div>
      </nav>

      <div class="logout-container">
        <a href="{{ path('app_logout') }}" class="logout-btn">
          <span class="logout-icon">&#8618;</span>
          <span>Logout</span>
        </a>
      </div>
    </aside>

    <main class="main-content legacy-main-content">
      {% block body %}{% endblock %}
    </main>

    <script src="{{ asset('js/jquery.min.js') }}"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const accordion = document.querySelector('[data-sidebar-accordion]');
        const trigger = document.querySelector('[data-sidebar-trigger]');
        const submenu = document.querySelector('[data-sidebar-panel]');
        const submenuLinks = document.querySelectorAll('[data-submenu-link]');

        if (accordion && trigger && submenu) {
          trigger.addEventListener('click', function () {
            const isOpen = accordion.classList.toggle('is-open');
            submenu.classList.toggle('is-open', isOpen);
            trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });
        }

        if (window.location.hash === '#supplements-orders-section') {
          submenuLinks.forEach(function (link) {
            link.classList.toggle('active', link.dataset.submenuLink === 'orders');
          });
        } else if (window.location.hash === '#supplements-list-section' || window.location.pathname.endsWith('/admin/stocks')) {
          submenuLinks.forEach(function (link) {
            if (link.dataset.submenuLink === 'products' && !document.querySelector('[data-submenu-link="orders"].active')) {
              link.classList.add('active');
            }
          });
        }
      });
    </script>
    {% block javascripts %}{% endblock %}
  </body>
</html>
