<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}Fitopia Admin{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <style>
      :root {
        --fitopia-dark: #0b3a3d;
        --fitopia-mid: #0d5b50;
        --fitopia-light: #0f7a5f;
        --ink: #0f172a;
        --muted: #6b7280;
        --bg: #f7faf9;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Poppins", sans-serif;
        background: var(--bg);
        color: var(--ink);
      }
      .admin-shell {
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: 100vh;
      }
      .sidebar {
        background: linear-gradient(180deg, var(--fitopia-dark), var(--fitopia-mid));
        color: #fff;
        padding: 1.5rem 1.25rem;
        position: sticky;
        top: 0;
        height: 100vh;
      }
      .brand-link {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        color: #fff;
        text-decoration: none;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }
      .brand img {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #fff;
        padding: 6px;
      }
      .brand span {
        font-weight: 700;
        letter-spacing: 0.3px;
      }
      .nav {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .nav-item {
        margin-bottom: 0.5rem;
      }
      .nav-link {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.85rem 1rem;
        border-radius: 10px;
        color: #fff;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.08);
        transition: all 0.2s ease;
        font-size: 1rem;
        font-weight: 600;
      }
      .nav-link.active {
        background: rgba(255, 255, 255, 0.22);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
      }
      .nav-link:hover {
        background: rgba(255, 255, 255, 0.18);
      }
      .submenu {
        list-style: none;
        margin: 0.6rem 0 0 1.2rem;
        padding: 0;
        display: none;
      }
      .nav-item:hover .submenu {
        display: block;
      }
      .submenu a {
        display: block;
        padding: 0.55rem 0.7rem;
        color: #e6fffa;
        text-decoration: none;
        font-size: 0.98rem;
        font-weight: 500;
        border-radius: 8px;
      }
      .submenu a:hover {
        text-decoration: underline;
      }
      .submenu a.active {
        background: rgba(255, 255, 255, 0.2);
        text-decoration: none;
      }
      .admin-mini {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 0.75rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.12);
        margin-bottom: 1.2rem;
      }
      .admin-mini img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.5);
      }
      .admin-mini .name {
        font-weight: 600;
        font-size: 0.95rem;
        color: #fff;
      }
      .logout-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        background: #fff;
        color: var(--fitopia-dark);
        border-radius: 10px;
        padding: 0.6rem 0.9rem;
        font-weight: 700;
        text-decoration: none;
      }
      .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1050;
      }
      .modal-card {
        background: #fff;
        border-radius: 14px;
        padding: 1.5rem;
        width: min(520px, 92vw);
        box-shadow: 0 20px 60px rgba(15, 23, 42, 0.25);
        text-align: center;
      }
      .modal-card h4 {
        margin-bottom: 0.5rem;
        font-weight: 800;
        color: #b42318;
      }
      .modal-card p {
        color: #475467;
      }
      .modal-actions {
        margin-top: 1.25rem;
        display: flex;
        gap: 0.75rem;
        justify-content: center;
      }
      .btn-cancel {
        background: #e2e8f0;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-weight: 600;
      }
      .btn-confirm {
        background: #b42318;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-weight: 700;
      }
      .content {
        padding: 2.5rem 2.5rem 3rem;
      }
      .page-title {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 1rem;
      }
      .card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 18px 50px rgba(14, 30, 37, 0.12);
        padding: 2rem;
      }
      @media (max-width: 991px) {
        .admin-shell {
          grid-template-columns: 1fr;
        }
        .sidebar {
          height: auto;
          position: relative;
        }
      }
    </style>
    {% block stylesheets %}{% endblock %}
  </head>
  <body>
    <div class="admin-shell">
      <aside class="sidebar">
        <div class="brand">
          <a class="brand-link" href="{{ path('admin_dashboard') }}">
            <img src="{{ asset('images/logo.png') }}" alt="Fitopia logo">
            <span>Fitopia Admin</span>
          </a>
        </div>
        <div class="admin-mini">
          <img src="{% if app.user and app.user.avatar %}{{ asset('uploads/avatars/' ~ app.user.avatar) }}{% else %}{{ asset('images/logo.png') }}{% endif %}" alt="Admin avatar">
          <div class="name">
            {{ app.user ? app.user.userIdentifier : 'Admin' }}
          </div>
        </div>
        <ul class="nav">
          <li class="nav-item">
            <a href="{{ path('admin_tables') }}" class="nav-link{% if app.request.attributes.get('_route') == 'admin_tables' %} active{% endif %}">
              <i class="fa fa-table"></i>
              Tables
            </a>
            <ul class="submenu">
              <li><a href="{{ path('admin_users') }}" class="{% if app.request.attributes.get('_route') == 'admin_users' %}active{% endif %}"><i class="fa fa-users"></i> Gestion utilisateur</a></li>
              <li><a href="{{ path('admin_blog_forum') }}" class="{% if app.request.attributes.get('_route') == 'admin_blog_forum' %}active{% endif %}"><i class="fa fa-comments"></i> Gestion forum et blog</a></li>
              <li><a href="{{ path('admin_stocks') }}" class="{% if app.request.attributes.get('_route') == 'admin_stocks' %}active{% endif %}"><i class="fa fa-cubes"></i> Gestion des stock</a></li>
              <li><a href="{{ path('admin_events') }}" class="{% if app.request.attributes.get('_route') == 'admin_events' %}active{% endif %}"><i class="fa fa-calendar"></i> Gestion des evenements</a></li>
              <li><a href="{{ path('admin_checkin_index') }}" class="{% if app.request.attributes.get('_route') starts with 'admin_checkin_' %}active{% endif %}"><i class="fa fa-qrcode"></i> Check-in QR</a></li>
              <li><a href="{{ path('admin_loyalty') }}" class="{% if app.request.attributes.get('_route') == 'admin_loyalty' %}active{% endif %}"><i class="fa fa-diamond"></i> Gestion fidelite clients</a></li>
              <li><a href="{{ path('admin_trainings') }}" class="{% if app.request.attributes.get('_route') == 'admin_trainings' %}active{% endif %}"><i class="fa fa-dumbbell"></i> Gestion des entrainement</a></li>
              <li><a href="{{ path('admin_nutrition') }}" class="{% if app.request.attributes.get('_route') == 'admin_nutrition' %}active{% endif %}"><i class="fa fa-leaf"></i> Gestion alimentation</a></li>
            </ul>
          </li>
        </ul>
        <a href="#" class="logout-btn" id="admin-logout-btn">
          <i class="fa fa-sign-out"></i> Logout
        </a>
      </aside>

      <main class="content">
        {% block body %}{% endblock %}
      </main>
    </div>
    <div class="modal-backdrop" id="logout-modal">
      <div class="modal-card">
        <h4>Leaving so soon?</h4>
        <p>We’ll be here when you’re ready to continue managing Fitopia.</p>
        <div class="modal-actions">
          <button class="btn-cancel" type="button" id="logout-cancel-btn">Cancel</button>
          <button class="btn-confirm" type="button" id="logout-confirm-btn">Logout</button>
        </div>
      </div>
    </div>
    {% block javascripts %}{% endblock %}
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const openBtn = document.getElementById('admin-logout-btn');
        const modal = document.getElementById('logout-modal');
        const cancelBtn = document.getElementById('logout-cancel-btn');
        const confirmBtn = document.getElementById('logout-confirm-btn');
        if (!openBtn || !modal || !cancelBtn || !confirmBtn) return;
        openBtn.addEventListener('click', (e) => {
          e.preventDefault();
          modal.style.display = 'flex';
        });
        cancelBtn.addEventListener('click', () => {
          modal.style.display = 'none';
        });
        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.style.display = 'none';
        });
        confirmBtn.addEventListener('click', () => {
          window.location.href = "{{ path('app_logout') }}";
        });
      });
    </script>
  </body>
</html>
