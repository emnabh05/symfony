<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #1f2937; }
    h2 { margin: 0 0 8px; color: #0b3a3d; }
    .meta { margin: 0 0 14px; color: #6b7280; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #d1d5db; padding: 6px 8px; text-align: left; }
    th { background: #eef6f4; }
  </style>
</head>
<body>
  <h2>Admin Events Report</h2>
  <p class="meta">Generated on {{ "now"|date("Y-m-d H:i") }}</p>
  <table>
    <thead>
      <tr><th>ID</th><th>Title</th><th>Type</th><th>Date</th><th>Location</th><th>Capacity</th><th>Price</th></tr>
    </thead>
    <tbody>
      {% for event in events %}
        <tr>
          <td>#{{ event.id }}</td>
          <td>{{ event.titre }}</td>
          <td>{{ event.typeEvent }}</td>
          <td>{{ event.dateEvent|date('Y-m-d') }}</td>
          <td>{{ event.lieu }}</td>
          <td>{{ event.capacite }}</td>
          <td>{{ event.prixEvent ?: '0.00' }}</td>
        </tr>
      {% else %}
        <tr><td colspan="7">No rows</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>

