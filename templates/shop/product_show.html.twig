{% extends 'shop/base.html.twig' %}

{% block title %}{{ supplement.name }} - Fitopia Supplements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .product-detail {
            padding: 60px 0;
            background: #f8fafc;
        }

        .product-detail-grid {
            display: grid;
            grid-template-columns: minmax(280px, 420px) 1fr;
            gap: 40px;
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .product-detail-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            border-radius: 16px;
            overflow: hidden;
            background: #f1f5f9;
        }

        .product-detail-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-detail-name {
            font-size: 28px;
            font-weight: 700;
            color: #0B2C3D;
            margin-bottom: 10px;
        }

        .product-detail-brand {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #1B5E4B;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .product-detail-rating {
            color: #fbbf24;
            font-size: 16px;
            margin-bottom: 15px;
        }

        .product-detail-rating span {
            color: #64748b;
            font-size: 13px;
            margin-left: 6px;
        }

        .product-detail-price {
            font-size: 30px;
            font-weight: 800;
            color: #1B5E4B;
            margin-bottom: 12px;
        }

        .product-detail-stock {
            font-size: 13px;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 20px;
        }

        .product-detail-description {
            font-size: 14px;
            color: #334155;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .product-detail-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        .add-to-cart-btn {
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #1B5E4B 0%, #0B2C3D 100%);
            color: white;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .add-to-cart-btn:disabled {
            background: #cbd5e1;
            cursor: not-allowed;
        }

        .reviews-section {
            margin-top: 40px;
        }

        .reviews-header {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #0B2C3D;
        }

        .review-form {
            background: white;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            margin-bottom: 30px;
        }

        .review-form .form-group {
            margin-bottom: 15px;
        }

        .review-form label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #0B2C3D;
        }

        .review-form input,
        .review-form select,
        .review-form textarea {
            width: 100%;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            font-size: 14px;
        }

        .review-form textarea {
            min-height: 120px;
            resize: vertical;
        }

        .rating-input {
            display: flex;
            gap: 6px;
            align-items: center;
            margin-top: 6px;
        }

        .rating-star {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 20px;
            color: #cbd5e1;
            padding: 0;
        }

        .rating-star.active {
            color: #fbbf24;
        }

        .rating-star.active i {
            color: #fbbf24;
        }

        .rating-hint {
            font-size: 12px;
            color: #64748b;
            margin-top: 6px;
        }

        .review-submit {
            padding: 12px 18px;
            border-radius: 8px;
            border: none;
            background: #0B2C3D;
            color: white;
            font-weight: 600;
            cursor: pointer;
        }

        .review-list {
            display: grid;
            gap: 16px;
        }

        .review-card {
            background: white;
            border-radius: 14px;
            padding: 16px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.05);
        }

        .review-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .review-card-name {
            font-weight: 700;
            color: #0B2C3D;
            font-size: 14px;
        }

        .review-card-date {
            font-size: 12px;
            color: #64748b;
        }

        .review-card-rating {
            color: #fbbf24;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .review-card-comment {
            font-size: 14px;
            color: #334155;
            line-height: 1.6;
        }

        .review-empty {
            text-align: center;
            color: #64748b;
            font-size: 14px;
            padding: 20px;
        }

        @media screen and (max-width: 900px) {
            .product-detail-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="product-detail">
        <div class="container">
            <div class="product-detail-grid">
                <div class="product-detail-image">
                    {% if supplement.image %}
                        <img src="{{ asset('uploads/supplements/' ~ supplement.image) }}" alt="{{ supplement.name }}">
                    {% else %}
                        <img src="{{ asset('images/image_1.jpg') }}" alt="{{ supplement.name }}">
                    {% endif %}
                </div>
                <div class="product-detail-info">
                    <div class="product-detail-brand">{{ supplement.brand }}</div>
                    <h1 class="product-detail-name">{{ supplement.name }}</h1>
                    <div class="product-detail-rating">
                        {% include 'shop/partials/rating_stars.html.twig' with { rating: ratingAverage, count: ratingCount } %}
                    </div>
                    <div class="product-detail-price">{{ supplement.price }} DT</div>
                    <div class="product-detail-stock">
                        {% if supplement.stock > 0 %}
                            In stock ({{ supplement.stock }})
                        {% else %}
                            Out of stock
                        {% endif %}
                    </div>
                    <div class="product-detail-description">
                        {{ supplement.description }}
                    </div>
                    <div class="product-detail-actions">
                        {% if supplement.stock > 0 %}
                            <button class="add-to-cart-btn" data-id="{{ supplement.id }}" data-name="{{ supplement.name }}">
                                <i class="fa fa-shopping-cart"></i> Add to Cart
                            </button>
                        {% else %}
                            <button class="add-to-cart-btn" disabled>
                                <i class="fa fa-times"></i> Out of Stock
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="reviews-section" id="reviews">
                <div class="reviews-header">Ratings & Comments</div>

                <div class="review-form">
                    {% if app.user %}
                        <form method="post" action="{{ path('app_shop_product_review', {id: supplement.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('review' ~ supplement.id) }}">
                            <div class="form-group">
                                <label>Your Name</label>
                                <input type="text" value="{{ app.user.username }}" readonly>
                                <div class="rating-hint">Your username will be used for this review.</div>
                            </div>
                            <div class="form-group">
                                <label>Rating *</label>
                                <div class="rating-input" id="ratingInput">
                                    <button type="button" class="rating-star" data-value="1" aria-label="1 star">
                                        <i class="fa fa-star-o"></i>
                                    </button>
                                    <button type="button" class="rating-star" data-value="2" aria-label="2 stars">
                                        <i class="fa fa-star-o"></i>
                                    </button>
                                    <button type="button" class="rating-star" data-value="3" aria-label="3 stars">
                                        <i class="fa fa-star-o"></i>
                                    </button>
                                    <button type="button" class="rating-star" data-value="4" aria-label="4 stars">
                                        <i class="fa fa-star-o"></i>
                                    </button>
                                    <button type="button" class="rating-star" data-value="5" aria-label="5 stars">
                                        <i class="fa fa-star-o"></i>
                                    </button>
                                </div>
                                <input type="hidden" id="review-rating" name="rating" required>
                                <div class="rating-hint" id="ratingHint">Click a star to rate</div>
                            </div>
                            <div class="form-group">
                                <label for="review-comment">Comment *</label>
                                <textarea id="review-comment" name="comment" required></textarea>
                            </div>
                            <button type="submit" class="review-submit">Submit Review</button>
                        </form>
                    {% else %}
                        <div class="review-empty">Sign in to leave a rating and comment.</div>
                        <a href="{{ path('app_login') }}" class="review-submit" style="display:inline-block;text-align:center;">
                            Sign in
                        </a>
                    {% endif %}
                </div>

                <div class="review-list">
                    {% for review in reviews %}
                        <div class="review-card">
                            <div class="review-card-header">
                                <div class="review-card-name">{{ review.name }}</div>
                                <div class="review-card-date">{{ review.createdAt|date('Y-m-d') }}</div>
                            </div>
                            <div class="review-card-rating">
                                {% include 'shop/partials/rating_stars.html.twig' with { rating: review.rating } %}
                            </div>
                            <div class="review-card-comment">{{ review.comment }}</div>
                        </div>
                    {% else %}
                        <div class="review-empty">No reviews yet. Be the first to leave one.</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).on('click', '.add-to-cart-btn', function() {
            const supplementId = $(this).data('id');
            const productName = $(this).data('name');
            const button = $(this);

            if (!supplementId) {
                return;
            }

            button.prop('disabled', true);

            $.ajax({
                url: '{{ path('app_shop_cart_add') }}',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    supplementId: supplementId,
                    quantity: 1
                }),
                success: function(response) {
                    if (response.success) {
                        updateCartCount();
                        alert(productName + ' added to cart!');
                    }
                    button.prop('disabled', false);
                },
                error: function() {
                    alert('Error adding product to cart');
                    button.prop('disabled', false);
                }
            });
        });

        (function() {
            const ratingInput = document.getElementById('ratingInput');
            const ratingValue = document.getElementById('review-rating');
            const ratingHint = document.getElementById('ratingHint');

            if (!ratingInput || !ratingValue) {
                return;
            }

            let selectedValue = 0;

            function updateStars(value) {
                const stars = ratingInput.querySelectorAll('.rating-star');
                stars.forEach(function(star) {
                    const starValue = parseInt(star.getAttribute('data-value'), 10);
                    if (starValue <= value) {
                        star.classList.add('active');
                        star.innerHTML = '<i class="fa fa-star"></i>';
                    } else {
                        star.classList.remove('active');
                        star.innerHTML = '<i class="fa fa-star-o"></i>';
                    }
                });

                if (ratingHint) {
                    ratingHint.textContent = value > 0 ? ('You selected ' + value + ' star' + (value > 1 ? 's' : '')) : 'Click a star to rate';
                }
            }

            ratingInput.addEventListener('click', function(event) {
                const button = event.target.closest('.rating-star');
                if (!button) {
                    return;
                }

                const value = parseInt(button.getAttribute('data-value'), 10);
                selectedValue = value;
                ratingValue.value = value;
                updateStars(value);
            });

            ratingInput.addEventListener('mouseover', function(event) {
                const button = event.target.closest('.rating-star');
                if (!button) {
                    return;
                }

                const value = parseInt(button.getAttribute('data-value'), 10);
                updateStars(value);
            });

            ratingInput.addEventListener('mouseleave', function() {
                updateStars(selectedValue);
            });
        })();
    </script>
{% endblock %}
