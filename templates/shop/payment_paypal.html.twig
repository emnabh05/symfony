{% extends 'shop/base.html.twig' %}

{% block title %}Paiement PayPal - Fitopia Supplements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/cart.css') }}">
    <link rel="stylesheet" href="{{ asset('css/checkout.css') }}">
    <link rel="stylesheet" href="{{ asset('css/payment.css') }}">
{% endblock %}

{% block body %}
    <!-- Payment Section -->
    <section class="payment-section">
        <div class="container">
            <div class="checkout-steps">
                <div class="step completed">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Panier</span>
                </div>
                <div class="step-line"></div>
                <div class="step completed">
                    <i class="fas fa-user"></i>
                    <span>Informations</span>
                </div>
                <div class="step-line"></div>
                <div class="step active">
                    <i class="fas fa-credit-card"></i>
                    <span>Paiement</span>
                </div>
            </div>

            <div class="payment-layout">
                <!-- Payment Form -->
                <div class="payment-main">
                    <div class="payment-header paypal-header">
                        <i class="fab fa-paypal"></i>
                        <h2>Connexion PayPal</h2>
                        <p>Connectez-vous à votre compte PayPal pour finaliser le paiement</p>
                    </div>

                    <form id="paypalForm" class="payment-form">
                        <div class="form-group">
                            <label for="paypalEmail">Email ou numéro de mobile *</label>
                            <input type="email" id="paypalEmail" name="paypalEmail" 
                                   placeholder="exemple@email.com" required>
                        </div>

                        <div class="form-group">
                            <label for="paypalPassword">Mot de passe *</label>
                            <input type="password" id="paypalPassword" name="paypalPassword" 
                                   placeholder="Entrez votre mot de passe" required>
                        </div>

                        <div class="paypal-links">
                            <a href="#" class="paypal-link">Mot de passe oublié?</a>
                        </div>

                        <div class="security-info">
                            <i class="fas fa-shield-alt"></i>
                            <span>Vos informations PayPal sont sécurisées</span>
                        </div>

                        <div class="form-actions">
                            <a href="{{ path('app_shop_checkout') }}" class="back-btn">
                                <i class="fas fa-arrow-left"></i> Retour
                            </a>
                            <button type="submit" class="submit-payment-btn paypal-btn">
                                <i class="fab fa-paypal"></i> Se connecter et payer
                            </button>
                        </div>
                    </form>

                    <div class="paypal-signup">
                        <p>Vous n'avez pas de compte PayPal?</p>
                        <a href="#" class="signup-link">Créer un compte</a>
                    </div>
                </div>

                <!-- Payment Summary -->
                <aside class="payment-summary">
                    <h3>Pourquoi PayPal?</h3>
                    <div class="payment-info">
                        <div class="info-row">
                            <i class="fas fa-shield-alt"></i>
                            <span>Protection des achats</span>
                        </div>
                        <div class="info-row">
                            <i class="fas fa-lock"></i>
                            <span>Paiement sécurisé</span>
                        </div>
                        <div class="info-row">
                            <i class="fas fa-check-circle"></i>
                            <span>Rapide et facile</span>
                        </div>
                        <div class="info-row">
                            <i class="fas fa-globe"></i>
                            <span>Accepté mondialement</span>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Get order number from URL
        const urlParams = new URLSearchParams(window.location.search);
        const orderNumber = urlParams.get('order');

        // Submit PayPal payment (simulated)
        $('#paypalForm').on('submit', function(e) {
            e.preventDefault();
            
            // Simulate PayPal authentication
            const btn = $('.submit-payment-btn');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Connexion...');
            
            setTimeout(function() {
                // Redirect to success page
                if (orderNumber) {
                    window.location.href = '{{ path('app_shop_order_success', {orderNumber: '__ORDER__'}) }}'.replace('__ORDER__', orderNumber);
                } else {
                    alert('Numéro de commande manquant');
                    btn.prop('disabled', false).html('<i class="fab fa-paypal"></i> Se connecter et payer');
                }
            }, 2000);
        });
    </script>
{% endblock %}

