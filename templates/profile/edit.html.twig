{% extends 'base.html.twig' %}

{% block title %}Profile Security | Fitopia{% endblock %}

{% block stylesheets %}
<style>
  .profile-wrap {
    padding: 3rem 0 4rem;
  }
  .profile-card {
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 22px 60px rgba(14, 30, 37, 0.14);
  }
  .profile-header {
    background: linear-gradient(160deg, #0b5f61 0%, #176f69 50%, #2f8a7d 100%);
    color: #fff;
    padding: 2rem;
  }
  .profile-header h2 {
    margin: 0 0 0.4rem;
    font-size: 1.95rem;
    font-weight: 800;
  }
  .profile-header p {
    margin: 0;
    max-width: 700px;
    opacity: 0.92;
  }
  .profile-body {
    padding: 2rem;
  }
  .profile-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }
  .profile-badges {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .profile-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 700;
    background: #eef7f5;
    color: #0b5f61;
  }
  .profile-form .form-control,
  .profile-form textarea,
  .profile-form input[type="date"] {
    min-height: 54px;
    border-radius: 18px;
    border: 1px solid #d9e5f1;
    box-shadow: none;
    padding: 0.95rem 1.1rem;
  }
  .profile-form textarea.form-control {
    min-height: 110px;
  }
  .security-card {
    margin-top: 1.4rem;
    border: 1px solid #dbe6f2;
    border-radius: 18px;
    background: #f7fbff;
    padding: 1.1rem;
  }
  .security-card h4 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f355c;
    margin-bottom: 0.4rem;
  }
  .security-card p {
    color: #6279a2;
    margin-bottom: 0.8rem;
  }
  .face-preview,
  #profile-face-video {
    width: 100%;
    max-width: 420px;
    border-radius: 14px;
    background: #0f172a;
    display: block;
  }
  .danger-zone {
    margin-top: 1.8rem;
    border: 1px solid #f4c7cb;
    background: #fff5f5;
    border-radius: 18px;
    padding: 1.2rem;
  }
  .danger-zone h4 {
    margin-bottom: 0.45rem;
    font-weight: 800;
    color: #9b1c1c;
  }
  .danger-zone p {
    margin-bottom: 0.9rem;
    color: #7f1d1d;
  }
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1200;
  }
  .modal-card {
    width: min(420px, 92vw);
    background: #fff;
    border-radius: 18px;
    padding: 1.4rem;
  }
  .modal-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    margin-top: 1rem;
  }
</style>
{% endblock %}

{% block body %}
<section class="container profile-wrap">
  <div class="profile-card">
    <div class="profile-header">
      <h2>Profile Security</h2>
      <p>Les informations de compte ne s'affichent plus ici apres connexion. Vous arrivez directement sur le Diet &amp; Eating Planner, et cette page garde seulement les actions de securite utiles.</p>
    </div>

    <div class="profile-body">
      {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
      {% endfor %}
      {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
      {% endfor %}

      <div class="profile-topbar">
        <div class="profile-badges">
          <span class="profile-pill">Role: {{ app.user.role ?? 'Patient' }}</span>
          <span class="profile-pill">Face ID: {{ app.user and app.user.faceIdEnabled ? 'Enabled' : 'Disabled' }}</span>
        </div>
        <a href="{{ path('app_logout') }}" class="btn btn-outline-dark">Logout</a>
      </div>

      <div class="security-card">
        <h4>Face ID</h4>
        <p>Capture your face here to keep the Java-style Face ID login available in Symfony too.</p>
        <div class="mb-2">
          <span class="badge badge-{{ app.user and app.user.faceIdEnabled ? 'success' : 'secondary' }}">
            {{ app.user and app.user.faceIdEnabled ? 'Enrolled' : 'Not enrolled' }}
          </span>
        </div>
        <video id="profile-face-video" autoplay playsinline></video>
        <canvas id="profile-face-canvas" style="display:none;"></canvas>
        <img id="profile-face-preview" class="face-preview mt-2" alt="Face capture preview" style="display:none;">
        <small id="profile-face-status" class="text-muted d-block mt-2">Camera starts automatically. Click Save My Face when ready.</small>

        <form method="post" action="{{ path('app_profile_face_id_enroll') }}" class="mt-3" id="profile-face-enroll-form">
          <input type="hidden" name="_token" value="{{ csrf_token('profile_face_id_enroll') }}">
          <input type="hidden" name="image_base64" id="profile-face-image">
          <button class="btn btn-dark" type="submit">Save My Face</button>
        </form>

        <form method="post" action="{{ path('app_profile_face_id_remove') }}" class="mt-2">
          <input type="hidden" name="_token" value="{{ csrf_token('profile_face_id_remove') }}">
          <button class="btn btn-outline-danger" type="submit">Remove Face ID</button>
        </form>
      </div>

      <div class="danger-zone">
        <h4>Delete Account</h4>
        <p>This action is permanent and removes your Fitopia account from Symfony and the legacy Java side.</p>
        <button type="button" class="btn btn-danger" id="delete-account-btn">Delete my account</button>
      </div>

      <form id="delete-account-form" method="post" action="{{ path('app_profile_delete') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
      </form>

      <div class="modal-backdrop" id="delete-modal">
        <div class="modal-card">
          <h4>Delete account</h4>
          <p>Are you sure you want to permanently delete this account?</p>
          <div class="modal-actions">
            <button class="btn btn-outline-secondary" type="button" id="delete-cancel-btn">Cancel</button>
            <button class="btn btn-danger" type="button" id="delete-confirm-btn">Yes, delete</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block footer %}{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('delete-account-btn');
    const modal = document.getElementById('delete-modal');
    const cancelBtn = document.getElementById('delete-cancel-btn');
    const confirmBtn = document.getElementById('delete-confirm-btn');
    const deleteForm = document.getElementById('delete-account-form');
    const faceVideo = document.getElementById('profile-face-video');
    const faceCanvas = document.getElementById('profile-face-canvas');
    const facePreview = document.getElementById('profile-face-preview');
    const faceEnrollForm = document.getElementById('profile-face-enroll-form');
    const faceImage = document.getElementById('profile-face-image');
    const faceStatus = document.getElementById('profile-face-status');
    let faceStream = null;

    openBtn?.addEventListener('click', () => {
      if (modal) {
        modal.style.display = 'flex';
      }
    });

    cancelBtn?.addEventListener('click', () => {
      if (modal) {
        modal.style.display = 'none';
      }
    });

    confirmBtn?.addEventListener('click', () => {
      deleteForm?.submit();
    });

    modal?.addEventListener('click', (event) => {
      if (event.target === modal) {
        modal.style.display = 'none';
      }
    });

    async function startProfileFaceCamera() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        if (faceStatus) {
          faceStatus.textContent = 'Camera is unavailable.';
        }
        return false;
      }

      try {
        faceStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        faceVideo.srcObject = faceStream;
        if (faceStatus) {
          faceStatus.textContent = 'Camera ready.';
        }
        return true;
      } catch (error) {
        if (faceStatus) {
          faceStatus.textContent = 'Unable to access camera.';
        }
        return false;
      }
    }

    function captureProfileFace() {
      if (!faceStream) {
        return false;
      }

      const width = faceVideo.videoWidth || 640;
      const height = faceVideo.videoHeight || 480;
      faceCanvas.width = width;
      faceCanvas.height = height;

      const ctx = faceCanvas.getContext('2d');
      ctx.drawImage(faceVideo, 0, 0, width, height);

      const dataUrl = faceCanvas.toDataURL('image/jpeg', 0.75);
      faceImage.value = dataUrl.replace(/^data:image\/jpeg;base64,/, '');
      facePreview.src = dataUrl;
      facePreview.style.display = 'block';
      if (faceStatus) {
        faceStatus.textContent = 'Face captured.';
      }
      return true;
    }

    startProfileFaceCamera();

    faceEnrollForm?.addEventListener('submit', async (event) => {
      if (!faceImage.value) {
        if (!faceStream) {
          await startProfileFaceCamera();
        }

        const ok = captureProfileFace();
        if (!ok) {
          event.preventDefault();
          if (faceStatus) {
            faceStatus.textContent = 'Camera not ready yet. Please retry.';
          }
        }
      }
    });
  });
</script>
{% endblock %}
