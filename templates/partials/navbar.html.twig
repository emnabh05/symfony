{% set currentRoute = app.request.attributes.get('_route')|default('') %}
{% set isHome = currentRoute in ['home', 'home_public', 'home_public_slash', 'home_index_php', 'home_index_php_slash'] %}
{% set isAbout = currentRoute == 'about' %}
{% set isDiet = currentRoute == 'diet_planner' or currentRoute starts with 'diet_' %}
{% set isSupplements = currentRoute == 'supplements' or currentRoute starts with 'app_shop_' %}
{% set isFitness = currentRoute == 'fitness_planner' %}
{% set isEvents = currentRoute == 'events' or currentRoute starts with 'reservation_' or currentRoute starts with 'waitlist_' or currentRoute starts with 'events_' %}
{% set isCommunity = currentRoute == 'explore_forums_blogs' or currentRoute == 'blog' %}

{% set dietHref = app.user ? path('diet_planner') : '#' %}
{% set supplementsHref = app.user ? path('supplements') : '#' %}
{% set fitnessHref = app.user ? path('fitness_planner') : '#' %}
{% set eventsHref = app.user ? path('events') : '#' %}
{% set communityHref = app.user ? path('explore_forums_blogs') : '#' %}

<style>
  .fitopia-global-topbar {
    background: #0f7a5f;
    color: #ffffff;
    padding: 10px 38px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
    line-height: 1.35;
  }

  .fitopia-global-topbar a {
    color: inherit;
    text-decoration: none;
  }

  .fitopia-global-socials {
    display: inline-flex;
    align-items: center;
    gap: 26px;
    flex-shrink: 0;
  }

  .fitopia-global-shell {
    background: #ffffff;
    border-bottom: 1px solid #d9e4ea;
    box-shadow: 0 12px 30px rgba(15, 37, 65, 0.05);
  }

  .fitopia-global-shell .container-fluid {
    padding: 0 18px;
  }

  .fitopia-main-nav {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 24px;
    min-height: 128px;
    padding: 18px 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
  }

  .fitopia-main-nav::-webkit-scrollbar {
    height: 8px;
  }

  .fitopia-main-nav::-webkit-scrollbar-thumb {
    background: #d0dbe3;
    border-radius: 999px;
  }

  .fitopia-brand {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 84px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .fitopia-brand img {
    height: 40px;
    width: auto;
    display: block;
  }

  .fitopia-brand span {
    color: #072f3f;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.06em;
  }

  .fitopia-basic-links,
  .fitopia-feature-links,
  .fitopia-nav-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-shrink: 0;
  }

  .fitopia-feature-links {
    flex: 1 1 auto;
    min-width: 0;
    gap: 14px;
    flex-wrap: nowrap;
  }

  .fitopia-nav-spacer {
    flex: 1 1 auto;
    min-width: 20px;
  }

  .fitopia-basic-link {
    position: relative;
    color: #0f9b74;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    padding: 8px 0;
  }

  .fitopia-basic-link:hover {
    color: #0f7a5f;
    text-decoration: none;
  }

  .fitopia-basic-link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -10px;
    height: 3px;
    border-radius: 999px;
    background: #0f9b74;
  }

  .fitopia-feature-link {
    flex: 1 1 0;
    min-width: 138px;
    max-width: 168px;
    min-height: 92px;
    padding: 12px 12px;
    border: 1px solid #cad9e3;
    border-radius: 6px;
    background: #ffffff;
    color: #08263a;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-transform: uppercase;
    font-size: 11px;
    line-height: 1.22;
    font-weight: 900;
    letter-spacing: 0.01em;
    transition: border-color .2s ease, box-shadow .2s ease, color .2s ease, background .2s ease;
  }

  .fitopia-feature-link:hover {
    text-decoration: none;
    color: #0f7a5f;
    border-color: #1cc48e;
    box-shadow: 0 10px 24px rgba(20, 78, 66, 0.08);
  }

  .fitopia-feature-link.is-active {
    border-color: #19c691;
    box-shadow: inset 0 0 0 1px #19c691;
  }

  .fitopia-user-pill,
  .fitopia-auth-link,
  .fitopia-logout-link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all .2s ease;
  }

  .fitopia-user-pill {
    min-width: 92px;
    height: 64px;
    padding: 0 22px;
    border-radius: 999px;
    background: #eef8f4;
    border: 1px solid #cfe6db;
    color: #0a6c59;
    gap: 14px;
    font-size: 22px;
  }

  .fitopia-user-pill:hover,
  .fitopia-user-pill:focus {
    color: #0a6c59;
    text-decoration: none;
    background: #e6f5ef;
  }

  .fitopia-logout-link {
    min-width: 128px;
    height: 74px;
    padding: 0 24px;
    border-radius: 18px;
    border: 2px solid #f4c8d0;
    background: #ffffff;
    color: #ff3b30;
    font-size: 16px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .fitopia-logout-link:hover {
    color: #ff3b30;
    text-decoration: none;
    background: #fff8f9;
  }

  .fitopia-auth-link {
    min-width: 118px;
    height: 56px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
  }

  .fitopia-auth-link.login {
    border: 1px solid #cfe6db;
    background: #eef8f4;
    color: #0a6c59;
  }

  .fitopia-auth-link.register {
    border: 1px solid #ffb9bc;
    background: #ffffff;
    color: #ff4b40;
  }

  .fitopia-auth-link:hover {
    text-decoration: none;
    opacity: .92;
  }

  .fitopia-profile-menu {
    border: 0;
    border-radius: 16px;
    box-shadow: 0 16px 38px rgba(15, 37, 65, 0.12);
    padding: 10px;
    min-width: 240px;
  }

  .fitopia-profile-head {
    padding: 10px 12px 12px;
    border-bottom: 1px solid #edf2f7;
    margin-bottom: 6px;
  }

  .fitopia-profile-head strong {
    display: block;
    color: #08263a;
    font-size: 14px;
  }

  .fitopia-profile-head span {
    display: block;
    color: #6b7a8d;
    font-size: 12px;
    margin-top: 2px;
    word-break: break-word;
  }

  .fitopia-profile-menu .dropdown-item {
    border-radius: 12px;
    padding: 10px 12px;
    font-weight: 700;
    color: #123247;
  }

  .fitopia-profile-menu .dropdown-item:hover {
    background: #f2f7fb;
  }

  .fitopia-nav-actions {
    margin-left: auto;
  }

  .fitopia-user-pill::after {
    display: none;
  }

  @media (max-width: 1760px) {
    .fitopia-main-nav {
      gap: 18px;
    }

    .fitopia-basic-links,
    .fitopia-nav-actions {
      gap: 16px;
    }

    .fitopia-feature-link {
      min-width: 128px;
      max-width: 156px;
      min-height: 88px;
      font-size: 10.5px;
      padding: 10px 10px;
    }
  }

  @media (max-width: 1280px) {
    .fitopia-main-nav {
      align-items: flex-start;
      flex-wrap: wrap;
      overflow-x: visible;
    }

    .fitopia-basic-links {
      gap: 16px;
    }

    .fitopia-feature-links {
      flex-basis: 100%;
      order: 3;
      flex-wrap: wrap;
    }

    .fitopia-nav-spacer {
      display: none;
    }

    .fitopia-nav-actions {
      order: 2;
    }
  }

  @media (max-width: 991.98px) {
    .fitopia-global-topbar {
      padding: 10px 18px;
      font-size: 12px;
      flex-wrap: wrap;
    }

    .fitopia-main-nav {
      min-height: auto;
      align-items: flex-start;
      flex-wrap: wrap;
      overflow-x: visible;
    }

    .fitopia-basic-links,
    .fitopia-feature-links,
    .fitopia-nav-actions {
      width: 100%;
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .fitopia-feature-link {
      flex: 1 1 220px;
      min-width: 220px;
      max-width: none;
    }

    .fitopia-nav-actions {
      margin-left: 0;
    }
  }
</style>

<div class="fitopia-global-topbar">
  <div>Phone no: +216 58 938 889 or email us: customerservice@fitopia.com</div>
  <div class="fitopia-global-socials">
    <a href="#">FB</a>
    <a href="#">X</a>
    <a href="#">IG</a>
  </div>
</div>

<div class="fitopia-global-shell">
  <div class="container-fluid">
    <div class="fitopia-main-nav">
      <a href="{{ path('home') }}" class="fitopia-brand" aria-label="Fitopia home">
        <img src="{{ asset('images/logo.png') }}" alt="Fitopia logo">
        <span>FITOPIA</span>
      </a>

      <div class="fitopia-basic-links">
        <a href="{{ path('home') }}" class="fitopia-basic-link {{ isHome ? 'is-active' : '' }}">Home</a>
        <a href="{{ path('about') }}" class="fitopia-basic-link {{ isAbout ? 'is-active' : '' }}">About<br>Fitopia</a>
      </div>

      <div class="fitopia-feature-links">
        <a
          href="{{ dietHref }}"
          class="fitopia-feature-link {{ isDiet ? 'is-active' : '' }}"
          {% if not app.user %}id="diet-planner-guest-btn"{% endif %}
        >Explore<br>Our<br>Diet&amp;Eating<br>Planner</a>
        <a
          href="{{ supplementsHref }}"
          class="fitopia-feature-link {{ isSupplements ? 'is-active' : '' }}"
          {% if not app.user %}id="supplements-guest-btn"{% endif %}
        >Explore<br>Our<br>Supplements</a>
        <a
          href="{{ fitnessHref }}"
          class="fitopia-feature-link {{ isFitness ? 'is-active' : '' }}"
          {% if not app.user %}id="fitness-planner-guest-btn"{% endif %}
        >Explore<br>Our<br>Fitness<br>Planner</a>
        <a
          href="{{ eventsHref }}"
          class="fitopia-feature-link {{ isEvents ? 'is-active' : '' }}"
          {% if not app.user %}id="events-guest-btn"{% endif %}
        >Explore<br>Our<br>Events</a>
        <a
          href="{{ communityHref }}"
          class="fitopia-feature-link {{ isCommunity ? 'is-active' : '' }}"
          {% if not app.user %}id="explore-guest-btn"{% endif %}
        >Explore<br>Forums&amp;Blogs</a>
      </div>

      <div class="fitopia-nav-spacer"></div>

      <div class="fitopia-nav-actions">
        {% if app.user %}
          <div class="dropdown">
            <a
              href="#"
              class="fitopia-user-pill dropdown-toggle"
              id="fitopiaUserMenu"
              data-toggle="dropdown"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span class="fa fa-user"></span>
              <span class="fa fa-angle-down" style="font-size:16px;"></span>
            </a>
            <div class="dropdown-menu dropdown-menu-right fitopia-profile-menu" aria-labelledby="fitopiaUserMenu">
              <div class="fitopia-profile-head">
                <strong>{{ app.user.userIdentifier }}</strong>
                <span>{{ app.user.email }}</span>
              </div>
              <a class="dropdown-item" href="{{ path('diet_planner') }}">Open Diet Planner</a>
            </div>
          </div>
          <a href="{{ path('app_logout') }}" class="fitopia-logout-link">Logout</a>
        {% else %}
          <a href="{{ path('app_login') }}" class="fitopia-auth-link login">Login</a>
          <a href="{{ path('app_register') }}" class="fitopia-auth-link register">Register</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
