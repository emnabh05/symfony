{% extends 'base.html.twig' %}

{% block title %}Login | Fitopia{% endblock %}

{% block stylesheets %}
<style>
  .login-page-shell {
    background: #f6fafb;
    min-height: 100vh;
  }
  .login-wrap {
    display: flex;
    align-items: center;
    padding: 2rem 0 4rem;
  }
  .login-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 1.8rem;
    align-items: stretch;
  }
  .login-panel {
    background: linear-gradient(160deg, #0b5f61 0%, #176f69 50%, #2f8a7d 100%);
    color: #fff;
    border-radius: 22px;
    padding: 2.4rem;
    box-shadow: 0 22px 60px rgba(14, 30, 37, 0.14);
  }
  .brand-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.4rem;
  }
  .brand-row img {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #fff;
    padding: 6px;
  }
  .brand-chip {
    background: #fff;
    color: #0b5f61;
    border-radius: 16px;
    padding: 0.55rem 1.1rem;
    font-weight: 800;
    font-size: 1.05rem;
  }
  .login-panel .kicker {
    font-size: 0.92rem;
    font-weight: 700;
    opacity: 0.86;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .login-panel h2 {
    font-size: 2rem;
    line-height: 1.35;
    font-weight: 800;
    color: #08303f;
    margin-bottom: 1rem;
  }
  .login-panel p {
    line-height: 1.65;
    font-size: 1.02rem;
    margin-bottom: 1.5rem;
  }
  .feature-list {
    display: grid;
    gap: 0.9rem;
  }
  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border-radius: 18px;
    padding: 0.9rem 1rem;
    background: rgba(255, 255, 255, 0.12);
  }
  .feature-index {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }
  .login-card {
    background: #fff;
    border-radius: 22px;
    padding: 2.2rem;
    box-shadow: 0 22px 60px rgba(14, 30, 37, 0.14);
  }
  .login-loading-overlay {
    position: fixed;
    inset: 0;
    z-index: 5000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(211, 240, 236, 0.72);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s ease;
  }
  .login-loading-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }
  .login-loading-stage {
    position: relative;
    width: min(560px, 100%);
    min-height: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .login-loading-orbit {
    position: relative;
    width: 360px;
    height: 360px;
    max-width: 84vw;
    max-height: 84vw;
    margin-bottom: 1.25rem;
  }
  .login-loading-ring {
    position: absolute;
    inset: 0;
    animation: orbitSpin 2.8s linear infinite;
    transform-origin: 50% 50%;
  }
  .login-loading-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150px;
    height: 150px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 24px 44px rgba(19, 61, 76, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .login-loading-core img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14px;
  }
  .loading-bubble {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1ca0db 0%, #6fd2ff 100%);
    opacity: 0.95;
    box-shadow: 0 10px 26px rgba(28, 160, 219, 0.26);
    transform: translate(-50%, -50%);
    animation: bubblePulse 1.5s ease-in-out infinite;
  }
  .loading-bubble.b1 { top: 8%; animation-delay: 0s; }
  .loading-bubble.b2 { left: 73%; top: 14%; animation-delay: .12s; }
  .loading-bubble.b3 { left: 87%; top: 38%; animation-delay: .24s; }
  .loading-bubble.b4 { left: 84%; top: 66%; animation-delay: .36s; }
  .loading-bubble.b5 { left: 66%; top: 85%; animation-delay: .48s; }
  .loading-bubble.b6 { left: 34%; top: 85%; animation-delay: .6s; }
  .loading-bubble.b7 { left: 16%; top: 66%; animation-delay: .72s; }
  .loading-bubble.b8 { left: 13%; top: 38%; animation-delay: .84s; }
  .loading-bubble.b9 { left: 27%; top: 14%; animation-delay: .96s; }
  .login-loading-title {
    margin: 0 0 .5rem;
    color: #12343b;
    font-size: 1.5rem;
    font-weight: 800;
  }
  .login-loading-copy {
    margin: 0;
    color: #26515d;
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .login-loading-dots {
    display: inline-flex;
    gap: 8px;
    margin-top: 1rem;
  }
  .login-loading-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #b7c8ce;
    animation: dotsBlink 1.1s infinite ease-in-out;
  }
  .login-loading-dots span:nth-child(2) { animation-delay: .12s; }
  .login-loading-dots span:nth-child(3) { animation-delay: .24s; }
  .login-loading-dots span:nth-child(4) { animation-delay: .36s; }
  .login-loading-dots span:nth-child(5) { animation-delay: .48s; }
  .login-loading-dots span:nth-child(6) { animation-delay: .6s; }
  .login-loading-dots span:nth-child(7) { animation-delay: .72s; }
  .login-loading-dots span:nth-child(8) { animation-delay: .84s; }
  .login-loading-dots span:nth-child(9) { animation-delay: .96s; }
  .login-loading-dots span:nth-child(10) { animation-delay: 1.08s; }
  .login-loading-dots span:nth-child(11) { animation-delay: 1.2s; }
  .login-loading-dots span:nth-child(12) { animation-delay: 1.32s; }
  @keyframes orbitSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes bubblePulse {
    0%, 100% { transform: translate(-50%, -50%) scale(0.92); opacity: 0.82; }
    50% { transform: translate(-50%, -50%) scale(1.08); opacity: 1; }
  }
  @keyframes dotsBlink {
    0%, 100% { background: #c4d3d8; }
    50% { background: #6baed0; }
  }
  .login-card h3 {
    font-size: 2.1rem;
    font-weight: 800;
    color: #0f355c;
    margin-bottom: 0.4rem;
  }
  .login-card .subtle {
    color: #6279a2;
    font-size: 1.02rem;
    margin-bottom: 1.2rem;
  }
  .login-card .form-control,
  .login-card input[type="date"] {
    min-height: 54px;
    border-radius: 18px;
    border: 1px solid #d9e5f1;
    box-shadow: none;
    padding: 0.95rem 1.1rem;
  }
  .challenge-card,
  .forgot-box,
  .face-camera {
    border: 1px solid #dbe6f2;
    border-radius: 20px;
    background: #f7fbff;
    padding: 1rem 1.1rem;
  }
  .face-section {
    display: none;
    margin-top: 1rem;
  }
  .face-section.active {
    display: block;
  }
  .face-camera video {
    width: 100%;
    border-radius: 14px;
    background: #0f172a;
  }
  .face-camera-preview {
    width: 100%;
    border-radius: 14px;
    margin-top: 0.8rem;
    display: none;
  }
  .forgot-box {
    margin-top: 1rem;
    display: none;
  }
  .forgot-box.active {
    display: block;
  }
  .forgot-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.8rem;
  }
  @media (max-width: 991px) {
    .login-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
{% endblock %}

{% block body %}
<div class="login-page-shell">
  <div class="login-loading-overlay" id="login-loading-overlay" aria-hidden="true">
    <div class="login-loading-stage">
      <div class="login-loading-orbit">
        <div class="login-loading-ring" aria-hidden="true">
          <span class="loading-bubble b1"></span>
          <span class="loading-bubble b2"></span>
          <span class="loading-bubble b3"></span>
          <span class="loading-bubble b4"></span>
          <span class="loading-bubble b5"></span>
          <span class="loading-bubble b6"></span>
          <span class="loading-bubble b7"></span>
          <span class="loading-bubble b8"></span>
          <span class="loading-bubble b9"></span>
        </div>
        <div class="login-loading-core">
          <img src="{{ asset('images/logo.png') }}" alt="Fitopia">
        </div>
      </div>
      <h3 class="login-loading-title">Connexion reussie, bienvenue chez Fitopia</h3>
      <p class="login-loading-copy">Fitopia prepare votre espace...</p>
      <div class="login-loading-dots" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
  </div>
  {% include 'partials/navbar.html.twig' %}
  <div class="container login-wrap">
    <div class="login-grid">
      <div class="login-panel">
        <div class="brand-row">
          <img src="{{ asset('images/logo.png') }}" alt="Fitopia logo">
          <div class="brand-chip">fitopia</div>
        </div>
        <div class="kicker">Welcome Fitopia</div>
        <h2>Access a cleaner, smarter Fitopia sign in experience.</h2>
        <p>Connectez-vous a votre espace front ou admin depuis une interface plus claire, plus elegante et mieux alignee avec la homepage de ton projet.</p>

        <div class="feature-list">
          <div class="feature-item">
            <span class="feature-index">01</span>
            <strong>Navigation coherente entre home, login et modules Fitopia.</strong>
          </div>
          <div class="feature-item">
            <span class="feature-index">02</span>
            <strong>Connexion classique ou verification Face ID deja integree.</strong>
          </div>
          <div class="feature-item">
            <span class="feature-index">03</span>
            <strong>Challenge anti-robot et recuperation de mot de passe toujours disponibles.</strong>
          </div>
        </div>
      </div>

      <div class="login-card">
        <h3>Sign In</h3>
        <p class="subtle">Email / Username + Password</p>

        <form method="post" id="classic-login-form">
          {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
          {% endfor %}
          {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
          {% endfor %}
          {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
          {% endif %}

          <div class="mb-3">
            <label for="inputEmail" class="form-label">Email ou Username</label>
            <input type="text" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" placeholder="exemple@mail.com" required autofocus>
          </div>

          <div class="mb-3">
            <label for="inputPassword" class="form-label">Mot de passe</label>
            <input type="password" name="password" id="inputPassword" class="form-control" placeholder="Password" required>
          </div>

          <div class="challenge-card mb-3">
            <h5 class="mb-2" style="font-weight:800;color:#0f355c;">Verification anti-robot</h5>
            <div class="mb-2" style="color:#6279a2;">{{ anti_robot_question }}</div>
            <input type="text" name="anti_robot_answer" class="form-control" placeholder="Entrez votre reponse" required>
            <a href="{{ path('app_login', {renew_challenge: 1}) }}" class="btn btn-outline-secondary btn-sm mt-3">Renouveler le challenge</a>
          </div>

          <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

          <div class="d-grid gap-2">
            <button class="btn btn-dark btn-lg" type="submit">Se connecter</button>
            <button type="button" class="btn btn-outline-secondary btn-lg" id="show-face-panel-btn">Utiliser Face ID</button>
          </div>
        </form>

        <div class="face-section" id="auth-face-section">
          <form method="post" action="{{ path('app_login_face_id_camera') }}" id="face-id-camera-form">
            <div class="mb-3">
              <label for="faceIdEmail" class="form-label">Email</label>
              <input type="email" name="email" id="faceIdEmail" class="form-control" placeholder="exemple@mail.com" required>
            </div>

            <div class="face-camera">
              <video id="face-camera-video" autoplay playsinline></video>
              <canvas id="face-camera-canvas" style="display:none;"></canvas>
              <img id="face-camera-preview" class="face-camera-preview" alt="Face capture preview">
              <input type="hidden" name="image_base64" id="face-camera-image" required>
              <small id="face-camera-status" class="text-muted d-block mt-2">Camera starts automatically. Click login when ready.</small>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('face_id_authenticate') }}">

            <div class="d-grid gap-2 mt-3">
              <button class="btn btn-outline-dark" type="submit">Verifier mon Face ID</button>
            </div>
            <div id="face-action-error" class="alert alert-danger mt-3 mb-0" style="display:none;"></div>
          </form>
        </div>

        <div class="mt-4">
          <button type="button" class="btn btn-outline-secondary w-100" id="forgot-toggle-btn">Mot de passe oublie ?</button>
          <div class="forgot-box" id="forgot-box">
            <div class="mb-2 text-muted">Use the same reset API already connected to the legacy accounts.</div>
            <input type="email" id="forgot-email" class="form-control mb-2" placeholder="Email">
            <input type="text" id="forgot-code" class="form-control mb-2" placeholder="OTP code">
            <input type="password" id="forgot-password" class="form-control" placeholder="New password">
            <div class="forgot-actions">
              <button type="button" class="btn btn-outline-dark btn-sm" id="forgot-send-btn">Envoyer le code</button>
              <button type="button" class="btn btn-dark btn-sm" id="forgot-reset-btn">Reinitialiser</button>
            </div>
            <div id="forgot-status" class="mt-2 text-muted"></div>
          </div>
        </div>
        <div class="text-center mt-4">
          <p class="mb-2">Vous n'avez pas de compte ?</p>
          <a href="{{ path('app_register') }}" class="btn btn-outline-primary w-100">Sign Up</a>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block footer %}{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faceSection = document.getElementById('auth-face-section');
    const loginLoadingOverlay = document.getElementById('login-loading-overlay');
    const classicLoginForm = document.getElementById('classic-login-form');
    const showFacePanelBtn = document.getElementById('show-face-panel-btn');
    const video = document.getElementById('face-camera-video');
    const loginEmail = document.getElementById('inputEmail');
    const faceEmail = document.getElementById('faceIdEmail');
    const canvas = document.getElementById('face-camera-canvas');
    const preview = document.getElementById('face-camera-preview');
    const hiddenImage = document.getElementById('face-camera-image');
    const statusEl = document.getElementById('face-camera-status');
    const actionErrorEl = document.getElementById('face-action-error');
    const faceForm = document.getElementById('face-id-camera-form');
    const forgotToggleBtn = document.getElementById('forgot-toggle-btn');
    const forgotBox = document.getElementById('forgot-box');
    const forgotEmail = document.getElementById('forgot-email');
    const forgotCode = document.getElementById('forgot-code');
    const forgotPassword = document.getElementById('forgot-password');
    const forgotStatus = document.getElementById('forgot-status');
    const forgotSendBtn = document.getElementById('forgot-send-btn');
    const forgotResetBtn = document.getElementById('forgot-reset-btn');

    let stream = null;
    let cameraStarted = false;
    function launchLoadingThenSubmit(form) {
      if (!form) {
        return;
      }
      loginLoadingOverlay?.classList.add('active');
      document.body.style.overflow = 'hidden';
      form.querySelectorAll('button, input').forEach((field) => {
        if (field.tagName === 'BUTTON' || field.type === 'submit') {
          field.disabled = true;
        }
      });
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          form.dataset.loaderBypass = '1';
          HTMLFormElement.prototype.submit.call(form);
        });
      });
    }

    function showActionError(message) {
      if (!actionErrorEl) return;
      actionErrorEl.textContent = message;
      actionErrorEl.style.display = 'block';
    }

    function clearActionError() {
      if (!actionErrorEl) return;
      actionErrorEl.textContent = '';
      actionErrorEl.style.display = 'none';
    }

    async function startCamera() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        statusEl.textContent = 'Camera API unavailable in this browser/context.';
        return;
      }
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        cameraStarted = true;
        video.srcObject = stream;
        statusEl.textContent = 'Camera started. Place your face clearly and click login.';
      } catch (error) {
        statusEl.textContent = 'Unable to access camera. Allow permission and retry.';
      }
    }

    function captureFace() {
      if (!stream) {
        return false;
      }
      const width = video.videoWidth || 640;
      const height = video.videoHeight || 480;
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0, width, height);
      const dataUrl = canvas.toDataURL('image/jpeg', 0.72);
      hiddenImage.value = dataUrl.replace(/^data:image\/jpeg;base64,/, '');
      preview.src = dataUrl;
      preview.style.display = 'block';
      statusEl.textContent = 'Face captured.';
      clearActionError();
      return true;
    }

    async function postForm(url, payload) {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'Accept': 'application/json'
        },
        body: new URLSearchParams(payload)
      });

      const data = await response.json().catch(() => ({}));
      return { response, data };
    }

    classicLoginForm?.addEventListener('submit', (event) => {
      if (classicLoginForm.dataset.loaderBypass === '1') {
        return;
      }

      event.preventDefault();
      launchLoadingThenSubmit(classicLoginForm);
    });

    faceForm?.addEventListener('submit', async (event) => {
      if (faceForm.dataset.loaderBypass === '1') {
        return;
      }

      if (!hiddenImage.value) {
        if (!stream) {
          await startCamera();
        }
        const ok = captureFace();
        if (!ok) {
          event.preventDefault();
          statusEl.textContent = 'Camera not ready yet. Please allow camera and retry.';
          showActionError('Camera not ready. Please retry in 1-2 seconds.');
          return;
        }
      }

      event.preventDefault();
      launchLoadingThenSubmit(faceForm);
    });

    forgotToggleBtn?.addEventListener('click', () => {
      forgotBox?.classList.toggle('active');
    });

    forgotSendBtn?.addEventListener('click', async () => {
      forgotStatus.textContent = 'Sending reset code...';
      const { response, data } = await postForm("{{ path('api_auth_forgot_password') }}", {
        email: forgotEmail?.value || ''
      });

      if (!response.ok) {
        forgotStatus.textContent = data.message || 'Unable to send reset code.';
        return;
      }

      const debugCode = data.debugCode ? ` Code: ${data.debugCode}` : '';
      forgotStatus.textContent = (data.message || 'Reset code sent.') + debugCode;
    });

      forgotResetBtn?.addEventListener('click', async () => {
      forgotStatus.textContent = 'Resetting password...';
      const { response, data } = await postForm("{{ path('api_auth_reset_password') }}", {
        email: forgotEmail?.value || '',
        otpCode: forgotCode?.value || '',
        newPassword: forgotPassword?.value || ''
      });

      if (!response.ok) {
        forgotStatus.textContent = data.message || 'Unable to reset password.';
        return;
      }

      forgotStatus.textContent = data.message || 'Password updated.';
    });

    showFacePanelBtn?.addEventListener('click', async () => {
      faceSection?.classList.toggle('active');
      if (faceSection?.classList.contains('active') && faceEmail && loginEmail && !faceEmail.value.trim() && loginEmail.value.trim()) {
        faceEmail.value = loginEmail.value.trim();
      }
      if (faceSection?.classList.contains('active') && !cameraStarted) {
        await startCamera();
      }
    });

    [loginEmail, faceEmail].forEach((input) => {
      input?.addEventListener('input', () => {
        if (input === loginEmail && faceEmail && !faceEmail.value.trim()) {
          faceEmail.value = loginEmail.value.trim();
        }
      });
    });
  });
</script>
{% endblock %}
