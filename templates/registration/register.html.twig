{% extends 'base.html.twig' %}

{% block title %}Register | Fitopia{% endblock %}

{% block footer %}{% endblock %}

{% block stylesheets %}
<style>
  .register-page-shell {
    background: #f6fafb;
    min-height: 100vh;
  }
  .register-wrap {
    padding: 2rem 0 4rem;
  }
  .register-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 22px 60px rgba(14, 30, 37, 0.14);
  }
  .register-left {
    background: linear-gradient(160deg, #0b5f61 0%, #176f69 50%, #2f8a7d 100%);
    color: #fff;
    padding: 2.2rem;
  }
  .register-right {
    padding: 2.2rem;
  }
  .brand-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .brand-row img {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #fff;
    padding: 6px;
  }
  .brand-chip {
    background: #fff;
    color: #0b5f61;
    border-radius: 16px;
    padding: 0.55rem 1.1rem;
    font-weight: 800;
    font-size: 1.05rem;
  }
  .intro-kicker {
    font-size: 0.9rem;
    font-weight: 700;
    opacity: 0.85;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .register-left h2 {
    font-size: 2rem;
    line-height: 1.28;
    font-weight: 800;
    color: #08303f;
    margin-bottom: 1rem;
  }
  .register-left p {
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 620px;
    margin-bottom: 1.4rem;
  }
  .role-panel,
  .reason-panel {
    background: rgba(255, 255, 255, 0.13);
    border-radius: 18px;
    padding: 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .role-panel {
    margin-bottom: 1.2rem;
  }
  .role-panel h5,
  .reason-panel h5 {
    font-size: 0.95rem;
    font-weight: 800;
    margin-bottom: 0.9rem;
    text-transform: uppercase;
  }
  .role-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }
  .role-grid input[type="radio"] {
    display: none;
  }
  .role-grid label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.95rem 0.9rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    cursor: pointer;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.08);
    transition: all 0.2s ease;
  }
  .role-grid input[type="radio"]:checked + label {
    background: #fff;
    color: #0b5f61;
    border-color: #fff;
  }
  .reason-panel p,
  .reason-panel strong {
    color: #fff;
  }
  .register-right h3 {
    font-size: 1.95rem;
    font-weight: 800;
    color: #0f355c;
    margin-bottom: 0.4rem;
  }
  .register-right .subtle {
    color: #6279a2;
    font-size: 1.02rem;
    margin-bottom: 1.2rem;
  }
  .register-right .form-control,
  .register-right textarea,
  .register-right input[type="date"] {
    min-height: 54px;
    border-radius: 18px;
    border: 1px solid #d9e5f1;
    box-shadow: none;
    padding: 0.95rem 1.1rem;
  }
  .register-right textarea.form-control {
    min-height: 110px;
  }
  .assistant-box {
    margin-top: 1.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid #dbe6f2;
    border-radius: 18px;
    background: #f7fbff;
  }
  .assistant-box h5 {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f355c;
    margin-bottom: 0.7rem;
  }
  .assistant-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .assistant-output {
    margin-top: 0.9rem;
    color: #6279a2;
    min-height: 24px;
  }
  .assistant-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 0.9rem;
  }
  .assistant-field {
    color: #0f355c;
    font-size: 0.95rem;
  }
  .assistant-field strong {
    display: block;
    margin-bottom: 0.3rem;
  }
  .assistant-panel {
    margin-top: 0.9rem;
    border-radius: 18px;
    border: 12px solid #4b5563;
    background: #fff;
    color: #475569;
    min-height: 96px;
    padding: 0.85rem 1rem;
    width: 100%;
    resize: none;
  }
  .register-submit {
    margin-top: 1.4rem;
  }
  .register-submit .btn {
    min-height: 52px;
    border-radius: 14px;
    font-weight: 700;
  }
  @media (max-width: 991px) {
    .register-card {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 575px) {
    .role-grid,
    .assistant-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
{% endblock %}

{% block body %}
<div class="register-page-shell">
  {% include 'partials/navbar.html.twig' %}
  <section class="container register-wrap">
    {{ form_start(registrationForm, {'attr': {'id': 'register-form'}}) }}
    <div class="register-card">
      <div class="register-left">
        <div class="brand-row">
          <img src="{{ asset('images/logo.png') }}" alt="Fitopia logo">
          <div class="brand-chip">fitopia</div>
        </div>
        <div class="intro-kicker">Welcome to Fitopia</div>
        <h2>Create your account and enter a cleaner Fitopia experience.</h2>
        <p>Join the platform with a full profile, a clear role selection and guided account setup designed to match the Java project.</p>

        <div class="role-panel">
          <h5>You will join as</h5>
          <div class="role-grid">
            {% for child in registrationForm.role %}
              {{ form_widget(child) }}
              <label for="{{ child.vars.id }}">
                <span>{{ child.vars.label }}</span>
                <span>{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}</span>
              </label>
            {% endfor %}
          </div>
          {{ form_errors(registrationForm.role) }}
        </div>

        <div class="reason-panel">
          <h5>Why create an account</h5>
          <p id="role-description-text">A personalized profile, role-based access, and a smoother entry into the Fitopia platform.</p>
          <strong id="role-description-label">Patient</strong>
        </div>
      </div>

      <div class="register-right">
        <h3>Account Information</h3>
        <p class="subtle">Complete your profile details to create your account.</p>

        {% for message in app.flashes('error') %}
          <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {% if not registrationForm.vars.valid %}
          <div class="alert alert-danger">{{ form_errors(registrationForm) }}</div>
        {% endif %}

        <div class="row">
          <div class="col-md-6 mb-3">
            {{ form_widget(registrationForm.firstName, {'attr': {'class': 'form-control', 'placeholder': 'First name', 'id': 'reg-first-name'}}) }}
            {{ form_errors(registrationForm.firstName) }}
          </div>
          <div class="col-md-6 mb-3">
            {{ form_widget(registrationForm.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Last name', 'id': 'reg-last-name'}}) }}
            {{ form_errors(registrationForm.lastName) }}
          </div>
        </div>

        <div class="mb-3">
          {{ form_widget(registrationForm.username, {'attr': {'class': 'form-control', 'placeholder': 'Username', 'id': 'reg-username'}}) }}
          {{ form_errors(registrationForm.username) }}
        </div>

        <div class="mb-3">
          {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'Email', 'id': 'reg-email'}}) }}
          {{ form_errors(registrationForm.email) }}
        </div>

        <div class="mb-3">
          {{ form_widget(registrationForm.phone, {'attr': {'class': 'form-control', 'placeholder': 'Phone', 'id': 'reg-phone'}}) }}
          {{ form_errors(registrationForm.phone) }}
        </div>

        <div class="row">
          <div class="col-md-4 mb-3">
            {{ form_widget(registrationForm.birthDate, {'attr': {'class': 'form-control', 'id': 'reg-birth-date'}}) }}
            {{ form_errors(registrationForm.birthDate) }}
          </div>
          <div class="col-md-8 mb-3">
            {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Plain password'}}) }}
            {{ form_errors(registrationForm.plainPassword) }}
          </div>
        </div>

        <div class="mb-3">
          {{ form_widget(registrationForm.bio, {'attr': {'class': 'form-control', 'placeholder': 'Short bio or profile description', 'id': 'reg-bio'}}) }}
          {{ form_errors(registrationForm.bio) }}
        </div>

        <div class="assistant-box">
          <h5>AI SignUp Assistant</h5>
          <p class="subtle mb-2">L'IA peut corriger vos noms, normaliser le telephone, suggerer un username et reformuler votre bio.</p>
          <div class="assistant-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="assistant-generate-btn">Generer les suggestions IA</button>
            <button type="button" class="btn btn-outline-dark btn-sm" id="assistant-apply-btn">Appliquer au formulaire</button>
          </div>
          <div class="assistant-output" id="assistant-output">Les suggestions IA apparaitront ici.</div>
          <div class="assistant-grid">
            <div class="assistant-field">
              <strong>Username suggere</strong>
              <span id="assistant-username">-</span>
            </div>
            <div class="assistant-field">
              <strong>Telephone normalise</strong>
              <span id="assistant-phone">-</span>
            </div>
          </div>
          <div class="assistant-field mt-3">
            <strong>Bio amelioree</strong>
            <textarea id="assistant-bio" class="assistant-panel" rows="3" readonly placeholder="La bio reformulee apparaitra ici"></textarea>
          </div>
          <div class="assistant-field mt-3">
            <strong>Resume du profil</strong>
            <textarea id="assistant-summary" class="assistant-panel" rows="3" readonly placeholder="Le resume du profil apparaitra ici"></textarea>
          </div>
        </div>

        <div class="register-submit">
          <button class="btn btn-dark w-100">Create Account</button>
        </div>

        <div class="text-center mt-3">
          <small>Already have an account?</small><br>
          <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-sm mt-2">Login</a>
        </div>
      </div>
    </div>
    {{ form_end(registrationForm) }}
  </section>
</div>
{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const roleInputs = Array.from(document.querySelectorAll('input[name="registration_form[role]"]'));
    const roleLabel = document.getElementById('role-description-label');
    const roleText = document.getElementById('role-description-text');
    const generateBtn = document.getElementById('assistant-generate-btn');
    const applyBtn = document.getElementById('assistant-apply-btn');
    const output = document.getElementById('assistant-output');
    const assistantUsername = document.getElementById('assistant-username');
    const assistantPhone = document.getElementById('assistant-phone');
    const assistantBio = document.getElementById('assistant-bio');
    const assistantSummary = document.getElementById('assistant-summary');
    const firstName = document.getElementById('reg-first-name');
    const lastName = document.getElementById('reg-last-name');
    const username = document.getElementById('reg-username');
    const email = document.getElementById('reg-email');
    const phone = document.getElementById('reg-phone');
    const bio = document.getElementById('reg-bio');
    let lastSuggestions = null;

    const roleDescriptions = {
      ROLE_PATIENT: {
        label: 'Patient',
        text: 'A personalized profile, role-based access, and a smoother entry into the Fitopia platform.'
      },
      ROLE_COACH: {
        label: 'Coach',
        text: 'Manage your professional presence and stay aligned with the coaching module from the Java project.'
      },
      ROLE_NUTRITIONIST: {
        label: 'Nutritionist',
        text: 'Create your nutritionist account with the same clean entry flow used in the Java project.'
      },
      ROLE_ADMIN: {
        label: 'Admin',
        text: 'Access the admin area with the same core account information and role structure.'
      }
    };

    function toTitle(value) {
      return (value || '')
        .trim()
        .toLowerCase()
        .replace(/\b\w/g, (letter) => letter.toUpperCase());
    }

    function normalizePhone(value) {
      return (value || '').replace(/[^\d+]/g, '');
    }

    async function fetchAssistantSuggestions() {
      const selected = roleInputs.find((input) => input.checked);
      const payload = {
        firstName: firstName?.value || '',
        lastName: lastName?.value || '',
        email: email?.value || '',
        phone: phone?.value || '',
        bio: bio?.value || '',
        role: selected?.value || 'ROLE_PATIENT'
      };

      const response = await fetch("{{ path('app_register_assistant') }}", {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ok) {
        throw new Error(data.message || 'Assistant unavailable');
      }

      return data;
    }

    function updateRoleText() {
      const selected = roleInputs.find((input) => input.checked);
      const meta = selected ? roleDescriptions[selected.value] : roleDescriptions.ROLE_PATIENT;
      roleLabel.textContent = meta.label;
      roleText.textContent = meta.text;
    }

    function buildSuggestions() {
      const safeFirst = toTitle(firstName?.value || '');
      const safeLast = toTitle(lastName?.value || '');
      const safePhone = normalizePhone(phone?.value || '');
      const safeEmail = (email?.value || '').trim().toLowerCase();
      const draftedBio = (bio?.value || '').trim().replace(/\s+/g, ' ');
      const suggestedUsername = safeEmail && safeEmail.includes('@')
        ? safeEmail.split('@')[0]
        : [safeFirst, safeLast].join('.').toLowerCase().replace(/\s+/g, '').replace(/^\./, '') || ('fitopia' + (safePhone.slice(-4) || 'user'));

      const selected = roleInputs.find((input) => input.checked);
      const roleName = selected ? (roleDescriptions[selected.value]?.label || 'Patient') : 'Patient';
      const displayName = `${safeFirst} ${safeLast}`.trim() || 'This member';
      const suggestedBio = draftedBio
        ? `${displayName} is joining Fitopia as ${roleName.toLowerCase()}. ${draftedBio.replace(/[.?!]*$/, '.')}`
        : `${displayName} is joining Fitopia as ${roleName.toLowerCase()} and is ready to build a healthier routine.`;

      return {
        firstName: safeFirst,
        lastName: safeLast,
        username: suggestedUsername,
        phone: safePhone,
        bio: suggestedBio,
        summary: `${displayName} ${roleName.toLowerCase()} account ready${safePhone ? `, phone ${safePhone}` : ''}.`
      };
    }

    function renderSuggestions(suggestions) {
      output.textContent = 'Suggestions generees avec succes.';
      if (assistantUsername) assistantUsername.textContent = suggestions.username || '-';
      if (assistantPhone) assistantPhone.textContent = suggestions.phone || '-';
      if (assistantBio) assistantBio.value = suggestions.bio || '';
      if (assistantSummary) assistantSummary.value = suggestions.summary || '';
      if (bio && suggestions.bio) bio.value = suggestions.bio;
    }

    roleInputs.forEach((input) => input.addEventListener('change', updateRoleText));
    updateRoleText();

    generateBtn?.addEventListener('click', async () => {
      output.textContent = 'Generation des suggestions en cours...';
      try {
        lastSuggestions = await fetchAssistantSuggestions();
      } catch (error) {
        lastSuggestions = buildSuggestions();
      }
      renderSuggestions(lastSuggestions);
    });

    applyBtn?.addEventListener('click', () => {
      if (!lastSuggestions) {
        lastSuggestions = buildSuggestions();
        renderSuggestions(lastSuggestions);
      }

      if (firstName && lastSuggestions.firstName) firstName.value = lastSuggestions.firstName;
      if (lastName && lastSuggestions.lastName) lastName.value = lastSuggestions.lastName;
      if (username && lastSuggestions.username) username.value = lastSuggestions.username;
      if (phone && lastSuggestions.phone) phone.value = lastSuggestions.phone;
      if (bio && lastSuggestions.bio) bio.value = lastSuggestions.bio;
      output.textContent = 'Suggestions appliquees au formulaire.';
    });
  });
</script>
{% endblock %}
