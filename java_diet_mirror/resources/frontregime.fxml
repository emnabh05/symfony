                                    <Button onAction="#supprimerRepas" styleClass="danger-button" text="Supprimer définitivement"/>
                                </HBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>

                <!-- 8. EXPLORER REPAS -->
                <VBox fx:id="paneRepasExplore" alignment="CENTER" managed="false" visible="false" style="-fx-background-color: rgba(0,0,0,0.5);">
                    <ScrollPane fitToWidth="true" maxWidth="950" maxHeight="850" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 20;">
                        <content>
                            <VBox maxWidth="850" spacing="18.0" styleClass="panel-card" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.02), 5, 0, 0, 2); -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 30, 0, 0, 15);">
                                <HBox alignment="CENTER_RIGHT"><Button onAction="#masquerTousLesFormulaires" text="✖ Fermer" style="-fx-background-color: #bb2d22; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8;"/></HBox>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="section-title" text="Explorer les repas"/>
                                        <Label fx:id="lblRepasExploreCount" styleClass="section-subtitle" text="0 repas affichés"/>
                                    </VBox>
                                    <Button onAction="#afficherStatistiquesRepas" styleClass="primary-button" text="Statistiques"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="14.0">
                                    <ComboBox fx:id="cbRepasExploreSort" prefWidth="190.0" styleClass="combo-input"/>
                                    <TextField fx:id="tfRepasSearch" promptText="Rechercher..." styleClass="text-input" HBox.hgrow="ALWAYS"/>
                                    <ComboBox fx:id="cbRepasExploreTypeFilter" prefWidth="180.0" styleClass="combo-input"/>
                                </HBox>
                                <TilePane fx:id="tileRepasCards" hgap="18.0" vgap="18.0" prefColumns="2" />
                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>

                <!-- 9. SCAN IMAGE POPUP -->
                <VBox fx:id="paneScanIA" alignment="CENTER" managed="false" visible="false" style="-fx-background-color: rgba(15, 23, 42, 0.75);">
                    <VBox maxWidth="700" spacing="24.0" style="-fx-background-color: white; -fx-background-radius: 28; -fx-padding: 36; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 40, 0, 0, 20);">
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblScanIATitle" text="Reconnaissance Visuelle" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #0F172A;"/>
                                <Label fx:id="lblScanIASubtitle" text="Analysez votre plat instantanément grâce à l'intelligence artificielle." style="-fx-font-size: 14px; -fx-text-fill: #64748B;"/>
                            </VBox>
                            <Button onAction="#masquerTousLesFormulaires" text="✕" style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-font-weight: 900; -fx-font-size: 18px; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.02), 5, 0, 0, 2); -fx-min-width: 44; -fx-min-height: 44; -fx-cursor: hand;"/>
                        </HBox>
                        
                        <VBox spacing="24" alignment="CENTER">
                             <StackPane maxWidth="550" maxHeight="320" style="-fx-background-color: #F8FAFC; -fx-background-radius: 20; -fx-border-color: #E2E8F0; -fx-border-width: 2; -fx-border-style: dashed; -fx-border-radius: 20; -fx-padding: 10;">
                                  <ImageView fx:id="ivScanImagePreview" fitWidth="500" fitHeight="300" preserveRatio="true" smooth="true" cache="true">
                                      <effect>
                                          <DropShadow color="rgba(0,0,0,0.1)" radius="15" />
                                      </effect>
                                  </ImageView>
                                  
                                  <Pane fx:id="paneScanOverlay" managed="false" visible="false" mouseTransparent="true">
                                       <Region fx:id="regionScanLine" prefHeight="4" prefWidth="500" style="-fx-background-color: #10B981; -fx-effect: dropshadow(gaussian, #10B981, 20, 0.6, 0, 0);"/>
                                       <Region prefHeight="300" prefWidth="500" style="-fx-background-color: linear-gradient(to bottom, rgba(16,185,129,0.1), transparent, rgba(16,185,129,0.1));"/>
                                  </Pane>
                             </StackPane>
                             
                             <HBox alignment="CENTER" spacing="20">
                                  <Button fx:id="btnScanIAUpload" text="📁 Charger une photo" onAction="#chargerImagePourScan" prefHeight="50" style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px; -fx-background-radius: 14; -fx-padding: 0 28; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.2), 10, 0, 0, 4);"/>
                                  
                                  <VBox fx:id="boxResultatIA" spacing="12" alignment="CENTER_LEFT" prefWidth="320" style="-fx-background-color: #F0FDF4; -fx-padding: 20; -fx-border-color: #DCFCE7; -fx-border-radius: 16; -fx-background-radius: 16;" managed="false" visible="false">
                                       <HBox spacing="8" alignment="CENTER_LEFT">
                                           <Label text="✨" style="-fx-font-size: 18px;"/>
                                           <Label text="Repas détecté" style="-fx-text-fill: #166534; -fx-font-weight: 900; -fx-font-size: 14px;"/>
                                       </HBox>
                                       <TextField fx:id="tfIARepasNomParticulier" prefHeight="44" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #BBF7D0; -fx-border-radius: 10; -fx-font-weight: 800;"/>
                                       <Label fx:id="lblIACalories" text="Calories : 0 kcal" style="-fx-text-fill: #15803D; -fx-font-weight: 900; -fx-font-size: 16px;"/>
                                       <Button fx:id="btnAppliquerCalories" maxWidth="Infinity" text="💾 Ajouter à mon journal" onAction="#appliquerCaloriesScan" prefHeight="44" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: 900; -fx-background-radius: 10; -fx-cursor: hand;"/>
                                  </VBox>
                             </HBox>
                        </VBox>
                        
                        <VBox alignment="CENTER" spacing="12">
                             <Label fx:id="lblScanStatus" text="Analyse du plat en cours..." visible="false" style="-fx-text-fill: #059669; -fx-font-weight: 900; -fx-font-size: 13px;"/>
                             <ProgressBar fx:id="pbScanProgress" prefWidth="600" visible="false" prefHeight="10" styleClass="calorie-progress-bar" style="-fx-accent: #10B981;"/>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- 10. WEEKLY PROGRAM POPUP -->
                <VBox fx:id="paneWeeklyProgram" alignment="CENTER" managed="false" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);">
                    <VBox maxWidth="1100" maxHeight="750" spacing="0" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 40, 0, 0, 20); -fx-overflow: hidden;">
                        
                        <!-- Header Premium Vert Sombre -->
                        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: linear-gradient(to right, #0c3f44, #1a7177); -fx-padding: 30; -fx-background-radius: 20 20 0 0;">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="📅 Mon Programme de Nutrition" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                <Label text="Planning hebdomadaire personnalisé selon vos besoins caloriques." style="-fx-font-size: 14px; -fx-text-fill: #ecfdf5;"/>
                            </VBox>
                            <Button text="Re-générer la semaine" onAction="#genererSemaineIARegimeActif" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand;"/>
                            <Button onAction="#masquerTousLesFormulaires" text="✕" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 18px; -fx-background-radius: 10; -fx-min-width: 45; -fx-min-height: 45; -fx-cursor: hand;"/>
                        </HBox>

                        <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-background: white; -fx-padding: 20;">
                            <VBox fx:id="boxWeeklyDaysContainer" spacing="25" style="-fx-padding: 10;" />
                        </ScrollPane>

                        <HBox alignment="CENTER" style="-fx-padding: 15; -fx-background-color: #f8fafc; -fx-background-radius: 0 0 20 20; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
                            <Label text="Cliquez sur le 'plus' pour ajouter un plat à votre suivi d'aujourd'hui." style="-fx-text-fill: #64748b; -fx-font-style: italic;"/>
                        </HBox>
                </VBox>
            </VBox>

                <!-- OCN Optimiseur Popup (Now handled via code-based Stage for better styling) -->

                <!-- 12. MOTEUR DE RECOMMANDATION NUTRITIONNELLE -->
                <VBox fx:id="paneRecommandation" alignment="CENTER" managed="false" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);">
                    <ScrollPane fitToWidth="true" maxWidth="950" maxHeight="850" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 20;">
                        <content>
                            <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 30, 0, 0, 15);">

                                <!-- En-tête -->
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <VBox HBox.hgrow="ALWAYS" spacing="4">
                                        <Label text="🛒 Ma Liste de Courses"
                                               style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #111827;"/>
                                        <Label fx:id="lblRecommandationTitre"
                                               text="Ingr&#233;dients n&#233;cessaires pour vos repas Spoonacular"
                                               style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                                    </VBox>
                                    <Button onAction="#masquerTousLesFormulaires" text="&#10006; Fermer"
                                            style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand;"/>
                                </HBox>

                                <Separator/>

                                <!-- Bandeau explicatif supprimé -->
                                <!-- Zone des cartes de recommandation (inject&#233;e dynamiquement) -->
                                <VBox fx:id="boxRecommandationCards" spacing="14"/>

                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>

                </StackPane>
            
            <!-- Floating Buttons -->
            <Button text="📷 Scanner un plat" onAction="#afficherPopupScanIA" 
                    onMouseEntered="#hoverScannerOn" onMouseExited="#hoverScannerOff"
                    style="-fx-background-color: #0c3f44; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 14 24; -fx-font-weight: 800; -fx-font-size: 14px; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.4), 10, 0, 0, 5); -fx-cursor: hand;"
                    StackPane.alignment="BOTTOM_RIGHT" translateX="-24" translateY="-24" />
        </StackPane>
    </center>
</BorderPane>
